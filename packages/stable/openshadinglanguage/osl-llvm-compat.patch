     // faster). Since we call the option "jit_fma", we interpret that as
     // switching between Strict and Standard. We will need some other control
     // if we ever want full "Fast" mode.
+#if OSL_LLVM_VERSION < 240
+    // AllowFPOpFusion and the llvm::FPOpFusion mode enum were removed from
+    // TargetOptions in LLVM 24 (llvm/llvm-project PR #222683); FP contraction
+    // is now derived solely from the per-instruction 'contract' fast-math
+    // flag. OSL's IR never sets 'contract' and never emits llvm.fmuladd, so
+    // neither the Standard nor the Strict branch here ever contracted
+    // anything; simply dropping the assignment for LLVM 24+ preserves the
+    // existing behavior. (fp fusion is also constrained by the CPU feature
+    // selection in detect_cpu_features below.)
     options.AllowFPOpFusion = jit_fma() ? llvm::FPOpFusion::Standard
                                         : llvm::FPOpFusion::Strict;
+#endif
     // Unfortunately enabling UnsafeFPMath allows reciprocals, which we don't want for divides
     // To match results for existing unit tests we might need to disable UnsafeFPMath
     // TODO: investigate if reciprocals can be disabled by other means.
@@ -1572,15 +1582,29 @@
     options.NoSignedZerosFPMath = false;
 #endif
     // We will not be setting up any exception handling for FP math
+#if OSL_LLVM_VERSION < 240
     options.NoTrappingFPMath = true;
+#endif
+#if OSL_LLVM_VERSION < 240
+    // HonorSignDependentRoundingFPMathOption was removed from TargetOptions
+    // in LLVM 24 (llvm/llvm-project PR #222027); its documented meaning,
+    // honoring a dynamically-changeable rounding mode, is what strictfp
+    // expresses. OSL set it to false (which was LLVM's default) and its JIT
+    // code is not strictfp, so dropping the assignment preserves behavior.
     // We will NOT be changing rounding mode dynamically
     options.HonorSignDependentRoundingFPMathOption = false;
+#endif
 
