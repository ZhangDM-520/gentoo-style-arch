+    // FloatABIType was removed from TargetOptions in LLVM 24; the float ABI
+    // is now taken from the module flags or inferred from the target triple,
+    // which matches the FloatABI::Default value that was set here.
     options.FloatABIType          = llvm::FloatABI::Default;
+#endif
 #if OSL_LLVM_VERSION < 190
     options.RelaxELFRelocations = false;
 #endif
