# Maintainer : Daniel Bermond <dbermond@archlinux.org>
# Contributor: Dave Reisner <d@falconindy.com>

pkgname=pkgfile
pkgver=27
pkgrel=1.1
pkgdesc='A tool to search for files in official repository packages'
arch=('x86_64')
url='https://github.com/falconindy/pkgfile/'
license=('MIT')
depends=(
    'curl'
    'glibc'
    'libarchive'
    'libgcc'
    'libstdc++'
    'pacman'
    'pcre'
    'systemd-libs')
makedepends=(
    'git'
    'meson')
checkdepends=(
    'gtest'
    'python')
install=pkgfile.install
source=("git+https://github.com/falconindy/pkgfile.git#tag=v${pkgver}?signed")
sha256sums=('6cbabedf072ef730ceae544c2da1a6ef2306cb37713ad8993f64bbddd2322566')
validpgpkeys=('487EACC08557AD082088DABA1EB2638FF56C0C53') # Dave Reisner <d@falconindy.com>

build() {
    # pod2man lives in /usr/bin/core_perl since Perl 5.42 — on PATH for login
    # shells only, not the makepkg context (sudo secure_path); meson's
    # find_program in pkgfile/meson.build dies without it (same root cause
    # as the git-git/openssl/libpwquality incidents, 2026-09-07/2026-10-19).
    export PATH="/usr/bin/core_perl:$PATH"
    # House style: mold linker when available (runtime-guarded, no output effect).
    local _mold=""
    command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
    export LDFLAGS+=" ${_mold}"
    arch-meson "$pkgname" build
    meson compile -C build --jobs "${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
    meson test -C build --print-errorlogs
}

package() {
    meson install -C build --destdir "$pkgdir"

    # trim: man pages (man8 pkgfile, man8 pkgfile-update) (docs) — not shipped
    rm -rf "$pkgdir"/usr/share/man

    # explicit licence ship (repo convention); upstream's meson install also
    # places LICENSE here — path is $srcdir-relative unless qualified
    install -Dm644 "$srcdir/$pkgname/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
