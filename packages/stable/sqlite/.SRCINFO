pkgname = sqlite
	pkgdesc = A C library that implements an SQL database engine
	depends = readline
	depends = zlib
	depends = glibc
	provides = sqlite3=3.53.4
	provides = libsqlite3.so
	replaces = sqlite3

pkgname = sqlite-tcl
	pkgdesc = sqlite Tcl Extension Architecture (TEA)
	depends = sqlite
	depends = tcl
	depends = zlib
	depends = glibc
	provides = sqlite3-tcl=3.53.4
	replaces = sqlite3-tcl

pkgname = sqlite-analyzer
	pkgdesc = An analysis program for sqlite3 database files
	depends = sqlite
	depends = tcl
	depends = glibc

pkgname = lemon
	pkgdesc = A parser generator
	depends = glibc
