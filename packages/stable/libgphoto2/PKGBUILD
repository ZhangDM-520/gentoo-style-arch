pkgbase=libgphoto2
# Per-output recipe: builds/ships only the libgphoto2 split; the
# libgphoto2-docs split is trimmed (docs).
# trim: dropped split libgphoto2-docs (doxygen/graphviz API docs) together
# with its package_*() function, split-doc staging paths and its
# doxygen/graphviz makedeps and the -D docs=true build bit
pkgname=(
  libgphoto2
)
pkgver=2.5.34
pkgrel=1
pkgdesc="Digital camera access library"
url="http://www.gphoto.org/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  bash
  curl
  gd
  glibc
  libexif
  libjpeg-turbo
  libltdl
  libtiff
  libusb
  libxml2
)
makedepends=(
  git
  meson
)
source=(
  "git+https://github.com/gphoto/libgphoto2#tag=v$pkgver"
)
b2sums=('a8d8159e3cda9046c1dbd4a79b88db7a716769d872e5b15241f78727bce5bcab91bd57a09407a0d6653af72ff44d407b08ec505195a7a76f5fe10d17d3bcfd2a')
validpgpkeys=(
  7C4AFD61D8AAE7570796A5172209D6902F969C95 # Marcus Meissner <marcus@jet.franken.de>
)

prepare() {
  cd $pkgbase
}

build() {
  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local meson_options=(
    -D docs=false
  )

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs --no-suite no-ci
}

package_libgphoto2() {
  provides=(libgphoto2{,_port}.so)

  meson install -C build --destdir "$pkgdir"

  # trim: docs — API docs are not built (-D docs=false); drop any remaining
  # stock /usr/share/doc staging with the dropped docs split
  rm -rf "$pkgdir"/usr/share/doc

  local camlibdir="$pkgdir/usr/lib/libgphoto2/$pkgver"
  test -d "$camlibdir"

  # Remove unused udev helper
  rm -v "$pkgdir/usr/lib/udev/check-ptp-camera"

  (
    export LD_LIBRARY_PATH="$pkgdir/usr/lib"
    export CAMLIBS="$camlibdir"

    build/packaging/generic/print-camera-list hwdb \
      | install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/hwdb.d/20-gphoto.hwdb"
    build/packaging/generic/print-camera-list udev-rules version 201 \
      | install -Dm644 /dev/stdin "$pkgdir/usr/lib/udev/rules.d/40-gphoto.rules"
  )

  # license
  install -Dm644 "$pkgbase"/COPYING \
    "$pkgdir"/usr/share/licenses/"$pkgname"/COPYING
}

