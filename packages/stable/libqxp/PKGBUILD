# Maintainer: AndyRTR <andyrtr@archlinux.org>

pkgname=libqxp
pkgver=0.0.3
pkgrel=1.1
pkgdesc="a library that parses the file format of QuarkXPress documents"
arch=('x86_64')
url="https://wiki.documentfoundation.org/DLP/Libraries/libqxp"
license=('MPL-2.0')
depends=('librevenge' 'icu' 'glibc' 'libstdc++' 'libgcc')
makedepends=('boost' 'cppunit')
# trim: doxygen (makedepends) — the doxygen API docs are not shipped;
# --without-docs in build() disables docs/doxygen for good
source=("https://dev-www.libreoffice.org/src/$pkgname/$pkgname-$pkgver.tar.xz")
sha256sums=('4687a9cc96c32d7406e5072c4da150fca696c563e5cde62b024f82fa53d32332')

prepare() {
	cd "$pkgname-$pkgver"
	autoreconf -vfi
}

build() {
	cd "$pkgname-$pkgver"
	# House style: mold linker when available
	local _mold=""
	command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
	export LDFLAGS+=" ${_mold}"
	./configure --prefix=/usr --without-docs
        sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
	make
}

check() {
	cd "$pkgname-$pkgver"
	make check
}

package() {
	cd "$pkgname-$pkgver"
	provides=(libqxp-0.0.so)

	make DESTDIR="$pkgdir/" install
	# trim: doxygen API docs — never built (--without-docs)
	rm -rf "$pkgdir"/usr/share/doc
	install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
