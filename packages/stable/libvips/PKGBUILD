# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=libvips
pkgver=8.18.7
pkgrel=1
pkgdesc="A fast image processing library with low memory needs"
arch=('x86_64')
license=('LGPL-2.1-or-later')
url="https://libvips.github.io/libvips/"
depends=('cairo' 'cfitsio' 'expat' 'fftw' 'fontconfig' 'glib2' 'glibc' 'highway'
         'lcms2' 'libarchive' 'libcgif' 'libexif' 'libgcc' 'libimagequant'
         'libjpeg-turbo' 'libmatio' 'libpng' 'libraw' 'librsvg' 'libstdc++'
         'libtiff' 'libwebp' 'openexr' 'openjpeg2' 'pango' 'zlib')
# trim: doxygen/gi-docgen/graphviz dropped together with the libvips-docs
# split output (docs are not built in this recipe)
makedepends=('glib2-devel' 'gobject-introspection'
             'imagemagick' 'libheif' 'libjxl' 'meson' 'openslide'
             'poppler-glib' 'vala')
checkdepends=('python-pytest' 'python-pyvips')
source=("https://github.com/libvips/libvips/releases/download/v$pkgver/vips-$pkgver.tar.xz")
sha512sums=('f1fb30f15c321c686ede573b3d00a850a9b138ea82473a5ad900454923758e0ee593ee9fb724a68aff389b506996719f9220e6f1fb62be375df15a7cb08edfa4')

build() {
  local meson_options=(
    # trim: docs/cpp-docs disabled with the libvips-docs split output
    -D cpp-docs=false
    -D docs=false
    -D nifti=disabled
    -D pdfium=disabled
    -D uhdr=disabled
    -D vapi=true
  )

  arch-meson vips-$pkgver build "${meson_options[@]}"

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  meson compile -C build
}

check() {
  meson test -C build
  LD_LIBRARY_PATH="$srcdir/build/libvips" \
    pytest -k "not test_text" -sv --log-cli-level=WARNING \
    vips-$pkgver/test/test-suite
}

package_libvips() {
  optdepends=('imagemagick: for magick module'
              'libheif: for heif module'
              'libjxl: for jxl module'
              'openslide: for openslide module'
              'poppler-glib: for poppler module'
              'python: for vipsprofile')
  provides=('libvips.so' 'libvips-cpp.so')

  meson install -C build --destdir="$pkgdir"

  # trim: docs/man + the libvips-docs split output (dropped together with its
  # package() and doc staging; lean consumer-rebuild recipe ships no docs)
  rm -rf "$pkgdir"/usr/share/doc "$pkgdir"/usr/share/man

  install -Dm644 vips-$pkgver/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

# trim: dropped the libvips-docs split output (this single-output recipe
# packages only libvips; docs are not needed for ABI-rebuild consumers)

