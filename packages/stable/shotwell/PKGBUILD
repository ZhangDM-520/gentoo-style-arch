# Maintainer : Ionut Biru <ibiru@archlinux.org>
# Contributor: Joeny Ang <ang(dot)joeny(at)gmail(dot)com>

pkgname=shotwell
epoch=2
pkgver=33.0
_basever=${pkgver%.*}
pkgrel=2
pkgdesc="A digital photo organizer designed for the GNOME desktop environment"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/shotwell"
license=('LGPL-2.1-or-later')
depends=('libgee' 'gexiv2' 'libraw' 'libsoup3'
	 'dconf' 'hicolor-icon-theme' 'json-glib' 'gcr-4'
	 'gst-plugins-base' 'libgphoto2' 'libgudev'
	 'gtk4' 'libportal-gtk4')
# bare soname provides for the three sonamed libs (builtin publishing/
# transitions plugins are soname-less dlopened modules — no provides)
provides=('libshotwell-authenticator.so' 'libshotwell-plugin-common.so' 'libshotwell-plugin-dev-1.0.so')
makedepends=('vala' 'itstool' 'meson' 'ninja' 'git')
optdepends=('gst-libav: encoders, decoders, muxers, and demuxers provided by FFmpeg')
source=("git+https://gitlab.gnome.org/GNOME/shotwell.git#tag=$pkgver")
sha256sums=('e1195715fc0f9f76b857f16e99a9fffc397e9d526225f086f86b37b22357c92a')

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson ${pkgname} build
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "${pkgdir}"
  # trim: man page (docs) — GNOME help pages kept (help/meson.build hard-requires
  # itstool and exposes no docs knob)
  rm -rf "${pkgdir}"/usr/share/man
  install -Dm644 "$srcdir/shotwell/COPYING" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
}
