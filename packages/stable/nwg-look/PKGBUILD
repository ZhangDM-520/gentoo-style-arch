# Maintainer: Robin Candau <antiz@archlinux.org>
# Contributor: kpcyrd <kpcyrd[at]archlinux[dot]org>
# Contributor: Piotr Miller <nwg.piotr@gmail.com>

pkgname=nwg-look
pkgver=1.1.2
pkgrel=1
pkgdesc="GTK settings editor adapted to work on wlroots-based compositors"
url="https://github.com/nwg-piotr/nwg-look"
arch=('x86_64')
license=('MIT')
depends=('glibc' 'gtk3' 'at-spi2-core' 'cairo' 'fontconfig' 'freetype2' 'gdk-pixbuf2' 'glib2' 'harfbuzz' 'pango' 'zlib' 'xcur2png')
makedepends=('go')
source=("${url}/archive/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('2db9bf20042beec0e9e9bba5769c08e34197e3a0da595b743c39b384aa0e0af0')

build() {
	cd "${pkgname}-${pkgver}"
	# House style: mold linker when available
	local _mold=""
	command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
	go build \
		-trimpath \
		-buildmode=pie \
		-mod=readonly \
		-modcacherw \
		-p "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}" \
		-ldflags "-linkmode external -extldflags \"${LDFLAGS} ${_mold}\"" \
		-o bin/nwg-look \
		.
}

package() {
	make DESTDIR="${pkgdir}" install -C "${pkgname}-${pkgver}"
	# trim: man/locales — lean consumer-rebuild recipe
	rm -rf "${pkgdir}/usr/share/man" "${pkgdir}/usr/share/locale"
	# license: ship upstream licence text (MIT)
	local _l
	for _l in LICENSE LICENSE.md COPYING; do
		if [[ -f ${pkgname}-${pkgver}/$_l ]]; then install -Dm644 "${pkgname}-${pkgver}/$_l" -t "${pkgdir}/usr/share/licenses/${pkgname}/"; fi
	done
}
