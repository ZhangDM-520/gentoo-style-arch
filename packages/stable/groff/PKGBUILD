# Maintainer: Tobias Powalowski <tpowa@archlinux.org>

pkgname=groff
pkgver=1.24.2
pkgrel=1.1
pkgdesc='GNU troff text-formatting system'
arch=('x86_64')
url='https://www.gnu.org/software/groff/groff.html'
license=('GPL-3.0-or-later')
depends=(
  glibc
  libgcc
  libstdc++
  libx11
  libxaw
  libxmu
  libxt
  perl
  uchardet
)
makedepends=(
  git
  netpbm
  psutils
  libxaw
  perl-file-homedir
)
optdepends=(
  'netpbm: for use together with man -H command interaction in browsers'
  'psutils: for use together with man -H command interaction in browsers'
  'perl-file-homedir: for use with glilypond'
)
options=(
  !docs
  !emptydirs
  !makeflags
)
validpgpkeys=(
  '2D0C08D2B0AD0D3D8626670272D23FBAC99D4E75' # G. Branden Robinson <g.branden.robinson@gmail.com
  '8773D61D68E30E072B10DC1AD19E9C7D71266DCE' # Bertrand Garrigues <bertrand.garrigues@laposte.net>
)
source=(
  git+https://git.savannah.gnu.org/git/groff.git?signed#tag=${pkgver}
  site.tmac
)
b2sums=('51dfb48d7ad28d29cd2468ccf5553767fcd7f6905d8829eb2bb5fab66fe6df0c913be077e173a358d00d851a7d1f7f8825424b3488620838dea809268103a595'
        '39087d04a2af011820e9428c3c01da4be63cd34125bb087097b4e56865806e33e3e20a666885110ab71d36eeafdbfb01202ca4ee45d6cdeed8ab71d83852341b')

prepare() {
  cd "${pkgname}"
  ./bootstrap
}  

build() {
  cd "${pkgname}"
  # House style: mold linker when available (runtime-guarded, no output effect).
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  # --without-urw-fonts: the git tree carries no pregenerated devpdf/U-*
  # descriptions (release tarballs do), and generating them needs URW AFM
  # files no system package provides. Stock groff ships without U-* too, so
  # this is parity with the repo package, not a trim.
  ./configure \
    --prefix=/usr \
    --with-x \
    --with-appresdir=/usr/share/X11/app-defaults \
    --without-urw-fonts
  # Stock `!makeflags` is load-bearing: groff's recursive make is not
  # parallel-safe, so GSA_BUILD_JOBS is deliberately not applied here.
  make
}

check() {
  cd "${pkgname}"
  make check
}

package() {
  cd "${pkgname}"
  make DESTDIR="$pkgdir" install
  
  # add compatibility symlinks
  ln -s eqn "${pkgdir}"/usr/bin/geqn
  ln -s tbl "${pkgdir}"/usr/bin/gtbl
  ln -s soelim "${pkgdir}"/usr/bin/zsoelim

  cat "${srcdir}"/site.tmac >> \
  "${pkgdir}"/usr/share/groff/site-tmac/man.local
  cat "$srcdir"/site.tmac >> \
  "${pkgdir}"/usr/share/groff/site-tmac/mdoc.local

  # trim: man pages (man1/man7 for the groff tools) and locales (man/locales)
  # — not shipped; options=(!docs) already drops doc/ and info/; the
  # /usr/share/groff runtime data (fonts, tmac, devices) is kept in full
  rm -rf "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale

  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
