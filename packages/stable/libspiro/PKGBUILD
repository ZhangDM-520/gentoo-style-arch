# Contributor: Gaetan Bisson <bisson@archlinux.org>
# Contributor: Rémy Oudompheng <oudomphe@clipper.ens.fr>

pkgname=libspiro
epoch=1
pkgver=20240903
pkgrel=1.2
pkgdesc='Library that simplifies the drawing of beautiful curves'
arch=(x86_64)
url='https://github.com/fontforge/libspiro'
license=(GPL-3.0-or-later)
depends=(glibc)
makedepends=(git)
source=("git+https://github.com/fontforge/libspiro.git#tag=$pkgver")
b2sums=(6ec78aec4580a9f338d03ede7f028af5d60b9c572f46e2b068a085178617d042b10bce09079e45eb69f97b27e8fb38305ece538640b6f285977d57c8184bde3e)

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make
}

check() {
  cd $pkgname
  make check
}

package() {
  cd $pkgname
  provides=(libspiro.so)

  make DESTDIR="$pkgdir" install
  # trim: libspiro.3 man page (man_MANS) — Class B trim standard (man payload)
  rm -rf "$pkgdir"/usr/share/man
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
