# trim: the libical-docs split (doxygen + gi-docgen API docs) is dropped
# together with its doxygen/gi-docgen makedeps and its /usr/share/doc split
# move — single output only
pkgbase=libical
pkgname=(libical)
pkgver=4.0.7
pkgrel=1.1
pkgdesc="An open source reference implementation of the icalendar data type and serialization format"
arch=(x86_64)
url='https://github.com/libical/libical'
license=('LGPL-2.1-only' 'MPL-2.0')
depends=(glib2
         glibc
         icu
         libgcc
         libstdc++
         libxml2)
makedepends=(cmake
             git
             gobject-introspection
             jdk-openjdk
             vala)
provides=(libical.so
          libical_cxx.so
          libical-glib.so
          libical_jni.so
          libicalss.so
          libicalss_cxx.so
          libicalvcal.so
          libicalvcard.so)
source=(git+https://github.com/libical/libical#tag=v$pkgver)
sha512sums=('cc7a4bbec8edaae01cabc3aef5573ff5ca0b71d89b85d7d87facdb66f6f801d32998f9b12697867e4862aeebd1dbe46000644639ef52083b7e53a4e1794e264f')

build() {
  # House style: mold linker when available (CMake reads LDFLAGS at cache init)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  cmake -S $pkgname -B build \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DLIBICAL_GOBJECT_INTROSPECTION=true \
    -DLIBICAL_GLIB_VAPI=true \
    -DCMAKE_DISABLE_FIND_PACKAGE_BerkeleyDB=true \
    -DLIBICAL_BUILD_DOCS=false \
    -DLIBICAL_BUILD_EXAMPLES=false \
    -DLIBICAL_BUILD_TESTING=false
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # trim: any doc dir left by the disabled docs/examples/tests build (docs)
  rm -rf "$pkgdir"/usr/share/doc
  install -Dm644 $pkgname/LICENSE.txt $pkgname/COPYING.LESSER.txt -t "$pkgdir"/usr/share/licenses/$pkgname/
}
