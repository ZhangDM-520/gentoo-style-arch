# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgbase=wireplumber
pkgname=(
  wireplumber
  libwireplumber
)
pkgver=0.5.18
pkgrel=1.1
pkgdesc="Session / policy manager implementation for PipeWire"
url="https://pipewire.pages.freedesktop.org/wireplumber/"
arch=(x86_64)
license=(MIT)
makedepends=(
  git
  glib2
  glib2-devel
  glibc
  libgcc
  libpipewire
  lua
  meson
  pipewire
  systemd
  systemd-libs
)
checkdepends=(pipewire-audio)
source=(
  "git+https://gitlab.freedesktop.org/pipewire/$pkgbase.git#tag=$pkgver"
  20-bluez-codecs.conf
)
b2sums=('eea6a3e022c0b8918a72b56a9cdb1c02bca4411a9394fc2a8732faad2c0c71d1443b2a37b22e60467aaab62c154150d18b185b2690271d1d4830dee6513e2e8c'
        '5cafd375bb644177a00ef7092e1db3a48f9164c09bb4b2d714fca54b375de219c8430a8fccfeb8da91ee616a1c0ebdf87c9566043908210a229fd40ae7abc35d')

prepare() {
  cd $pkgbase
}

build() {
  # ISA match + O3

  local meson_options=(
    -D doc=disabled
    -D elogind=disabled
    -D system-lua=true
    # no GIR consumers on this machine (noctalia talks D-Bus, wpctl is C)
    -D introspection=disabled
  )

  # ── Phase 1: PGO instrumented build ──
  arch-meson $pkgbase build "${meson_options[@]}" \
    -Db_pgo=generate \
    -Db_lto=false
  meson compile -C build

  # Training: run tests to generate profile data
  # (tests may need a running PipeWire — tolerate failures)
  meson test -C build --print-errorlogs || true

  # Verify profile data
  local gcda_count
  gcda_count=$(find build -name '*.gcda' 2>/dev/null | wc -l)

  if test "$gcda_count" -gt 0; then
    echo "PGO: $gcda_count .gcda files — applying profile with LTO"
    meson configure build -Db_pgo=use -Db_lto=true
    meson compile -C build
  else
    echo "PGO: no profile data (tests need PipeWire?) — falling back to LTO-only"
    meson configure build -Db_lto=true
    meson compile -C build
  fi
}

check() {
  meson test -C build --print-errorlogs
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

_ver=${pkgver:0:3}

package_wireplumber() {
  depends=(
    "libwireplumber=$pkgver-$pkgrel"
    glibc
    libgcc
    libg{lib,object,io}-2.0.so
    libpipewire
    libpipewire-0.3.so
    libsystemd.so
    lua
    pipewire
    systemd-libs
  )
  optdepends=()
  provides=(pipewire-session-manager)
  conflicts=(pipewire-media-session)
  install=wireplumber.install

  meson install -C build --destdir "$pkgdir"

  (
    cd "$pkgdir"

    _pick libw usr/lib/libwireplumber-$_ver.so*
    _pick libw usr/lib/pkgconfig
    _pick libw usr/include
    # GIR data no longer built (introspection disabled 2026-09-04, no consumers);
    # the usr/lib/girepository-1.0 _pick was removed with it — do not re-add.
  )

  # Host policy: force LDAC for phone -> PC A2DP receive (see file header)
  install -Dt "$pkgdir/etc/wireplumber/wireplumber.conf.d" -m644 20-bluez-codecs.conf

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgbase/LICENSE
}

package_libwireplumber() {
  pkgdesc+=" - client library"
  depends=(
    glibc
    libgcc
    libg{lib,module,object,io}-2.0.so
    libpipewire-0.3.so
  )
  provides=(libwireplumber-$_ver.so)

  mv libw/* "$pkgdir"

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 $pkgbase/LICENSE
}

