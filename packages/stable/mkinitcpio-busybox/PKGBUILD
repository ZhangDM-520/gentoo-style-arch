# Contributor: Thomas Bächler <thomas@archlinux.org>

pkgname=mkinitcpio-busybox
pkgver=1.36.1
pkgrel=2
pkgdesc='Base initramfs tools'
arch=(x86_64)
url="https://www.busybox.net/"
license=(GPL)
depends=(glibc libxcrypt)
options=(!buildflags)
source=(https://busybox.net/downloads/busybox-$pkgver.tar.bz2{,.sig}
        config)
sha256sums=('b8cc24c9574d809e7279c3be349795c5d5ceb6fdf19ca709f80cde50e47de314'
            'SKIP'
            'f1a67ecda5b73a50e49953efaaa0be582e4b707cf5a6270519e28ee022098518')
validpgpkeys=('C9E9416F76E610DBD09D040F47B70C55ACC9965B') # Denis Vlasenko <vda.linux@googlemail.com>

prepare() {
  cd "busybox-$pkgver"
  
  # -march/-mtune dropped from the stock safeflags (house: no ISA/tuning
  # flags); with options=(!buildflags) gcc's x86-64 baseline default is the
  # same target the stock pin chose, and -Os (an opt-size flag, not -O3) and
  # the no-strict-aliasing requirement stay
  local safeflags="-Os -pipe -fno-strict-aliasing"

  # use make oldconfig for updating the config file
  sed 's|^\(CONFIG_EXTRA_CFLAGS\)=.*|\1="'"$safeflags"'"|' "$srcdir/config" > .config
}

build() {
  # reproducible build
  export KCONFIG_NOTIMESTAMP=1
  # House style: mold linker when available (runtime-guarded, no output effect).
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  make -C "busybox-$pkgver" -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  install -Dm755 "$srcdir/busybox-$pkgver/busybox" "$pkgdir/usr/lib/initcpio/busybox"
  # upstream's license text lives inside the extracted tree — package() runs
  # with cwd=$srcdir (makepkg default workingdir), so a bare LICENSE only
  # worked via stale $srcdir artifacts and failed on a clean build (run #22)
  install -Dm644 "$srcdir/busybox-$pkgver/LICENSE" -t "$pkgdir/usr/share/licenses/$pkgname/"
}
