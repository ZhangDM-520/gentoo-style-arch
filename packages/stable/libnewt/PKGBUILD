pkgname=libnewt
pkgver=0.52.25
pkgrel=4
_tclver=8.6
pkgdesc="Not Erik's Windowing Toolkit - text mode windowing with slang"
arch=(x86_64)
url='https://pagure.io/newt'
license=(GPL-2.0-only)
depends=(
  glibc
  gpm
  popt
  slang
)
makedepends=(
  "tcl>=$_tclver"
  python
)
optdepends=(
  'python: libnewt support with the _snack module'
  'tcl: whiptcl support'
)
provides=(libnewt.so)
# Source note (2026-10-06): pagure.io's archive endpoint started returning
# 404 for every snapshot URL (tag r0-52-25 still exists — verified via
# git ls-remote; the web archive service alone is down). Switched to Debian's
# orig tarball of the same upstream release; content verified against the
# upstream tag by tree diff (git tag r0-52-25 vs this tarball: 0 files
# missing, 0 files differing, only release-generated extras — configure,
# config.h.in, po/*.mo). Same trust class: checksum-pinned unsigned tarball
# from a reputable mirror, matching stock's pinning.
source=("https://deb.debian.org/debian/pool/main/n/newt/newt_$pkgver.orig.tar.xz")
b2sums=('5dd03ade5ae781a0fb1e3adf658aeef399f173047eb5a8a1a59735f32a5de82213f2d05db1aaf6fec88d80004ce357665921f8867efebb640ef6f9aa82b570e4')

prepare() {
  cd "newt-$pkgver"
  echo '#define USE_INTERP_RESULT 1' >> config.h
  sed -i "s:tcl8.4:tcl$_tclver:" Makefile.in

  ./autogen.sh
}

build() {
  cd "newt-$pkgver"
  ./configure --prefix=/usr --with-gpm-support
  make
}

package() {
  DESTDIR=$pkgdir make -C "newt-$pkgver" install
  # trim: gettext translations (share/locale) and whiptail man page (man1) —
  # docs/locales not shipped
  rm -rf "$pkgdir"/usr/share/locale "$pkgdir"/usr/share/man
  install -Dm644 "newt-$pkgver"/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
