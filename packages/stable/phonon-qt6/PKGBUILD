# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgbase=phonon
pkgname=(phonon-qt6)
pkgdesc='The multimedia framework by KDE'
pkgver=4.12.0
pkgrel=6
arch=(x86_64)
url='https://community.kde.org/Phonon'
license=(LGPL-2.1-or-later)
depends=(libstdc++
         glibc
         libpulse
         qt6-5compat
         qt6-base)
makedepends=(extra-cmake-modules
             qt6-tools)
optdepends=('pulseaudio: PulseAudio support'
            'qt6-tools: Designer plugin')
source=(https://download.kde.org/stable/$pkgbase/$pkgver/$pkgbase-$pkgver.tar.xz{,.sig})
sha256sums=('3287ffe0fbcc2d4aa1363f9e15747302d0b080090fe76e5f211d809ecb43f39a'
            'SKIP')
validpgpkeys=(CB9387521E1EE0127DA804843FDBB55084CC5D84  # Harald Sitter <sitter@kde.org>
              E0A3EB202F8E57528E13E72FD7574483BB57B18D) # Jonathan Esk-Riddell <jr@jriddell.org>

build() {
  # House style: mold linker when available (CMake reads LDFLAGS at cache init)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  cmake -B build -S $pkgbase-$pkgver \
    -DCMAKE_BUILD_TYPE=None \
    -DPHONON_BUILD_QT5=OFF
  cmake --build build
}

package_phonon-qt6(){
  depends+=(phonon-qt6-backend)
  optdepends+=('qt6-tools: Designer plugin')
  provides=(libphonon4qt6.so libphonon4qt6experimental.so)

  DESTDIR="$pkgdir" cmake --install build

  # trim: translations (locales) — .qm message catalogs are not part of the
  # maintained target
  rm -rf "$pkgdir"/usr/share/locale

  # license: ship upstream licence text (LGPL-2.1-or-later)
  local _l
  for _l in COPYING COPYING.LIB; do
    if [[ -f $pkgbase-$pkgver/$_l ]]; then install -Dm644 $pkgbase-$pkgver/$_l -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}
