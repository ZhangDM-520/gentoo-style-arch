# Maintainer: Andreas Radke <andyrtr@archlinux.org>

pkgname=libppd
pkgver=2.1.1
pkgrel=2
pkgdesc="OpenPrinting - the legacy support library for PPD files"
arch=('x86_64')
url="https://github.com/OpenPrinting/libppd"
# the CUPS exception text is the same as LLVM exception
license=('Apache-2.0 WITH LLVM-exception')
depends=('libcups' 'libcupsfilters'
         'zlib' 'glibc' 'libstdc++' 'libgcc')
makedepends=('ghostscript' 
#            'mupdf-tools'
)
source=(https://github.com/OpenPrinting/libppd/releases/download/$pkgver/$pkgname-$pkgver.tar.xz)
sha256sums=('3fa341cc03964046d2bf6b161d80c1b4b2e20609f38d860bcaa11cb70c1285e4')

build() {
  # cups 2.5 dropped cups-config (pkg-config only) and moved its headers to
  # /usr/include/libcups2; these releases still probe with cups-config and
  # bare AC_CHECK_HEADER([cups/cups.h]) — hand them the shared pkg-config-
  # backed shim from lib/ (run #94 wall class)
  install -Dm755 "$startdir/../../../lib/cups-config" "$srcdir/bin/cups-config"
  export PATH="$srcdir/bin:$PATH"
  # bare AC_CHECK_HEADER([cups/cups.h]) needs the moved include dir too
  export CPPFLAGS+=" $(pkg-config --cflags cups)"

  cd "$pkgname"-$pkgver
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure --prefix=/usr  \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --localstatedir=/var \
    --disable-mutool 
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
  cd "$pkgname"-$pkgver
  make check
}

package() {
  provides=(libppd.so)

  cd "$pkgname"-$pkgver
  make DESTDIR="$pkgdir/" install
  rmdir $pkgdir/usr/bin
  # trim: any man/doc payload under /usr/share (docs/man) — this recipe ships
  # the library + ppdc utilities only
  rm -rf "$pkgdir"/usr/share/man
  # license
  mkdir -p "${pkgdir}"/usr/share/licenses/${pkgname}
  install -m644 "${srcdir}"/${pkgname}-${pkgver}/{COPYING,NOTICE} "${pkgdir}"/usr/share/licenses/${pkgname}/
}
