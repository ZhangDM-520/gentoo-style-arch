# Contributor: Ionut Biru <ibiru@archlinux.org>
# Contributor: William Díaz <wdiaz@archlinux.us>

pkgname=libnice
pkgver=0.1.24
pkgrel=1
pkgdesc="Nice: GLib ICE library"
url="https://libnice.freedesktop.org/"
arch=(x86_64)
license=('MPL-1.1 OR LGPL-2.1-only')
depends=(
  glib2
  glibc
  gnutls
  gupnp-igd
)
# trim: gtk-doc (API docs) + graphviz (gtk-doc inheritance diagrams) go
# together with gtk_doc=disabled in build() (docs)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gstreamer
  meson
)
checkdepends=(
  gst-plugins-base-libs
)
optdepends=('gstreamer: "nice" GStreamer plugin')
provides=(libnice.so)
source=(
  "git+https://gitlab.freedesktop.org/libnice/libnice.git#tag=$pkgver"
  0001-Update-for-gupnp-igd-1.6.patch
)
b2sums=('01391bca0d3fd3cf0b695d2bbefbf8b4eed988a12b847e86175e30fbe5046b3bb9a35bd7f9796c7ea001848207340b0306b40535566e9a28ae2ea25aa9420b3c'
        '4ea554ffb9f0c54e4550c4882f3dcc14d7666f11bbd365441658e9558eed51b5dca4a5d328d8eb1d46d4fbba1607f3d403e42bfc871be10fb3e9c966ff7e78d3')

prepare() {
  cd libnice

  # https://gitlab.freedesktop.org/libnice/libnice/-/merge_requests/255
  git apply -3 ../0001-Update-for-gupnp-igd-1.6.patch
}

build() {
  local meson_options=(
    -D glib_debug=disabled
    # trim: gtk-doc API docs — Class B trim standard (docs)
    -D gtk_doc=disabled
  )

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson libnice build "${meson_options[@]}"
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  # license: ship the upstream MPL-1.1 / LGPL-2.1-only texts
  local _l
  for _l in COPYING COPYING.MPL COPYING.LGPL LICENSE; do
    if [[ -f libnice/$_l ]]; then install -Dm644 "libnice/$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}

