            'f50d23993eeab4786e68edec88665783a697c141e8f26d38edbe4deb1c760ec690741c70f39e1ec5edaf07ce18216709ea8c23bd622543796248408ce32e53c4'
            '4d528f60bbbfed7f9569a6e6e5d22d74a8122aec624683c62fd17e4447eee7b79b2f722747c9e72ff1b948d7bebb56e233cdfac7a032db502c954ff4d2ccdb2e')
b2sums=('e5b5d87c4357ee113769732cb6a7e0afa28b2bc4923be8dacd1fa39ac5fb96d8a5e19bc45137ffc8ec63eef0382130ab9b311aad3a66be4566e0cb9761417b23'
        '5ace51c34b8f9409c5f322ccb1381984b35402866ced3b1b38b2b8fffd10780de80d33418e031decb2cfba452029a48b40df8077d7d67390fcf87bcf57c0cbca'
        'f7e8f4ee69b435a639ecd0538d23fcc4a99cac82bc2dbba296d44a3470492b1cee6eba004bc0960e1d0b82d6b9821fd1b0e7a38d0516da3dffcec15de5b645e2')

prepare() {
  cd $pkgname-$pkgver
  # add missing `time.h` include
  patch -Np1 -i ../$pkgname-1.2.2-add-missing-time-include.patch
  autoreconf -fiv
  # Purge stale libtool outputs. makepkg re-extracts over the old src/ tree on
  # an in-place rebuild, and a leftover libpulse.la makes libtool resolve the
  # pulse plugin's own -lpulse dependency to its own .libs/libpulse.so output
  # (module name collides with the dependency name) — every linker then fails
  # opening the not-yet-built output. Fresh trees link fine; this only matters
  # for rebuilds over reused src/.
  find . -name '*.la' -delete
}

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local configure_options=(
    --prefix=/usr
    --enable-alsa-mmap
  )

  cd $pkgname-$pkgver
  ./configure "${configure_options[@]}"
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  depends+=(
    alsa-lib libasound.so
    libpulse libpulse.so libpulse-simple.so
  )

  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
  # default config
  install -vDm 644 ../$pkgname.conf -t "$pkgdir/etc/"
  # trim: bundled AUTHORS/CHANGES/HACKING/README/TODO docs (docs not shipped)
  rm -rf "$pkgdir"/usr/share/doc

  # license: ship the upstream GPL-2.0-or-later text
  local _lic
  for _lic in LICENSE COPYING; do
    if [[ -f $pkgname-$pkgver/$_lic ]]; then
      install -Dm644 "$pkgname-$pkgver/$_lic" -t "$pkgdir/usr/share/licenses/$pkgname/"
    fi
  done
}
