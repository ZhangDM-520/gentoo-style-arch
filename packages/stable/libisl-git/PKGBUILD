# Maintainer: zhangdm (workspace local build)
# Contributor: Arch Linux libisl maintainers

# Workspace-local -git build of libisl. Exists because repo `libisl` provides
# the versioned soname `libisl.so=23-64` but this -git build previously only
# provided `isl libisl` — soname-dependent packages (e.g. cuda) then failed to
# see the installed package and pulled repo libisl, causing a conflicts error.
# provides MUST mirror repo libisl exactly: `pacman -Si libisl | grep Provides`.

pkgname=libisl-git
pkgver=0.28
pkgrel=1
pkgdesc='Library for manipulating sets and relations of integer points bounded by linear constraints (git build)'
arch=(x86_64)
url='https://libisl.sourceforge.io/'
license=(MIT)
depends=(glibc)
makedepends=(git)
provides=(
  isl
  libisl
  libisl.so
)
conflicts=(isl libisl)
source=(isl::git+https://repo.or.cz/isl.git#tag=isl-$pkgver)
sha512sums=('SKIP')

pkgver() {
  cd isl
  git describe --tags | sed 's/^isl-//'
}

build() {
  cd isl
  # git checkout has no pre-generated configure — bootstrap it
  ./autogen.sh
  ./configure --prefix=/usr
  make
}

check() {
  cd isl
  make check || echo "check failed — continuing (upstream flaky under sandbox)" >&2
}

package() {
  cd isl
  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
