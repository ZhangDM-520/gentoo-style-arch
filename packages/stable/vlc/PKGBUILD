# Split-output recipe: this is the single pkgbase for every VLC 3.0.23 split
# output this repo ships plus every split output the cluster's depends
# reference, so the vlc tree is cloned, configured and built exactly once.
# It replaces the former per-output recipes packages/stable/{vlc-gui-qt,
# vlc-plugin-aalib, vlc-plugin-archive, vlc-plugin-caca, vlc-plugin-ffmpeg,
# vlc-plugin-freetype, vlc-plugin-gnutls, vlc-plugin-jack, vlc-plugin-jpeg,
# vlc-plugin-notify, vlc-plugin-opus, vlc-plugin-png, vlc-plugin-pulse,
# vlc-plugin-sftp, vlc-plugin-svg, vlc-plugin-xml, vlc-plugins-extra,
# vlc-plugins-video-output, vlc-plugins-visualization}.

pkgbase=vlc
pkgname=(
