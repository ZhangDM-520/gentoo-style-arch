    usr/lib/vlc/plugins/video_filter/{libadjust,libalphamask,libanaglyph,libantiflicker,libball,libblend,libblendbench,libbluescreen,libcanvas,libcolorthres,libcroppadd,libdeinterlace,libedgedetection,liberase,libextract,libfps,libfreeze,libgaussianblur,libgradfun,libgradient,libgrain,libhqdn3d,libinvert,libmagnify,libmirror,libmotionblur,libmotiondetect,liboldmovie,libposterize,libpsychedelic,libpuzzle,libripple,librotate,libscale,libscene,libsepia,libsharpen,libtransform,libvhs,libwave}_plugin.so
    usr/lib/vlc/plugins/video_output/{libfb,libvdummy,libvmem,libyuv}_plugin.so
  ); _install
}

