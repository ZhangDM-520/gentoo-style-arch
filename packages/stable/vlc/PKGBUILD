prepare() {
  cd $pkgbase

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  autoreconf -fiv
}

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local configure_options=(
    --disable-chromaprint
    --disable-fdkaac
    --disable-kwallet
    --disable-libgcrypt
    --disable-libplacebo
    --disable-opencv
    --disable-rpath
    --disable-schroedinger
    --disable-sndio
    --disable-update-check
    --enable-a52
    --enable-aa
    --enable-alsa
    --enable-aom
    --enable-archive
    --enable-aribsub
    --enable-aribcam
    --enable-avahi
    --enable-avcodec
    --enable-avformat
    --enable-bluray
    --enable-caca
    --enable-chromecast
    --enable-dav1d
    --enable-dc1394
    --enable-dca
    --enable-dv1394
    --enable-dvbpsi
    --enable-dvdnav
    --enable-dvdread
    --enable-faad
    --enable-flac
    --enable-fluidsynth
    --enable-fontconfig
    --enable-freetype
    --enable-fribidi
    --enable-gnutls
    --enable-gme
    --enable-goom
    --enable-gst-decode
    --enable-harfbuzz
    --enable-jack
    --enable-jpeg
    --enable-kate
    --enable-libass
    --enable-libcddb
    --enable-libmpeg2
    --enable-libva
    --enable-libxml2
    --enable-lirc
    --enable-live555
    --enable-mad
    --enable-matroska
    --enable-mod
    --enable-mpc
    --enable-mpg123
    --enable-microdns
    --enable-mtp
    --enable-ncurses
    --enable-nfs
    --enable-nls
    --enable-notify
    --enable-ogg
    --enable-oggspots
    --enable-opus
    --enable-png
    --enable-postproc
    --enable-projectm
    --enable-pulse
    --enable-qt
    --enable-realrtsp
    --enable-samplerate
    --enable-sdl-image
    --enable-secret
    --enable-sftp
    --enable-shout
    --enable-skins2
    --enable-smbclient
    --enable-soxr
    --enable-speex
    --enable-srt
    --enable-svg
    --enable-svgdec
    --enable-taglib
    --enable-tiger
    --enable-twolame
    --enable-upnp
    --enable-vcd
    --enable-vdpau
    --enable-vlc
    --enable-vorbis
    --enable-vpx
    --enable-wayland
    --enable-x264
    --enable-x265
    --enable-zvbi
    --prefix=/usr
    --sysconfdir=/etc
    --with-kde-solid=/usr/share/solid/actions/
  )

  cd $pkgbase

  # VLC still relies on an old lua version for its scripts (and compat for external scripts)
  export LUAC=/usr/bin/luac5.1

  ./configure "${configure_options[@]}"

  # prevent excessive overlinking due to libtool
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

# trim: stock split outputs vlc, vlc-gui-ncurses, vlc-gui-skins2,
# vlc-plugins-all and vlc-plugin-{a52dec,alsa,dav1d,dbus,dbus-screensaver,
# faad2,firewire,flac,fluidsynth,gstreamer,inflate,journal,matroska,mpg123,
# ogg,shout,smb,speex,tag,theora,twolame,vorbis,vpx,x264,x265} dropped from
# the output set (user decision: ship the 19 folded outputs plus every
# output the cluster's depends reference) — their payload stays behind in
# $srcdir/root and is never moved
# trim: stock vlc split payload (desktop entry, hicolor app icons, locale
# catalogues, docs, KDE solid actions and utils scripts) dropped together
# with the vlc output itself
# trim: stock static library usr/lib/vlc/libcompat.a dropped (nothing links
# it)
# trim: stock utils script usr/share/vlc/utils/gnome-vlc-default.sh dropped
# (incompatible with GNOME >= 3)
# trim: stock developer example project usr/share/doc/vlc/libvlc dropped
# (docs)
# trim: stock compiled-in images usr/share/vlc/vlc.ico and the hicolor
# icon payload dropped (nothing references them without the vlc output)
# trim: stock plugin registry usr/lib/vlc/plugins/plugins.dat dropped —
# libvlc ships an empty one that its ALPM hook regenerates
# trim: stock libtool leftovers usr/lib/vlc/**.la dropped (only the .so
# plugin payloads ship)
# trim: stock conflicts/replaces=(vlc-plugin),
# replaces=(vlc-plugin-quicksync) and replaces=(vlc-plugin-kwallet) dropped
# — house standard (no conflicts/replaces)

_install() {
  local src dir
  for src in "${files[@]}"; do
    dir="$pkgdir/$(dirname "$src")"
    mkdir -p "$dir"
    mv -v "$src" "$dir"
  done

  # license: COPYING (GPL-2.0-or-later) + COPYING.LIB (LGPL-2.1-or-later)
  install -Dm644 "$srcdir/$pkgbase"/{COPYING,COPYING.LIB} -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libvlc() {
  pkgdesc+=" - library"
  provides=(
    libvlc.so
    libvlccore.so
  )
  depends=(
    dbus
    glibc
    libgcc
  )

  make -C $pkgbase DESTDIR="$srcdir/root" install

  cd root; local files=(
    usr/include
    usr/lib/libvlc*
    usr/lib/pkgconfig/{libvlc,vlc-plugin}.pc
    usr/lib/vlc/vlc-cache-gen
  ); _install

  # install ALPM hook to update the VLC plugin cache when /usr/lib/vlc/plugins/ is altered
  install -Dm644 "$srcdir/update-vlc-plugin-cache.hook" -t "$pkgdir/usr/share/libalpm/hooks/"
  # create an empty plugin cache, so that the ALPM hook can write to it
  install -vdm 755 "$pkgdir/usr/lib/vlc/plugins/"
  touch "$pkgdir/usr/lib/vlc/plugins/plugins.dat"
}

package_vlc-cli() {
  pkgdesc+=" - command line interface"
  depends=(
    libvlc=$pkgver-$pkgrel libvlc.so
    vlc-plugins-base=$pkgver-$pkgrel
    bash
    glibc
  )
  optdepends=(
    'vlc-plugin-lua: for Lua scripting plugins'
  )

  cd root; local files=(
    usr/bin/{vlc,cvlc,rvlc,vlc-wrapper}
    usr/share/man/man1/vlc{,-wrapper}.1*
  ); _install
}

package_vlc-gui-qt() {
  pkgdesc+=" - Qt GUI"
  provides=(
    libqt_plugin.so
  )
  depends=(
    libvlc=$pkgver-$pkgrel libvlccore.so
    vlc-cli=$pkgver-$pkgrel
    vlc-plugin-lua=$pkgver-$pkgrel
    vlc-plugin-pulse=$pkgver-$pkgrel
    vlc-plugins-base=$pkgver-$pkgrel
    vlc-plugins-video-output=$pkgver-$pkgrel
    bash
    glibc
    libgcc
    libstdc++
    libx11
    qt5-base
    qt5-svg
    qt5-x11extras
    qt5-wayland
    wayland
  )
  optdepends=(
    'vlc-plugin-libsecret: for libsecret/gnome-keyring support on Gnome'
    'vlc-plugin-notify: for notification support'
    'vlc-plugins-extra: for extra plugins'
    'vlc-plugins-visualization: for visualization plugins'
  )

  cd root; local files=(
    usr/bin/qvlc
    usr/lib/vlc/plugins/gui/libqt_plugin.so
  ); _install
}

