pkgbase=tar
pkgname=(tar tar-scripts)
pkgver=1.35
pkgrel=5
pkgdesc='Utility used to store, backup, and transport files'
arch=('x86_64')
url='https://www.gnu.org/software/tar/'
license=('GPL-3.0-or-later')
makedepends=('git')
checkdepends=('attr')
# trim: options=('!emptydirs') — no load-bearing empty directory payload
# (makepkg drops empty directories by default)
install=tar.install
validpgpkeys=('325F650C4C2B6AD58807327A3602B07F55D0C732') # Sergey Poznyakoff <gray@gnu.org>
source=("git+https://git.savannah.gnu.org/git/tar.git#tag=v${pkgver}?signed"
        "git+https://git.savannah.gnu.org/git/gnulib.git"
        "git+https://git.savannah.gnu.org/git/paxutils.git"
        "https://ftp.gnu.org/gnu/tar/tar-${pkgver}.tar.gz"{,.sig}
        "fix-libacl-conflicts.patch")
sha256sums=('8476308a482ba89b7ba806dc2f77aea268e88828b3f4527d85484c813e025332'
            'SKIP'
            'SKIP'
            '14d55e32063ea9526e057fbf35fcabd53378e769787eff7919c3755b02d2b57e'
            'SKIP'
            '07c20fc924001f15e93e779588de8113a2ce683ce5b18431e797f7c242eaa33a')

prepare() {
  cd "${pkgname}"

  git submodule init
  git config submodule.gnulib.url "${srcdir}/gnulib"
  git config submodule.paxutils.url "${srcdir}/paxutils"
  git -c protocol.file.allow=always submodule update

  # upstream commit doesn't cherry-pick cleanly to stable
  # 08c3fc2e9337094aff01a511170fd35fdb8f1ee3 Avoid acl_ prefix for functions
  patch -Np1 -i ../fix-libacl-conflicts.patch

  # Don't pull unstable translations from web
  ./bootstrap --skip-po
}

build() {
  cd "${pkgname}"

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure --prefix=/usr --sbindir=/usr/bin --libexecdir=/usr/lib/tar --enable-backup-scripts
  make WERROR_CFLAGS="" -j"${GSA_BUILD_JOBS:-$(nproc)}" # -Werror is enabled by default and causes build failures

  # trim: gettext locales (Class B trim standard locale payload) — the
  # dist-tarball .po -> .mo generation loops went with them; --skip-po above
  # already keeps ./bootstrap from pulling unstable translations from the web
}

check() {
  cd "${pkgname}"
  make check
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_tar() {
  depends=('glibc' 'acl')

  cd "${pkgname}"

  make DESTDIR="${pkgdir}" install

  # trim: man + info pages and gettext locales (Class B trim standard
  # docs/man/locales payload; the mo install loop went with them)
  rm -rf "${pkgdir}"/usr/share/man "${pkgdir}"/usr/share/info \
    "${pkgdir}"/usr/share/locale

  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"

  # Pick backup and restore scripts for tar-scripts package
  ( cd "$pkgdir" && _pick tar-scripts usr/bin/{backup,restore} usr/lib/tar/{backup.sh,dump-remind})
}

package_tar-scripts() {
  pkgdesc+=' (scripts)'
  depends=('sh' 'tar')
  mv -v $pkgname/* "$pkgdir"
  install -Dm644 "${srcdir}/tar/COPYING" "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}

