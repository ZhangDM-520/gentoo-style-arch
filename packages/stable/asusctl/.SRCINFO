pkgbase = asusctl
	pkgdesc = Daemon and tools to control your ASUS ROG laptop
	pkgver = 6.5.0
	pkgrel = 1
	url = https://asus-linux.org
	arch = x86_64
	license = MPL-2.0
	checkdepends = clang
	checkdepends = sdl2
	makedepends = cargo
	makedepends = fontconfig
	source = asusctl-6.5.0.tar.gz::https://github.com/OpenGamingCollective/asusctl/archive/6.5.0.tar.gz
	sha256sums = edceeab080df670a3851af9815c082949e5c0d14be20fc41216d4a7e84d8fca8

pkgname = asusctl
	pkgdesc = An utility for Linux to control many aspects of various ASUS laptops
	install = asusctl.install
	depends = glibc
	depends = libgcc
	depends = libusb
	depends = systemd-libs
	optdepends = rog-control-center: graphical user interface for asusctl

pkgname = rog-control-center
	pkgdesc = Graphical user interface for asusctl
	depends = asusctl=6.5.0
	depends = fontconfig
	depends = glibc
	depends = hicolor-icon-theme
