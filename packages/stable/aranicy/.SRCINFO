	conflicts = ananicy-cpp
	backup = etc/ananicy.d/ananicy.conf

pkgname = aranicy-collector
	license = GPL-2.0-only
	depends = glibc
	depends = gcc-libs
	depends = libbpf
	conflicts = aranicy<0.3.0
