pkgbase = aranicy
	pkgdesc = Auto-nice daemon in Rust (ananicy-compatible rules, learned nice bias)
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/ZhangDM-520/aranicy
	arch = x86_64
	license = MIT
	makedepends = cargo
	makedepends = clang
	makedepends = llvm
	makedepends = libbpf
	makedepends = pkgconf
	source = git+https://github.com/ZhangDM-520/aranicy#commit=922a3edabfce1ea2f7342a78686a53184db10b80
	sha256sums = SKIP

pkgname = aranicy
	depends = glibc
	depends = gcc-libs
