pkgname=lxc
epoch=1
pkgver=7.0.0
pkgrel=2
pkgdesc="Linux Containers"
arch=('x86_64')
url="https://linuxcontainers.org"
depends=('bash' 'perl' 'libseccomp' 'libcap' 'python' 'rsync' 'wget' 'dbus')
makedepends=('docbook2x' 'systemd' 'meson' 'python-setuptools' 'apparmor' 'git')
# House standard: bare soname provide per ELF output (never pinned).
# Upstream soname is liblxc.so.1.
provides=('liblxc.so')
optdepends=('dnsmasq: lxc-net.service'
	    'lua'
	    'lua-filesystem: lxc-top'
	    'lua-alt-getopt: lxc-top')
license=('LGPL-2.1-or-later')
# trim: stock options=('emptydirs') — a no-op under the house makepkg.conf
# OPTIONS (emptydirs is already default-on), so not load-bearing
backup=('etc/lxc/default.conf'
	'etc/default/lxc')
validpgpkeys=('602F567663E593BCBD14F338C638974D64792D67')
source=("git+https://github.com/lxc/lxc.git#tag=v$pkgver?signed"
	"lxc.tmpfiles"
	"lxc.service"
	"lxc-auto.service")
sha256sums=('66c1db46122cc9d129627dca5b36dbbcf92e7d095f37c4cb9578b3efe697e3b9'
            '10e4f661872f773bf3122a2f9f2cb13344fea86a4ab72beecb4213be4325c479'
            'bbe7e0447bc3bf5f75f312c34d647f5218024731628a5e8633b1ea1801ebe16b'
            'b31f8d6b301ab9901b43f2696bcd0babb32b96e4a59fab63a2d642e43bf26bb3')


prepare() {
  cd "$pkgname"
  sed -i "s|if sanitize == 'none'|if false|g" src/lxc/cmd/meson.build
}

build() {
  cd "$pkgname"

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # https://gitlab.archlinux.org/archlinux/packaging/packages/lxc/-/issues/1
  # lxd conflicts with tools-multicall
  arch-meson build -Dtools=true -Dtools-multicall=false
  meson compile -C build -v -j "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  cd "$pkgname"

  meson install -C build --destdir "$pkgdir"

  install -d -m755 "$pkgdir/var/lib/lxc"
  install -d -m755 "$pkgdir/usr/lib/lxc/rootfs/dev"
  install -D -m644 "$srcdir"/lxc.service "$pkgdir"/usr/lib/systemd/system/lxc@.service
  install -D -m644 "$srcdir"/lxc-auto.service "$pkgdir"/usr/lib/systemd/system/lxc-auto.service
  install -D -m644 "$srcdir"/lxc.tmpfiles "$pkgdir"/usr/lib/tmpfiles.d/lxc.conf

  # trim: the docbook man pages — together with the stock doc/ find-install
  # block that shipped them — and any doc/locale payload, Class B trim
  # standard (docs/man/locales)
  rm -rf "$pkgdir"/usr/share/man "$pkgdir"/usr/share/doc "$pkgdir"/usr/share/locale

  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
