_name=raptor2
pkgname=raptor
pkgver=2.0.16
pkgrel=9
pkgdesc="A C library that parses RDF/XML/N-Triples into RDF triples"
arch=(x86_64)
url="https://librdf.org/raptor"
license=("Apache-2.0 OR GPL-2.0-or-later OR LGPL-2.1-or-later")
depends=(
  glibc
  libxml2
  libxslt
)
makedepends=(
  curl
  # trim: gtk-doc no longer generates the API docs (installed docs trimmed
  # in package()), but GTK_DOC_CHECK is unconditional in configure.ac so
  # autoreconf still needs the gtk-doc macros — kept as a build requirement only
  gtk-doc
  icu
)
provides=(libraptor2.so)
source=(
  https://librdf.org/dist/source/$_name-$pkgver.tar.gz{,.asc}
  raptor-2.0.15-libxml2-2.11.patch
)
sha512sums=('9bd5cff36390e1e0ef15ac56e5413ecfceb4018cb531a4da8850d3623615f12a93690a78be61f9d9ae7a24e16f6446e356bc2b7f34051ddc077761d85a9b7c44'
            'SKIP'
            '6d6c6ab0be9136ccf3e5b0c1140e88a49cbf94d4c36d27e3bb672ef13c83cdc7c8048c7ef883f9302fb3924ed78db1b059a983b9e1f8bce4522d5ef33a811ba7')
b2sums=('1e5e5742ba4cdaacb98a9ba77a9352589df0da60869e7721ee140c81ed4886bf909b37b247bd925c82a4ac44b3c11a909c913f0851d49a1d9d91c9293189266d'
        'SKIP'
        '0e3462817a77917eb82066f7d9efb1a28fa27221596c18fb140dadb4c0fd074b0936ed5cbd9fc620548796f548ad75890b00a3f73300af7d754cea695dc7f993')
validpgpkeys=('F879F0DEDA780198DD08DC6443EC92504F71955A') # Dave Beckett <dave@dajobe.org>

prepare() {
  cd $_name-$pkgver
  patch -Np1 -i ../raptor-2.0.15-libxml2-2.11.patch
  autoreconf -fiv
}

build() {
  local configure_options=(
    --prefix=/usr
    --disable-static
    --with-icu-config=/usr/bin/icu-config
  )

  cd $_name-$pkgver

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure "${configure_options[@]}"
  # prevent excessive overlinking due to libtool
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

# trim: check() (test suite; upstream tests are flaky beyond -j1 anyway)

package() {
  depends+=(
    curl libcurl.so
    icu libicuuc.so
  )

  make DESTDIR="$pkgdir" install -C $_name-$pkgver

  # trim: gtk-doc API docs + man pages + AUTHORS/ChangeLog/README doc copy
  rm -rf "$pkgdir/usr/share/gtk-doc" "$pkgdir/usr/share/man" "$pkgdir/usr/share/doc"

  # license: ship upstream licence text(s) (tri-licensed)
  cd $_name-$pkgver
  local _l
  for _l in LICENSE.txt LICENSE-2.0.txt COPYING COPYING.LIB; do
    if [[ -f $_l ]]; then install -Dm644 "$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}
