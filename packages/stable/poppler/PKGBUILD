pkgbase=poppler
# Merged split recipe: the single pkgbase for the poppler splits poppler
# (libpoppler + libpoppler-cpp), poppler-glib and poppler-qt6 — the pinned
# poppler tag is cloned, configured and built exactly once. It replaces the
# former per-output recipes packages/stable/{poppler,poppler-glib,poppler-qt6}.
# trim: dropped split poppler-qt5 together with its package_*() and its build
# dep qt5-base; gtk-doc API docs dropped with -DENABLE_GTK_DOC=OFF
pkgname=('poppler'
         'poppler-glib'
         'poppler-qt6')
pkgver=26.08.0
pkgrel=1
arch=(x86_64)
license=('GPL-2.0-only'
         'GPL-3.0-or-later'
         'LGPL-2.0-or-later'
         'LGPL-2.1-or-later'
         'MIT'
         'HPND-sell-variant')
# trim: poppler-qt5 split build dep (qt5-base — that split is not built) and
# gtk3 (poppler-glib-demo only — demo dropped) and gtk-doc (API docs,
# -DENABLE_GTK_DOC=OFF)
makedepends=('libjpeg-turbo' 'libgcc' 'libstdc++' 'cairo' 'fontconfig' 'openjpeg2'
             'pkgconfig' 'lcms2' 'gobject-introspection' 'icu'
             'qt6-base' 'git' 'nss' 'gpgmepp' 'curl' 'poppler-data'
             'cmake' 'python' 'boost' 'glib2-devel')
options=('!emptydirs')
url="https://poppler.freedesktop.org/"
source=("git+https://gitlab.freedesktop.org/poppler/poppler.git#tag=${pkgbase}-${pkgver}?signed"
        test::git+https://gitlab.freedesktop.org/poppler/test.git#commit=46785c9a414d8918d8d4c55d3498258c7eac86c3
)
sha256sums=('939a14fd5fd7181a4dfba29785a417b47215f7c0e18c23318bd1c59c3aa1883a'
            '982f8d137e8210a699a22b3615cafef85ded5810a9ac4a6d145944e764f29b9b')
validpgpkeys=('CA262C6C83DE4D2FB28A332A3A6A4DB839EAA6D7') # Albert Astals Cid <aacid@kde.org>

build() {
  # House style: mold linker when available (CMake reads LDFLAGS at cache init)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  cmake -B build -S "${pkgbase}" \
    -DCMAKE_INSTALL_PREFIX:PATH=/usr \
    -DCMAKE_INSTALL_LIBDIR=/usr/lib \
    -DENABLE_UNSTABLE_API_ABI_HEADERS=ON \
    -DENABLE_CPP=ON \
    -DENABLE_GLIB=ON \
    -DENABLE_QT5=OFF \
    -DENABLE_QT6=ON \
    -DENABLE_GTK_DOC=OFF
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

# trim: upstream test suite (check()/ctest) — no tests are run; the test::
# fixture source stays in source=() as delivered (source=() kept complete)

package_poppler() {
  pkgdesc="PDF rendering library based on xpdf 3.0"
  depends=('libjpeg-turbo' 'libgcc' 'libstdc++' 'cairo' 'fontconfig'
           'openjpeg2' 'lcms2' 'nss' 'curl' 'gpgmepp'
           'nspr' 'libpng' 'freetype2' 'zlib' 'libtiff' 'glibc')
  optdepends=('poppler-data: highly recommended encoding data to display PDF documents with certain encodings and characters')
  provides=('libpoppler.so' 'libpoppler-cpp.so')

  DESTDIR="${pkgdir}" cmake --install build

  # cleanup for splitted build — the poppler-glib/poppler-qt6 output files are
  # reinstalled by their own package_*() below
  rm -vrf "${pkgdir}"/usr/include/poppler/{glib,qt5,qt6}
  rm -vf "${pkgdir}"//usr/lib/libpoppler-{glib,qt5,qt6}.*
  rm -vf "${pkgdir}"/usr/lib/pkgconfig/poppler-{glib,qt5,qt6}.pc
  rm -vrf "${pkgdir}"/usr/{lib,share}/gir*
  rm -vrf "${pkgdir}"/usr/share/gtk-doc

  # trim: the poppler-glib-demo binary (demos) — dropped together with the
  # gtk3 build dep, like the gtk-doc tree above
  rm -vf "${pkgdir}"/usr/bin/poppler-glib-demo

  # license
  mkdir -p "${pkgdir}"/usr/share/licenses/${pkgname}
  install -m644 "${srcdir}"/${pkgbase}/{COPYING,COPYING3,README-XPDF,README.contributors} "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_poppler-glib() {
  pkgdesc="Poppler glib bindings"
  depends=("poppler=$pkgver-$pkgrel" 'glib2' 'libgcc' 'libstdc++' 'freetype2' 'cairo' 'glibc')
  provides=('libpoppler-glib.so')

  cd build

  make -C glib DESTDIR="${pkgdir}" install
  install -m755 -d "${pkgdir}/usr/lib/pkgconfig"
  install -m644 poppler-glib.pc "${pkgdir}/usr/lib/pkgconfig/"
  rm -vf "${pkgdir}"/usr/lib/libpoppler.*
  rm -vf "${pkgdir}"/usr/bin/poppler-glib-demo

  # trim: gtk-doc API docs (/usr/share/gtk-doc) and the poppler-glib-demo
  # binary (demos) — gir/typelib kept
  rm -rf "${pkgdir}"/usr/share/gtk-doc

  # license
  mkdir -p "${pkgdir}"/usr/share/licenses/${pkgname}
  install -m644 "${srcdir}"/${pkgbase}/{COPYING,COPYING3,README-XPDF,README.contributors} "${pkgdir}"/usr/share/licenses/${pkgname}/
}

package_poppler-qt6() {
  pkgdesc="Poppler Qt6 bindings"
  depends=("poppler=$pkgver-$pkgrel" 'qt6-base' 'lcms2' 'freetype2' 'libgcc' 'libstdc++' 'glibc')
  provides=('libpoppler-qt6.so')

  cd build
  make -C qt6 DESTDIR="${pkgdir}" install
  install -m755 -d "${pkgdir}/usr/lib/pkgconfig"
  install -m644 poppler-qt6.pc "${pkgdir}/usr/lib/pkgconfig/"

  # license
  mkdir -p "${pkgdir}"/usr/share/licenses/${pkgname}
  install -m644 "${srcdir}"/${pkgbase}/{COPYING,COPYING3,README-XPDF,README.contributors} "${pkgdir}"/usr/share/licenses/${pkgname}/
}
