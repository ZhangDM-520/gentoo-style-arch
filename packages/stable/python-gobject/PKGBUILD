prepare() {
  cd pygobject
}

build() {
  # Inject subprojects
  export MESON_PACKAGE_CACHE_DIR="$srcdir"

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson pygobject build
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

package_python-gobject() {
  provides=("pygobject-devel=$pkgver")
  # house: stock conflicts=(pygobject-devel) + replaces=(pygobject-devel<=3.36.1-1)
  # dropped — upgrade-in-place takes no conflicts/replaces

  meson install -C build --destdir "$pkgdir"
  python -m compileall -d /usr/lib "$pkgdir/usr/lib"
  python -O -m compileall -d /usr/lib "$pkgdir/usr/lib"
  # house: licence re-homed to /usr/share/licenses (stock installs none)
  install -Dm644 pygobject/COPYING "$pkgdir"/usr/share/licenses/$pkgname/COPYING
}


