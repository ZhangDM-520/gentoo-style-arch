  'ninja'
  'procps-ng'
  'python'
)
optdepends=('npm: nodejs package manager')
source=("git+https://github.com/nodejs/node.git#tag=v$pkgver?signed"
        '0001-v8-regexp-special-case-keep-class-walk-bmp-only.patch')

