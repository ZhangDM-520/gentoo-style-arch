pkgname=nodejs
pkgver=26.10.0
pkgrel=2
pkgdesc='Evented I/O for V8 javascript ("Current" release)'
arch=('x86_64')
url='https://nodejs.org/'
license=('MIT')
# bare soname provides per ELF output (never pinned): node installs libnode.so
provides=('libnode.so')
depends=(
  'abseil-cpp'
  'ada'
  'brotli'
  'c-ares'
  'icu'
