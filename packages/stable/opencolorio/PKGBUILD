pkgname=opencolorio
pkgver=2.6.0
pkgrel=1.1
pkgdesc="A color management framework for visual effects and animation"
arch=('x86_64')
url="https://opencolorio.org"
license=('BSD-3-Clause')
depends=('freeglut' 'glew' 'lcms2' 'expat' 'yaml-cpp' 'imath' 'pystring' 'minizip-ng' 'openexr'
         'glibc' 'libgcc' 'libstdc++' 'glu')
makedepends=('cmake' 'python' 'pybind11' 'ninja')
provides=('libOpenColorIO.so')
checkdepends=('openimageio')
optdepends=('python: python bindings')
source=($pkgname-$pkgver.tar.gz::https://github.com/AcademySoftwareFoundation/OpenColorIO/archive/v$pkgver.tar.gz)
sha512sums=('fa7a8b2d909ff754b591be2d5dffa6056bdcfc58738876cb7358e329187a30d46cf27c2b1387d57d58cc02248cf07e46f17bb27a532c6b3523c82ef8367f66bf')

build() {
  cd OpenColorIO-$pkgver

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  CXXFLAGS+=" -ffat-lto-objects"
  # house: pin the system interpreter (uv/pyenv shims lead PATH; NOTE.md 2026-10-10)
  cmake \
    -GNinja \
    -DPython_EXECUTABLE=/usr/bin/python \
    -DPython3_EXECUTABLE=/usr/bin/python \
    -Bbuild \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_SKIP_INSTALL_RPATH=YES \
    -Wno-dev
  ninja -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
  cd OpenColorIO-$pkgver/build

  # Currently broken
  # ctest -E test_gpu
}

package() {
  cd OpenColorIO-$pkgver

  DESTDIR="$pkgdir" ninja -C build install
  install -Dm644 LICENSE $pkgdir/usr/share/licenses/$pkgname/LICENSE
}

