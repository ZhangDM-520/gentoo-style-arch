# Contributor: James An <james@jamesan.ca>
# Contributor: Daniel Nagy <danielnagy at gmx de>

pkgname=libde265
pkgver=1.1.3
pkgrel=1.1
pkgdesc='Open h.265 video codec implementation'
arch=(x86_64)
url='https://github.com/strukturag/libde265'
license=(LGPL-3.0-or-later)
depends=(glibc
         libgcc
         libstdc++)
makedepends=(cmake
             git
             sdl2-compat)
optdepends=('sdl2-compat: for the decoder tool')
provides=(libde265.so)
source=(git+https://github.com/strukturag/libde265#tag=v$pkgver)
sha256sums=('15b35cc5ed154a31bd825bb22d033d9bb93663d1f85ba971ff04b41a239c99a3')

build() {
  # House style: mold linker when available (CMake reads LDFLAGS at cache init)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DENABLE_ENCODER=ON
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # trim: docs/man (this library recipe ships the shared lib + headers + tools)
  rm -rf "$pkgdir"/usr/share/{doc,man}

  # license: ship the upstream LGPL-3.0-or-later text
  local _lic
  for _lic in LICENSE LICENSES COPYING; do
    if [[ -f $pkgname/$_lic ]]; then
      install -Dm644 "$pkgname/$_lic" -t "$pkgdir/usr/share/licenses/$pkgname/"
    elif [[ -d $pkgname/$_lic ]]; then
      cp -a "$pkgname/$_lic" "$pkgdir/usr/share/licenses/$pkgname/"
    fi
  done
}
