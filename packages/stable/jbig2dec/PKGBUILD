### jbig2dec new releases require a rebuild for the following packages: ghostscript, mupdf, python-pymupdf, zathura-pdf-mupdf ###

pkgname=jbig2dec
_commit=1d1347e38a55e657dcc4c8f1c77bb3a26bfc9ff3 # = master 2023-10-07 = v2.3
pkgver=0.20
#_gsver=gs9530
pkgrel=2
pkgdesc='Decoder implementation of the JBIG2 image compression format'
url='https://jbig2dec.com/'
arch=('x86_64')
license=('GPL3')
depends=('libpng' 'glibc')
makedepends=('git')
provides=('libjbig2dec.so')
# tarball is not yet available
source=(#"https://github.com/ArtifexSoftware/ghostpdl-downloads/releases/download/${_gsver}/${pkgname}-${pkgver}.tar.gz"
        "git+https://github.com/ArtifexSoftware/jbig2dec.git#commit=$_commit"
)
sha512sums=('SKIP')

pkgver() {
  cd $pkgname
  git describe --tags | sed 's/^Release.//;s/\([^-]*-g\)/\1/;s/-/+/g;'
}

prepare() {
  cd ${pkgname} #-${pkgver}
#  autoreconf -vfi
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd ${pkgname} #-${pkgver}

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd ${pkgname} #-${pkgver}
  make DESTDIR="${pkgdir}" install

  # trim: man pages (jbig2dec.1) — Class B trim standard (man)
  rm -rf "$pkgdir/usr/share/man"

  # license: ship the upstream GPL3 texts (COPYING, LICENSE)
  install -Dm644 COPYING LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

# vim:set sw=2 sts=-1 et:
