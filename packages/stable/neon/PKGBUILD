# Contributor: Jan de Groot <jgc@archlinux.org>
# Contributor: Tom Newsom <Jeepster@gmx.co.uk>
# Contributor: Juergen Hoetzel <juergen@archlinux.org>

pkgname=neon
pkgver=0.37.1
pkgrel=1
pkgdesc='HTTP/1.1 and WebDAV client library'
arch=(x86_64)
url='https://notroj.github.io/neon/'
license=(LGPL-2.0-or-later)
depends=(
  ca-certificates
  expat
  glibc
  krb5
  openssl
  zlib
)
makedepends=(
  git
)
provides=(libneon.so)
source=("git+https://github.com/notroj/neon.git#tag=$pkgver")
b2sums=(51b19f2d5a506d16bc1b0b76bcddc43d8960fc785499317e93570e7877884e48ae900d9a06dcc1943bb4c72213b6990c11a58caa47c76a17178f588516717e51)
validpgpkeys=(190555472DCC589BEF01609C608A86DF9833CC49) # Joe Orton

prepare() {
  cd $pkgname
  echo $pkgver > .version
  autoreconf -fiv
}

build() {
  cd $pkgname
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --enable-shared \
    --with-ssl=openssl \
    --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt
  make
  # trim: docs/man/locales — the xmlto-built manual (make docs: HTML + man) and
  # the gettext catalogs (make compile-gmo) are not built (docbook-xsl + xmlto
  # makedepends dropped together); package() installs only the lib, headers and
  # config (stock install-yes also runs install-docs + install-nls)
}

# trim: upstream test suite (check()) — not run for this recipe

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install-lib install-headers install-config

  # license: ship the upstream LGPL-2.0-or-later text
  install -Dm644 src/COPYING.LIB -t "$pkgdir/usr/share/licenses/$pkgname/"
}
