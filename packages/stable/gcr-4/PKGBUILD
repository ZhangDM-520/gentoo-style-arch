# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Ionut Biru <ibiru@archlinux.org>

pkgname=gcr-4
pkgver=4.4.1
pkgrel=1
pkgdesc="A library for bits of crypto UI and parsing"
url="https://gitlab.gnome.org/GNOME/gcr"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  gnutls
  libp11-kit
  libsecret
  openssh
  systemd-libs
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  gtk4
  meson
  systemd
  vala
)
optdepends=('gtk4: gcr-viewer-gtk4')
# trim: gcr-4-docs split + gi-docgen makedep dropped together with
#       -D gtk_doc=false below and the doc staging move in package() (docs)
# House standard: bare soname provides per ELF output (never pinned) — stock kept.
provides=(
  libgck-2.so
  libgcr-4.so
)
source=("git+https://gitlab.gnome.org/GNOME/gcr.git?signed#tag=$pkgver")
b2sums=('fba7ff91a22fe7e7b1d5a53e4841a8d3bdc76d49855e87ccc09b9da00094267174fa96a405c919a6922e3885aadd6def127f48894df87f1e507c93d62a293cfa')
validpgpkeys=(
  EF3226243ABEFC1A828BC5B46A2AC2B52126D946 # Dhanuka Warusadura <dhanuka@gnome.org>
  A7C626E13F9AD776776BD9CA1D8A57CF2E8D36A3 # Niels De Graef (nielsdg) <nielsdegraef@gmail.com>
)

prepare() {
  cd gcr
}

build() {
  local meson_options=(
    -D crypto=gnutls
    # trim: gi-docgen API reference (docs) for the dropped gcr-4-docs split
    -D gtk_doc=false
  )

  # House style: mold linker when available
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  arch-meson gcr build "${meson_options[@]}"
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

# trim: check() test suite (Secure memory tests) dropped (Class B tests)

package() {
  meson install -C build --destdir "$pkgdir"

  # trim: locale/doc payload for the dropped gcr-4-docs split (locales/docs)
  rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/locale" "$pkgdir/usr/share/man"

  # license: ship the upstream licence text(s) (LGPL-2.1-or-later)
  cd gcr
  local _l
  for _l in COPYING COPYING.LGPL LICENSE; do
    [[ -f $_l ]] && install -Dm644 "$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"
  done
}

