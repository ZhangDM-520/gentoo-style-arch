# Maintainer: David Runge <dvzrv@archlinux.org>

pkgbase=libtraceevent
pkgname=(
  libtraceevent
)
# trim: the libtraceevent-docs split is dropped — the asciidoc/xmlto
# Documentation output (API man3 + html) is not shipped
pkgver=1.9.0
pkgrel=1
epoch=1
pkgdesc="Linux kernel trace event library"
arch=(x86_64)
url="https://git.kernel.org/pub/scm/libs/libtrace/libtraceevent.git/about/"
license=(
  GPL-2.0-only
  LGPL-2.1-only
)
depends=(glibc)
makedepends=()
# trim: asciidoc + xmlto (makedepends) went with the libtraceevent-docs split
# and its Documentation build
source=(
  https://git.kernel.org/pub/scm/libs/libtrace/$pkgname.git/snapshot/$pkgname-$pkgver.tar.gz
  $pkgname-1.5.0-documentation.patch
)
sha512sums=('9afb3c20ec1161f38ae8ad507dd1bf5841861f76c567e0cd4a195044eddf72b790301e7f628db40597bae34822eb15ceb57de4eb5bb34758931a4a994991f6ee'
            '74b34a722d3fb9d672826e0b6b137f94a7fcd41bb372f8944bb6a0c652c0e725aaef8e95284fc091c2e9954bcf1656b5428d7e0f121682d40c25623178ee4a1e')
b2sums=('e731501f19fcfafc7b3d5dc16bebc9eb0d100c5ed28fef174c1c6c6ef23b74132d6f20a7648064927d0e013349b8891a93b5682f4e86e3f8c712bb9453c823f7'
        'f66f4f20dfe562407a0d4bb53785d1515c4b5f4be64dd96e06ea6c9e03c299b2f0f613901c30893a976b3874d13e768791632a7cb89be92f3788330e4f5ab97d')

# trim: the _pick() helper went with the libtraceevent-docs split

prepare() {
  patch -d $pkgname-$pkgver -p1 -i ../$pkgname-1.5.0-documentation.patch
}

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  # upstream Makefile is not parallel-safe on its own; keep the serialized -j1
  make -C $pkgname-$pkgver EXTRA_CFLAGS="$CFLAGS" -j1
  # trim: the Documentation build (asciidoc/xmlto API man3 + html) — went
  # with the libtraceevent-docs split
}

package() {
  provides=(libtraceevent.so)

  make libdir_relative=lib prefix=/usr DESTDIR="$pkgdir/" install -C $pkgname-$pkgver
  install -Dm644 $pkgname-$pkgver/LICENSES/GPL-2.0 -t "$pkgdir"/usr/share/licenses/$pkgname/
  install -Dm644 $pkgname-$pkgver/LICENSES/LGPL-2.1 -t "$pkgdir"/usr/share/licenses/$pkgname/
}
