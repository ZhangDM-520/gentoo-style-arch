# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: György Balló <ballogy@freestart.hu>

pkgbase=gupnp
# trim: the gupnp-docs split (gi-docgen API reference) is dropped together
# with its _pick path and the gi-docgen makedep (gtk_doc=false below)
pkgname=(
  gupnp
)
pkgver=1.6.10
pkgrel=1
epoch=1
pkgdesc="GObject-based UPNP framework"
url="https://wiki.gnome.org/Projects/GUPnP"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  gssdp
  libgcc
  libxml2
)
makedepends=(
  git
  glib2-devel
  gobject-introspection
  meson
  vala
)
# trim: check() (meson test) — Class B trim standard (tests)
source=("git+https://gitlab.gnome.org/GNOME/gupnp.git?signed#tag=gupnp-$pkgver")
b2sums=('270f88486bdcbd05e4868c6783aa16c4d12feec4af2fd9f6781c202de5d369c93ddd7dbf4adb50d4ceb31f52b8a0064bb7842ce0d3b8ae9ff613ebb3225ae2a6')
validpgpkeys=(
  AC9CD4E32D7C7F6357BA8ADD10F6E970175D29E1 # Jens Georg <mail@jensge.org>
)

prepare() {
  cd gupnp
}

build() {
  local meson_options=(
    # trim: the gi-docgen API reference (docs) — pairs with the dropped
    # gupnp-docs split, its _pick path and the gi-docgen makedep
    -D gtk_doc=false
  )

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson gupnp build "${meson_options[@]}"
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package_gupnp() {
  depends+=(
    libg{lib,object,io,module}-2.0.so
    libgssdp-1.6.so
    libsoup-3.0.so
  )
  optdepends=('python: gupnp-binding-tool')
  provides=(libgupnp-1.6.so)

  meson install -C build --destdir "$pkgdir"

  # license: ship the upstream LGPL-2.1-or-later (COPYING) text
  install -Dm644 gupnp/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}

