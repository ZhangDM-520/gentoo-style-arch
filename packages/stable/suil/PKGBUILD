# Contributor: Ray Rashif <schiv@archlinux.org>
# Contributor: speps <speps at aur dot archlinux dot org>

# trim: the suil-docs split (sphinx API docs) is dropped — this recipe ships
# the library only; its docs build is disabled in build() and its _pick path
# and doc installs went with it.
pkgbase=suil
pkgname=(suil)
pkgver=0.10.26
pkgrel=1.1
pkgdesc="A lightweight C library for loading and wrapping LV2 plugin UIs"
arch=(x86_64)
url="https://drobilla.net/software/suil.html"
license=(
  0BSD
  ISC
)
makedepends=(
  gtk3
  lv2
  meson
  qt5-base
  qt5-x11extras
  qt6-base
)
source=(https://download.drobilla.net/$pkgname-$pkgver.tar.xz{,.sig})
sha512sums=('82d06b4de5ac238b8e65bf7b47b4275ab5b4e5342362871ec90845fa0a5a6e86c02b3607717a7bd1948eec00596c67e9f7f7388811de79b580443d2d17ab8fc8'
            'SKIP')
b2sums=('d3f2ac0baf4722bbd779eb47253c326aada772c228d7a675bd16b96f8877989d4e0eb017781e483f21ed6a98486551b43042ff63daa6998a7cc9357f1ff0b91c'
        'SKIP')
validpgpkeys=('907D226E7E13FA337F014A083672782A9BF368F3') # David Robillard <d@drobilla.net>

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local meson_options=(
    -D cocoa=disabled
    -D gtk2=disabled
    # trim: docs=disabled drops the sphinx API docs (suil-docs split)
    -D docs=disabled
  )

  # gtk2-compat (pulled in by pinentry) ships a pkg-config shim for gtk+-2.0/
  # gtk+-x11-2.0 that redirects to gtk3, so suil's *optional* gtk2 probe resolves
  # even with -D gtk2=disabled and the wrapper build gate ignores the option —
  # then genuine GTK2 code fails against gtk3-mapped headers. Gate the build on
  # the option too (fail-closed: the grep aborts if upstream moves the line).
  sed -i "s/if gtk2_dep.found() and gtk2_x11_dep.found() and x11_dep.found()/if get_option('gtk2').allowed() and gtk2_dep.found() and gtk2_x11_dep.found() and x11_dep.found()/" $pkgname-$pkgver/meson.build
  grep -q "get_option('gtk2').allowed() and gtk2_dep.found()" $pkgname-$pkgver/meson.build

  arch-meson $pkgname-$pkgver build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build
}

package() {
  depends=(
    glibc
    glib2
    gtk3
    libgcc
    libstdc++
    libx11
    lv2
    qt5-base
    qt5-x11extras
    qt6-base
  )
  provides=(libsuil-0.so)

  meson install -C build --destdir "$pkgdir"
  # trim: /usr/share/doc (API docs plus the AUTHORS/NEWS/README copies — docs)
  rm -rf "$pkgdir"/usr/share/doc
  install -vDm 644 $pkgbase-$pkgver/LICENSES/* -t "$pkgdir/usr/share/licenses/$pkgname/"
}
