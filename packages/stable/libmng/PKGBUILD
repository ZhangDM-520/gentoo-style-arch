# Maintainer: Eric Bélanger <eric@archlinux.org>

pkgname=libmng
pkgver=2.0.3
pkgrel=4
pkgdesc="A collection of routines used to create and manipulate MNG format graphics files"
arch=(x86_64)
url='https://www.libmng.com/'
license=(LicenseRef-libmng)
depends=(glibc
         lcms2
         libjpeg-turbo
         zlib)
provides=(libmng.so)
source=(https://downloads.sourceforge.net/sourceforge/$pkgname/$pkgname-$pkgver.tar.xz{,.asc})
sha256sums=('4a462fdd48d4bc82c1d7a21106c8a18b62f8cc0042454323058e6da0dbb57dd3'
            'SKIP')
validpgpkeys=('8048643BA2C840F4F92A195FF54984BFA16C640F')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd $pkgname-$pkgver
  ./configure \
    --prefix=/usr
  make
}

package() {
  cd $pkgname-$pkgver
  make DESTDIR="$pkgdir" install
  # trim: man pages (man3/libmng, man5/jng, man5/mng) — docs not shipped
  rm -rf "$pkgdir"/usr/share/man
  install -D -m644 LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
