# Maintainer: AndyRTR <andyrtr@archlinux.org>

pkgname=libfreehand
pkgver=0.1.4
pkgrel=1
pkgdesc="a library for import of Aldus/Macromedia/Adobe FreeHand documents"
arch=('x86_64')
url="https://wiki.documentfoundation.org/DLP/Libraries/libfreehand"
license=('MPL-2.0')
depends=('librevenge' 'lcms2' 'zlib' 'glibc' 'libstdc++' 'libgcc')
# trim: cppunit feeds the unit tests and doxygen the API docs (dropped in
# build() below) — neither is pulled back in as a makedep
makedepends=('boost' 'gperf')
provides=('libfreehand-0.1.so')
source=("https://dev-www.libreoffice.org/src/libfreehand/$pkgname-$pkgver.tar.xz")
sha256sums=('350b10d24a76d7e8c8ae98b74c2d432a2c8ddec08935d09856d20b695a35e600')

prepare() {
	cd "$pkgname-$pkgver"
    autoreconf -vfi
}

build() {
	cd "$pkgname-$pkgver"
	# House style: mold linker when available
	local _mold=""
	command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
	export LDFLAGS+=" ${_mold}"
	# trim: unit tests (cppunit), fuzz targets and doxygen API docs — the
	# shipped converters stay (default --enable-tools)
	./configure --prefix=/usr --disable-werror --disable-tests --disable-fuzzers --without-docs
	make
}

package() {
	cd "$pkgname-$pkgver"
	make DESTDIR="$pkgdir/" install
	# trim: any doxygen HTML left under /usr/share/doc (docs)
	rm -rf "$pkgdir"/usr/share/doc
	install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
