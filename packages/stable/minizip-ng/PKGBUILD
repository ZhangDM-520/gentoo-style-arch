# Maintainer: Antonio Rojas <arojas@archlinux.org>

pkgname=minizip-ng
pkgver=4.2.2
pkgrel=1
pkgdesc='Fork of the popular zip manipulation library found in the zlib distribution'
arch=(x86_64)
url='https://github.com/zlib-ng/minizip-ng'
license=(Zlib)
depends=(bzip2
         glibc
         openssl
         xz
         zlib-ng
         zstd)
makedepends=(cmake
             git)
# House standard: bare soname provide per ELF output (never pinned).
# Upstream soname is libminizip-ng.so.1 (MZ_LIB_SUFFIX=-ng).
provides=('libminizip-ng.so')
source=(git+https://github.com/zlib-ng/minizip-ng#tag=$pkgver)
sha256sums=('3564e2aa171fb6556607d5c08c753c78e488c8e9342c166901f445f5415ed05b')

build() {
  # House style: mold linker when available (cmake consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  cmake -B build -S $pkgname \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMZ_LIB_SUFFIX="-ng" \
    -DBUILD_SHARED_LIBS=ON
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 $pkgname/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname
}
