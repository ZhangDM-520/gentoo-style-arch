# Maintainer: Christian Hesse <eworm@archlinux.org>

# ➡️ The mariadb package will be latest stable (GA / General Availability)
#   release, regardless of rolling or long-term release.
# ➡️ The mariadb-lts package will be latest long-term release not packaged
#   in mariadb. So mariadb-lts will always be behind mariadb.
# https://mariadb.com/kb/en/mariadb-server-release-dates/
#
# trim: dropped splits mariadb-clients/mariadb/mariadb-mytop/mariadb-pam —
#       this recipe delivers only the mariadb-libs output (upgrade-in-place of
#       the stock split); their package_* functions and install paths were
#       removed together with them (mariadb.install + the service .conf
#       installs belong to the dropped mariadb split; the two .conf sources
#       stay in source=() untouched per source-preservation house rule)

pkgbase=mariadb-libs
pkgname=(
  'mariadb-libs'
)
pkgdesc='Fast SQL database server, derived from MySQL'
pkgver=13.0.2
pkgrel=2
