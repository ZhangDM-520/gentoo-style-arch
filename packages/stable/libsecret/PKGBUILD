# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan de Groot <jgc@archlinux.org>

pkgbase=libsecret
pkgname=(
  libsecret
)
# trim: the libsecret-docs split is dropped — the gi-docgen API docs are not
# shipped (gtk_doc=false in build()); only the library/secret-tool output stays
pkgver=0.21.8.2
pkgrel=1
pkgdesc="Library for storing and retrieving passwords and other secrets"
url="https://gnome.pages.gitlab.gnome.org/libsecret/"
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  glibc
  libgcrypt
  tpm2-tss
)
makedepends=(
  bash-completion
  git
  glib2-devel
  gobject-introspection
  meson
  vala
)
# trim: gi-docgen (makedepends) went with the libsecret-docs split
checkdepends=(
  gjs
  python-dbus
  python-gobject
  swtpm
  tpm2-abrmd
)
source=(
  "git+https://gitlab.gnome.org/GNOME/libsecret.git?signed#tag=$pkgver"
)
b2sums=('feb0a32bd0ff4d78731059a1df46c6aec2f43bebe27440ff6b09fbe55715d8b18a4726bddba68e3f648f565ca01125d263a423edb27fd18fbe9e9d5190d3e843')
validpgpkeys=(
  A7C626E13F9AD776776BD9CA1D8A57CF2E8D36A3 # Niels De Graef <nielsdegraef@gmail.com>
)

prepare() {
  cd $pkgbase

  # Secure memory tests fail in containers
  sed -ri '/test-(secmem|dh-length)/d' egg/meson.build
}

build() {
  local meson_options=(
    -D test_setup=disabled
    -D tpm2=true
    # trim: reference docs and man pages — Class B trim standard
    -D gtk_doc=false
    -D manpage=false
  )

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

_check() (
  export TPM_PATH="$PWD/tpm"
  mkdir -p "$TPM_PATH"

  swtpm_setup --create-config-files
  swtpm_setup --tpm2 --tpm-state "$TPM_PATH" --createek --allow-signing \
    --decryption --overwrite --display

  swtpm socket --tpm2 --flags startup-clear \
    --server type=unixio,path="$TPM_PATH/socket" \
    --ctrl type=unixio,path="$TPM_PATH/socket.ctrl" &
  _p1=$!

  tpm2-abrmd --tcti=swtpm:path="$TPM_PATH/socket" \
    --session --flush-all &
  _p2=$!

  trap "kill $_p1 $_p2; wait" EXIT

  export TCTI=tabrmd:bus_type=session

  meson test -C build --print-errorlogs
)

check() {
  dbus-run-session bash -c "$(declare -f _check); _check"
}

package() {
  optdepends=('org.freedesktop.secrets: secret storage backend')
  provides=(libsecret-1.so)

  meson install -C build --destdir "$pkgdir"

  # trim: locales — Class B trim standard (docs/man/locales payload)
  rm -rf "$pkgdir"/usr/share/locale
  install -Dm644 $pkgbase/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}

