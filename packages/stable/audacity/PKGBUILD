_name=Audacity
# Per-output recipe: ships the audacity output of the pkgbase; the
# audacity-docs split is trimmed (docs).
# trim: dropped split audacity-docs together with its package_*() function,
# its license decl (CC-BY-3.0 manual) and its /usr/share/doc/$pkgbase/html
# staging path; the audacity-manual tarball stays in source=() as delivered
# (unused — source=() kept complete)
pkgbase=audacity
pkgname=(
  audacity
)
pkgver=3.7.9
pkgrel=1
epoch=1
pkgdesc="A program that lets you manipulate digital audio waveforms"
arch=(x86_64)
url="https://audacityteam.org"
license=(GPL-3.0-or-later)
makedepends=(
