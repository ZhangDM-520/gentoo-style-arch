install=wine.install

prepare() {
  # Get rid of old build dirs
  rm -rf $pkgname-64-build
  mkdir $pkgname-64-build

  # cups >= 2.5 renamed the http_status_t constants and dropped the old
  # spellings (see cups-2.5-enum-compat.patch). Rerun-safe over a dirty
  # checkout: restore the file before applying.
  git -C wine checkout -- dlls/winspool.drv/cups.c
  patch -Np1 -d wine -i "$srcdir/cups-2.5-enum-compat.patch"
}

build() {
  # Apply flags for cross-compilation
  export CROSSCFLAGS="-O2 -pipe -g"
  export CROSSCXXFLAGS="-O2 -pipe -g"
  export CROSSLDFLAGS="-Wl,-O1"

  # Make sure correct source file paths are recorded in debug information,
  # so that wine crash reports can have correct paths
  if [[ $CFLAGS =~ (-ffile-prefix-map=[^[:space:]]+) ]]; then
    CROSSCFLAGS="$CROSSCFLAGS ${BASH_REMATCH[1]}"
    CROSSCXXFLAGS="$CROSSCXXFLAGS ${BASH_REMATCH[1]}"
  fi

  # House style: mold linker when available (unix-side link; the PE side is
  # CROSSCFLAGS/CROSSLDFLAGS and stays stock)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  cd "$srcdir/$pkgname-64-build"
  ../wine/configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --disable-tests \
    --enable-archs=x86_64,i386 \
    --enable-build-id

  make
}

package() {
  cd "$srcdir/$pkgname-64-build"
  make prefix="$pkgdir/usr" \
    libdir="$pkgdir/usr/lib" \
    dlldir="$pkgdir/usr/lib/wine" install

  # Font aliasing settings for Win32 applications
  install -d "$pkgdir"/usr/share/fontconfig/conf.{avail,default}
  install -m644 "$srcdir/30-win32-aliases.conf" "$pkgdir/usr/share/fontconfig/conf.avail"
  ln -s ../conf.avail/30-win32-aliases.conf "$pkgdir/usr/share/fontconfig/conf.default/30-win32-aliases.conf"
  install -Dm 644 "$srcdir/wine-binfmt.conf" "$pkgdir/usr/lib/binfmt.d/wine.conf"

  # trim: man pages (docs)
  rm -rf "$pkgdir"/usr/share/man

  install -Dm644 ../wine/LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}

