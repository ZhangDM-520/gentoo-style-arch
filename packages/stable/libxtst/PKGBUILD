# Contributor: Jan de Groot <jgc@archlinux.org>

pkgname=libxtst
pkgver=1.2.6
pkgrel=1.1
pkgdesc="library for XTEST & RECORD extensions"
arch=('x86_64')
url="https://gitlab.freedesktop.org/xorg/lib/libxtst"
license=('MIT-open-group'
         'HPND-sell-variant'
         'X11'
         'HPND-doc'
         'HPND-doc-sell')
depends=('libxext' 'libxi' 'libx11' 'glibc' 'xorgproto')
makedepends=('xorg-util-macros')
provides=('libXtst.so')
source=(https://xorg.freedesktop.org/releases/individual/lib/libXtst-${pkgver}.tar.xz{,.sig})
sha512sums=('c1ce90e1274d91c0c7e18b9f004a583bc4104d461cb85642cc01a104cab854f14fc2960a578af56c9ae8d307a20d5efe2a40062cc0c4352765ea8db540d5f34e'
            'SKIP')
#validpgpkeys=('C41C985FDCF1E5364576638B687393EE37D128F8') # Matthieu Herrb <matthieu.herrb@laas.fr>
validpgpkeys=('4A193C06D35E7C670FA4EF0BA2FB9E081F2D130E' '3AB285232C46AE43D8E192F4DAB0F78EA6E7E2D2') # Alan Coopersmith <alan.coopersmith@oracle.com>

build() {
  cd "${srcdir}/libXtst-${pkgver}"
  ./configure --prefix=/usr --disable-static
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd "${srcdir}/libXtst-${pkgver}"
  make DESTDIR="${pkgdir}" install

  # trim: shipped API doc XML and man3 pages (docs, not needed at runtime)
  rm -rf "${pkgdir}"/usr/share/doc "${pkgdir}"/usr/share/man

  install -m755 -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/"
}
