# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan De Groot <jgc@archlinux.org>

pkgname=gnome-keyring
pkgver=51.1
pkgrel=1
epoch=1
pkgdesc="Stores passwords and encryption keys"
url="https://gitlab.gnome.org/GNOME/gnome-keyring"
arch=(x86_64)
license=(
  GPL-2.0-or-later
  LGPL-2.1-or-later
)
depends=(
  dconf
  gcr
  gcr-4
  glib2
  glibc
  libcap-ng
  libgcc
  libgcrypt
  pam
  systemd-libs
)
makedepends=(
  git
  glib2-devel
  meson
  p11-kit
  python
)
# trim: check() (flaky secure-memory tests — the stock recipe swallowed their
# failures with `|| :`) and the docbook-xsl makedep dropped together with the
# man pages (manpage=false below) — Class B trim standard (tests/man)
provides=(
  org.freedesktop.secrets
  pam_gnome_keyring.so
  gnome-keyring-pkcs11.so
  gkm-gnome2-store-standalone.so
  gkm-secret-store-standalone.so
  gkm-ssh-store-standalone.so
  gkm-xdg-store-standalone.so
)
groups=(gnome)
install=gnome-keyring.install
source=(
  "git+$url.git?signed#tag=${pkgver/[a-z]/.&}"
  0001-daemon-Add-Cinnamon-to-autostart-files.patch
)
b2sums=('c6ab0cab71f2815177466dbac5355b8a81699e9e981ad27293972a9c9cde6ab225eb8326da434768f7101d58f217ef414181060e1ab517888ed27177d4b4a367'
        '584832e529ee2be98b78b128ab4271fae919a194f2d9254526943da6baccfe5eb6deb17ee03cfb54261cade4be0e93ea7fbcc91ebc77ecfacd2f25d90f9e29c4')
validpgpkeys=(
  A7C626E13F9AD776776BD9CA1D8A57CF2E8D36A3 # Niels De Graef (nielsdg) <nielsdegraef@gmail.com>
)

prepare() {
  cd $pkgname

  # Autolaunch in Cinnamon
  git apply -3 ../0001-daemon-Add-Cinnamon-to-autostart-files.patch
}

build() {
  local meson_options=(
    -D selinux=disabled
    # trim: man pages (gnome-keyring.1/gnome-keyring-daemon.1) — Class B
    # trim standard (man)
    -D manpage=false
  )

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson $pkgname build "${meson_options[@]}"
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  meson install -C build --no-rebuild --destdir "$pkgdir"

  # license: ship the upstream GPL-2.0-or-later (COPYING) and
  # LGPL-2.1-or-later (COPYING.LIB) texts
  install -Dm644 $pkgname/COPYING $pkgname/COPYING.LIB -t "$pkgdir/usr/share/licenses/$pkgname/"
}

