pkgname=fish
pkgver=4.9.3
pkgrel=2
pkgdesc='Smart and user friendly shell intended mostly for interactive use'
url='https://fishshell.com/'
arch=(x86_64)
license=('GPL-2.0-only AND BSD-3-Clause AND ISC AND MIT AND PSF-2.0')
depends=(glibc libgcc pcre2)
makedepends=(cmake git jq llvm pcre2 rust)  # pcre2: FISH_USE_SYSTEM_PCRE2=ON consumer (NOTE.md 2026-10-11)
checkdepends=(expect procps-ng python-pexpect)
optdepends=(
  'python: man page completion parser / web config tool'
  'pkgfile: command-not-found hook'
  'groff: --help for built-in commmands'
  'mandoc: --help for built-in commmands (alternative)'
  'xsel: X11 clipboard integration'
  'xclip: X11 clipboard integration (alternative)'
  'wl-clipboard: Wayland clipboard integration'
)
install=fish.install
backup=(etc/fish/config.fish)
source=("${pkgname}::git+https://github.com/fish-shell/fish-shell#tag=${pkgver}"
        'cmake-install-code.patch')
#validpgpkeys=(003837986104878835FA516D7A67D962D88A709A) # David Adam <zanchey@gmail.com>
sha512sums=('017388b8776fb86563cf475fa280d07b3e3016c00b48f1141dbd6596e041e98ad614ecdb85e2cda92699179caebee64d95193f3a9d9653769de05cdf8d38d9cc'
            '6b43b719ba920aa71c9bb1f11a604dac594c228e149d19e6e4a8ee7d06faffb01b08948268a09e479aa33636c2bae85518edefd6ff4110f5ba656009446518ee')
b2sums=('223586c51e69adbf5ba00df84b3d2f23cc730d989f22afab0e29064bf2d94e9bbbf746f3c46146fb1c696d7c4a3b6008d5c89d15bda0cede6a618472a159b6e8'
        '9dedb8448f853d70cb19ec23c81f0b47e815cdb9505b9af3f6b5d859b00e7ce23ddfa52ed86081c879c8834aec16222e565579aedc15d2983a56f3936a3feb80')

# PGO toggle — set false for quick rebuilds
_pgo=true

prepare() {
  cd ${pkgname}

  # cmake-git 4.4 tightened install() argument parsing and rejects the
  # deprecated install(SCRIPT CODE "...") form ("SCRIPT: missing required
  # value"); install(CODE "...") is the identical install-time hook and
  # parses on both old and new CMake.
  patch -Np1 -i ../cmake-install-code.patch
}

build() {
  cd ${pkgname}

  export CXXFLAGS+=" ${CPPFLAGS}"

  # optimize standards: mold linker when available (all three CMake linker vars)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"

  local cmake_options=(
    -B build
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_INSTALL_SYSCONFDIR=/etc
    -D CMAKE_BUILD_TYPE=Release
    -D WITH_DOCS=OFF
    -D FISH_USE_SYSTEM_PCRE2=ON
    -D WITH_MESSAGE_LOCALIZATION=ON
    -D CMAKE_EXE_LINKER_FLAGS="${_mold}"
    -D CMAKE_SHARED_LINKER_FLAGS="${_mold}"
    -D CMAKE_MODULE_LINKER_FLAGS="${_mold}"
    -W no-dev
  )

  local _pgo_profile_dir="${srcdir}/fish-pgo"
  local _cflags_orig="${CFLAGS}"
  local _cxxflags_orig="${CXXFLAGS}"
  local _ldflags_orig="${LDFLAGS}"
  local _rustflags_orig="${RUSTFLAGS}"

  if ${_pgo}; then
    # phase 1: instrumented build — C/C++ via GCC gcda, Rust via LLVM profraw (no LTO yet)
    export CFLAGS+=" -fprofile-generate=${_pgo_profile_dir} -fprofile-update=atomic"
    export CXXFLAGS+=" -fprofile-generate=${_pgo_profile_dir} -fprofile-update=atomic"
    export LDFLAGS+=" -fprofile-generate=${_pgo_profile_dir}"
    export RUSTFLAGS+=" -Cprofile-generate=${_pgo_profile_dir}"
    export CARGO_PROFILE_RELEASE_LTO=false
  fi

  cmake "${cmake_options[@]}"
  make -C build VERBOSE=1

  if ${_pgo}; then
    # ---- PGO training: scripted fish sessions (parser, expansion, completion) ----
    local _home="${srcdir}/fish-home"
    mkdir -p "${_home}"
    export HOME="${_home}"
    export TERM="${TERM:-xterm-256color}"
    export LLVM_PROFILE_FILE="${_pgo_profile_dir}/fish-%p.profraw"
    local _fish="build/fish"
    "$_fish" -N -c 'true' || true
    "$_fish" -N -c 'set -l x (seq 1 200); count $x' || true
    "$_fish" -N -c 'string upper (echo hello world)' || true
    "$_fish" -N -c 'for i in (seq 1 50); math $i \* 3; end' || true
    "$_fish" -N -c 'function foo; echo bar; end; foo' || true
    "$_fish" -N -c 'complete -C "git s"' || true
    "$_fish" -N -c 'complete -C "pacman -"' || true
    "$_fish" -N -c 'complete -C "fish -"' || true
    printf 'echo hello\nset -l a 1\nmath $a + 2\n' | "$_fish" -N -i || true

    # merge Rust profraw profiles
    local _profdata_bin
    _profdata_bin=$(command -v llvm-profdata || true)
    local _rust_profile_ok=false
    local _profraw_count
    _profraw_count=$(find "${_pgo_profile_dir}" -name '*.profraw' 2>/dev/null | wc -l)
    if [ -n "${_profdata_bin}" ] && [ "${_profraw_count}" -gt 0 ]; then
      "${_profdata_bin}" merge -sparse -o "${_pgo_profile_dir}/rust.profdata" \
        "${_pgo_profile_dir}"/*.profraw || true
      if [ -s "${_pgo_profile_dir}/rust.profdata" ]; then
        _rust_profile_ok=true
      fi
    fi

    # verify C profile data before shipping -fprofile-use (never use an empty profile)
    local _gcda_count
    _gcda_count=$(find "${_pgo_profile_dir}" -name '*.gcda' 2>/dev/null | wc -l)
    echo "  -> Generated ${_gcda_count} gcda + ${_profraw_count} profraw files"

    # phase 2: rebuild with profile-use (fresh build dir for clean objects)
    export CFLAGS="${_cflags_orig}"
    export CXXFLAGS="${_cxxflags_orig}"
    export LDFLAGS="${_ldflags_orig}"
    export RUSTFLAGS="${_rustflags_orig}"
    export CARGO_PROFILE_RELEASE_LTO=thin

    if [ "${_gcda_count}" -gt 0 ]; then
      export CFLAGS+=" -fprofile-use=${_pgo_profile_dir} -fprofile-reorder-functions \
-Wno-error=format-overflow -Wno-error=coverage-mismatch"
      export CXXFLAGS+=" -fprofile-use=${_pgo_profile_dir} -fprofile-reorder-functions \
-Wno-error=format-overflow -Wno-error=coverage-mismatch"
    else
      echo "  -> WARNING: No C profile data generated. C side falls back to LTO-only build."
    fi
    if ${_rust_profile_ok}; then
      export RUSTFLAGS+=" -Cprofile-use=${_pgo_profile_dir}/rust.profdata"
    else
      echo "  -> WARNING: No usable Rust profile. Rust side falls back to LTO-only build."
    fi

    rm -rf build
    cmake "${cmake_options[@]}"
    make -C build VERBOSE=1
    rm -rf "${_pgo_profile_dir}" "${_home}"
  fi
}

check() {
  cd ${pkgname}

  cmake --build build --target fish_run_tests
}

package() {
  cd ${pkgname}

  DESTDIR="$pkgdir" cmake --install build
}

