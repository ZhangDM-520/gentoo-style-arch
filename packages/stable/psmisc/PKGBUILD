# Maintainer: Eric Bélanger <eric@archlinux.org>

pkgname=psmisc
pkgver=23.7
pkgrel=2
pkgdesc='Miscellaneous procfs tools'
arch=('x86_64')
url='https://gitlab.com/psmisc/psmisc'
license=('GPL')
depends=('ncurses')
makedepends=('git')
# trim: po4a makedep (PURGED tool) with the man-po translated-man machinery it
# feeds, trimmed together in prepare() — translated man pages not built
validpgpkeys=('5D2FB320B825D93904D205193938F96BDF50FEA5') # Craig Small <csmall@debian.org>
source=("git+https://gitlab.com/psmisc/psmisc.git?signed#tag=v${pkgver}")
sha256sums=('80ae6e626ba83232b7af1c02f3f528834ebdd96325367b701f69125d3e196f2f')

prepare() {
  cd ${pkgname}

  # trim: drop the man-po subdirectory from the build (translated man pages;
  # its po4a tooling is a purged tool and stays uninstalled)
  sed -i '/^[[:space:]]*man-po[[:space:]]*\\$/d' Makefile.am

  ./autogen.sh
}

build() {
  cd ${pkgname}

  # House style: mold linker when available (runtime-guarded, no output effect).
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure \
    --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd ${pkgname}

  make DESTDIR="${pkgdir}" install

  # trim: man pages (man1 killall/pslog/prtstat/pstree/peekfd/fuser) (docs) —
  # not shipped (message translations under locale/ are kept)
  rm -rf "${pkgdir}"/usr/share/man

  install -Dm644 COPYING -t "${pkgdir}"/usr/share/licenses/$pkgname/
}
