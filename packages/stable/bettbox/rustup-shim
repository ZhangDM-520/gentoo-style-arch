#!/usr/bin/env bash
# rustup shim for rust-git — translates rustup subcommands to direct toolchain access
# Place in /usr/local/bin/rustup so it shadows the missing binary.

HOST_TARGET="x86_64-unknown-linux-gnu"
TOOLCHAIN_NAME="stable-${HOST_TARGET}"
SYSROOT="$(rustc --print sysroot 2>/dev/null || echo /usr)"

cmd="${1:-}"
shift 2>/dev/null || true

case "$cmd" in
  toolchain)
    subcmd="${1:-}"
    case "$subcmd" in
      list)
        echo "${TOOLCHAIN_NAME} (default)"
        ;;
      install)
        # no-op: system toolchain is always installed
        exit 0
        ;;
      *)
        echo "rustup-shim: unsupported toolchain subcommand: $subcmd" >&2
        exit 1
        ;;
    esac
    ;;
  target)
    subcmd="${1:-}"
    case "$subcmd" in
      list)
        # Parse --installed flag
        installed_only=0
        toolchain=""
        while [[ $# -gt 0 ]]; do
          case "$1" in
            --installed) installed_only=1; shift ;;
            --toolchain) toolchain="$2"; shift 2 ;;
            *) shift ;;
          esac
        done
        if [[ $installed_only -eq 1 ]]; then
          echo "$HOST_TARGET"
        else
          echo "$HOST_TARGET (installed)"
        fi
        ;;
      add)
        # no-op: target is always available
        exit 0
        ;;
      *)
        echo "rustup-shim: unsupported target subcommand: $subcmd" >&2
        exit 1
        ;;
    esac
    ;;
  component)
    # no-op: all components available in system rust
    exit 0
    ;;
  run)
    # rustup run <toolchain> <command> [args...]
    # Skip the toolchain arg, execute the rest
    shift  # remove toolchain name
    exec "$@"
    ;;
  show)
    subcmd="${1:-}"
    case "$subcmd" in
      home)
        echo "$SYSROOT"
        ;;
      *)
        echo "rustup-shim: unsupported show subcommand: $subcmd" >&2
        exit 1
        ;;
    esac
    ;;
  which)
    # rustup which <binary>
    bin="${1:-cargo}"
    which_path="$(command -v "$bin" 2>/dev/null)"
    if [[ -n "$which_path" ]]; then
      echo "$which_path"
    else
      echo "rustup-shim: '$bin' not found in PATH" >&2
      exit 1
    fi
    ;;
  *)
    echo "rustup-shim: unsupported command: $cmd" >&2
    echo "Supported: toolchain, target, component, run, show, which" >&2
    exit 1
    ;;
esac
