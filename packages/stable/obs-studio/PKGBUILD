pkgname=obs-studio
pkgver=32.2.2
pkgrel=1.1
pkgdesc="Free, open source software for live streaming and recording"
arch=('x86_64')
url="https://obsproject.com"
license=('GPL-2.0-only')
provides=('libobs.so' 'libobs-frontend-api.so' 'libobs-opengl.so' 'libobs-scripting.so')
depends=('ffmpeg' 'jansson' 'libxinerama' 'libxkbcommon-x11' 'mbedtls3' 'rnnoise' 'pciutils'
         'qt6-svg' 'curl' 'jack' 'gtk-update-icon-cache' 'pipewire' 'libxcomposite'
         'libdatachannel' 'uthash' 'simde' 'qrcodegencpp-cmake' 'python' 'luajit')
# trim: cef dropped together with the obs-studio-plugin-browser split output
makedepends=('cmake' 'libfdk-aac' 'x264' 'swig' 'sndio' 'nlohmann-json'
             'ffnvcodec-headers' 'websocketpp' 'asio' 'extra-cmake-modules'
             'git')
source=(
  "$pkgname::git+https://github.com/obsproject/obs-studio#tag=$pkgver"
  "${pkgname}-libdshowcapture::git+https://github.com/obsproject/libdshowcapture.git"
  "${pkgname}-obs-browser::git+https://github.com/obsproject/obs-browser.git"
  "${pkgname}-obs-websocket::git+https://github.com/obsproject/obs-websocket.git"
  "obs-studio-ffmpeg-snapshot-version.patch"
  "obspython-swig-genex.patch"
)
sha256sums=('18edf1162e6cc37c192c4532ccfb902a07c5891d5929e95c4f028c6ad5d762d5'
            'SKIP'
            'SKIP'
            'SKIP'
            'ba9ec63493e251c68c03a191b99aafb6fb3a29eaaaae5088bec63388f20a60e2'
            '8f74993a30c49aa1729b7014923397d2dda3b52a994812691559552d93462246')

prepare() {
  cd $pkgname

  git submodule init

  git config submodule."plugins/obs-browser".url "${srcdir}/${pkgname}"-obs-browser
  git config submodule."plugins/obs-websocket".url "${srcdir}/${pkgname}"-obs-websocket
  git config submodule."plugins/win-dshow/libdshowcapture".url "${srcdir}/${pkgname}"-libdshowcapture

  git -c protocol.file.allow=always submodule update --init --recursive

  # use FindCEF provided by system CEF
  rm cmake/finders/FindCEF.cmake

  # house: FindFFmpeg's version gate only parses release-style ffversion.h;
  # ffmpeg git snapshots report "N-<rev>-g<hash>" and were rejected at the
  # 6.1 floor despite all components being found (NOTE.md 2026-10-10)
  patch -Np1 -i "$srcdir/obs-studio-ffmpeg-snapshot-version.patch"

  # house: UseSWIG's swig command receives SWIG_FLAGS generator expressions
  # unevaluated under the cmake 4.4 snapshot (obspython.i compile dies);
  # flatten the two GUI-only flags (NOTE.md 2026-10-10)
  patch -Np1 -i "$srcdir/obspython-swig-genex.patch"

  # obs-browser's pinned commit (3f0a2cd, 2.26.9) already contains the C++20
  # (PR #517) and CEF 6613+ (PR #523) changes plus the /usr/lib/cef/ rpath —
  # the former house patches and the rpath sed are dropped (they reverse-fail
  # at the pin; NOTE.md 2026-10-10)
}

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local cmake_options=(
    -B build
    -S $pkgname
    -DCMAKE_INSTALL_PREFIX="/usr"
    -DCMAKE_COMPILE_WARNING_AS_ERROR=OFF
    # mbedtls 4 not supported yet
    # https://github.com/obsproject/obs-studio/issues/13601
    -DMbedTLS_INCLUDE_DIR="/usr/include/mbedtls3"
    -DMbedtls_LIBRARY="/usr/lib/mbedtls3/libmbedtls.so"
    -DMbedcrypto_LIBRARY="/usr/lib/mbedtls3/libmbedcrypto.so"
    -DMbedx509_LIBRARY="/usr/lib/mbedtls3/libmbedx509.so"
    # trim: CEF browser support dropped together with the
    # obs-studio-plugin-browser split output (cef makedep and its staging gone)
    -DENABLE_BROWSER=OFF
    -DENABLE_VST=ON
    -DENABLE_VLC=OFF
    -DENABLE_NEW_MPEGTS_OUTPUT=OFF
    -DENABLE_AJA=OFF
    -DENABLE_JACK=ON
    -DENABLE_LIBFDK=ON
    -DENABLE_WEBRTC=ON
    -DOBS_VERSION_OVERRIDE="$pkgver"
    -DCALM_DEPRECATION=ON
    -DENABLE_WEBSOCKET=ON
    # house: pin the system interpreter — FindPython otherwise picks the
    # uv/pyenv shims that lead PATH (~/.local/bin/python3.11) and the
    # outputs embed a libpython the payload cannot ship (NOTE.md 2026-10-10)
    -DPython_EXECUTABLE=/usr/bin/python
    -DPython3_EXECUTABLE=/usr/bin/python
    -Wno-dev
  )
  cmake "${cmake_options[@]}"
  cmake --build build
}

package() {
  optdepends=('libfdk-aac: FDK AAC codec support'
              'libva-intel-driver: hardware encoding for older Intel GPUs'
              'intel-media-driver: hardware encoding for recent Intel GPUs'
              'libva-mesa-driver: hardware encoding'
              'sndio: Sndio input client'
              'v4l2loopback-dkms: virtual camera support'
              'xdg-desktop-portal-impl: Wayland window/screen capture'
              )

  DESTDIR="$pkgdir" cmake --install build

  # trim: obs-studio-plugin-browser split output dropped with its staging
  # (obs-browser-page/obs-browser.so moves) — nothing browser ships here
  # trim: docs/man/locales — lean consumer-rebuild recipe, docs not shipped
  rm -rf "$pkgdir"/usr/share/doc "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale

  install -Dm644 $pkgname/COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}

# trim: dropped the obs-studio-plugin-browser split output (this single-output
# recipe packages only obs-studio; CEF browser plugin not built)
