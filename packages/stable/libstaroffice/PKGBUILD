# Maintainer: AndyRTR <andyrtr@archlinux.org>
# Contributor: twa022 <twa022 at gmail dot com>

pkgbase=libstaroffice
pkgname=(libstaroffice)
# trim: the libstaroffice-doc split is dropped — the doxygen API docs are not
# shipped (--without-docs in build()); only the library/tools output stays
pkgver=0.0.8
pkgrel=1.1
pkgdesc="filter for old StarOffice documents(.sdc, .sdw, ...) based on librevenge"
url="https://github.com/fosnola/libstaroffice"
arch=('x86_64')
license=('LGPL-2.1-or-later OR MPL-2.0')
depends=('librevenge' 'zlib' 'glibc' 'libstdc++' 'libgcc')
makedepends=('librevenge' 'zlib' 'gcc-libs' 'glibc')
# trim: doxygen (makedepends) went with the libstaroffice-doc split
source=(https://github.com/fosnola/$pkgname/releases/download/$pkgver/libstaroffice-$pkgver.tar.xz)
sha256sums=('bbca92882e96c55bd1527670866d6bc7529ccb12786da55a2398b60a063378da')

prepare() {
  cd $pkgname-$pkgver
  autoreconf -fiv
}

build() {
  cd "${pkgbase}-${pkgver}"
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure --prefix=/usr --without-docs
  make
}

check() {
  cd "${pkgbase}-${pkgver}"
  make check
}

package() {
  provides=(libstaroffice-0.0.so)

  cd "${pkgbase}-${pkgver}"
  make DESTDIR="${pkgdir}" install-exec install-pkgconfDATA
  make -C inc/libstaroffice DESTDIR="${pkgdir}" install
  install -Dm644 COPYING.{LGPL,MPL} -t "${pkgdir}"/usr/share/licenses/${pkgname}/
}
