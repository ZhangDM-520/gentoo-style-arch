# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=libldac
pkgver=2.0.2.6
pkgrel=1.1
pkgdesc="LDAC Bluetooth encoder library"
url="https://github.com/EHfive/ldacBT"
arch=(x86_64)
license=(Apache-2.0)
depends=(glibc)
makedepends=(
  cmake
  git
  ninja
)
provides=(libldacBT_{abr,enc}.so)
# libldac is upstream's git submodule pinned at the submodule gitlink of the
# v$pkgver tag (82b6a1ab...). The canonical android.googlesource host advertises
# a corrupt branch ref (refs/heads/android17-security-release -> non-commit
# 15a1c66) that git 2.56 refuses to clone past ("trying to write non-commit
# object ... to branch"), and makepkg clones --mirror (all refs), so no fragment
# avoids it. Fetched from the libldacdec author's mirror of the same repo
# instead: content is pinned by the git object id itself (identical commit hash
# = identical content). googlesource's +archive tarball was rejected as a
# replacement: its bytes are regenerated per request (gzip metadata), so no
# checksum can pin it.
source=(
  "git+$url#tag=v$pkgver"
  "git+https://github.com/anonymix007/libldac#commit=82b6a1abee84787b8fa167efe20290073f60db2d"
)
b2sums=('cefd6836476371999cbca1d45c3b5fce447d88186de24ab85f4d7c2b771bd2bd7427adc73112a6f003004a259f519319586589d46bd07af192e795943400cc46'
        '38ce7971ea7dda28aadc023694722ddc7d8c269454e4c219b92f9673688c5baa6d6777d506b75229192d6e7bc9bc8c0641b2abd211c5e088dfd60226e3f379be')

prepare() {
  cd ldacBT

  # Feed the pinned libldac clone in as the submodule instead of re-fetching it
  # from its .gitmodules URL (the local path needs protocol.file.allow).
  git submodule init
  git submodule set-url libldac "$srcdir/libldac"
  git -c protocol.file.allow=always -c protocol.allow=never submodule update
}

build() {
  # House style: mold linker when available (CMake reads LDFLAGS at cache init)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local cmake_options=(
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_BUILD_TYPE=None
    -D LDAC_SOFT_FLOAT=OFF
  )

  cmake -S ldacBT -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ldacBT/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

