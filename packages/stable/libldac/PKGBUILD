# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=libldac
pkgver=2.0.2.6
pkgrel=1
pkgdesc="LDAC Bluetooth encoder library"
url="https://github.com/EHfive/ldacBT"
arch=(x86_64)
license=(Apache-2.0)
depends=(glibc)
makedepends=(
  cmake
  git
  ninja
)
provides=(libldacBT_{abr,enc}.so)
# libldac is upstream's git submodule pinned at the submodule gitlink of the
# v$pkgver tag (82b6a1ab...). It is fetched as googlesource's +archive tarball
# of the SAME commit, not as a git clone: the android.googlesource repo
# advertises a corrupt branch ref (refs/heads/android17-security-release ->
# non-commit 15a1c66) and git 2.56 refuses to clone past it ("trying to write
# non-commit object ... to branch"); makepkg clones --mirror (all refs), so no
# fragment avoids it. The archive is checksummed here (fail closed if
# googlesource ever regenerates it differently).
_libldac_commit=82b6a1abee84787b8fa167efe20290073f60db2d
source=(
  "git+$url#tag=v$pkgver"
  "libldac.tar.gz::https://android.googlesource.com/platform/external/libldac/+archive/${_libldac_commit}.tar.gz"
)
b2sums=('cefd6836476371999cbca1d45c3b5fce447d88186de24ab85f4d7c2b771bd2bd7427adc73112a6f003004a259f519319586589d46bd07af192e795943400cc46'
        '64346c3b0fc9f63b1fe633a2fd3212a174ce4fd57af8fb65411a263658d6f498d88f83c505846c1c2a1d546e8811bbb28d69f04806a38e3a53a21f475caffffa')
# the +archive tarball is a bare tree (no wrapping dir): keep makepkg from
# spilling it over $srcdir and unpack it into the submodule path ourselves
noextract=('libldac.tar.gz')

prepare() {
  cd ldacBT

  # upstream tracks libldac as a git submodule; drop the pinned tree in as the
  # submodule content (the build compiles these sources and needs no git metadata)
  rm -rf libldac
  mkdir libldac
  tar -xf "$srcdir/libldac.tar.gz" -C libldac
}

build() {
  # House style: mold linker when available (CMake reads LDFLAGS at cache init)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local cmake_options=(
    -D CMAKE_INSTALL_PREFIX=/usr
    -D CMAKE_BUILD_TYPE=None
    -D LDAC_SOFT_FLOAT=OFF
  )

  cmake -S ldacBT -B build -G Ninja "${cmake_options[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ldacBT/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

