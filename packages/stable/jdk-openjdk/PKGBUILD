# Full stock pkgbase delivered under this id for upgrade-in-place (single
# target row) — qca-qt6 precedent. The install_*.sh files are install=()
# assets of the kept outputs (not source=() assets) and are kept as
# load-bearing local files.
# trim: dropped split openjdk-doc (javadoc) together with its package_()
# function, staging path, its pinned provide and the `docs` make target
pkgbase=java-openjdk
# stock merged the old jre-headless/jre/jdk split into one jdk-openjdk
# package (2026-10-09 run #94 wall: the inherited split shipped three nested
# supersets of bin/lib/conf/legal — 713 overlapping paths — so no install
# transaction could ever commit); house trim policy drops split packages and
# the monolith is stock parity, keeping the full compat provides union
pkgname=(
  jdk-openjdk
  openjdk-src
)
# on a majorver change, don't forget to update the misc files that come along this PKGBUILD
_majorver=27
_minorver=0
_securityver=0
_updatever=35
# pkgver=${_majorver}.${_minorver}.${_securityver}.u${_updatever}
pkgver=${_majorver}.u${_updatever}
pkgrel=1
# _git_tag=jdk-${_majorver}.${_minorver}.${_securityver}+${_updatever}
_git_tag=jdk-${_majorver}+${_updatever}
arch=('x86_64')
url='https://openjdk.java.net/'
license=('LicenseRef-Java')
makedepends=(
  "java-environment>=22"
  alsa-lib
  bash
  cpio
  freetype2
  giflib
  glibc
  harfbuzz
  lcms2
  libcups
  libelf
  libgcc
  libjpeg-turbo
  libnet
  libpng
  libstdc++
  libx11
  libxext
  libxrandr
  libxrender
  libxt
  libxtst
  unzip
  zip
)
optdepends=(
  'gvfs: open links e.g. hyperlinks'
)             
source=(
  https://github.com/openjdk/jdk${_majorver}u/archive/${_git_tag}.tar.gz
  freedesktop-java.desktop
  freedesktop-jconsole.desktop
  freedesktop-jshell.desktop
)
sha256sums=('b3c60f65d3b280eb51e2bec66fcac143e275fcf1ab6228e7fb27d26d572604ff'
            'b86c1585ecd1ad90f70088a42ff95e9b7a2089d78db1f41233058f57d2ed0d62'
            '13e1223e633440f185720371282e58befc289faa156d4a7233f8c19102311ef5'
            '5673ab7e4d30678d71e513331c6cb03c1972210ba098f25e507974d4cb7ec4e4')

case "${CARCH}" in
  x86_64) _JARCH='x86_64';;
  i686)   _JARCH='x86';;
  riscv64)_JARCH='riscv64';;
  aarch64) _JARCH='aarch64';;
esac

_jvmdir=/usr/lib/jvm/java-${_majorver}-openjdk
_jdkdir=jdk${_majorver}u-${_git_tag//+/-}
_imgdir=${_jdkdir}/build/linux-${_JARCH}-server-release/images

_commondeps=(
  'java-runtime-common>=3'
  ca-certificates-utils
  freetype2
  glibc
  harfbuzz
  lcms2
  libfreetype.so
  libgcc
  libharfbuzz.so
  libjpeg.so
  libjpeg-turbo
  liblcms2.so
  libnet
  libstdc++
  nss
)

build() {
  cd ${_jdkdir}

  # remove -j from MAKEFLAGS to prevent build fail
  local MAKEFLAG_J=$(echo ${MAKEFLAGS} | sed -En 's/.*-j([0-9]+).*/\1/p')
  export MAKEFLAGS=${MAKEFLAGS/-j${MAKEFLAG_J}/}

  # House: no -O3 — the stock CFLAGS/CXXFLAGS -O2→-O3 rewrite is dropped;
  # stock comment was: Avoid optimization of HotSpot to be lowered from O3 to O2
  local _CFLAGS="${CFLAGS} ${CPPFLAGS} -fcommon"
  local _CXXFLAGS="${CXXFLAGS} ${CPPFLAGS} -fcommon"
  local _LDFLAGS=${LDFLAGS}

  # House style: mold linker when available (consumed via --with-extra-ldflags)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  _LDFLAGS+=" ${_mold}"

  # OpenJDK's configure hard-refuses a ccache-wrapped compiler — it resolves
  # the symlink and dies even when --enable-ccache is passed ("ccache usage
  # must be controlled by a configure option"), so hand it the real
  # binaries and let --enable-ccache do the wrapping (host makepkg
  # BUILDENV=ccache; run #93 wall)
  local _ccache=""
  if command -v ccache >/dev/null 2>&1; then
    _ccache="--enable-ccache"
    export CC=/usr/bin/cc CXX=/usr/bin/c++
  fi

  # cups 2.5 installs headers under /usr/include/libcups2 (the pkg-config
  # includedir), while lib-cups.m4's bare AC_CHECK_HEADERS([cups/cups.h])
  # probe cannot see them ("Could not find cups!") — point the sanctioned
  # --with-cups-include knob at the resolved dir (same class as hplip's
  # run #90 wall; run #93)
  local _cups="--with-cups-include=$(pkg-config --variable=includedir cups 2>/dev/null)"

  # TODO: Should be rechecked for the next releases
  # compiling with -fexceptions leads to:
  # /usr/bin/ld: /build/java-openjdk/src/jdk17u-jdk-17.0.3-2/build/linux-x86_64-server-release/hotspot/variant-server/libjvm/objs/zPhysicalMemory.o: in function `ZList<ZMemory>::~ZList()':
  # /build/java-openjdk/src/jdk17u-jdk-17.0.3-2/src/hotspot/share/gc/z/zList.hpp:54: undefined reference to `ZListNode<ZMemory>::~ZListNode()'
  # collect2: error: ld returned 1 exit status
  _CFLAGS=${_CFLAGS/-fexceptions/}
  _CXXFLAGS=${_CXXFLAGS/-fexceptions/}

  # CFLAGS, CXXFLAGS and LDFLAGS are ignored as shown by a warning
  # in the output of ./configure unless used like such:
  #  --with-extra-cflags="${CFLAGS}"
  #  --with-extra-cxxflags="${CXXFLAGS}"
  #  --with-extra-ldflags="${LDFLAGS}"
  # See also paragraph "Configure Control Variables from "jdk${_majorver}-${_git_tag}/common/doc/building.md
  unset CFLAGS
  unset CXXFLAGS
  unset LDFLAGS

  if check_option "lto" "y"; then
    jvm_features="zgc,shenandoahgc,link-time-opt"
  else
    jvm_features="zgc,shenandoahgc"
  fi


  bash configure \
    --with-version-string="${_majorver}.${_minorver}.${_securityver}" \
    --with-stdc++lib=dynamic \
    --with-extra-cflags="${_CFLAGS}" \
    --with-extra-cxxflags="${_CXXFLAGS}" \
    --with-extra-ldflags="${_LDFLAGS}" \
    --with-libjpeg=system \
    --with-giflib=system \
    --with-libpng=system \
    --with-lcms=system \
    --with-zlib=system \
    --with-harfbuzz=system \
    --with-jvm-features="${jvm_features}" \
    --with-native-debug-symbols=internal \
    --enable-unlimited-crypto \
    --disable-warnings-as-errors \
    ${_ccache} \
    ${_cups} \
    PANDOC= DOT= \
    --with-vendor-name="Arch Linux"

  # trim: `docs` make target goes with the dropped openjdk-doc split; man
  # pages and full docs are trimmed below anyway, so the doc tool chain is
  # disabled at the seam — `PANDOC=`/`DOT=` empty tool overrides ("disabled
  # by user", util_paths.m4 UTIL_SETUP_TOOL) — and the pandoc/graphviz
  # makedeps are gone (run #93 wall: a host pandoc broken by the icu 78→79
  # soname move aborted `images` at BUILD_MAN_PAGES)
  make JOBS="${GSA_BUILD_JOBS:-$(nproc)}" images legacy-jre-image

  # https://bugs.openjdk.java.net/browse/JDK-8173610
  find "${srcdir}/${_imgdir}" -iname '*.so' -exec chmod +x {} \;
}

check() {
  cd ${_jdkdir}
  # TODO package jtreg
  # make -k check
}

package_jdk-openjdk() {
  pkgdesc="OpenJDK Java ${_majorver} development kit"
  depends=(
    "${_commondeps[@]}"
    'java-environment-common=3'
    ca-certificates-utils
    freetype2
    harfbuzz
    hicolor-icon-theme
    lcms2
    libelf
    libfreetype.so
    libgif.so
    libharfbuzz.so
    libjpeg.so
    libjpeg-turbo
    liblcms2.so
    libnet
    libpng
    nss
  )
  optdepends=(
    'java-rhino: for some JavaScript support'
    'alsa-lib: for basic sound support'
    'gtk3: for the Gtk+ 3 look and feel - desktop usage'
  )
  # stock's pinned virtual provides restored (2026-10-09 run #93 family):
  # java-environment/java-runtime/headless virtuals plus the jdkNN/jreNN
  # names; stock conflicts=() stays dropped.
  provides=(
    "java-environment=${_majorver}"
    "java-environment-openjdk=${_majorver}"
    "jdk${_majorver}-openjdk=${pkgver}-${pkgrel}"
    "java-runtime=${_majorver}"
    "java-runtime-openjdk=${_majorver}"
    "jre${_majorver}-openjdk=${pkgver}-${pkgrel}"
    "java-runtime-headless=${_majorver}"
    "java-runtime-headless-openjdk=${_majorver}"
    "jre${_majorver}-openjdk-headless=${pkgver}-${pkgrel}"
    libattach.so
    libsaproc.so
    libawt_headless.so
    libawt.so
    libdt_socket.so
    libextnet.so
    libfontmanager.so
    libinstrument.so
    libj2gss.so
    libj2pcsc.so
    libj2pkcs11.so
    libjavajpeg.so
    libjava.so
    libjdwp.so
    libjimage.so
    libjli.so
    libjsig.so
    libjsvml.so
    libjvm.so
    liblcms.so
    libmanagement_agent.so
    libmanagement_ext.so
    libmanagement.so
    libmlib_image.so
    libnet.so
    libnio.so
    libprefs.so
    librmi.so
    libsctp.so
    libsimdsort.so
    libsyslookup.so
    libverify.so
    libzip.so
    libawt_xawt.so
    libjawt.so
    libjsound.so
    libsplashscreen.so
  )
  backup=(
    etc/${pkgbase}/logging.properties
    etc/${pkgbase}/management/jmxremote.access
    etc/${pkgbase}/management/jmxremote.password.template
    etc/${pkgbase}/management/management.properties
    etc/${pkgbase}/net.properties
    etc/${pkgbase}/security/java.policy
    etc/${pkgbase}/security/java.security
    etc/${pkgbase}/security/policy/README.txt
    etc/${pkgbase}/security/policy/limited/default_US_export.policy
    etc/${pkgbase}/security/policy/limited/default_local.policy
    etc/${pkgbase}/security/policy/limited/exempt_local.policy
    etc/${pkgbase}/security/policy/unlimited/default_US_export.policy
    etc/${pkgbase}/security/policy/unlimited/default_local.policy
    etc/${pkgbase}/sound.properties
  )
  install=install_jdk-openjdk.sh

  cd ${_imgdir}/jdk

  install -dm 755 "${pkgdir}${_jvmdir}"

  # trim: demos — the stock `demo` tree is not shipped
  cp -a bin include jmods lib release\
    "${pkgdir}${_jvmdir}"

  rm "${pkgdir}${_jvmdir}/lib/src.zip"

    # Conf
  install -dm 755 "${pkgdir}/etc"
  cp -r conf "${pkgdir}/etc/${pkgbase}"
  ln -s /etc/${pkgbase} "${pkgdir}/${_jvmdir}/conf"

  # Legal
  install -dm 755 "${pkgdir}/usr/share/licenses"
  cp -r legal "${pkgdir}/usr/share/licenses/${pkgbase}"
  ln -s ${pkgbase} "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -s /usr/share/licenses/${pkgbase} "${pkgdir}/${_jvmdir}/legal"


  # trim: man pages (docs) — man1 installs and the jvmdir/man symlink trimmed
  # Link JKS keystore from ca-certificates-utils
  rm -f "${pkgdir}${_jvmdir}/lib/security/cacerts"
  ln -sf /etc/ssl/certs/java/cacerts "${pkgdir}${_jvmdir}/lib/security/cacerts"

  # Icons
  for s in 16 24 32 48; do
    install -Dm 644 \
      "${srcdir}/${_jdkdir}/src/java.desktop/unix/classes/sun/awt/X11/java-icon${s}.png" \
      "${pkgdir}/usr/share/icons/hicolor/${s}x${s}/apps/java${_majorver}-openjdk.png"
  done

  # Desktop files
  for f in jconsole java jshell; do
    install -Dm 644 \
      "${srcdir}/freedesktop-${f}.desktop" \
      "${pkgdir}/usr/share/applications/${f}-${pkgbase}.desktop"
  done
}

package_openjdk-src() {
  pkgdesc="OpenJDK Java ${_majorver} sources"
  # Depends on JDK to get license files
  depends=("jdk${_majorver}-openjdk=${pkgver}-${pkgrel}")
  # stock's rename-compat provide stays pinned at stock's value (rule 4: NAME
  # capabilities are version-pinned; bare-soname-only governs SONAME provides)
  provides=("openjdk${_majorver}-src=${pkgver}-${pkgrel}")

  install -Dm 644 -t "${pkgdir}${_jvmdir}/lib" ${_imgdir}/jdk/lib/src.zip

  install -dm 755 "${pkgdir}/usr/share/licenses"
  ln -s ${pkgbase} "${pkgdir}/usr/share/licenses/${pkgname}"
}

