pkgname=0ad
pkgver=0.28.0
pkgrel=3.1
pkgdesc="Cross-platform, 3D and historically-based real-time strategy game"
arch=('x86_64')
url="http://play0ad.com/"
license=('GPL-2.0-or-later')
depends=("0ad-data=$pkgver" 'binutils' 'boost-libs' 'curl' 'enet' 'libogg' 'libpng' 'libvorbis'
         'libxml2' 'openal' 'sdl2' 'wxwidgets-gtk3' 'zlib' 'libgl' 'glu' 'fmt'
         'gloox' 'miniupnpc' 'libminiupnpc.so' 'icu' 'nspr' 'libsodium' 'which')
makedepends=('boost' 'cmake' 'mesa' 'zip' 'libsm' 'rust' 'git' 'python' 'llvm' 'cbindgen'
             'premake')
options=('!lto') # breaks spidermonkey linking (https://bugs.gentoo.org/746947)
source=("https://releases.wildfiregames.com/$pkgname-$pkgver-unix-build.tar.xz"
        "FixRustTargetDetection.diff")
validpgpkeys=('A035C8C19219BA821ECEA86B64E628F8D684696D')  # Pablo Galindo Salgado <pablogsal@gmail.com>
sha512sums=('6b5d7893d27d5fa71ce4cad1b424a7d4b36e8bc438c590cbd86d9872148d5051cd3215f8f8f4b817e48d4fe386d8902ecc0dcd612ca779306ef35dfa2898a878'
            'dbd105f60233752cafe5b41c756208ebf8f13f0ad0618274e3511a33766ee30469952de9cc1920323dc82c762b236b764f1914842041f0b3c5eb273ec99892fe')

prepare() {
  cd "$pkgname-$pkgver"

  # rust-git's target list carries vendor-specific triples (x86_64-oe-linux-gnu,
  # x86_64-unikraft-linux-musl, ...) that collide with the generic targets on
  # the raw-OS narrowing inside mozjs-128's rust target detection, and the
  # host's config.guess vendor ("pc") disambiguates nothing — configure dies
  # with "Don't know how to translate x86_64-pc-linux-gnu for rustc" (run #136
  # wall). Wire the mozjs-side fix through 0ad's own patch mechanism:
  # patches/patch.sh is sourced inside the freshly unpacked mozjs on every
  # build.sh run.
  install -Dm644 "$srcdir/FixRustTargetDetection.diff" \
    libraries/source/spidermonkey/patches/FixRustTargetDetection.diff
  if ! grep -q FixRustTargetDetection libraries/source/spidermonkey/patches/patch.sh; then
    printf '\npatch -p1 <"${PATCHES}"/FixRustTargetDetection.diff\n' \
      >> libraries/source/spidermonkey/patches/patch.sh
  fi
}

build() {
  cd "$pkgname-$pkgver"

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # When buidling the included spidermonkey, we need to
  # a compile error: https://gitea.wildfiregames.com/0ad/0ad/issues/8571
  export CXXFLAGS="${CXXFLAGS/-fexceptions/}"

  cd libraries
  ./build-source-libs.sh \
    --with-system-premake

  cd ../build/workspaces
  ./update-workspaces.sh -j"${GSA_BUILD_JOBS:-$(nproc)}" \
    --with-system-premake5 \
    --with-lto \
    --without-pch \
    --bindir=/usr/bin \
    --libdir=/usr/lib/0ad \
    --datadir=/usr/share/0ad/data

  cd gcc
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd "$pkgname-$pkgver"
  provides+=(libAtlasUI.so
             libCollada.so
             libmozjs128-debug.so
             libmozjs128-release.so
             libnvcore.so
             libnvimage.so
             libnvmath.so
             libnvtt.so)

  install -d "${pkgdir}"/usr/{bin,lib/0ad,share/"${pkgname}"/data}
  install -Dm755 binaries/system/pyrogenesis "${pkgdir}/usr/bin"
  install -Dm755 binaries/system/*.so "${pkgdir}/usr/lib/0ad"

  cp -r binaries/data/l10n/ "${pkgdir}/usr/share/${pkgname}/data/"

  install -Dm755 build/resources/${pkgname}.sh "${pkgdir}/usr/bin/${pkgname}"
  install -Dm644 build/resources/${pkgname}.desktop "${pkgdir}/usr/share/applications/${pkgname}.desktop"
  install -Dm644 build/resources/${pkgname}.appdata.xml "${pkgdir}/usr/share/metainfo/${pkgname}.appdata.xml"
  install -Dm644 build/resources/${pkgname}.png "${pkgdir}/usr/share/pixmaps/${pkgname}.png"

  # license: 0.28 replaced the top-level LICENSE.txt with LICENSE.md (the
  # licensing-details index) plus per-license texts; ship both the index and
  # the operative GPL-2.0-or-later text
  install -Dm644 LICENSE.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.md"
  install -Dm644 license_gpl-2.0.txt "${pkgdir}/usr/share/licenses/${pkgname}/license_gpl-2.0.txt"
}
