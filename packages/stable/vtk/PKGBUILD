  vtkRenderingLookingGlass::git+https://github.com/Kitware/LookingGlassVTKModule.git#commit=$_vtk_module_RenderingLookingGlass_commit
  vtkDICOM::git+https://github.com/dgobbi/vtk-dicom.git#commit=$_vtk_module_DICOM_commit
  fmt-12.2.patch
  anari-1.1-light-extensions.patch
  anari-pre-1.1-sdk-detection.patch
  openvdb-13.patch
  ffmpeg-git-version.patch
  token-string-include.patch
  ioss-fstream-include.patch
)
