prepare() {
  # Self-heal: makepkg's extraction restores the tarball's files but leaves
  # behind files a previous build's patches CREATED (measured 2026-10-22:
  # `Documentation/release/dev/anari-light-extensions.md` from the 03:14
  # build walled the 07:48 rebuild with "would create … which already
  # exists"). Patches must always meet a PRISTINE tree (--fuzz=0), so wipe
  # the source root and re-extract before anything else runs.
  rm -rf "${pkgname^^}-${pkgver}"
  bsdtar -xf "$srcdir/VTK-${pkgver}.tar.gz" -C "$srcdir"
  cd ${pkgname^^}-${pkgver}
  # Point VTK's remote modules at the prefetched clones.
  # NOTE: the directory names must match the first argument of each
  # vtk_fetch_module() call in Remote/*.remote.cmake
  ln -snfv "$srcdir"/vtkMomentInvariants Remote/MomentInvariants
  ln -snfv "$srcdir"/vtkRenderingLookingGlass Remote/RenderingLookingGlass
  ln -snfv "$srcdir"/vtkDICOM Remote/DICOM

  _fast_float_version=$(pacman -Q fast_float | sed -e 's/.* //; s/-.*//g')
  sed -i "s|7.0.0|${_fast_float_version}|" ThirdParty/fast_float/CMakeLists.txt
  # Use cmake's FindHDF5
  rm CMake/patches/99/FindHDF5.cmake
  sed -e '/FindHDF5/d' -i CMake/vtkInstallCMakePackage.cmake

  # Fix build with fmt 12.2.0 https://gitlab.kitware.com/vtk/vtk/-/work_items/20092
  patch -p1 -i ../fmt-12.2.patch

  # Backport ANARI 1.1 (SDK 0.16) support: KHR_AREA_LIGHTS was removed from the
  # specification https://gitlab.kitware.com/vtk/vtk/-/commit/c02fc7daf3790e48c07628c5096867b1eb272d77
  patch -p1 -i ../anari-1.1-light-extensions.patch
  # Support ANARI SDKs that predate KHR_LIGHT_PRIMARY_VISIBILITY as well
  # https://gitlab.kitware.com/vtk/vtk/-/commit/7b88eefcbfa22442052d2c8a1790b5000cbce975
  patch -p1 -i ../anari-pre-1.1-sdk-detection.patch

  # Fix vtkNanoVDBWriter with OpenVDB 12+: nanovdb::tools::build namespace
  # https://gitlab.kitware.com/vtk/vtk/-/issues/20171
  patch -p1 -i ../openvdb-13.patch

  # FindFFMPEG aggregates its version from ffversion.h, where a git build
  # stamps 'N-<rev>-g<sha>' — IO/FFMPEG's 2.3.3 floor then rejects our
  # far-newer ffmpeg-git (measured 2026-10-21, configure wall). The probe
  # falls back to a fresh numeric parse of libavformat's version headers.
  patch -p1 -i ../ffmpeg-git-version.patch

  # token/Manager.h uses std::string without including <string> (upstream
  # master still relies on transitive includes); gcc-snapshot's libstdc++
  # no longer pulls it in — 56-error cascade, measured 2026-10-21.
  patch -p1 -i ../token-string-include.patch

  # same class one subsystem over: vtkioss catalyst's logging header uses
  # std::fstream without <fstream> (the compiler names the missing include)
  patch -p1 -i ../ioss-fstream-include.patch
}

# Synthetic PGO training workload. Stock's ctest suite is not self-contained:
# nearly every VTK test resolves its fixtures through ExternalData
# (VTK_DATA_ROOT) downloads, and enabling VTK_BUILD_TESTING would pull them —
# forbidden for training here. VTK_BUILD_TESTING therefore stays at its OFF
# default and this driver carries the workload: a spread of surface/volume
# filters, geometry, IO round-trips and a best-effort offscreen render, each
# step isolated so one failing filter does not starve the rest of the profile.
_train_pgo() {
  cat > "${srcdir}"/pgo_train.py <<'EOF'
import os
import random
import sys

try:
    import vtk
except ImportError:
    import vtkmodules.all as vtk

SCRATCH = 'pgo-train-scratch'


def step(name, fn):
    try:
        fn()
    except Exception as exc:
        print('train: %s skipped: %s' % (name, exc), file=sys.stderr)


def surfacing():
    src = vtk.vtkSphereSource()
    src.SetRadius(1.0)
    src.SetThetaResolution(48)
    src.SetPhiResolution(48)
    elev = vtk.vtkElevationFilter()
    elev.SetInputConnection(src.GetOutputPort())
    contour = vtk.vtkContourFilter()
    contour.SetInputConnection(elev.GetOutputPort())
    contour.GenerateValues(12, 0.0, 1.0)
    normals = vtk.vtkPolyDataNormals()
    normals.SetInputConnection(contour.GetOutputPort())
    glyphs = vtk.vtkGlyph3D()
    glyphs.SetInputConnection(normals.GetOutputPort())
    cone = vtk.vtkConeSource()
    glyphs.SetSourceConnection(cone.GetOutputPort())
    tri = vtk.vtkTriangleFilter()
    tri.SetInputConnection(glyphs.GetOutputPort())
    clean = vtk.vtkCleanPolyData()
    clean.SetInputConnection(tri.GetOutputPort())
    clean.Update()
    print('surfacing cells:', clean.GetOutput().GetNumberOfCells())


def volume():
    src = vtk.vtkRTAnalyticSource()
    src.SetWholeExtent(0, 63, 0, 63, 0, 63)
    smooth = vtk.vtkImageGaussianSmooth()
    smooth.SetInputConnection(src.GetOutputPort())
    iso = vtk.vtkFlyingEdges3D()
    iso.SetInputConnection(smooth.GetOutputPort())
    iso.SetValue(0, 200.0)
    sinc = vtk.vtkWindowedSincPolyDataFilter()
    sinc.SetInputConnection(iso.GetOutputPort())
    sinc.SetNumberOfIterations(8)
    mass = vtk.vtkMassProperties()
    mass.SetInputConnection(sinc.GetOutputPort())
    mass.Update()
    print('volume area:', mass.GetSurfaceArea())


def geometry():
    rnd = random.Random(42)
    pts = vtk.vtkPoints()
    for _ in range(200):
        pts.InsertNextPoint(rnd.uniform(0, 1), rnd.uniform(0, 1), rnd.uniform(0, 1))
    cloud = vtk.vtkPolyData()
    cloud.SetPoints(pts)
    delau = vtk.vtkDelaunay3D()
    delau.SetInputData(cloud)
    edges = vtk.vtkExtractEdges()
    edges.SetInputConnection(delau.GetOutputPort())
    tube = vtk.vtkTubeFilter()
    tube.SetInputConnection(edges.GetOutputPort())
    tube.Update()
    print('geometry cells:', tube.GetOutput().GetNumberOfCells())


def io_roundtrip():
    src = vtk.vtkConeSource()
    src.Update()
    path = os.path.join(SCRATCH, 'train.vtp')
    writer = vtk.vtkXMLPolyDataWriter()
    writer.SetFileName(path)
    writer.SetInputData(src.GetOutput())
    writer.Write()
    reader = vtk.vtkXMLPolyDataReader()
    reader.SetFileName(path)
    reader.Update()
    print('io cells:', reader.GetOutput().GetNumberOfCells())


def tabular():
    path = os.path.join(SCRATCH, 'train.csv')
    with open(path, 'w') as fh:
        fh.write('x,y,z,value\n')
        for i in range(64):
            fh.write('%f,%f,%f,%f\n' % (i * 0.1, (i * 0.2) % 3.0, i * 0.05, i * i * 0.01))
    reader = vtk.vtkDelimitedTextReader()
    reader.SetFileName(path)
    reader.DetectNumericColumnsOn()
    reader.Update()
    table = vtk.vtkTableToPolyData()
    table.SetInputConnection(reader.GetOutputPort())
    table.SetXColumn('x')
    table.SetYColumn('y')
    table.SetZColumn('z')
    table.Update()
    print('table points:', table.GetOutput().GetNumberOfPoints())


def render():
    # Best-effort offscreen render: the stock GLX build may lack OSMesa/EGL
    # offscreen support, so failure here is tolerated — the filter pipelines
    # above already carry the training weight.
    cone = vtk.vtkConeSource()
    mapper = vtk.vtkPolyDataMapper()
    mapper.SetInputConnection(cone.GetOutputPort())
    actor = vtk.vtkActor()
    actor.SetMapper(mapper)
    ren = vtk.vtkRenderer()
    ren.AddActor(actor)
    ren_win = vtk.vtkRenderWindow()
    ren_win.SetOffScreenRendering(1)
    ren_win.SetSize(128, 128)
    ren_win.AddRenderer(ren)
    ren_win.Render()
    ren_win.Finalize()


os.makedirs(SCRATCH, exist_ok=True)
step('surfacing', surfacing)
step('volume', volume)
step('geometry', geometry)
step('io_roundtrip', io_roundtrip)
step('tabular', tabular)
step('render', render)
sys.stdout.flush()
EOF

  # The trainer must import the instrumented build tree, never an installed
  # stock vtk (qt6-multimedia 2026-10-11: a trainer linking the stale stock
  # lib trains the wrong binary); the gcda floor below catches an import
  # that still went wrong.
  local _py_path="${srcdir}/build/lib"
  local _vtkmods
  _vtkmods="$(find "${srcdir}/build" -maxdepth 6 -type d -name vtkmodules 2>/dev/null | head -n1)"
  [ -n "${_vtkmods}" ] && _py_path="${_vtkmods%/vtkmodules}:${_py_path}"

  # SIGINT (not TERM!) so python unwinds and the gcov destructors flush the
  # .gcda files (qt6-declarative's measured lesson); a failing trainer is
  # tolerated — the floor guard turns a thin profile into a plain build.
  env PYTHONPATH="${_py_path}" LD_LIBRARY_PATH="${srcdir}/build/lib" \
    timeout -s INT -k 5 120 python "${srcdir}"/pgo_train.py >/dev/null 2>&1 || true

  rm -rf "${srcdir}"/pgo-train-scratch "${srcdir}"/pgo_train.py
}

build() {
  # To help cmake find java
  export JAVA_HOME=/usr/lib/jvm/default
  # To set tcl lib path
  local _tkver=$(echo 'puts $tcl_version' | tclsh)

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # Phase 1: instrumented build. LTO is stripped for the generate phase
  # (instrumented LTO is fragile — qt6-declarative's measured choice) and
  # comes back for phase 2 / the fallback as the first -flto* token makepkg's
  # LTOFLAGS left in the environment; the recipe never spells LTO flags
  # itself — host makepkg.conf owns the policy. The profile dir lives OUTSIDE
  # the build dir so a build-dir clean can never eat the profile (mesa
  # precedent).
  local _pgo_dir="${srcdir}/vtk-pgo-profile"
  mkdir -p "${_pgo_dir}"
  local _lto_flag="" _gen_cflags="" _gen_cxxflags="" _gen_ldflags="" _f
  for _f in ${CFLAGS}; do
    case $_f in
      -flto*) [ -n "${_lto_flag}" ] || _lto_flag="${_f}" ;;
      *) _gen_cflags+=" ${_f}" ;;
    esac
  done
  for _f in ${CXXFLAGS}; do
    case $_f in
      -flto*) [ -n "${_lto_flag}" ] || _lto_flag="${_f}" ;;
      *) _gen_cxxflags+=" ${_f}" ;;
    esac
  done
  for _f in ${LDFLAGS}; do
    case $_f in
      -flto*) [ -n "${_lto_flag}" ] || _lto_flag="${_f}" ;;
      *) _gen_ldflags+=" ${_f}" ;;
    esac
  done
  CFLAGS="${_gen_cflags# } -fprofile-generate=${_pgo_dir} -fprofile-update=atomic"
  CXXFLAGS="${_gen_cxxflags# } -fprofile-generate=${_pgo_dir} -fprofile-update=atomic"
  LDFLAGS="${_gen_ldflags# } -fprofile-generate=${_pgo_dir}"
  export CFLAGS CXXFLAGS LDFLAGS

  local cmake_options=(
    -B build
    -S ${pkgname^^}-${pkgver}
    -G Ninja
    -Wno-dev
    -DCMAKE_BUILD_TYPE=Release
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
    -DCMAKE_INSTALL_PREFIX=/usr
    -DCMAKE_INSTALL_LICENSEDIR=share/licenses/vtk
    -DCMAKE_SKIP_RPATH=OFF
    -DCMAKE_SKIP_INSTALL_RPATH=ON
    -DBUILD_SHARED_LIBS=ON
    -DVTK_BUILD_ALL_MODULES=ON
    -DVTK_ENABLE_CATALYST=ON
    -DVTK_INSTALL_TCL_DIR=/usr/lib/tcl${_tkver}/vtk/
    -DVTK_LEGACY_REMOVE=ON
    -DVTK_SMP_ENABLE_OPENMP=ON
    -DVTK_SMP_IMPLEMENTATION_TYPE=TBB
    -DVTK_PYTHON_VERSION=3
    -DVTK_QT_VERSION=6
    -DVTK_USE_MPI=ON
    -DVTK_USE_TK=ON
    -DVTK_VERSIONED_INSTALL=OFF
    -DVTK_WRAP_JAVA=ON
    -DVTK_WRAP_PYTHON=ON
    -DVTK_ENABLE_OSPRAY=ON
    -DVTKOSPRAY_ENABLE_DENOISER=ON
    -DVTK_USE_EXTERNAL=ON
    #-DFIDES_USE_EXTERNAL_RAPIDJSON=ON
    -DVTK_MODULE_USE_EXTERNAL_VTK_exprtk=OFF
    -DVTK_MODULE_USE_EXTERNAL_VTK_fides=OFF
    -DVTK_MODULE_USE_EXTERNAL_VTK_ioss=OFF
    -DVTK_MODULE_USE_EXTERNAL_VTK_pegtl=OFF
    -DVTK_MODULE_USE_EXTERNAL_VTK_scn=OFF
    -DVTK_MODULE_USE_EXTERNAL_VTK_token=OFF
    -DVTK_MODULE_ENABLE_VTK_DomainsMicroscopy=NO
    -DVTK_MODULE_ENABLE_VTK_FiltersOpenTURNS=NO
    -DVTK_MODULE_ENABLE_VTK_IOCatalystConduit=YES
    # requires IfcOpenShell which is not packaged
    -DVTK_MODULE_ENABLE_VTK_IOIFC=NO
    # remote modules prefetched in prepare()
    -DVTK_MODULE_ENABLE_VTK_MomentInvariants=YES
    -DVTK_MODULE_ENABLE_VTK_DICOM=YES
    # requires the HoloPlay SDK which is not packaged
    -DVTK_MODULE_ENABLE_VTK_RenderingLookingGlass=NO
    # building with the usd package does not work: https://gitlab.archlinux.org/archlinux/packaging/packages/usd/-/issues/7
    -DVTK_MODULE_ENABLE_VTK_IOUSD=NO
    -DHDF5_NO_FIND_PACKAGE_CONFIG_FILE=ON
    -DHDF5_C_COMPILER_EXECUTABLE=h5hlcc
    -DHDF5_CXX_COMPILER_EXECUTABLE=h5hlc++
  )
  cmake "${cmake_options[@]}"
  cmake --build build

  # Training workload
  _train_pgo

  # Floor guard: pgo_min_gcda ≈ the minimum distinct translation units the
  # training must touch before a profile is worth trusting; below it the
  # profile is too thin and the recipe falls back to a plain (LTO-only)
  # build rather than shipping a thin-profile binary. 100 here: a healthy
  # run loads the whole wrapped module set (its gcda count lands in the
  # thousands), so anything under 100 means the import or the workload
  # collapsed, not merely a thin profile.
  local pgo_min_gcda=100
  local _gcda_count
  _gcda_count="$(find "${_pgo_dir}" -name '*.gcda' 2>/dev/null | wc -l)"
  if (( _gcda_count < pgo_min_gcda )); then
    warning "PGO produced only %d gcda files — rebuilding plain (LTO only)" "$_gcda_count"
    # The fallback must REBUILD: the phase-1 build dir still carries
    # -fprofile-generate objects and a warn-only fallback shipped them
    # (2026-10-11 qt6-multimedia). Same cache rewrite as phase 2, minus the
    # profile: instrumentation out, the host's LTO token back in.
    sed -i "s|-fprofile-generate=${_pgo_dir}|${_lto_flag}|g" build/CMakeCache.txt
    sed -i 's| -fprofile-update=atomic||g' build/CMakeCache.txt
    if grep -q -- '-fprofile-generate' build/CMakeCache.txt; then
      error "fallback rewrite left -fprofile-generate in CMakeCache.txt"
      return 1
    fi
    touch ${pkgname^^}-${pkgver}/CMakeLists.txt
    # Discard the phase-1 objects only: a full `--target clean` also wipes the
    # generated Java wrapper sources and the vtkjava sample javac then races
    # their regeneration ('cannot find symbol: vtkNativeLibrary', measured
    # 2026-10-22 in phase 2). Every link still reruns from the fresh objects —
    # the requirement the clean exists for (docs/build-guide.md).
    find build -name '*.o' -delete
    cmake --build build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    # Phase 2: profile-use. The generate->use rewrite has to reach *inside
    # CMakeCache.txt*: CMake only reads CFLAGS/CXXFLAGS/LDFLAGS while it
    # *initialises* the cache, so an env change here — even followed by a
    # re-run of the configure step — is ignored and the payload would stay a
    # generate-phase build (the 2026-09-20 cmake-git failure). Deleting the
    # cache is the trap that looks like the local fix: it drops every other
    # decision phase 1 made (install prefix, dependency selection, the mold
    # link flags). -Wno-error=missing-profile keeps a TU the training never
    # ran a warning instead of a hard error; -Wno-error=coverage-mismatch
    # downgrades the arc-count mismatch -fprofile-use otherwise errors on —
    # those functions compile without profile data, the rest keep it (jq's
    # load-bearing pair).
    sed -i "s|-fprofile-generate=${_pgo_dir}|-fprofile-use=${_pgo_dir} ${_lto_flag} -Wno-error=missing-profile -Wno-error=coverage-mismatch|g" build/CMakeCache.txt
    sed -i 's| -fprofile-update=atomic||g' build/CMakeCache.txt
    if grep -q -- '-fprofile-generate' build/CMakeCache.txt; then
      error "phase-2 rewrite left -fprofile-generate in CMakeCache.txt"
      return 1
    fi
    # The generated build files only reconfigure when a tracked input is
    # newer, so force that check; the clean is still required because
    # regenerated rules do not invalidate the phase-1 objects.
    touch ${pkgname^^}-${pkgver}/CMakeLists.txt
    # object-wipe instead of a full clean — see the fallback branch above
    find build -name '*.o' -delete
    cmake --build build
  fi

  rm -rf "${_pgo_dir}"
}

package() {
  DESTDIR="${pkgdir}" cmake --install build

  # Move the vtk.jar to the arch-specific location…
  install -dv "${pkgdir}"/usr/share/java/vtk
  mv -v "${pkgdir}"/usr/lib/java/vtk.jar "${pkgdir}"/usr/share/java/vtk
  # …and the libs to the proper place
  mv "${pkgdir}"/usr/lib/java/vtk-Linux-${CARCH}/*.so "${pkgdir}"/usr/lib/
  rmdir "${pkgdir}"/usr/lib/java/{vtk-Linux-${CARCH}/,}

  # byte-compile python modules since the CMake build does not do it
  local site_packages=$(python -c "import site; print(site.getsitepackages()[0])")
  python -m compileall -o 0 -o 1 -o 2 --hardlink-dupes -s "${pkgdir}" "${pkgdir}"${site_packages}

  # trim: third party CMake patching for older versions than ours — dead
  # packaging input (stock's removal, kept)
  rm -rv "${pkgdir}"/usr/lib/cmake/vtk/patches/3.*

  # trim: docs/man/locales — mirror opencv's lean-recipe choice; nothing in
  # the maintained payload reads them and no makedepend feeds them
  rm -rf "${pkgdir}"/usr/share/doc "${pkgdir}"/usr/share/man "${pkgdir}"/usr/share/locale

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may
  # be added to $pkgdir after the payload is verified.
  verify_no_profile_instrumentation "${pkgdir}"
}
