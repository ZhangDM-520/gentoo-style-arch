# Reshape of the official Arch VTK recipe for this tree. The core libs here
# come from -git recipes: this build must link the tree's jsoncpp-git
# (provides jsoncpp + libjsoncpp.so → libjsoncpp.so.28). Stock/CachyOS vtk
# links libjsoncpp.so.27 and is broken on this host, so a stock jsoncpp must
# never be able to satisfy the jsoncpp dependency below.

# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package(). A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgname=vtk
# May need bootstrapping on upgrades due to circular vtk <-> opencascade dependency
pkgver=9.7.1
# 1.2: the broken CachyOS build on this host is already stamped 9.7.1-1.1 —
# the same-version skip would silently leave it in place (pandoc-cli
# precedent); 1.2 also marks this as the second local delta over stock
pkgrel=1.2
# Remote modules pinned by VTK's Remote/*.remote.cmake files
# See https://gitlab.kitware.com/vtk/vtk/-/tree/master/Remote
_vtk_module_MomentInvariants_commit=ccb44911b7e1ccf99a36fe4ca6b7755ac4c87743
_vtk_module_RenderingLookingGlass_commit=56105797c066dfd54a5bad08e1aee223297470d9
_vtk_module_DICOM_commit=2160aadbd7bd89430370848dca42142769aeb04c
pkgdesc="Software system for 3D computer graphics, image processing, and visualization"
arch=(x86_64)
url="https://www.vtk.org"
license=(BSD-3-Clause)
# Rule 25(a) bare-soname provides — one per DT_SONAME the payload ships
# (measured from the 9.7.1 payload; makepkg auto-versions the stems from
# the built ELF). tools/provides-audit.sh checks PRESENCE against the
# built archive after any module-set change.
