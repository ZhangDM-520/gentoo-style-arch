# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Fina Wilke <fina@felinira.net>

pkgbase=libcloudproviders
pkgname=(
  libcloudproviders
)
pkgver=0.4.1
pkgrel=1
pkgdesc="DBus API that allows cloud storage sync clients to expose their services"
url="https://gitlab.gnome.org/GNOME/libcloudproviders"
arch=(x86_64)
license=(LGPL-3.0-or-later)
depends=(
  libgcc
  glib2
  glibc
)
makedepends=(
  # trim: gi-docgen dropped with the -docs split (documentation disabled)
  git
  glib2-devel
  gobject-introspection
  meson
  vala
)
source=("git+$url.git?signed#tag=$pkgver")
b2sums=('720a21e38d745b84164859977952369e5986cb96221f791caaadd0399ce17cf012ba20ccbd878586059383970ce00800818310f9e72c935b865bf5e4f1c244d8')
validpgpkeys=(
  AD1483F8A95118F7F0C8AF4A965D4777208E7691 # Corentin Noël <corentin.noel@collabora.com>
)

prepare() {
  cd $pkgname
}

build() {
  local meson_options=(
    # trim: API docs disabled (the -docs split is dropped in this recipe)
    -D documentation=false
  )

  arch-meson $pkgname build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_libcloudproviders() {
  provides=(libcloudproviders.so)

  meson install -C build --destdir "$pkgdir"

  # trim: drop the gi-docgen API docs (the -docs split is dropped in this recipe)
  rm -rf "$pkgdir/usr/share/doc"

  # license: ship upstream licence text (LGPL-3.0-or-later)
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/" 2>/dev/null || true
}

# vim:set sw=2 sts=-1 et:
