# Merged recipe: this is the single pkgbase for the transmission release
# tarball, so it is downloaded, configured and built exactly once. It replaces
# the former per-output recipes
# packages/stable/{transmission-cli,transmission-gtk}.
# trim: the transmission-qt split output is dropped together with its
# split-install path, the qt6-base/qt6-svg/qt6-tools makedeps with ENABLE_QT,
# and the po (gettext locales) component with its intltool makedep

pkgbase=transmission
pkgname=(transmission-cli
         transmission-gtk)
pkgdesc='Fast, easy, and free BitTorrent client'
pkgver=4.1.3
pkgrel=2
arch=(x86_64)
url="http://www.transmissionbt.com/"
license=(GPL-2.0-or-later)
makedepends=(cmake
             dht
             glibmm-2.68
             gtk4
             gtkmm-4.0
             ninja
             npm)
_archive="transmission-$pkgver"
source=("https://github.com/transmission/transmission/releases/download/$pkgver/$_archive.tar.xz"
        transmission-cli.sysusers
        transmission-cli.tmpfiles)
sha256sums=('ce7d2d8b101f7eb54bc3cf0bc55f52f7ebd4a25fa48e00bdca9a7e0fc02617da'
            '641310fb0590d40e00bea1b5b9c843953ab78edf019109f276be9c6a7bdaf5b2'
            '1266032bb07e47d6bcdc7dabd74df2557cc466c33bf983a5881316a4cc098451')

build() {
	export CFLAGS+=' -ffat-lto-objects'

	# House style: mold linker when available (cmake consumes the LDFLAGS env)
	local _mold=""
	command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
	export LDFLAGS+=" ${_mold}"

	cd "$_archive"
	local cmake_flags=(
		CMAKE_BUILD_TYPE=RelWithDebInfo
		CMAKE_INSTALL_PREFIX=/usr
		ENABLE_CLI=ON
		ENABLE_DAEMON=ON
		ENABLE_GTK=ON
		ENABLE_MAC=OFF
		ENABLE_QT=OFF
		ENABLE_TESTS=ON
		ENABLE_UTILS=ON
		ENABLE_UTP=ON
		INSTALL_LIB=ON
		REBUILD_WEB=ON
		RUN_CLANG_TIDY=OFF
		USE_SYSTEM_B64=ON
		USE_SYSTEM_DEFLATE=ON
		USE_SYSTEM_DHT=ON
		USE_SYSTEM_EVENT2=ON
		USE_SYSTEM_MINIUPNPC=ON
		USE_SYSTEM_NATPMP=ON
		USE_SYSTEM_PSL=ON
		USE_SYSTEM_UTP=OFF
		WITH_CRYPTO=openssl
	)
	cmake -G Ninja -S . -B build ${cmake_flags[@]/#/-D }
	cmake --build build --config Release --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
	cd "$_archive"
	cd build
	# Exclude test that fails on the build server
	ctest --output-on-failure -j "${GSA_BUILD_JOBS:-$(nproc)}" -E LT.DhtTest.usesBootstrapFile
}

_install_component() {
	(cd $srcdir/transmission-$pkgver/build; DESTDIR="$pkgdir" ninja $1/install)
}

package_transmission-cli() {
	pkgdesc+=' (CLI tools, daemon and web client)'
	depends=(curl
	         libb64
	         libdeflate
	         libevent
	         libnatpmp
	         miniupnpc
	         systemd)
	cd "$_archive"
	for dir in daemon cli web utils; do
		_install_component $dir
	done
	install -d "$pkgdir"/usr/share/transmission
	cp -a build/web/public_html/ "$pkgdir"/usr/share/transmission

	# trim: man pages (Class B trim standard docs payload)
	rm -rf "$pkgdir"/usr/share/man

	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" COPYING
	install -Dm0644 "$srcdir/$pkgname.sysusers" "$pkgdir/usr/lib/sysusers.d/transmission.conf"
	install -Dm0644 "$srcdir/$pkgname.tmpfiles" "$pkgdir/usr/lib/tmpfiles.d/transmission.conf"
}

package_transmission-gtk() {
	pkgdesc+=' (GTK+ GUI)'
	depends=(curl
	         libb64
	         libdeflate
	         libevent
	         libnatpmp
	         miniupnpc
	         gtk4
	         gtkmm-4.0
	         hicolor-icon-theme)
	optdepends=('libnotify: Desktop notification support'
	            'transmission-cli: daemon and web support')
	cd "$_archive"
	_install_component gtk

	# trim: man pages (Class B trim standard docs payload)
	rm -rf "$pkgdir"/usr/share/man

	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" COPYING
}
