# Maintainer: Tobias Powalowski <tpowa@archlinux.org>
# Contributor: Thomas Bächler <thomas@archlinux.org>

pkgbase=linux-firmware
pkgname=(
  linux-firmware
  linux-firmware-whence
  linux-firmware-other

  # Splits — trimmed to the AMD laptop target (Strix Halo:
  # Radeon 880M/890M, MediaTek MT7925 wifi/BT, AMD ACP/USB4,
  # Cirrus CS35L41 speaker amps)
  amd-ucode
  linux-firmware-amd
  linux-firmware-amdgpu
  linux-firmware-mediatek
  linux-firmware-cirrus
)
pkgver=20260916
pkgrel=1
epoch=1
pkgdesc="Firmware files for Linux"
url="https://gitlab.com/kernel-firmware/linux-firmware"
license=(LicenseRef-WHENCE)
arch=(any)
makedepends=(
  git
  parallel
  python
  rdfind
)
options=(
  !debug
  !strip
)
source=("git+$url.git?signed#tag=${pkgver}")
b2sums=('6cab8bee911441b26075d459b5d98152cf7cb3aa0eecd872f5856d7228077ab6a52d0c5f24c011c6fedfd19978b5b73e19239c21db071cf58da7c53564ad8aae')
validpgpkeys=(
  4CDE8575E547BF835FE15807A31B6BD72486CFD6 # Josh Boyer <jwboyer@fedoraproject.org>
)

_backports=(
  # amdgpu crashes
  # https://gitlab.archlinux.org/archlinux/packaging/packages/linux-firmware/-/work_items/50
  9305ccd3e07e6c5c2a34f84fb4a056fc47840ad3
)

_reverts=(
)

prepare() {
  cd ${pkgbase}

  local c
  for c in "${_backports[@]}"; do
    echo Backporting $(git log --oneline -1 "${c}")
    git cherry-pick -n "${c}"
  done
  for c in "${_reverts[@]}"; do
    echo Reverting $(git log --oneline -1 "${c}")
    git revert -n "${c}"
  done

  # amdgpu decoding glitches
  # https://gitlab.archlinux.org/archlinux/packaging/packages/linux-firmware/-/work_items/49
  local -a current_vcn old_vcn
  mapfile -t current_vcn < <(git ls-files 'amdgpu/*vcn*')
  mapfile -t old_vcn < <(git ls-tree -r --name-only 20260622 -- amdgpu | grep '/[^/]*vcn[^/]*\.bin$')
  if (( ${#current_vcn[@]} )); then
    git rm -f -- "${current_vcn[@]}"
  fi
  if (( ${#old_vcn[@]} )); then
    git checkout 20260622 -- "${old_vcn[@]}"
  fi
  for c in "${current_vcn[@]}"; do
    if ! printf '%s\n' "${old_vcn[@]}" | grep -Fqx "$c"; then
      sed -i "\|^File: ${c}$|d" WHENCE
    fi
  done
  git add WHENCE
  git diff --staged --stat
}

build() {
  mkdir -p kernel/x86/microcode
  cat ${pkgbase}/amd-ucode/microcode_amd*.bin > kernel/x86/microcode/AuthenticAMD.bin

  # Reproducibility: set the timestamp on the bin file
  if [[ -n ${SOURCE_DATE_EPOCH} ]]; then
    touch -d @${SOURCE_DATE_EPOCH} kernel/x86/microcode/AuthenticAMD.bin
  fi

  # Reproducibility: strip the inode and device numbers from the cpio archive
  echo kernel/x86/microcode/AuthenticAMD.bin |
    bsdtar --uid 0 --gid 0 -cnf - -T - |
    bsdtar --null -cf - --format=newc @- > amd-ucode.img
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#${pkgdir}/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

_licdir=${pkgbase}/LICENSES

package_linux-firmware() {
  pkgdesc+=" - Default set (trimmed to AMD Strix Halo hardware)"
  license=(CC0-1.0)
  depends=(
    amd-ucode
    linux-firmware-amd
    linux-firmware-amdgpu
    linux-firmware-mediatek
    linux-firmware-cirrus
    linux-firmware-other
  )
}

package_linux-firmware-whence() {
  pkgdesc+=" - WHENCE file (vendor licenses)"

  install -Dm644 ${pkgbase}/WHENCE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_linux-firmware-other() {
  pkgdesc+=" - Unsorted firmware for various devices"

  local fwdir="${pkgdir}/usr/lib/firmware"
  ZSTD_CLEVEL=19 make -C ${pkgbase} FIRMWAREDIR="${fwdir}" install-zst

  # split
  _pick amd-ucode "${fwdir}"/amd-ucode

  _pick amdgpu "${fwdir}"/amdgpu

  _pick mediatek "${fwdir}"/{mediatek,mt7*,rt[237]*}

  # Cirrus Logic: CS35L41 smart-amp speaker firmware + cs42l43 codec
  # (needed by the target's audio chain)
  _pick cirrus "${fwdir}"/cirrus "${fwdir}"/cs42l43*

  # AMD platform firmware (SEV, XDNA NPU, TEE) — target content, but it must
  # live under the upstream split name so it upgrades the repo's
  # linux-firmware-amd in place instead of colliding with its files.
  _pick amd "${fwdir}"/{amd,amdnpu,amdtee}

  # hardware trim (Strix Halo): drop firmware for vendors outside the target
  rm -rf "${fwdir}"/{ar[0-9]*,ath*,carl9170*,htc_*,qca,wil6210*}                    # Qualcomm Atheros
  rm -rf "${fwdir}"/{bnx2*,brcm,cypress,tigon}                                     # Broadcom/Cypress
  rm -rf "${fwdir}"/{e100,hfi1_*,i915,intel,isci,iwlwifi*,ixp4xx,qat_*,xe}          # Intel
  rm -rf "${fwdir}"/liquidio "${fwdir}"/{libertas,mwl8k,mwlwifi,mrvl}               # Cavium/Marvell
  rm -rf "${fwdir}"/mellanox "${fwdir}"/netronome "${fwdir}"/nvidia
  rm -rf "${fwdir}"/{qcom,a300_*} "${fwdir}"/{qlogic,qed,ql2???_*,c{b,t,t2}fw-*}    # Qualcomm SoC/QLogic
  rm -rf "${fwdir}"/radeon                                                         # pre-amdgpu Radeon
  rm -rf "${fwdir}"/{realtek,rtlwifi,rtw8*,rtl_*}                                  # Realtek
  rm -rf "${fwdir}"/{ti,ti-connectivity,ti_*.fw*}                                  # TI audio amps + WLAN
  rm -rf "${fwdir}"/{dell,HP,LENOVO}                                               # OEM-wrapped Intel ISH
  # WHENCE 'Link:' aliases for the trimmed TI tree land at the top level;
  # sweep exactly those broken aliases (targets under ti/), nothing else.
  find "${fwdir}" -maxdepth 1 -xtype l -lname 'ti/*' -delete

  # dedup after splitting
  make -C ${pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 ${_licdir}/LICEN[CS]E* \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_amd-ucode() {
  pkgdesc="Microcode update image for AMD CPUs"
  license=(LicenseRef-amd-ucode)

  mv -v ${pkgname}/* "${pkgdir}"
  make -C ${pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 amd-ucode.img -t "${pkgdir}/boot"
  install -Dm644 ${_licdir}/LICENSE.amd-ucode \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_linux-firmware-amd() {
  pkgdesc+=" - Firmware for non-GPU AMD devices (SEV, XDNA NPU, TEE)"
  license+=(
    LicenseRef-amd-sev
    LicenseRef-amd_pmf
    LicenseRef-amdnpu
  )
  depends=(linux-firmware-whence)

  mv -v ${pkgname#linux-firmware-}/* "${pkgdir}"
  make -C ${pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 ${_licdir}/LICENSE.{amd-sev,amd_pmf,amdnpu} \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_linux-firmware-amdgpu() {
  pkgdesc+=" - Firmware for AMD Radeon GPUs"
  license+=(
    LicenseRef-amdgpu
    MIT
  )
  depends=(linux-firmware-whence)

  mv -v ${pkgname#linux-firmware-}/* "${pkgdir}"
  make -C ${pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 ${_licdir}/LICENSE.amd{gpu,isp} \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_linux-firmware-mediatek() {
  pkgdesc+=" - Firmware for MediaTek and Ralink devices"
  license+=(LicenseRef-mediatek)
  depends=(linux-firmware-whence)

  mv -v ${pkgname#linux-firmware-}/* "${pkgdir}"
  make -C ${pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 ${_licdir}/LICENCE.{mediatek,ralink*} \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

package_linux-firmware-cirrus() {
  pkgdesc+=" - Firmware for Cirrus Logic devices"
  license+=(LicenseRef-cirrus)
  depends=(linux-firmware-whence)

  mv -v ${pkgname#linux-firmware-}/* "${pkgdir}"
  make -C ${pkgbase} FIRMWAREDIR="${pkgdir}/usr/lib/firmware" dedup

  install -Dm644 ${_licdir}/LICENSE.cirrus \
    -t "${pkgdir}/usr/share/licenses/${pkgname}"
}

