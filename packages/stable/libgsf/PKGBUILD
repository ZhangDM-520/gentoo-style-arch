# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan de Groot <jgc@archlinux.org>
# Contributor: Sarah Hay <sarahhay@mb.sympatico.ca>

pkgbase=libgsf
pkgname=(
  libgsf
)
pkgver=1.14.60
pkgrel=1
pkgdesc="Extensible I/O abstraction library for dealing with structured file formats"
url="https://gitlab.gnome.org/GNOME/libgsf"
arch=(x86_64)
license=(LGPL-2.1-only)
depends=(
  bzip2
  gdk-pixbuf2
  glib2
  glibc
  libxml2
  zlib
)
makedepends=(
  autoconf-archive
  git
  gobject-introspection
  # trim: gtk-doc no longer generates the API docs (--disable-gtk-doc below),
  # but GTK_DOC_CHECK is unconditional in configure.ac so autogen.sh still
  # needs the gtk-doc macros — kept as a build requirement only
  gtk-doc
)
# trim: checkdepends (perl-xml-parser, unzip) + check() — test suite dropped
#       libgsf-docs split dropped together with its doc staging path
provides=(libgsf-1.so)
source=("git+$url.git#tag=LIBGSF_${pkgver//./_}")
b2sums=('614b0818bcd0c1016394aef3a6dd46773a37dd6b0e45c84636ca61a16c606d5aa2a5ebfcde42293033b77499c0f0f148d0f8f5ddddc4ee61dac7828f139b9b9a')

prepare() {
  cd libgsf
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  local configure_options=(
    --prefix=/usr
    --sysconfdir=/etc
    --localstatedir=/var
    --disable-static
    --enable-introspection
    # trim: gtk-doc API docs (libgsf-docs split dropped)
    --disable-gtk-doc
  )

  cd libgsf

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure "${configure_options[@]}"
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd libgsf

  make DESTDIR="$pkgdir" install

  # trim: gtk-doc API docs + man pages (docs; the libgsf-docs split and its
  #       doc staging path were dropped together with them)
  rm -rf "$pkgdir/usr/share/gtk-doc" "$pkgdir/usr/share/man" "$pkgdir/usr/share/doc"

  # license: ship upstream licence text(s) (LGPL-2.1-only)
  local _l
  for _l in COPYING COPYING.LIB; do
    if [[ -f $_l ]]; then install -Dm644 "$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}
