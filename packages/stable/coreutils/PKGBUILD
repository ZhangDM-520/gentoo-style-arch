pkgname=coreutils
pkgver=9.12
pkgrel=2
pkgdesc='The basic file, shell and text manipulation utilities of the GNU operating system'
arch=('x86_64')
license=(
  GPL-3.0-or-later
  GFDL-1.3-or-later
)
url='https://www.gnu.org/software/coreutils/'
depends=( 
  acl  
  attr
  glibc
  gmp
  libcap
  openssl
)
makedepends=(
  git
  gperf
  python
  wget
)
source=(
  git+https://git.savannah.gnu.org/git/coreutils.git?signed#tag=v${pkgver}
  git+https://git.savannah.gnu.org/git/gnulib.git
  # https://lists.gnu.org/archive/html/coreutils/2026-09/msg00064.html
  0001-env-printenv-only-quote-when-outputting-to-terminals.patch
)
# trim: the coreutils-$pkgver.tar.gz{,.sig} dist tarball sources are dropped —
# they only fed the translated .mo files (locales) which are not shipped here
validpgpkeys=(
 6C37DC12121A5006BC1DB804DF6FD971306037D9 # Pádraig Brady
)
options=(!lto)
b2sums=('b893b993f6ee1f71939e1b54c3bde44eb0ad6d777e466125090488b082637539cbb07d1f9298cccfe4e510755945a7610b9a4ad2ea83061c5a53dd09c853ee7a'
        'SKIP'
        '97619b6af8bdb4e18d1a895f52e72af8e2fd2dc0afda8f724a70c9b68cdc31470398101012cc4452ab5142defe55956fd9bc8f87d71ea11ff87cb2147e122d10')

prepare() {
  cd "${pkgname}"
  # Skip downloading unstable po files in bootstrap scripts to avoid non-deterministic builds
  export SKIP_PO="1"
  # The $SKIP_PO environment variable is only honored by the gnulib submodule if using its "sh" implementation
  export GNULIB_TOOL_IMPL="sh"

  git submodule init
  git config submodule.gnulib.url ../gnulib
  git -c protocol.file.allow=always submodule update

  ./bootstrap

  # apply patch from the source array (should be a pacman feature)
  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done
}

build() {
  cd "${pkgname}"

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    --with-openssl
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

# trim: upstream "make check" suite (tests) — not run in this recipe

package() {
  cd "${pkgname}"
  make DESTDIR="${pkgdir}" install

  # trim: man pages + GNU info docs (docs) and gettext locales (locales —
  # the dist-tarball .mo generation/install that fed them is dropped above)
  rm -rf "${pkgdir}"/usr/share/man "${pkgdir}"/usr/share/info "${pkgdir}"/usr/share/locale

  # license (the GPL-3.0 text; the GFDL-1.3-or-later half of the stock
  # license array covers the trimmed man/info docs)
  install -Dm644 COPYING -t "${pkgdir}"/usr/share/licenses/$pkgname/
}

