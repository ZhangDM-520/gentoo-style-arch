# Maintainer EliasofWaffle <eliascontato@protonmail.com>
# Contributor: Jan Alexander Steffens (heftig) <heftig@archlinux.org>

pkgname=libldacdec
pkgver=1.0.0.1
pkgrel=1
pkgdesc="Reverse-engineered unofficial LDAC Bluetooth decoder library"
url="https://github.com/anonymix007/libldacdec"
arch=(x86_64)
license=(Apache-2.0)
depends=(glibc)
makedepends=(git make gcc patchelf)
provides=(libldacBT_dec.so)
_commit=c90094b15e25aef0e47c6d775fa94aceb36cabbc
# libldac is upstream's git submodule (see .gitmodules) pinned at the submodule
# gitlink of this commit (e8ff0f96...). The canonical android.googlesource host
# advertises a corrupt branch ref (refs/heads/android17-security-release ->
# non-commit 15a1c66) that git 2.56 refuses to clone past ("trying to write
# non-commit object ... to branch"), and makepkg clones --mirror (all refs), so
# no fragment avoids it. Fetched from the libldacdec author's mirror of the same
# repo instead: content is pinned by the git object id itself (identical commit
# hash = identical content; the sha256 below is makepkg's git-archive checksum
# and matches the value the AUR recipe pinned from googlesource).
# googlesource's +archive tarball was rejected as a replacement: its bytes are
# regenerated per request (gzip metadata), so no checksum can pin it.
source=("git+$url#commit=$_commit"
        "git+https://github.com/anonymix007/libldac#commit=e8ff0f96f26b84b47711c549e0d60baa425cd70e"
        "ldacBT-dec.pc"
        )
sha256sums=('4f2eb83a0ceaa71c0cbdb3e622ff37444199779df00372b8a167b9da3522fb2e'
            '096342df8d8675c354f0b6335d4d0b2f044511628952c9240e20f8c4bda6a93f'
            'd6425808c870f7c408013934478421e8895073c10fb3ac10fa1db9febe0783f4')

prepare() {
  cd libldacdec

  # Feed the pinned libldac clone in as the submodule instead of re-fetching it
  # from its .gitmodules URL (the local path needs protocol.file.allow).
  git submodule init
  git submodule set-url libldac "$srcdir/libldac"
  git -c protocol.file.allow=always submodule update
}

build() {
  cd libldacdec
  # The upstream Makefile links libldacdec.so against a not-yet-written
  # libldacdec.so (-lldacdec self-reference): GNU ld silently accepts the
  # dangling input, mold refuses it ("library not found: ldacdec"). Build the
  # library first with the self-reference dropped from LDLIBS, then the CLI
  # tool against the finished library — the ordering is the fix.
  make libldacdec.so LDLIBS='-lm -lsndfile'
  make ldacdec
  # Consumers dlopen the soname libldacBT_dec.so; set it on the finished ELF
  # before the rename so the recorded name matches the installed file.
  patchelf --set-soname libldacBT_dec.so libldacdec.so
  mv libldacdec.so libldacBT_dec.so
}

package() {
    install -Dm 0755 "${srcdir}/libldacdec/libldacBT_dec.so" "${pkgdir}/usr/lib/libldacBT_dec.so"
    install -Dm 0644 "${srcdir}/libldacdec/libldacBT_dec.h" "${pkgdir}/usr/include/ldac/ldacBT_dec.h"
    install -Dm 0644 "${srcdir}/ldacBT-dec.pc" "${pkgdir}/usr/lib/pkgconfig/ldacBT-dec.pc"
}
