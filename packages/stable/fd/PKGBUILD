# Maintainer: Daniel M. Capella <polyzen@archlinux.org>
# Maintainer: Sven-Hendrik Haase <svenstaro@archlinux.org>
# Contributor: Maxim Baz <archlinux at maximbaz dot com>

pkgname=fd
pkgver=10.5.0
pkgrel=3
pkgdesc='Simple, fast and user-friendly alternative to find'
arch=(x86_64)
url=https://github.com/sharkdp/fd
license=('MIT OR Apache-2.0')
depends=(
  glibc
  jemalloc
  libgcc
)
makedepends=(
  git
  rust
)
# Tag source like Arch's (no ?signed: Arch does not gate this tag; the tagged
# commit carries GitHub's web-flow signature only). makepkg hashes the tag
# tree via `git archive`, so the sum is deterministic across clones.
source=("git+$url.git#tag=v$pkgver")
sha256sums=('8b9c1501778c38962d23f5428de9e7aeb9f4d1fda6598e547d760c07b4851e12')

prepare() {
  cd fd
  # fix: Re-enable jemalloc by default
  git show 1765d0817b4e706141115b81c29a5965630e243a -- Cargo.toml | git apply -

  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

# Base build, kept phase-friendly for a later PGO wave: upstream
# [profile.release] already sets lto=true and codegen-units=1.
build() {
  cd fd
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
  cargo build --release --locked --offline
}

check() {
  cd fd
  export JEMALLOC_OVERRIDE=/usr/lib/libjemalloc.so
  export CARGO_FEATURE_UNPREFIXED_MALLOC_ON_SUPPORTED_PLATFORMS=1
  cargo test --locked --offline
}

package() {
  cd fd
  install -Dm755 target/release/fd "$pkgdir"/usr/bin/fd

  make completions
  install -Dm644 autocomplete/fd.bash "$pkgdir"/usr/share/bash-completion/completions/fd
  install -Dm644 autocomplete/fd.fish "$pkgdir"/usr/share/fish/vendor_completions.d/fd.fish
  install -Dm644 autocomplete/_fd "$pkgdir"/usr/share/zsh/site-functions/_fd

  install -Dm644 doc/fd.1 "$pkgdir"/usr/share/man/man1/fd.1
  install -Dm644 LICENSE-MIT "$pkgdir"/usr/share/licenses/fd/LICENSE-MIT
  install -Dm644 LICENSE-APACHE "$pkgdir"/usr/share/licenses/fd/LICENSE-APACHE
}

# vim:set ts=2 sw=2 et:
