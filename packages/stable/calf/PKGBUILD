# Contributor: David Runge <dave@sleepmap.de>
# Contributor: Ray Rashif <schiv@archlinux.org>

pkgname=calf
pkgver=0.90.9
pkgrel=2
pkgdesc='LV2 plug-in suite'
arch=(x86_64)
url='http://calf-studio-gear.org' # http only
_url="https://github.com/calf-studio-gear/calf"
groups=(lv2-plugins pro-audio)
license=(GPL-2.0-or-later LGPL-2.0-or-later)
depends=(expat fluidsynth glibc hicolor-icon-theme libgcc libstdc++)
makedepends=(cmake git lv2)
source=("git+$_url#tag=$pkgver")
b2sums=('a62f3617959a73a0b0f23ef4976944f31d9c3bc37d14cf316eee428aa197cfda4e9ebccce12a17d733567523480c3c48d99ada05a0501c709f4f8ab6d2f22a77')

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  cmake \
    -B build \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D WANT_EXPERIMENTAL=ON \
    -D WANT_GUI=OFF \
    -S $pkgname \
    -W no-dev
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # trim: drop the AUTHORS/ChangeLog/README.md doc payload and locales
  # (this recipe ships the LV2 plug-in suite only)
  rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/locale"

  # license: ship upstream licence text (LGPL-2.1 text; upstream ships no
  # separate GPL text, and COPYING.LGPL/LICENSE do not exist at 0.90.9)
  local _l
  for _l in COPYING; do
    if [[ -f $pkgname/$_l ]]; then install -Dm644 "$pkgname/$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}
