pkgname=guile
pkgver=3.0.11
pkgrel=1.2
pkgdesc='Portable, embeddable Scheme implementation written in C'
url='https://www.gnu.org/software/guile/'
arch=(x86_64)
license=(GPL)
# readline: the shipped guile-readline extension hard-links libreadline.so.8
# (declared-deps sweep + archive-seam) — /usr/lib/guile/3.0/extensions/
# guile-readline.so{,.0,.0.0.0} carry hard DT_NEEDED from configure
# auto-detection. Stock spelling: readline-git carries
# readline=…/libhistory.so=8-64/libreadline.so=8-64 (expac-evidenced).
depends=(gmp ncurses libunistring gc libffi libxcrypt readline)
provides=(libguile-3.0.so)
source=(https://ftp.gnu.org/pub/gnu/$pkgname/$pkgname-$pkgver.tar.gz{,.sig})
validpgpkeys=('3CE464558A84FDC69DB40CFB090B11993D9AEBB5' # Ludovic Courtès <ludo@gnu.org>
              'FF478FB264DE32EC296725A3DDC0F5358812F8F2' # Andy Wingo
              '4FD4D288D445934E0A14F9A5A8803732E4436885') # Andy Wingo <wingo@pobox.com>"
sha256sums=('3c9c16972a73bb792752f2e4f1cce7212d7638d5494b5f7e8e19f3819dbf3a19'
            'SKIP')

build() {
  cd $pkgname-$pkgver

  # Documented exception (glibc-git/python/jq/sqlite/nodejs class, JOURNAL
  # 2026-11-01): the host's -Ofast makes guile's boot compiler DIE with
  # SIGFPE ("Floating point exception (core dumped)" building
  # language/cps/types.go, run 0324) — fast-math folds a FP edge into a
  # trap. Drop the LEVEL to -O3 (no -ffast-math); the rest of CFLAGS stays
  # host-derived. Same for CXXFLAGS.
  CFLAGS=${CFLAGS/-Ofast/-O3}
  CXXFLAGS=${CXXFLAGS/-Ofast/-O3}
  CFLAGS+=" -fstack-reuse=all" # flag-audit 2026-11-01

  ./configure --prefix=/usr \
    --disable-static  \
    --disable-error-on-warning
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd $pkgname-$pkgver
  make check
}

package() {
  make -C $pkgname-$pkgver DESTDIR="$pkgdir" install

  # trim: GNU info manual (texinfo makedep dropped — docs)
  rm -rf "$pkgdir/usr/share/info"

  rm "$pkgdir"/usr/lib/libguile-3.?.so.*-gdb.scm

  # license: ship the upstream GPL text
  local _l
  for _l in COPYING COPYING.LESSERv3; do
    if [[ -f $pkgname-$pkgver/$_l ]]; then install -Dm644 "$pkgname-$pkgver/$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}
