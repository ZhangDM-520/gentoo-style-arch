# Maintainer: Thomas Bächler <thomas@archlinux.org>
pkgname=v4l-utils
pkgver=1.32.0
pkgrel=2
pkgdesc="Userspace tools and conversion library for Video 4 Linux"
arch=('x86_64')
url="https://linuxtv.org/"
provides=("libv4l=$pkgver"
          libdvbv5.so
          libv4l1.so
          libv4l2.so
          libv4l2rds.so
          libv4lconvert.so)
replaces=('libv4l')
conflicts=('libv4l')
backup=(etc/rc_maps.cfg)
license=('LGPL')
depends=('hicolor-icon-theme' 'libgcc' 'libbpf' 'libjpeg-turbo'  'systemd-libs' 'json-c')
makedepends=('qt6-base' 'qt6-5compat' 'alsa-lib' 'meson' 'clang')
optdepends=('qt6-base: for qv4l2 and qvidcap'
            'qt6-5compat: for qv4l2'
            'alsa-lib: for qv4l2')
source=(https://linuxtv.org/downloads/v4l-utils/${pkgname}-${pkgver}.tar.xz{,.asc})
sha256sums=('6828828a17775526eb93fb258a9294d1d1073d633c344dd71ecd4e7a1ffb7dfc'
            'SKIP')
validpgpkeys=('05D0169C26E41593418129DF199A64FADFB500FF') # Gregor Jasny <gjasny@googlemail.com>

prepare() {
  # HACK: inform upstream to make this configurable
  cd "${pkgname}-${pkgver}"
  sed -i 's/sbin/bin/' utils/v4l2-dbg/meson.build
}

build() {
  # House style: mold linker when available
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi
  # -Ddoxygen-doc=disabled: the docs feature is auto and turns on whenever
  # host doxygen exists; its output was pure waste (dropped in package())
  # and the doxygen run is a build wall (run #92 class)
  arch-meson -Dgconv=disabled -Ddoxygen-doc=disabled "${pkgname}-${pkgver}" build
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  meson install -C build --destdir "$pkgdir"

  # trim: man pages and locale catalogues (docs/man/i18n; nothing reads them
  # at run time — the doxygen HTML is no longer built at all, see build())
  rm -rf "$pkgdir"/usr/share/{doc,man,locale}

  # license: ship upstream licence texts (LGPL-2.1-or-later family)
  install -Dm644 "${pkgname}-${pkgver}"/COPYING{,.libdvbv5,.libv4l} \
    "${pkgname}-${pkgver}"/lib/libv4l1/libv4l1-kernelcode-license.txt \
    -t "$pkgdir/usr/share/licenses/$pkgname/"
}
