prepare() {
  cd ${pkgname}

  # Build with nettle 4
  git cherry-pick -n fd4487b629edea789fc22baac8a6b641e942bb49

  # Skip downloading po files in bootstrap to avoid non-deterministic builds
  # and to avoid wget (make-)depending on itself
  export SKIP_PO="1"
  # The $SKIP_PO environment variable is only honored by the gnulib submodule
  # if using its "sh" implementation
  export GNULIB_TOOL_IMPL="sh"
  # Prevent git-version-gen from appending "-dirty" to the default user agent
  echo "${pkgver}" > .tarball-version

  git submodule init
  git config submodule.gnulib.url "${srcdir}/gnulib"
  git -c protocol.file.allow=always submodule update

  sh bootstrap
  autoreconf -fiv

  cat >> doc/sample.wgetrc <<EOF

# default root certs location
ca_certificate=/etc/ssl/certs/ca-certificates.crt
EOF
}

build() {
  cd ${pkgname}
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-rpath \
    --enable-nls \
    --with-ssl=gnutls
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"

  # trim: locales (mo generation from the dist tarball dropped — no
  # translations in the packaged output; the tarball source stays for
  # source/checksum parity with stock)
}

check() {
  cd ${pkgname}
  make check
}

package() {
  cd ${pkgname}
  make DESTDIR="${pkgdir}" install

  # trim: locales (the wget/wget-gnulib mo install from the dist tarball is
  # dropped together with the build-side msgfmt loop)
  # trim: man/docs — lean consumer-rebuild recipe
  rm -rf "${pkgdir}/usr/share/locale" "${pkgdir}/usr/share/man" "${pkgdir}/usr/share/doc"

  # license: ship upstream licence text (GPL-3.0-or-later)
  local _l
  for _l in COPYING COPYING.GPL COPYING.GPLv3; do
    if [[ -f $_l ]]; then install -Dm644 "$_l" -t "${pkgdir}/usr/share/licenses/${pkgname}/"; fi
  done
}

