# Maintainer: Andreas Radke <andyrtr@archlinux.org>

# after a .so bump first rebuild dirmngr
# with sudo testing-x86_64-build -- -I libgcrypt-1.6.0-1-x86_64.pkg.tar.xz
# then cp /usr/lib/libgcrypt.so.11 /var/lib/archbuild/staging-x86_64/root/usr/lib/ and do staging-x86_64-build

pkgname=libgcrypt
pkgver=1.12.4
pkgrel=1
pkgdesc="General purpose cryptographic library based on the code from GnuPG"
arch=(x86_64)
url="https://www.gnupg.org"
license=(
    'BSD-3-Clause'
    'BSD-3-Clause OR GPL-2.0-only'
    'GPL-2.0-or-later'
    'LGPL-2.0-or-later'
    'LGPL-2.1-or-later'
    'X11'
    'LicenseRef-scancode-public-domain'
    'LicenseRef-OCB1'
)
depends=('libgpg-error' 'glibc')
provides=('libgcrypt.so')
options=('!emptydirs')
# https://www.gnupg.org/download/integrity_check.html
source=(https://gnupg.org/ftp/gcrypt/${pkgname}/${pkgname}-${pkgver}.tar.bz2{,.sig})
sha256sums=('d77f68f48879510e79a2f65977ccc68981781ea0923e5bdffac2a193ea3d660e'
            'SKIP')
# gnupg.org ships multi-signature .sig files ("one or more of these keys"), so
# every current release key must be pinned or makepkg rejects the whole .sig.
# Fingerprints verified against https://www.gnupg.org/signature_key.html 2026-10-06
validpgpkeys=('6DAA6E64A76D2840571B4902528897B826403ADA'  # Werner Koch (dist signing 2020)
              'AC8E115BF73E2D8D47FA9908E98E9B2D19C6C8BD'  # Niibe Yutaka (GnuPG Release Key)
              '3B761AE4E63BF3519CE7D63BECB664CBE1332EEF'  # Alexander Kulbartsch (GnuPG Release Key)
              'D02AE49173BDAD56E4F88223707E56D3DEF4115C'  # Ingo Kloecker (Release Signing Key 2026)
              '02F38DFF731FF97CB039A1DA549E695E905BA208'  # GnuPG.com (Release Signing Key 2021)
              '1493269DE61F124AA69A316E3ADF34EBDBB200A4') # GnuPG.com (Release Signing Key 2026)

prepare() {
  cd "${pkgname}"-${pkgver}

  # trim: the t-secmem/t-sexp Makefile.am exclusions and check() (test suite)
  # are dropped together — no PGO phase in Class B, the suite trains nothing

  # fix version - due to autoreconf
  sed -i 's/beta=yes/beta=no/; s/tmp="-unknown"/tmp=""/' autogen.sh

  autoreconf -vfi
}

build() {
  cd "${pkgname}"-${pkgver}
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure --prefix=/usr \
	--disable-static \
	--disable-padlock-support
  make
}

package() {
  cd "${pkgname}"-${pkgver}
  make DESTDIR="${pkgdir}" install
  # trim: GNU info manual + man pages (docs/man) — not part of the maintained
  # target; the shipped tools keep their --help
  rm -rf "${pkgdir}"/usr/share/info "${pkgdir}"/usr/share/man
  install -m755 -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -m644 {COPYING.LIB,LICENSES} "${pkgdir}/usr/share/licenses/${pkgname}/"
}
