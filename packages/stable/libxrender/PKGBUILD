pkgname=libxrender
pkgver=0.9.13
pkgrel=1.1
pkgdesc="X Rendering Extension client library"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('HPND-sell-variant')
depends=('libx11' 'glibc' 'xorgproto')
provides=('libXrender.so')
source=(${url}/archive/individual/lib/libXrender-${pkgver}.tar.xz{,.sig})
sha512sums=('c7428584a4bf5258ee95b8b1dafa14eb9e735ad6d3f16f356c0b5023e2d1023f61698b12f055df0bde761b2798b7bf42121007f3fe935ea6ac56cd1a6d5ece44'
            'SKIP')
validpgpkeys=('4A193C06D35E7C670FA4EF0BA2FB9E081F2D130E') #Alan Coopersmith <alan.coopersmith@oracle.com>
#validpgpkeys+=('C41C985FDCF1E5364576638B687393EE37D128F8') # Matthieu Herrb <matthieu.herrb@laas.fr>

build() {
  cd libXrender-${pkgver}
  ./configure --prefix=/usr --disable-static
  make
}

package() {
  cd libXrender-${pkgver}
  make DESTDIR="${pkgdir}" install

  # trim: man3 API pages (docs; nothing reads them at build or run time)
  rm -rf "${pkgdir}"/usr/share/man

  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
