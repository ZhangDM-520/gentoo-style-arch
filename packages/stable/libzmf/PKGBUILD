# Maintainer: AndyRTR <andyrtr@archlinux.org>

pkgname=libzmf
pkgver=0.0.2
pkgrel=20
pkgdesc="a library for import of Zoner drawing and bitmap files"
arch=('x86_64')
url="https://wiki.documentfoundation.org/DLP/Libraries/libzmf"
license=('MPL-2.0')
source=(https://dev-www.libreoffice.org/src/${pkgname}/${pkgname}-${pkgver}.tar.xz
        doxygen-1.14.patch)
depends=('librevenge' 'libpng'
         'zlib' 'icu' 'glibc' 'libstdc++' 'libgcc')
# trim: cppunit/librevenge-stream feed the unit tests, doxygen feeds the API
# docs — both trimmed below, so neither is pulled back in as a makedep.
makedepends=('boost')
provides=('libzmf-0.0.so')
sha256sums=('27051a30cb057fdb5d5de65a1f165c7153dc76e27fe62251cbb86639eb2caf22'
            'aa70e940c77124ac3bd9e5197b323b409551a95ae5098b3872d869025d0bccf9')

prepare() {
  cd ${pkgname}-${pkgver}
  patch -p1 -i ../doxygen-1.14.patch
  autoreconf -fiv
}

build() {
  cd ${pkgname}-${pkgver}
  # trim: unit tests (cppunit) and doxygen API docs — see makedepends note
  ./configure --prefix=/usr --disable-werror --disable-tests --without-docs
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

package() {
  cd ${pkgname}-${pkgver}
  make DESTDIR="${pkgdir}" install
  # trim: any doxygen HTML left under /usr/share/doc (docs)
  rm -rf "${pkgdir}"/usr/share/doc
  install -Dm644 COPYING "${pkgdir}/usr/share/licenses/${pkgname}/COPYING"
}
