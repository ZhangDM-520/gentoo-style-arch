+// 9.2.1164).
+#ifndef _ANSI_ARGS_
+# define _ANSI_ARGS_(x) x
+#endif
+#ifndef CONST
+# define CONST const
+#endif
+#if TCL_MAJOR_VERSION < 9
+# define Tcl_Size int
+#endif
