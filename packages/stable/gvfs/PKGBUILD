pkgbase=gvfs
# trim: the gvfs-afc, gvfs-dnssd, gvfs-goa, gvfs-gphoto2, gvfs-mtp,
# gvfs-nfs, gvfs-onedrive, gvfs-smb and gvfs-wsdd split outputs are dropped
# together with their depends/_pick/install-check paths (the stock _pick()
# helper, the gvfs-nfs.install install script and all package_* pick
# functions go with them); this single-output recipe packages only gvfs
pkgname=(
  gvfs
)
pkgver=1.62.0
pkgrel=3
pkgdesc="Virtual filesystem implementation for GIO"
url="https://gitlab.gnome.org/GNOME/gvfs"
arch=(x86_64)
license=(LGPL-2.0-only)
depends=(
  dconf
  fuse3
  gcr-4
  glib2
  glibc
  gsettings-desktop-schemas
  libarchive
  libbluray
  libcdio
  libcdio-paranoia
  libgcc
  libgcrypt
  libgudev
  libsecret
  libsoup3
  polkit
  procps-ng
  systemd
  systemd-libs
  udisks2
)
makedepends=(
  avahi
  dbus
  git
  glib2-devel
  libgoa
  libgphoto2
  libimobiledevice
  libmtp
  libnfs
  libxml2
  meson
  msgraph
  openssh
  python
  smbclient
  wsdd
)
# trim: check() (meson test) and the docbook-xsl makedep dropped together
# with the man pages (man=false below) — Class B trim standard (tests/man)
groups=(gnome)
source=(
  "git+https://gitlab.gnome.org/GNOME/gvfs.git#tag=$pkgver"
  gvfsd.hook
)
b2sums=('2982e6a0db8f3ae2064709397de7eff60cf9b66f073cfd24fa4f2c089cbd1141e467ca3c60ab92d25b685ec05c9e242e7be959df3b595673ba138db89a0a7712'
        'a0356a49c419dc69466c591d5e69701b865bb97ca336ea6d8bca0f0d9173b832b73d9f2c701d572a0245957d39c9a38ab6dff4ea7c737c34f2a1a28d93c0427f')

prepare() {
  cd gvfs
}

build() {
  local meson_options=(
    # trim: man pages — Class B trim standard (man)
    -D man=false
  )

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson gvfs build "${meson_options[@]}"
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package_gvfs() {
  optdepends=(
    'gvfs-afc: AFC support (Apple mobile devices)'
    'gvfs-dnssd: DNS-SD and WebDAV support (macOS file sharing)'
    'gvfs-goa:  Gnome Online Accounts support (e.g. OwnCloud)'
    'gvfs-gphoto2: gphoto2 support (PTP camera, MTP media player)'
    'gvfs-mtp: MTP support (Android, media player)'
    'gvfs-nfs: NFS support'
    'gvfs-onedrive: Microsoft OneDrive support'
    'gvfs-smb: SMB/CIFS support (Windows file sharing)'
    'gvfs-wsdd: Web Services Dynamic Discovery support (Windows discovery)'
  )
  provides=(libgvfscommon.so libgvfsdaemon.so)
  # trim: stock conflicts=(gvfs-google<=1.58.3-1) + replaces=(gvfs-google<=1.58.3-1)
  # dropped — house standard (no conflicts/replaces)

  meson install -C build --no-rebuild --destdir "$pkgdir"

  # trim: dropped-split payloads leave the base output here — the afc/dnssd/
  # goa/gphoto2/mtp/nfs/onedrive/smb/wsdd splits are dropped and their stock
  # _pick paths go with them (these paths mirror the stock _pick lists)
  rm -rf \
    "$pkgdir"/usr/lib/gvfs{-afc-volume-monitor,d-afc} \
    "$pkgdir"/usr/lib/systemd/user/gvfs-afc-volume-monitor.service \
    "$pkgdir"/usr/share/dbus-1/services/org.gtk.vfs.AfcVolumeMonitor.service \
    "$pkgdir"/usr/share/gvfs/mounts/afc.mount \
    "$pkgdir"/usr/share/gvfs/remote-volume-monitors/afc.monitor \
    "$pkgdir"/usr/lib/gvfsd-{dav,dnssd} \
    "$pkgdir"/usr/share/GConf/gsettings/gvfs-dns-sd.convert \
    "$pkgdir"/usr/share/glib-2.0/schemas/org.gnome.system.dns_sd.gschema.xml \
    "$pkgdir"/usr/share/gvfs/mounts/{dav+sd,dav,dns-sd}.mount \
    "$pkgdir"/usr/lib/gvfs-goa-volume-monitor \
    "$pkgdir"/usr/lib/systemd/user/gvfs-goa-volume-monitor.service \
    "$pkgdir"/usr/share/dbus-1/services/org.gtk.vfs.GoaVolumeMonitor.service \
    "$pkgdir"/usr/share/gvfs/remote-volume-monitors/goa.monitor \
    "$pkgdir"/usr/lib/gvfs{-gphoto2-volume-monitor,d-gphoto2} \
    "$pkgdir"/usr/lib/systemd/user/gvfs-gphoto2-volume-monitor.service \
    "$pkgdir"/usr/share/dbus-1/services/org.gtk.vfs.GPhoto2VolumeMonitor.service \
    "$pkgdir"/usr/share/gvfs/mounts/gphoto2.mount \
    "$pkgdir"/usr/share/gvfs/remote-volume-monitors/gphoto2.monitor \
    "$pkgdir"/usr/lib/gvfs{-mtp-volume-monitor,d-mtp} \
    "$pkgdir"/usr/lib/systemd/user/gvfs-mtp-volume-monitor.service \
    "$pkgdir"/usr/share/dbus-1/services/org.gtk.vfs.MTPVolumeMonitor.service \
    "$pkgdir"/usr/share/gvfs/mounts/mtp.mount \
    "$pkgdir"/usr/share/gvfs/remote-volume-monitors/mtp.monitor \
    "$pkgdir"/usr/lib/gvfsd-nfs \
    "$pkgdir"/usr/share/gvfs/mounts/nfs.mount \
    "$pkgdir"/usr/lib/gvfsd-onedrive \
    "$pkgdir"/usr/share/gvfs/mounts/onedrive.mount \
    "$pkgdir"/usr/lib/gvfsd-smb{,-browse} \
    "$pkgdir"/usr/share/GConf/gsettings/gvfs-smb.convert \
    "$pkgdir"/usr/share/glib-2.0/schemas/org.gnome.system.smb.gschema.xml \
    "$pkgdir"/usr/share/gvfs/mounts/smb{,-browse}.mount \
    "$pkgdir"/usr/lib/gvfsd-wsdd \
    "$pkgdir"/usr/share/glib-2.0/schemas/org.gnome.system.wsdd.gschema.xml \
    "$pkgdir"/usr/share/gvfs/mounts/wsdd.mount

  install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 *.hook

  # license: ship the upstream LGPL-2.0-only (COPYING) text
  install -Dm644 gvfs/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}

