# Maintainer: Balló György <ballogyor+arch at gmail dot com>
# Contributor: Jan de Groot <jgc@archlinux.org>
# Contributor: Chaiwat Suttipongsakul <cwt114@gmail.com>

pkgname=libthai
pkgver=0.1.30
pkgrel=1
pkgdesc='Thai language support library'
arch=(x86_64)
url='https://linux.thai.net/projects/libthai'
license=(LGPL-2.1-or-later)
depends=(
  glibc
  libdatrie
)
makedepends=(
  autoconf-archive
  git
)
# trim: doxygen (makedepends) — the doxygen API docs are not shipped;
# --disable-doxygen-doc in build() turns doc generation off for good
source=("git+https://github.com/tlwg/libthai.git#tag=v$pkgver")
b2sums=(b098f6dfdfc23b77e9b56861cdb71897e7d77a9c5d2196119192ff80c592b78bf580006b56134641b5e3882a833f983ac471a19991fc94b6cb165377a828ff07)

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-doxygen-doc
  make
}

check() {
  cd $pkgname
  make check
}

package() {
  cd $pkgname
  provides=(libthai.so)

  make DESTDIR="$pkgdir" install
  # trim: doxygen API docs — never built (--disable-doxygen-doc)
  rm -rf "$pkgdir"/usr/share/doc
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
