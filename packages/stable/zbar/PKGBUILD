pkgname=zbar
pkgver=0.23.95
pkgrel=1.1
pkgdesc="Application and library for reading bar codes from various sources"
arch=('x86_64')
url="https://github.com/mchehab/zbar"
license=('LGPL-2.1-or-later')
depends=('dbus' 'gtk3' 'imagemagick' 'libxv' 'qt5-base' 'qt5-x11extras' 'v4l-utils')
# trim: xmlto + docbook-xsl (man pages — configure auto-disables docs when
#       xmlto is absent, installed doc/man trimmed in package())
makedepends=('gtk3' 'qt5-x11extras' 'python' 'gobject-introspection' 'glib2-devel' 'meson' 'ninja')
optdepends=('python: for zbar python bindings')
# bare soname provides per ELF output: libzbar/libzbargtk/libzbarqt
# (sonames .so.0 each) + the python zbar module (filename SONAME);
# conflicts/replaces dropped (house rule)
provides=('zbar-gtk' 'zbar-qt' 'python-zbar'
          'libzbar.so' 'libzbargtk.so' 'libzbarqt.so' 'zbar.so')
source=(
  "$pkgname-$pkgver.tar.gz::https://github.com/mchehab/zbar/archive/refs/tags/$pkgver.tar.gz"
)
sha512sums=('cc6e1f39f0f709743e4fe4a375fa3295ad90941f59f37e75d4f862a9826a547645d7a856a159911ed44324e747d6e33dcd793d63dcdef51ec6847da4b98b0049')
b2sums=('f4d7ecd1f497a8baaef6537d13dbf8257a711d997710ea9e975dda44a835b94e0cd5239042049014dba985663e39e81a762027c7790c9fae498df78ae70d658e')

# upstream 0.23.95 moved to Meson (configure.ac is gone — the old configure.ac
# patches and autoreconf are obsolete and were dropped with the port)

build() {
  cd zbar-$pkgver

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  meson setup build \
    --prefix=/usr \
    --wrap-mode=nofallback \
    -Dgtk=gtk3 \
    -Dqt=true \
    -Dqt6=false \
    -Ddbusconfdir=/usr/share \
    -Ddoc=false
  meson compile -C build
}

package() {
  cd zbar-$pkgver
  meson install -C build --destdir "$pkgdir"

  # trim: man pages + docs (xmlto/docbook-xsl removed from makedepends)
  rm -rf "$pkgdir/usr/share/man" "$pkgdir/usr/share/doc"

  # license: ship upstream licence text(s) (LGPL-2.1-or-later)
  local _l
  for _l in COPYING LICENSE.md perl/COPYING.LIB; do
    if [[ -f $_l ]]; then install -Dm644 "$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}

