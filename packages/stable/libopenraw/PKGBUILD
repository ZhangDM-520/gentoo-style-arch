pkgname=libopenraw
pkgver=0.3.7
pkgrel=2
pkgdesc='Library for decoding RAW files'
arch=('x86_64')
url='https://libopenraw.freedesktop.org/'
license=('LGPL')
depends=('gdk-pixbuf2')
makedepends=('boost' 'libxml2' 'cargo')
provides=('libopenraw.so' 'libopenrawgnome.so')
source=("https://libopenraw.freedesktop.org/download/${pkgname}-${pkgver}.tar.bz2"{.asc,})
b2sums=('SKIP'
        '4f6ea0db32843c6685ddd5d72332e7eedfa28527d4ef76a8c1aeab56966681cc7a005cc903411a6d33c8638e31757b883fff25d6a5500b9b9395e5cdcf3a56f9')
validpgpkeys=('6C44DB3E0BF3EAF5B433239A5FEE05E6A56E15A3') # Hubert Figuiere <hub@mozilla.com>

prepare() {
# Fix libopenraw dependency in -gnome pc file
  sed -e 's|libopenraw-0.1|libopenraw-0.3|' -i $pkgname-$pkgver/gnome/libopenraw-gnome-0.3.pc.in

  # Vendored ahash 0.7.6's build.rs probes the toolchain channel and, on any
  # feature-supporting channel (rust-git's dev channel), emits
  # cfg feature="stdsimd"; that switches on lib.rs's `#![feature(stdsimd)]`,
  # a feature rustc has since removed (E0635, run #74 2026-10-08). Drop the
  # emission so the cfg-gated code falls back to the portable paths — ahash
  # 0.7.7 upstream did the same. Only the stdsimd line goes: the sibling
  # `specialize`/min_specialization probe still resolves on rust-git.
  local _vendor=$pkgname-$pkgver/lib/mp4/vendor/ahash
  sed -i '/rustc-cfg=feature=.*stdsimd/d' $_vendor/build.rs

  # A vendored directory source is checksum-pinned: cargo refuses any edit
  # whose .cargo-checksum.json entry no longer matches (rehearsal 2026-10-09
  # caught it), so re-anchor the one edited file instead of touching the
  # manifest's other entries or the package checksum.
  local _sum=$(sha256sum $_vendor/build.rs | cut -d' ' -f1)
  sed -i "s|\"build.rs\":\"[0-9a-f]\{64\}\"|\"build.rs\":\"$_sum\"|" $_vendor/.cargo-checksum.json
}

build() {
  cd ${pkgname}-${pkgver}

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure --prefix=/usr
  make
}

package() {
  make -C ${pkgname}-${pkgver} DESTDIR="${pkgdir}" install

  # license: ship the upstream license texts (COPYING + COPYING.LESSER + MPL-2.0)
  local _l
  for _l in COPYING COPYING.LESSER MPL-2.0; do
    if [[ -f ${pkgname}-${pkgver}/$_l ]]; then
      install -Dm644 "${pkgname}-${pkgver}/$_l" -t "${pkgdir}/usr/share/licenses/${pkgname}/"
    fi
  done
}
