pkgbase=sword
pkgname=(sword python-sword)
_mainver=1.9
pkgver=1.9.0
pkgrel=18
pkgdesc="Library for Bible study programs"
arch=('x86_64')
url="https://www.crosswire.org/sword/"
license=('GPL-2.0-only')
makedepends=('curl' 'clucene' 'swig' 'cmake' 'python' 'python-build' 'python-installer' 'python-setuptools' 'python-wheel')
source=("https://www.crosswire.org/ftpmirror/pub/$pkgbase/source/v$_mainver/$pkgbase-$pkgver.tar.gz")
sha512sums=('9ed3fbb5024af1f93b1473bae0d95534d02a5b00b3c9d41a0f855cee8106dc4e330844080adbee7c3f74c0e5ce1480bf16c87c842421337a341f641bae11137f')

build() {
  # http://site.icu-project.org/download/61#TOC-Migration-Issues
  CXXFLAGS+=' -DU_USING_ICU_NAMESPACE=1'

  #./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # Tests are never run (!check) and never installed — build-only surface that
  # also hard-fails on the GCC 17 snapshot (swbuftest.cpp prints through the
  # deleted operator<<(ostream&, const wchar_t*)), so the seam keeps them off.
  cmake -B build -S $pkgbase-$pkgver \
      -DCMAKE_BUILD_TYPE='None' \
      -DLIBSWORD_LIBRARY_TYPE="Shared" \
      -DSYSCONF_INSTALL_DIR='/etc' \
      -DSWORD_BUILD_TESTS="No" \
      -DSWORD_PYTHON_3=TRUE \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
      -Wno-dev
  cmake --build build -j "${GSA_BUILD_JOBS:-$(nproc)}"
  cd build/bindings/swig/python3
  python -m build --wheel --no-isolation
}

package_sword() {
  depends=('curl' 'clucene' 'xz')
  provides=('libsword.so')
  backup=('etc/sword.conf')

  DESTDIR="$pkgdir" cmake --install build

  # license: ship upstream licence text(s) (GPL-2.0-only)
  local _l
  for _l in LICENSE LICENCE COPYING COPYRIGHT; do
    if [[ -f $srcdir/$pkgbase-$pkgver/$_l ]]; then
      install -Dm644 "$srcdir/$pkgbase-$pkgver/$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"
    fi
  done
  if [[ -d $srcdir/$pkgbase-$pkgver/LICENSES ]]; then
    install -Dm644 "$srcdir/$pkgbase-$pkgver"/LICENSES/* -t "$pkgdir/usr/share/licenses/$pkgname/"
  fi
}

package_python-sword() {
  depends=('sword' 'python')

  # license: ship upstream licence text(s) (GPL-2.0-only)
  local _l
  for _l in LICENSE LICENCE COPYING COPYRIGHT; do
    if [[ -f $srcdir/$pkgbase-$pkgver/$_l ]]; then
      install -Dm644 "$srcdir/$pkgbase-$pkgver/$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"
    fi
  done
  if [[ -d $srcdir/$pkgbase-$pkgver/LICENSES ]]; then
    install -Dm644 "$srcdir/$pkgbase-$pkgver"/LICENSES/* -t "$pkgdir/usr/share/licenses/$pkgname/"
  fi

  cd build/bindings/swig/python3
  python -m installer --destdir="$pkgdir" dist/*.whl
}
