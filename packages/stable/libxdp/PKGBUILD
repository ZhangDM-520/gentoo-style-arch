# Contributor:  Emanuel Schmidt <emanuel.schmidt@gmail.com>

pkgbase=xdp-tools
pkgname=(xdp-tools libxdp)
pkgver=1.6.3
pkgrel=2
pkgdesc='Utilities and example programs for use with XDP'
url='https://github.com/xdp-project/xdp-tools'
license=('GPL' 'LGPL' 'BSD2')
arch=('x86_64')
depends=('libelf' 'linux-api-headers' 'libbpf')
makedepends=('clang' 'llvm' 'gcc' 'make' 'm4' 'pkgconfig' 'libpcap' 'zlib' 'bpf')
# !lto is load-bearing: the BPF object/xdp-dispatcher build path does not take
# LTO link flags cleanly
options=(!lto)
# NOTE: recipe id libxdp carries the stock pkgbase xdp-tools (both stock
# outputs xdp-tools + libxdp are kept — upgrade-in-place pkgbase shape).
source=("$pkgname-$pkgver.tar.gz::https://github.com/xdp-project/xdp-tools/archive/refs/tags/v${pkgver}.tar.gz")
sha512sums=('13c045af6a039cfcfbd5987a34c613a4f8767a1371d5d954d51fdaeed8dc8649388f87dd209135bfa5d6f759a9ee8316ee2b4e6779c3c16869d9f1d046bb4713')
b2sums=('7b705e254a8fc09c2358426ba712a9462ac02640dfc790ef2dc984026f5e93761c5636c70d6a4d488feb81f71e25cf8f8a69add92c1508bbdfaae7c885628420')


build() {
  cd "${pkgname}-${pkgver}"

  # xdp-tools embeds its BPF blobs via `gcc -r -Wl,--format=binary`, a
  # GNU-ld-only feature — mold refuses `-b binary`. The host makepkg.conf
  # pins -fuse-ld=mold in LDFLAGS (and the house guard below would re-add
  # it), so strip it for this build; bfd links everything here.
  export LDFLAGS="${LDFLAGS//-fuse-ld=mold/}"

  export PRODUCTION=1
  export DYNAMIC_LIBXDP=1
  export FORCE_SYSTEM_LIBBPF=1
  export PREFIX="/usr"
  ./configure
  make V=1 -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package_xdp-tools() {
  cd "${pkgname}-${pkgver}"
  pkgdesc="Utilities and example programs for use with XDP"
  depends=("libxdp" 'libpcap.so' 'libbpf')
  export DESTDIR="${pkgdir}"
  export SBINDIR="/usr/bin"
  export PREFIX="/usr"
  make install V=1

  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 LICENSE LICENSES/* -t "${pkgdir}/usr/share/licenses/${pkgname}"
  rm -rf "${pkgdir}"/usr/share/xdp-tools \
         "${pkgdir}"/usr/lib/libxdp* \
         "${pkgdir}"/usr/lib/bpf/{xdp-dispatcher*,xsk_*} \
         "${pkgdir}"/usr/lib/pkgconfig \
         "${pkgdir}"/usr/include \
         "${pkgdir}"/usr/share/man/man3

  # trim: man/doc/locale payload left by `make install` — Class B trim
  # standard (docs/man/locales)
  rm -rf "${pkgdir}"/usr/share/man "${pkgdir}"/usr/share/doc "${pkgdir}"/usr/share/locale
}

package_libxdp() {
  cd "${pkgbase}-${pkgver}"
  pkgdesc="The libxdp package contains the libxdp library for managing XDP programs"
  # House standard: bare soname provide per ELF output (never pinned); the
  # stock bare libxdp.so provide is kept as delivered.
  provides=('libxdp.so')
  export DESTDIR="${pkgdir}"
  export SBINDIR="/usr/bin"
  export PREFIX="/usr"
  make libxdp_install V=1

  # trim: man/doc/locale payload — Class B trim standard (docs/man/locales)
  rm -rf "${pkgdir}"/usr/share/man "${pkgdir}"/usr/share/doc "${pkgdir}"/usr/share/locale

  install -d "${pkgdir}/usr/share/licenses/${pkgname}"
  install -Dm644 LICENSE LICENSES/* -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
