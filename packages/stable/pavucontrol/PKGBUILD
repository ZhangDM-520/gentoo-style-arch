# Contributor: William Rea <sillywilly@gmail.com>

pkgname=pavucontrol
pkgver=6.2
pkgrel=1
epoch=1
pkgdesc="PulseAudio Volume Control"
url="https://freedesktop.org/software/pulseaudio/pavucontrol/"
arch=(x86_64)
license=(GPL-2.0-or-later)
depends=(
  glib2
  glibc
  glibmm-2.68
  gtk4
  gtkmm-4.0
  json-glib
  libcanberra
  libgcc
  libpulse
  libsigc++-3.0
  libstdc++
)
makedepends=(
  git
  lynx
  meson
)
checkdepends=(tidy)
source=("git+https://gitlab.freedesktop.org/pulseaudio/pavucontrol.git?signed#tag=v$pkgver")
b2sums=('bcedd14881a304580dd7998d62a89d4e1f7f8fcb9d8c6d3cf773df3716d04b68976665b491606f3cad39d742b8f636e0aa0950931f3045c470151b0c603d0491')
validpgpkeys=(
  52DFA7B8BAC74687C8A88EF48165E3D1987E2132 # Arun Raghavan <arun@asymptotic.io>
)

prepare() {
  cd pavucontrol
}

build() {
  # House style: mold linker when available (runtime-guarded, no output effect).
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  arch-meson pavucontrol build
  meson compile -C build --jobs "${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"

  # trim: man page (man1 pavucontrol) (docs) — not shipped
  rm -rf "$pkgdir"/usr/share/man

  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
}

