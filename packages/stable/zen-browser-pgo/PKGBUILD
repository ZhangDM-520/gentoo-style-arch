_srcroot='zen-source'
source=(
  "$_srcroot-$pkgver.tar.zst::https://github.com/zen-browser/desktop/releases/download/$pkgver/zen.source.tar.zst"
  "$pkgname.desktop"
  '0004-Use-wasm32-wasip1-target.patch'
  '0005-Fix-cbindgen-BudgetType_VALUES-COUNT-issue.patch'
  '0007-pgo-speedometer3.patch'
)
sha256sums=('5dafd8ae04726cb70b381723aa448f40507edab9232a20296e7d046037bd0b45'
            'af16fec9a88cbfffee34a6a4eb5b3074931477fcefee252840d77cf146568851'
            '28b086f5492d8e6731fe0dfe34a2e4c6d4d502a9eefa15a31e44b5788cf4df89'
            '0d24f2a45fa0f7fe108a91a50ae55708f66899b0229df7722fb87962f7a2a243'
            'b2050b23273ea77a98bc645af5ee4e35e79fb9d76dd142f8e553eabd5334bdec')
noextract=("$_srcroot-$pkgver.tar.zst")

prepare() {
  rm -rf "$srcdir/$_srcroot"
  mkdir -p "$srcdir/$_srcroot" "$srcdir/mozbuild"
  bsdtar -xf "$srcdir/$_srcroot-$pkgver.tar.zst" -C "$srcdir/$_srcroot"

  cd "$srcdir/$_srcroot"

  # Wipe any leftover object directory from previous build attempts
  rm -rf obj

  patch -Np1 -i "$srcdir/0004-Use-wasm32-wasip1-target.patch"
  patch -Np1 -i "$srcdir/0005-Fix-cbindgen-BudgetType_VALUES-COUNT-issue.patch"
  # SP2 workload entry -> Speedometer 3 (SP3 entry + sp3_httpd already in tree)
  patch -Np1 -i "$srcdir/0007-pgo-speedometer3.patch"

  # Fix standard header isolation for std::ifstream
  sed -i '/#include <string>/a #include <fstream>' ipc/chromium/src/base/file_path.h

  # Fix deprecated Clang attribute warnings
  find . -type f \( -name "*.h" -o -name "*.cpp" -o -name "*.h.in" \) \
    -exec sed -i 's/capture_lifetime_by(this)/capture_lifetime_by_this/g' {} + 2>/dev/null || true

  cat >"$srcdir/mozconfig" <<EOF
ac_add_options --enable-application=browser
mk_add_options MOZ_OBJDIR=${PWD@Q}/obj

ac_add_options --prefix=/usr
ac_add_options --enable-release
ac_add_options --enable-hardening
ac_add_options --enable-optimize=-O3
ac_add_options --enable-rust-simd
ac_add_options --host=x86_64-unknown-linux-gnu
ac_add_options --target=x86_64-unknown-linux-gnu
ac_add_options --enable-linker=lld
ac_add_options --disable-bootstrap
ac_add_options --without-wasm-sandboxed-libraries

# Compiler Cache (sccache)
ac_add_options --with-ccache=sccache
# Branding
ac_add_options --enable-update-channel=release
ac_add_options --with-distribution-id=org.archlinux
ac_add_options --with-unsigned-addon-scopes=app,system
ac_add_options --allow-addon-sideload
export MOZILLA_OFFICIAL=1
export MOZ_APP_REMOTINGNAME=zen-browser
export RUSTTARGET="x86_64-unknown-linux-gnu"
export DISPLAY=""
export MOZ_HEADLESS=1

# System libraries
ac_add_options --with-system-nspr
ac_add_options --with-system-nss

# Features
ac_add_options --disable-updater
ac_add_options --disable-tests
EOF
}

build() {
  cd "$srcdir/$_srcroot"

  # Force Clang toolchain so Cargo's cc-rs does not fall back to GCC
  export CC=clang
  export CXX=clang++
  export AR=llvm-ar
  export NM=llvm-nm
  export RANLIB=llvm-ranlib

  # Strip ambient LTO flags from environment variables
  export CFLAGS=$(echo "$CFLAGS" | sed -E 's/-flto[=-]?[^ ]*//g')
  export CXXFLAGS=$(echo "$CXXFLAGS" | sed -E 's/-flto[=-]?[^ ]*//g')
  export LDFLAGS=$(echo "$LDFLAGS" | sed -E 's/-flto[=-]?[^ ]*//g')
  # Do NOT export HOST_CFLAGS/HOST_CXXFLAGS: GNU make re-exports its own
  # internal HOST_CFLAGS to cargo's cc-rs host builds. That value embeds
  # `-MD -MP -MF $(MDDEPDIR)/$(@F).pp` (dependency-tracking flags whose
  # relative `.deps/` path does not exist in cc-rs's OUT_DIR), which makes
  # build scripts like cubeb-core fail with
  # "error opening '.deps/force-cargo-library-build.pp': No such file or directory".
  unset HOST_CFLAGS HOST_CXXFLAGS

  export CHOST="x86_64-unknown-linux-gnu"
  export RUST_HOST="x86_64-unknown-linux-gnu"
  export RUST_TARGET="x86_64-unknown-linux-gnu"
  export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE=pip
  export MOZBUILD_STATE_PATH="$srcdir/mozbuild"
  export MOZ_BUILD_DATE="$(date -u${SOURCE_DATE_EPOCH:+d @$SOURCE_DATE_EPOCH} +%Y%m%d%H%M%S)"
  export MOZ_NOSPAM=1

  # Ensure sccache server restarts cleanly
  export SCCACHE_DIR="${SCCACHE_DIR:-$HOME/.cache/sccache}"
  export RUSTC_WRAPPER="/usr/bin/sccache"
  sccache --stop-server 2>/dev/null || true
  sccache --start-server || true

  CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
  CFLAGS="${CFLAGS/-fexceptions/}"
  CXXFLAGS="${CXXFLAGS/-fexceptions/}"

  ulimit -n 4096

  # --- 3-tier PGO (Arch firefox style) ---
  # Pass 1: instrumented build. LTO is auto-disabled for the generate pass and
  # C++ is forced to -O3 on Linux by configure when MOZ_PGO is set.
  echo 'Building instrumented browser (PGO pass 1: profile-generate)...'
  { cat "$srcdir/mozconfig"
    echo 'ac_add_options --enable-profile-generate=cross'
  } > .mozconfig
  ./mach build --priority normal

  # Profile the instrumented browser headlessly (xvfb) to produce merged.profdata
  echo 'Profiling instrumented browser...'
  ./mach package
  LLVM_PROFDATA=llvm-profdata \
    JARLOG_FILE="$PWD/jarlog" \
    xvfb-run -s "-screen 0 1920x1080x24 -nolisten local" \
    ./mach python build/pgo/profileserver.py

  stat -c 'Profile data found (%s bytes)' merged.profdata
  test -s merged.profdata
  stat -c 'Jar log found (%s bytes)' jarlog
  test -s jarlog

  # Remove instrumented artifacts so pass 2 links cleanly
  echo 'Removing instrumented browser...'
  ./mach clobber

  # Pass 2: optimized build with the profile + cross-language (thin) LTO.
  # Cross-language LTO requires clang and rustc on the same LLVM version; with
  # llvm-git 24 + rust-git 24 (LLVM 24) that now holds -- the mismatch that
  # previously needed the 0006 workaround is gone.
  echo 'Building optimized browser (PGO pass 2: profile-use, thin+cross LTO)...'
  { cat "$srcdir/mozconfig"
    printf '%s\n' \
      'ac_add_options --enable-profile-use=cross' \
      'ac_add_options --enable-lto=thin,cross' \
      "ac_add_options --with-pgo-profile-path=$PWD/merged.profdata" \
      "ac_add_options --with-pgo-jarlog=$PWD/jarlog"
  } > .mozconfig
  ./mach build --priority normal

  sccache --show-stats
}

package() {
  cd "$srcdir/$_srcroot"

  DESTDIR="$pkgdir" ./mach install

  local _launcher='zen-browser'
  local _appdir="$pkgdir/usr/lib/$_launcher"
  local _size

  if [[ -d "$pkgdir/usr/lib/firefox" && ! -d "$_appdir" ]]; then
    mv "$pkgdir/usr/lib/firefox" "$_appdir"
    ln -sf firefox "$_appdir/zen"
  fi

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$_launcher" <<'EOF'
#!/bin/sh
exec /usr/lib/zen-browser/zen "$@"
EOF
  ln -s "$_launcher" "$pkgdir/usr/bin/zen"

  ln -srv "$pkgdir/usr/lib/libonnxruntime.so" -t "$_appdir"

  install -Dm644 "$srcdir/$pkgname.desktop" \
    "$pkgdir/usr/share/applications/$pkgname.desktop"

  for _size in 16 32 48 64 128; do
    install -Dm644 \
      "$_appdir/browser/chrome/icons/default/default${_size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${_size}x${_size}/apps/$_launcher.png"
  done

  install -Dm644 /dev/stdin \
    "$_appdir/browser/defaults/preferences/vendor.js" <<'EOF'
// Use LANG environment variable to choose locale.
pref("intl.locale.requested", "");

// Use system-provided dictionaries.
pref("spellchecker.dictionary_path", "/usr/share/hunspell");

// Avoid first-run default browser noise on managed systems.
pref("browser.shell.checkDefaultBrowser", false);

// Don't disable extensions shipped in application directories.
pref("extensions.autoDisableScopes", 11);
EOF

  install -Dm644 /dev/stdin "$_appdir/distribution/distribution.ini" <<EOF
[Global]
id=archlinux
version=1.0
about=Zen Browser for Arch Linux

[Preferences]
app.distributor=archlinux
app.distributor.channel=$_launcher
app.partner.archlinux=archlinux
EOF

  install -Dm644 /dev/stdin "$_appdir/distribution/policies.json" <<'EOF'
{
  "policies": {
    "DisableAppUpdate": true
  }
}
EOF

  rm -f \
    "$_appdir/updater" \
    "$_appdir/updater.ini" \
    "$_appdir/update-settings.ini"

  if [[ -e "$_appdir/libnssckbi.so" ]]; then
    ln -sf ../libnssckbi.so "$_appdir/libnssckbi.so"
  fi
}
