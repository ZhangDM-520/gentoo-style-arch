# Workaround: when the system clang's LLVM is newer than the LLVM bundled with
# rustc (e.g. clang 24 vs rustc 1.98's LLVM 22 on Arch), passing -flto=thin to
# cc-rs makes the C/C++ code inside rust crates (e.g. glslopt used by
# webrender's build script) be emitted as LLVM bitcode from the newer LLVM.
# rustc links build scripts with its bundled rust-lld (older LLVM), which fails
# to read that bitcode:
#   rust-lld: error: .../libglslopt-....rlib(glcpp-lex.o): Invalid record
#
# Keep the native C/C++ ThinLTO (clang 24 + system lld 24) and Rust's own
# -Clto (rust-lld reads rustc's own LLVM bitcode), but do NOT hand -flto=thin
# to cc-rs in this situation so the cc-rs C objects stay native and can be
# linked by rust-lld into build scripts.
--- a/config/makefiles/rust.mk
+++ b/config/makefiles/rust.mk
@@ -231,7 +231,9 @@
 # (e.g. -pgo-temporal-instrumentation)
 # We can't use LTO flags with GCC, though: https://github.com/rust-lang/rust/issues/138681
 ifneq (,$(filter clang%,$(CC_TYPE)))
+ifndef MOZ_CLANG_NEWER_THAN_RUSTC_LLVM
 RUST_LTO_CFLAGS=$(MOZ_LTO_CFLAGS)
 endif
+endif
 export CFLAGS_$(rust_cc_env_name)=$(CC_BASE_FLAGS) $(RUST_LTO_CFLAGS) $(COMPUTED_CFLAGS) $(filter-out -fprofile-generate%,$(PGO_CFLAGS))
