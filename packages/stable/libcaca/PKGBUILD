# Contributor: Jan de Groot <jgc@archlinux.org>

pkgname=libcaca
pkgver=0.99.beta20
pkgrel=8
pkgdesc='Color ASCII art library'
arch=(x86_64)
url='http://caca.zoy.org/wiki/libcaca'
license=(WTFPL)
depends=(
  freeglut
  glibc
  glu
  imlib2
  libglvnd
  libstdc++
  libx11
  ncurses
  slang
  zlib
)
makedepends=(
  git
  pango
  python
)
optdepends=('python: Python bindings')
provides=(libcaca.so libcaca++.so)
source=(
  "git+https://github.com/cacalabs/libcaca.git#tag=v$pkgver"
  libcaca-0.99.beta20-CVE-2022-0856.patch
)
b2sums=(
  2965c38a6ecb8f9384741ac707f60ba7c6b7e290303f0f2c5f5b9dd28ce89580012c7db647dff15f9dc012fe3e47caa713162d40ffb29f428739db3a66a94e6b
  82bc7243844238089c5f513738bd9e95ac6cb88b16202db0655592e4037732a8353b72e5bd26ad73cdb32ad2da5d864bbb9ee5196bc0c3d2805c397e7686f728
)

prepare() {
  cd $pkgname

  # Prevent a divide-by-zero by checking for a zero width or height
  # https://github.com/cacalabs/libcaca/pull/66
  git apply -3 ../libcaca-0.99.beta20-CVE-2022-0856.patch

  autoreconf -fiv
}

build() {
  cd $pkgname
  # ruby bindings: autodetected accident, never a declared feature (no
  # ruby makedep), bit-rotted upstream — Ruby 3.4's typed
  # rb_define_singleton_method dispatch rejects the (void) arity-0
  # prototypes in ruby/common.h (run #106 wall). Python stays: declared
  # makedep/optdepend and it ships. Docs likewise autodetected (doxygen +
  # LaTeX; host texlive now trips them on and the manual dies in TeX
  # capacity) — and package() deletes usr/share/doc anyway.
  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    --disable-ruby \
    --disable-doc
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd $pkgname
  make check
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install

  # trim: docs (doxygen API docs + the LaTeX manual; --disable-doc in
  # build(), doxygen makedep dropped), the demo programs
  # cacaball/cacafire/cacamatrix/cacademo (demos — the library, its plugins and
  # the img2txt/cacaview/cacaplay/cacaclock tools are kept) and the ruby
  # bindings (--disable-ruby in build(); python bindings stay)
  rm -rf "$pkgdir/usr/share/doc"
  rm -f "$pkgdir/usr/bin/cacaball" "$pkgdir/usr/bin/cacafire" \
        "$pkgdir/usr/bin/cacamatrix" "$pkgdir/usr/bin/cacademo"

  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname/" COPYING
}
