pkgname = bootconfig
	pkgdesc = Apply, delete or show boot config to initrd
	depends = glibc

pkgname = bpf
	pkgdesc = BPF tools
	depends = glibc
	depends = readline
	depends = zlib
	depends = libelf
	depends = libcap
	depends = zstd
	depends = llvm-libs
	depends = binutils
	depends = libsframe.so

pkgname = cpupower
	pkgdesc = Linux kernel tool to examine and tune power saving related features of your processor
	depends = glibc
	depends = bash
	depends = pciutils
	conflicts = cpufrequtils
	replaces = cpufrequtils
	backup = etc/default/cpupower-service.conf

pkgname = kcpuid
	pkgdesc = Kernel tool for various cpu debug outputs
	arch = x86_64
	depends = glibc

pkgname = linux-tools-meta
	pkgdesc = Linux kernel tools meta package
	groups = 
	depends = bootconfig
	depends = bpf
	depends = cpupower
	depends = perf
	depends = tmon
	depends = usbip
	conflicts = acpidump
	depends_x86_64 = kcpuid
	depends_x86_64 = turbostat

