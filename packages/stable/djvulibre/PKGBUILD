# Contributor: Jan de Groot <jgc@archlinux.org>
# Contributor: mgushee

pkgname=djvulibre
pkgver=3.5.30.1
pkgrel=1
pkgdesc='Library and utilities to create, manipulate and view DjVu (déjà vu) documents'
arch=(x86_64)
url='https://djvu.sourceforge.net/'
license=(GPL-2.0-or-later)
depends=(
  bash
  glibc
  hicolor-icon-theme
  libgcc
  libjpeg-turbo
  libstdc++
  libtiff
)
makedepends=(git)
provides=(libdjvulibre.so)
source=("$pkgname::git+https://git.code.sf.net/p/djvu/djvulibre-git#tag=release.$pkgver")
b2sums=(5d567940fedb5f260760b8ed01563381fcb5b8ce7e5b9a413029730fc0d68b2151cd13786ed2557b450c18e0a4127ebaf1cc170b13680aaf8459a26b61e3a5fb)

prepare() {
  cd $pkgname
  autoreconf -fiv
}

build() {
  cd $pkgname
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install

  # trim: man pages, locales and doc payload — Class B trim standard
  # (man/locale/docs)
  rm -rf "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale "$pkgdir"/usr/share/doc

  # license: ship upstream licence texts (GPL-2.0-or-later)
  install -Dm644 COPYING COPYRIGHT -t "$pkgdir"/usr/share/licenses/$pkgname/
}
