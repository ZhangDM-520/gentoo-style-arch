# Maintainer: David Runge <dvzrv@archlinux.org>
# Contributor: Lieven Moors <lieven.moors@gmail.com>

pkgname=x42-plugins-lv2
pkgver=20260908
pkgrel=1
_dir=x42-plugins-$pkgver
pkgdesc="Professional audio processing units available as LV2-plugin and JACK-application - LV2 plugins"
arch=(x86_64)
url="https://x42-plugins.com/x42/"
license=(
  GPL-2.0-or-later
  GPL-3.0-or-later
)
depends=(
  cairo
  ftgl
  fftw libfftw3f.so
  glib2 libgobject-2.0.so
  glibc
  libgcc
  libglvnd
  libltc libltc.so
  libsamplerate libsamplerate.so
  libsndfile libsndfile.so
  libstdc++
  libx11
  lv2-host
  pango libpango-1.0.so libpangocairo-1.0.so
)
makedepends=(
  cairo
  fftw
  ftgl
  glib2
  glu
  libltc
  libsamplerate
  libsndfile
  lv2
  pango
  ttf-dejavu
)
groups=(
  lv2-plugins
  pro-audio
)
# trim: the stock x42-plugins pkgbase splits into x42-plugins(-standalone)
# JACK applications + LV2 plugins — only the LV2 target is delivered here, so
# the JACK standalone build is disabled (BUILDJACKAPP=no) and its deps
# (jack, liblo, help2man man generation, gendesk desktop generation) are
# dropped together with the x42-plugins.png icon and x42-plugins.{directory,
# menu} assets and the _names/desktop/_pick split machinery
source=(
  https://gareus.org/misc/x42-plugins/x42-plugins-$pkgver.tar.xz
)
sha512sums=('8ea8f68eeb0bbd7365f830026df2a72ae9c2c8f729d6240ae48cce484ee11a1e82d54a04e75b1cb8d35df714404672da70d71f78cd97f309f303ab81fe223131')
b2sums=('8dce3edc1e21fd7d1275c3478d5c60a83d78d97673097230f482968c53d5a016bccbd5184eb55dadfcd2e77936304a4f43c5c5b5e7dd80bd63e48a0dab8acfa3')

prepare() {
  cd $_dir
  # moving images to correct location so installation is not such a hassle later on
  mv -v fat1.lv2/img/x42{_,-}fat1.png
  mv -v fil4.lv2/img/x42{_,-}fil4.png
  mv -v mixtri.lv2/img/x42{_,-}mixtri.png
  mv -v meters.lv2/img/x42-meter{s,}.png
  mv -v matrixmixer.lv2/img/x42-matrixmixer{,8x8}.png
}

build() {
  cd $_dir
  # replace ttf-freefont with ttf-liberation
  export FONTFILE=/usr/share/fonts/TTF/DejaVuSans-Bold.ttf

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  make BUILDJACKAPP=no -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

# trim: upstream lv2lint plugin test run (tests) with its
# kxstudio-lv2-extensions/lv2lint checkdepends — not run in this recipe
package() {
  make BUILDJACKAPP=no PREFIX=/usr DESTDIR="$pkgdir" install -C $_dir

  # trim: keep only the stock x42-plugins-lv2 payload (usr/lib/lv2) — with
  # BUILDJACKAPP=no nothing else should install, this is belt-and-braces
  find "$pkgdir" -mindepth 1 -maxdepth 1 -not -name usr -exec rm -rf {} +
  find "$pkgdir/usr" -mindepth 1 -maxdepth 1 -not -name lib -exec rm -rf {} +
  find "$pkgdir/usr/lib" -mindepth 1 -maxdepth 1 -not -name lv2 -exec rm -rf {} +

  # license: upstream ships one COPYING per plugin (GPL-2 text in 23 dirs,
  # GPL-3 text in darc/dpl) — install one copy of each distinct text
  install -Dm644 $_dir/balance.lv2/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 $_dir/controlfilter.lv2/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING.gpl2-variant"
  install -Dm644 $_dir/darc.lv2/COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING.gpl3"
}
