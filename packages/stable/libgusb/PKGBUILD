# Maintainer: Maxime Gauduin <alucryd@archlinux.org>
# Contributor: Ionut Biru <ibiru@archlinux.org>

pkgbase=libgusb
pkgname=(
  libgusb
)
# trim: the libgusb-docs split is dropped — the gi-docgen API docs are not
# shipped (docs=false in build()); only the library output stays
pkgver=0.4.9
pkgrel=2
pkgdesc='GObject wrapper for libusb1'
url=https://github.com/hughsie/libgusb
arch=(x86_64)
license=(LGPL-2.1-or-later)
depends=(
  glib2
  libjson-glib-1.0.so
  libusb-1.0.so
)
# trim: gi-docgen (makedepends) went with the libgusb-docs split (docs)
makedepends=(
  git
  gobject-introspection
  meson
  umockdev
  vala
)
source=(git+https://github.com/hughsie/libgusb.git#tag=${pkgver})
sha256sums=('27ac4dd41aa0279416bc74f8d195339d439bd9fc0a9f6a0dc9745a07d251c942')

build() {
  local meson_options=(
    # trim: gi-docgen API docs — Class B trim standard (docs)
    -D docs=false
  )

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  arch-meson libgusb build "${meson_options[@]}"
  ninja -j "${GSA_BUILD_JOBS:-$(nproc)}" -C build
}

check() {
  meson test -C build --print-errorlogs
}

package_libgusb() {
  provides=(libgusb-1.0.so)

  DESTDIR="${pkgdir}" ninja -C build install

  # license: ship the upstream LGPL-2.1-or-later text
  local _l
  for _l in COPYING COPYING.LGPL LICENSE; do
    if [[ -f libgusb/$_l ]]; then install -Dm644 "libgusb/$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}

