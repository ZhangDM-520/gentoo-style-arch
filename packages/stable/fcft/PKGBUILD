# Maintainer: Caleb Maclennan <caleb@alerque.com>
# Contributor: Daniel Eklöf <daniel at ekloef dot se>

# TODO: un-vendor nanosvg, migrate package from AUR and build against that

pkgname=fcft
pkgver=3.3.3
pkgrel=1
pkgdesc='Simple library for font loading and glyph rasterization'
arch=(x86_64)
url=https://codeberg.org/dnkl/${pkgname}
license=(MIT)
depends=(fontconfig
         freetype2
         harfbuzz
         libutf8proc
         pixman)
makedepends=(meson
             scdoc
             tllist)
checkdepends=(ttf-dejavu)
provides=(libfcft.so)
source=("$pkgname-$pkgver.tar.gz::$url/archive/$pkgver.tar.gz")
# Codeberg/Forgejo re-serialized the 3.3.3 archive on 2026-10-06 (server
# side; same source tree — verified byte-identical to tag 3.3.3, commit
# 38de2ae, via diff -r against a fresh tag clone; annotated tag object
# 24591f1 unmoved since 2025-12-27). The sum tracks the re-emitted bytes
# (re-verified from a fresh download 2026-10-07; the immutable-rev
# archive hashes identically). Not cache poison, not source drift.
sha256sums=('b0c0f4a599f43723736c8565b8b84337c4195077f07f1bb8bb3252bb13a2306a')

build() {
	arch-meson $pkgname build \
		-Dgrapheme-shaping=enabled \
		-Drun-shaping=enabled
}

check() {
	meson test -C build
}

package() {
	meson install -C build --destdir "$pkgdir"

	# trim: docs/man — this library recipe ships the shared lib + headers
	rm -rf "$pkgdir/usr/share/doc" "$pkgdir/usr/share/man"

	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" "$pkgname/LICENSE"
	install -Dm0644 "$pkgname/unicode/license.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.unicode"
}
