# Maintainer: Sergej Pupykin <pupykin.s+arch@gmail.com>
# Maintainer: William Rea <sillywilly@gmail.com>

pkgname=gloox
pkgver=1.0.28
pkgrel=1
pkgdesc="C++ libraries for development of Jabber client/component/server"
arch=(x86_64)
url="https://camaya.net/gloox"
license=("GPL")
depends=('libidn' 'gnutls')
# House standard: bare soname provide per ELF output (never pinned).
# Upstream soname is libgloox.so.18 (libtool -version-info 18:0:0).
provides=(libgloox.so)
source=(https://camaya.net/download/gloox-$pkgver.tar.bz2)
sha256sums=('591bd12c249ede0b50a1ef6b99ac0de8ef9c1ba4fd2e186f97a740215cc5966c')

build() {
  cd "$srcdir"/gloox-$pkgver

  # House style: mold linker when available
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd "$srcdir"/gloox-$pkgver
  make DESTDIR="$pkgdir" install

  # license: ship the upstream licence text(s) (GPL)
  local _l
  for _l in COPYING LICENSE; do
    if [[ -f $_l ]]; then install -Dm644 "$_l" -t "$pkgdir/usr/share/licenses/$pkgname/"; fi
  done
}
