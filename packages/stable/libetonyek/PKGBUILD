# Contributor: Yue

# trim: the libetonyek-doc split (doxygen API docs) is dropped together with
# its doxygen makedep and its docs/doxygen install path — single output only
pkgbase=libetonyek
pkgname=(libetonyek)
pkgver=0.1.13
pkgrel=3
pkgdesc='Library and a set of tools for reading and converting Apple Keynote presentations'
arch=('x86_64')
url="https://wiki.documentfoundation.org/DLP/Libraries/libetonyek"
license=('MPL-2.0')
makedepends=(
  'boost' 'glibc' 'glm' 'gperf' 'liblangtag'
  'librevenge' 'libxml2' 'mdds' 'zlib'
)
provides=('libetonyek-0.1.so')
source=(https://dev-www.libreoffice.org/src/$pkgname/$pkgname-$pkgver.tar.xz
        mdds3.patch)
sha256sums=('032b71cb597edd92a0b270b916188281bc35be55296b263f6817b29adbcb1709'
            'cd390fa4280b78fd0d1a7f587ab576d8ef0c4848036c8b0c821b576c6745db17')

prepare() {
  cd $pkgbase-$pkgver
  patch -Np0 -i ../mdds3.patch
  autoreconf -vfi
}

build() {
  cd $pkgbase-$pkgver
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"
  # trim: unit tests (cppunit), doxygen API docs and fuzz targets — only the
  # shipped tools remain (default --with-tools)
  ./configure --prefix=/usr --with-mdds=3.0 --disable-tests --without-docs --disable-fuzzers
  make
}

package() {
  depends=('libxml2' 'zlib' 'librevenge' 'liblangtag' 'libstdc++' 'libgcc' 'glibc')

  cd $pkgbase-$pkgver
  make DESTDIR="$pkgdir" install-exec install-pkgconfDATA
  make -C inc/libetonyek DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir"/usr/share/licenses/$pkgname/
}
