    usr/lib/gstreamer-1.0/libgstmpeg2dec.so
    usr/lib/gstreamer-1.0/libgstrealmedia.so
    usr/lib/gstreamer-1.0/libgstx264.so

    usr/share/gstreamer-1.0/presets/GstX264Enc.prs

    usr/share/locale/*/LC_MESSAGES/gst-plugins-ugly-1.0.mo
  ); _install
}

package_gst-libav() {
  pkgdesc+=" - libav plugin"
  provides=(
    # house idiom: bare soname (makepkg auto-versions it from the built ELF)
    # + at most a $pkgver name provide; the stock
    # 'gst-ffmpeg=$pkgver-$pkgrel' pin is dropped (deviation noted: the old
    # gst-libav recipe pinned the release too — only $pkgver is kept here)
    gst-ffmpeg=$pkgver
    libgstlibav.so
  )
  depends=(
    gst-plugins-base-libs=$pkgver-$pkgrel
    gstreamer=$pkgver-$pkgrel
    ffmpeg
    glib2
    glibc
  )

  cd root; local files=(
    usr/lib/gstreamer-1.0/libgstlibav.so
  ); _install
}

