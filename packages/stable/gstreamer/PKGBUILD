# trim: gstreamer-docs split (prebuilt gi-docgen/devhelp HTML from the
# gstreamer-docs tarball) dropped together with its package function and its
# root-leftover install-check; the docs tarball stays in source=() and is
# still fetched, now unused. Upstream meson test suite (xvfb) trimmed below.
source=(
  "git+https://gitlab.freedesktop.org/gstreamer/gstreamer.git?signed#tag=$pkgver"
  "https://gstreamer.freedesktop.org/src/gstreamer-docs/gstreamer-docs-$pkgver.tar.xz"{,.asc}

  # Disable broken tests
  0001-HACK-meson-Disable-broken-tests.patch

  # https://gitlab.freedesktop.org/gstreamer/gstreamer/-/merge_requests/12148
  0002-faac-support-faac-2.0-faac_-API.patch
)
