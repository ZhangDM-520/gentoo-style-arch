# Maintainer: Pierre Schmitz <pierre@archlinux.de>

pkgname=openssl
pkgver=3.6.5
pkgrel=1.1
pkgdesc='The Open Source toolkit for cryptography and Transport Layer Security'
arch=('x86_64')
url='https://www.openssl.org'
license=('Apache-2.0')
depends=('brotli' 'glibc' 'zlib' 'zstd')
makedepends=('perl')
optdepends=('ca-certificates' 'perl')
replaces=('openssl-perl' 'openssl-doc')
provides=('libcrypto.so' 'libssl.so')
backup=('etc/ssl/openssl.cnf')
source=("https://github.com/${pkgname}/${pkgname}/releases/download/${pkgname}-${pkgver}/${pkgname}-${pkgver}.tar.gz"{,.asc}
        'ca-dir.patch')
sha256sums=('a2157c2830efdec3788939b00c9b0638306d3f0bbb76dc4832ee503bb397df98'
            'SKIP'
            '0a32d9ca68e8d985ce0bfef6a4c20b46675e06178cc2d0bf6d91bd6865d648b7')
validpgpkeys=('EFC0A467D613CB83C7ED6D30D894E2CE8B3D79F5'
              'BA5473A2B0587B07FB27CF2D216094DFD0CB81EF'
              'B146647E45A7B33947AB226B2A2C87D161692D40')

prepare() {
	cd "$srcdir/$pkgname-$pkgver"

	# set ca dir to /etc/ssl by default
	patch -Np1 -i "$srcdir/ca-dir.patch"
}

build() {
	cd "$srcdir/$pkgname-$pkgver"

	local _platform="linux-$CARCH"
	case "${CARCH}" in
	"riscv64")
		_platform="linux64-$CARCH"
		;;
	esac

	# House style: mold linker when available.
	# OpenSSL's Configure consumes CFLAGS/LDFLAGS from the environment.
	local _mold=""
	command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
	export LDFLAGS+=" ${_mold}"

	./Configure --prefix=/usr --openssldir=/etc/ssl --libdir=lib \
		shared enable-ktls enable-brotli enable-zlib enable-zstd \
		enable-ec_nistp_64_gcc_128 no-docs ${_platform}

	make depend
	make
}

check() {
	cd "$srcdir/$pkgbase-$pkgver"
	local _test_jobs="${GSA_BUILD_JOBS:-$(nproc)}"

	# the test fails due to missing write permissions in /etc/ssl
	# revert this patch for make test
	patch -Rp1 -i "$srcdir/ca-dir.patch"

	if [[ "${CARCH}" == "riscv64" ]] || [[ "${CARCH}" == "aarch64" ]]; then
		# https://github.com/openssl/openssl/issues/12242
		make HARNESS_JOBS=$_test_jobs TESTS=-test_afalg test
	else
		make HARNESS_JOBS=$_test_jobs test
	fi


	patch -Np1 -i "$srcdir/ca-dir.patch"
	# re-run make to re-generate CA.pl from the patched .in file.
	make apps/CA.pl
}

package() {
	cd "$srcdir/$pkgname-$pkgver"

	# no-docs (2026-09-07): install_man_docs needed pod2man, which Perl 5.42
	# moved to /usr/bin/core_perl — PATH-dependent inside fakeroot/make and
	# died with "command not found". House style is docs trims; install_sw +
	# install_ssldirs cover everything functional.
	make DESTDIR="$pkgdir" install_sw install_ssldirs

	chmod 700 "$pkgdir/etc/ssl/private"

	install -D -m644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
}
