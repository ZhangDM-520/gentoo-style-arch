pkgname=mlt
pkgver=7.42.0
pkgrel=1.2
pkgdesc='An open source multimedia framework'
arch=(x86_64)
url='https://www.mltframework.org'
license=(LGPL-2.1-only)
provides=('libmlt-7.so' 'libmlt++-7.so')
# links: the shipped plugin modules link these (rule-54 class —
# optdepends-only or undeclared before). Not trimmable.
depends=(ffmpeg
         fftw
         fontconfig
         gdk-pixbuf2
         glib2
         glibc
         jack
         libebur128
         libepoxy
         libexif
         libgcc
         libglvnd
         libgomp
         libplacebo
         libsamplerate
         libstdc++
         libvorbis
         libx11
         libxml2
         lilv
         movit
         opencv
         pango
         qt6-base
         qt6-svg
         rnnoise
         rtaudio
         rubberband
         sdl2
         sox
         vid.stab
         zlib)
# optionality kept only where nothing shipped LINKS the lib (dlopen/plugin
# sets and bindings): frei0r-plugins, ladspa, python, qt6-5compat, SDL1 stack
optdepends=('frei0r-plugins: for additional effects'
            'ladspa: LADSPA plugins'
            'qt6-5compat: Qt6 plugin'
            'python: python bindings'
            'sdl_image: SDL1 plugin'
            'sdl12-compat: SDL1 plugin')
makedepends=(cmake
             eigen
             ffmpeg
             frei0r-plugins
             gdk-pixbuf2
             git
             imagemagick
             jack
             ladspa
             libdv
             libexif
             libsamplerate
             movit
             opencv
             pango
             python
             qt6-5compat
             qt6-svg
             rnnoise
             rtaudio
             rubberband
             sox
             sdl_image
             swig
             vid.stab)
source=(git+https://github.com/mltframework/mlt#tag=v$pkgver
        git+https://invent.kde.org/graphics/glaxnimate.git
        git+https://github.com/mbasaglia/thorvg.git)
sha256sums=('64d056c11ff0e9872f35fd3c7fc1145b5092d8faf944b2a339b54af3732a2b5f'
            'SKIP'
            'SKIP')

prepare() {
  cd $pkgname
  git submodule init
  git submodule set-url src/modules/glaxnimate/glaxnimate "$srcdir"/glaxnimate
  git -c protocol.file.allow=always submodule update


  cd src/modules/glaxnimate/glaxnimate
  git submodule init
  git submodule set-url external/thorvg/thorvg "$srcdir"/thorvg
  git -c protocol.file.allow=always submodule update external/thorvg/thorvg
}

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # house: pin the system interpreter (uv/pyenv shims lead PATH; NOTE.md 2026-10-10)
  cmake -B build -S $pkgname \
    -DPython_EXECUTABLE=/usr/bin/python \
    -DPython3_EXECUTABLE=/usr/bin/python \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DMOD_OPENCV=ON \
    -DMOD_GLAXNIMATE_QT6=ON \
    -DMOD_QT6=ON \
    -DSWIG_PYTHON=ON
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  # trim: docs/man/locales — lean consumer-rebuild recipe, docs not shipped
  rm -rf "$pkgdir"/usr/share/doc "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale

  install -Dm644 $pkgname/{COPYING,GPL} -t "$pkgdir"/usr/share/licenses/$pkgname/
}
