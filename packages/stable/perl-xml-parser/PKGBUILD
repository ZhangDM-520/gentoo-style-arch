# Maintainer: Eric Bélanger <eric@archlinux.org>

pkgname=perl-xml-parser
pkgver=2.59
pkgrel=1
pkgdesc="Expat-based XML parser module for perl"
arch=('x86_64')
license=('GPL-1.0-or-later' 'Artistic-1.0-Perl')
url="https://github.com/cpan-authors/XML-Parser"
depends=('perl-file-sharedir' 'perl-libwww' 'expat')
makedepends=('git' 'perl-file-sharedir-install' 'perl-devel-checklib')
# trim: test suite (make test below) — its perl-io-string checkdepends is
# dropped together with it
options=('!emptydirs')
source=("git+https://github.com/cpan-authors/XML-Parser.git#tag=${pkgver}")
sha512sums=('0be220504c032c6cef71b8a8b5e8b07c230a26b639a452340894f32633d491c9cbc4f38e06be6b762090d433b74c0cfe0f546d9df14be8316e45b9605de4f533')

build() {
  cd XML-Parser
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  perl Makefile.PL INSTALLDIRS=vendor
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd XML-Parser
  make DESTDIR="${pkgdir}" install
  # house: licence re-homed to /usr/share/licenses (stock installs none)
  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}
