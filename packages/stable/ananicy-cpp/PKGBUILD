# Maintainer: Peter Jung <ptr1337@archlinux.org>
# Contributor: Vladislav Nepogodin (vnepogodin) <vnepogodin@cachyos.org>
# Contributor: Antoine Viallon <antoine@lesviallon.fr>

pkgname=ananicy-cpp
pkgver=1.2.0
pkgrel=1
pkgdesc="Ananicy Cpp is a full rewrite of Ananicy in C++, featuring lower CPU and RAM usage."
arch=(x86_64)
url="https://gitlab.com/ananicy-cpp/ananicy-cpp"
license=('GPL-3.0-or-later')
depends=(
  glibc
  libgcc
  libbpf
  libelf
  libfmt.so
  libspdlog.so
  libstdc++
  pcre2
  systemd
  systemd-libs
  zlib
)
makedepends=(
  bpf
  clang
  cmake
  git
  ninja
  nlohmann-json
)
source=("git+https://gitlab.com/ananicy-cpp/ananicy-cpp.git#tag=v${pkgver}")
sha512sums=('f1e5c0308d0c6f4c5d56af858e2fcbc3a8a835ecb8a5d78b726d8663d9e7039e8cfb6ae33463c4f42bbe5f27f90bdaaba73f9628bf485c3cb6b6ea605764c29c')

prepare() {
  cd "${srcdir}/${pkgname}"
  # run #82 wall (rule 37 family): the toolchain stopped pulling
  # <cstdint>/<cstring>/<unistd.h> transitively, so std::intN_t / std::mem*
  # / std::strerror / getpid stopped resolving all over this pinned v1.2.0
  # tree. Sweep every translation unit that uses a symbol without the direct
  # header (idempotent: grep-guarded, so a dirty src/ re-run adds nothing).
  local _f
  for _f in $(grep -rlE 'std::(u?int[0-9]+_t)' src include --include='*.cpp' --include='*.hpp' --include='*.h'); do
    grep -q '#include <cstdint>' "$_f" || sed -i '1s/^/#include <cstdint>\n/' "$_f"
  done
  for _f in $(grep -rlE 'std::(memset|memcpy|memmove|strerror|strlen|strcmp)\b' src include --include='*.cpp' --include='*.hpp' --include='*.h'); do
    grep -q '#include <cstring>' "$_f" || sed -i '1s/^/#include <cstring>\n/' "$_f"
  done
  for _f in $(grep -rlE '[^_.a-zA-Z](getpid|gettid)\s*\(' src include --include='*.cpp' --include='*.hpp' --include='*.h'); do
    grep -q '#include <unistd.h>' "$_f" || sed -i '1s/^/#include <unistd.h>\n/' "$_f"
  done
}
build() {
  cd "${srcdir}/${pkgname}"
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  cmake -S . -Bbuild \
        -GNinja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DUSE_EXTERNAL_SPDLOG=ON \
        -DUSE_EXTERNAL_JSON=ON \
        -DUSE_EXTERNAL_FMTLIB=ON \
        -DENABLE_SYSTEMD=ON \
        -DUSE_BPF_PROC_IMPL=ON \
        -DBPF_BUILD_LIBBPF=OFF \
        -DENABLE_REGEX_SUPPORT=ON \
        -DVERSION=${_pkgver}

  cmake --build build --target ananicy-cpp -j "${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  cd "${srcdir}/${pkgname}"
  DESTDIR="${pkgdir}" cmake --install build --component Runtime

  install -m755 -d "${pkgdir}/etc/ananicy.d"

  # trim: man/locales — lean consumer-rebuild recipe
  rm -rf "${pkgdir}/usr/share/man" "${pkgdir}/usr/share/locale"

  # license: ship upstream licence text (GPL-3.0-or-later)
  local _l
  for _l in COPYING COPYING.GPLv3 LICENSE; do
    if [[ -f $_l ]]; then install -Dm644 "$_l" -t "${pkgdir}/usr/share/licenses/${pkgname}/"; fi
  done
}

