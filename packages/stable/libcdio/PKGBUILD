# Maintainer: Jan Alexander Steffens (heftig) <jan.steffens@gmail.com>
# Contributor: damir <damir@archlinux.org>

pkgname=libcdio
pkgver=2.4.0
pkgrel=1.1
pkgdesc="GNU Compact Disc Input and Control Library"
url="https://www.gnu.org/software/libcdio/"
arch=(x86_64)
license=(GPL-3.0-or-later)
depends=(
  glibc
  libgcc
  libstdc++
  ncurses
)
makedepends=(
  git
  help2man
)
provides=(libcdio.so
          libcdio++.so
          libiso9660.so
          libiso9660++.so
          libudf.so)
source=(
  "git+https://github.com/libcdio/libcdio#tag=${pkgver/[a-z]/.&}"
)
b2sums=('dc718b1bc62a7f4cb4171b19a4baa6983df97f7eade0d0e9310d175d762837388dc75f666c159d0ad140bfadeece8d3220fdb50df440007f4595f999c7b320ce')
validpgpkeys=(
  DAA63BC2582034A02B923D521A8DE5008275EC21 # R. Bernstein <rocky@panix.com>
)

prepare() {
  cd $pkgname
  autoreconf -fvi
}

build() {
  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local configure_options=(
    --prefix=/usr
    --sysconfdir=/etc
    --localstatedir=/var
    --disable-cddb
    --enable-cpp-progs
    --enable-maintainer-mode
    --disable-static
    --disable-vcd-info
  )

  cd $pkgname
  ./configure "${configure_options[@]}"
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

check() {
  cd $pkgname
  make -C test check
}

package() {
  cd $pkgname
  make DESTDIR="$pkgdir" install

  # trim: man/info pages and gettext translations (docs/man/locales not shipped)
  rm -rf "$pkgdir"/usr/share/{doc,man,info,locale}

  # license: ship the upstream GPL-3.0-or-later text
  local _lic
  for _lic in LICENSE COPYING; do
    if [[ -f $pkgname/$_lic ]]; then
      install -Dm644 "$pkgname/$_lic" -t "$pkgdir/usr/share/licenses/$pkgname/"
    fi
  done
}

