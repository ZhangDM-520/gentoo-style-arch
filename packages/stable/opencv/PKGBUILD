prepare() {
  pushd opencv
  patch -p1 < ../vtk9.patch # Don't require all vtk optdepends
  # https://github.com/opencv/opencv/issues/27223
  # https://bugreports.qt.io/browse/QTBUG-134774
  sed -i 's/add_definitions(${Qt${QT_VERSION_MAJOR}${dt_dep}_DEFINITIONS})/link_libraries(${Qt${QT_VERSION_MAJOR}${dt_dep}})/' modules/highgui/CMakeLists.txt
  # OpenCV passes all CXXFLAGS to nvcc through -Xcompiler, which does not work for '-Wp,something' flags
  # We remove the -Xcompiler and pass our CXXFLAGS through cmake's CUDAFLAGS
  patch -p1 < ../fix-cuda-flags.patch
  git cherry-pick -n a18356853d99a67e432e818cf0328b4690d68833 # https://github.com/opencv/opencv/issues/29292
#  git cherry-pick -n 142801f769ed4946a161f62738bac5a5fe56a60f # https://github.com/opencv/opencv/issues/29291
#  git cherry-pick -n 883f8d83ae1463a5f486ace784762e8c42e7ea7d # https://github.com/opencv/opencv/issues/29471
  patch -p1 < ../fix-dnn-umat-dimensions.patch # Fix face recognition in digikam
  patch -p1 < ../ffmpeg-9.patch # Fix build with FFmpeg 9
  popd

  pushd opencv_contrib
  patch -p1 < ../fix-std.patch
}

build() {
  export JAVA_HOME="/usr/lib/jvm/default"

  # House style: mold linker when available
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  local cmake_options=(
    -DWITH_OPENCL=ON
    -DWITH_OPENGL=ON
    -DOpenGL_GL_PREFERENCE=LEGACY
    -DWITH_TBB=ON
    -DWITH_VULKAN=ON
    -DWITH_QT=ON
    -DWITH_JPEGXL=ON
    -DBUILD_TESTS=OFF
    -DBUILD_PERF_TESTS=OFF
    # trim: examples disabled with the opencv-samples split output
    -DBUILD_EXAMPLES=OFF
#    -DBUILD_PROTOBUF=OFF
#    -DPROTOBUF_UPDATE_FILES=ON
    -DINSTALL_C_EXAMPLES=OFF
    -DINSTALL_PYTHON_EXAMPLES=OFF
    -DCMAKE_INSTALL_PREFIX=/usr
    -DOPENCV_EXTRA_MODULES_PATH="$srcdir"/opencv_contrib/modules
    -DOPENCV_SKIP_PYTHON_LOADER=ON
    # cmake's FindLAPACK doesn't add cblas to LAPACK_LIBRARIES, so we need to specify them manually
    -DLAPACK_LIBRARIES="/usr/lib/liblapack.so;/usr/lib/libblas.so;/usr/lib/libcblas.so"
    -DLAPACK_CBLAS_H=/usr/include/cblas.h
    -DLAPACK_LAPACKE_H=/usr/include/lapacke.h
    -DOPENCV_GENERATE_PKGCONFIG=ON
    -DOPENCV_ENABLE_NONFREE=ON
    -DOPENCV_JNI_INSTALL_PATH=lib
    -DOPENCV_GENERATE_SETUPVARS=OFF
    -DEIGEN_INCLUDE_PATH=/usr/include/eigen3
    -Dprotobuf_MODULE_COMPATIBLE=ON
    -DHDF5_NO_FIND_PACKAGE_CONFIG_FILE=ON
  )

  if [[ ${CARCH} == x86_64* ]]; then
    cmake_options+=(
      -DCPU_BASELINE_DISABLE=SSE3
      -DCPU_BASELINE_REQUIRE=SSE2
    )
  fi

  cmake -B build -S $pkgname "${cmake_options[@]}" \
    -DBUILD_WITH_DEBUG_INFO=ON
  cmake --build build

  # trim: the build-cuda tree (cuda_archs list, CUDAFLAGS handling and the
  # second cmake run) dropped together with the opencv-cuda and
  # python-opencv-cuda split outputs
}

package_opencv() {
  DESTDIR="$pkgdir" cmake --install build

  # trim: examples/samples — opencv-samples split output dropped together
  # with its staging; no sample tree ships in this output
  rm -rf "$pkgdir"/usr/share/opencv5/samples

  # Add java symlinks expected by some binary blobs
  ln -sr "$pkgdir"/usr/share/java/{opencv5/opencv-${pkgver//./},opencv}.jar
  ln -sr "$pkgdir"/usr/lib/{libopencv_java${pkgver//./},libopencv_java}.so

  # Split Python bindings
  # trim: python bindings payload dropped together with the python-opencv
  # and python-opencv-cuda split outputs
  rm -r "$pkgdir"/usr/lib/python3*

  # trim: docs/man/locales — lean consumer-rebuild recipe, docs not shipped
  rm -rf "$pkgdir"/usr/share/doc "$pkgdir"/usr/share/man "$pkgdir"/usr/share/locale

  install -Dm644 opencv/LICENSE -t "$pkgdir"/usr/share/licenses/$pkgname/
}

# trim: dropped the opencv-samples, python-opencv, opencv-cuda and
# python-opencv-cuda split outputs with their depends/provides/conflicts/
# options and install paths TOGETHER (this single-output recipe packages
# only opencv)
