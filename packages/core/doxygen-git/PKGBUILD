# Maintainer: Wouter Haffmans <wouter@simply-life.net>
pkgname=doxygen-git
pkgver=1.18.0.r182.gd4fe2eb0
pkgrel=1
pkgdesc="A documentation system for C++, C, Java, IDL and PHP - git version"
arch=('i686' 'x86_64')
url="http://www.doxygen.org"
license=('GPL2')
# Qt required for doxywizard - prefer Qt6
depends=('gcc-libs')
makedepends=('git' 'cmake' 'perl' 'flex' 'bison' 'python')
optdepends=('graphviz: enable dot support')
conflicts=('doxygen')
provides=("doxygen=${pkgver}")
replaces=('doxygen-svn')
source=("$pkgname"::'git+https://github.com/doxygen/doxygen.git')
md5sums=('SKIP')

prepare() {
    cd "$pkgname"
    # upstream regression: src/util.h declares openOutputFile(..., std::ofstream &)
    # without including <fstream> (relied on a transitive libstdc++ include that
    # GCC 17 no longer provides). Drop this once upstream adds the include.
    grep -q '#include <fstream>' src/util.h || \
        sed -i 's/^#include <variant>$/#include <fstream>\n#include <variant>/' src/util.h
}

pkgver() {
    cd "$pkgname"
    git describe --long --abbrev=8 | sed 's/^Release_//;s/_/./g;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
    mkdir -p "build"
    cd "build"

    # Phase 1: Generate profile data
    # No CMAKE_*_COMPILER_LAUNCHER=ccache here: with makepkg's ccache farm on
    # PATH the compiler already IS /usr/lib/ccache/bin/cc, and the extra
    # launcher wraps it as `ccache <farm-path>` — a key pinned to the farm
    # symlink's frozen mtime, so compiler-cache entries survive toolchain
    # updates and replay stale LTO bytecode (run #68 wall, GCC 16.2.1 stream
    # into a 17.0.0 link).
    cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -Dbuild_wizard=NO \
        -Dbuild_search=NO \
        -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold -fprofile-generate" \
        -DCMAKE_C_FLAGS="-fprofile-generate" \
        -DCMAKE_CXX_FLAGS="-fprofile-generate" \
        "../$pkgname"
    make

    # Run doxygen on a minimal project to generate profile data
    mkdir -p /tmp/doxygen-pgo-test/src
    cat > /tmp/doxygen-pgo-test/Doxyfile << 'EOF'
PROJECT_NAME = pgo_test
INPUT = /tmp/doxygen-pgo-test/src
OUTPUT_DIR = /tmp/doxygen-pgo-test/output
QUIET = YES
EOF
    cat > /tmp/doxygen-pgo-test/src/main.cpp << 'EOF'
/** @brief A test function */
int main() { return 0; }
EOF
    ./bin/doxygen /tmp/doxygen-pgo-test/Doxyfile 2>/dev/null || true
    rm -rf /tmp/doxygen-pgo-test

    # Verify profile data
    local gcda_count=$(find . -name '*.gcda' | wc -l)
    if [ $gcda_count -eq 0 ]; then
        echo "Warning: No profile data generated, skipping PGO"
        return 0
    fi
    echo "Profile data generated: $gcda_count .gcda files"

    # Phase 2: Use profile data
    cmake -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
        -Dbuild_wizard=NO \
        -Dbuild_search=NO \
        -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold -fprofile-use" \
        -DCMAKE_C_FLAGS="-fprofile-use" \
        -DCMAKE_CXX_FLAGS="-fprofile-use" \
        "../$pkgname"
    make clean
    make
}

package() {
    cd "build"
    make DESTDIR="$pkgdir/" install
}
