# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-tools
# placeholder — overridden by pkgver() (git describe on dev branch)
pkgver=6.13.0_r7576.gbbf76d83a
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='A cross-platform application and UI framework (Development Tools, QtHelp)'
depends=(glibc
         libstdc++
         litehtml
         qt6-base
         zstd)
makedepends=(clang
             cmake
             git
             llvm
             ninja
             qt6-declarative
             vulkan-headers)
optdepends=('clang: for qdoc and lupdate'
            'qt6-declarative: for qdistancefieldgenerator, qdoc and lupdate')
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#branch=dev
        git+https://code.qt.io/playground/qlitehtml)
# llvm22.patch DROPPED 2026-09-04: it targeted the 6.11.2 branch + llvm 22;
# dev qttools tracks new clang natively and we build against llvm-git 24.
sha256sums=('SKIP'
            'SKIP')

prepare() {
  cd $_pkgfn
  git submodule init
  git submodule set-url src/assistant/qlitehtml "$srcdir"/qlitehtml
  git -c protocol.file.allow=always submodule update

# Support litehtml 0.10
  cd src/assistant/qlitehtml
  git checkout 1f56cfe0a8e9a8a99072e0d325632bd8dc0e20d3
}

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DQT_INSTALL_XDG_DESKTOP_ENTRIES=ON \
    -DQLITEHTML_USE_SYSTEM_LITEHTML=ON \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

pkgver() {
  cd $_pkgfn
  # git describe is UNUSABLE on Qt dev branches: release tags (6.8+) live on
  # the 'release' branch, not in dev ancestry — describe finds ancient tags.
  # Read the real module version from .cmake.conf instead (pyside6 precedent).
  _ver="$(grep -m1 -oP 'QT_REPO_MODULE_VERSION\s+"?\K[0-9][0-9.]*' .cmake.conf)"
  echo "${_ver}_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}
