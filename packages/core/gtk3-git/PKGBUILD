# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package_gtk3-git. A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"
_pkg="gtk"
_project="gnome"
_pkgbase="${_pkg}3"
pkgbase="${_pkgbase}-git"
pkgname=(
  "${pkgbase}"
)
pkgver=3.24.52.r67.g2776f156e2
pkgrel=1
pkgdesc="GObject-based multi-platform GUI toolkit (GIT Version)"
arch=($CARCH)
url="http://www.${_pkg}.org/"
license=(
  'LGPL-2.0-only')
depends=(
  'at-spi2-atk'
  'atk'
  'cairo'
  'glib2'
  "${_pkg}-update-icon-cache"
  'libcups'
  'libepoxy'
  'libxcomposite'
  'libxcursor'
  'libxdamage'
  'libxi'
  'libxinerama'
  'libxkbcommon'
  'libxrandr'
  'pango'
  'shared-mime-info'
  'wayland'
  'wayland-protocols'
  'iso-codes'
  'tracker3'
  'libcloudproviders'
)
makedepends=(
  'gobject-introspection' 'git' 'libcolord' 'meson' 'sassc')
# colord notes: stock 'colord' is the daemon split and cannot be installed
# beside house libcolord-git (its internal libcolord dep is exact-version);
# the daemon was deliberately trimmed there (client library only). Neither
# gtk3 nor its print backends link libcolord (measured), so the daemon is
# not a runtime dep — the -D colord=yes D-Bus glue idles without it. The
# build auto-detects colord.pc from libcolord, hence the makedepends name.
optdepends=(
  "${_project}-icon-theme: Default icon theme"
  "${_project}-themes-standard: Default widget theme")
conflicts=('gtk3')
provides=("gtk3=${pkgver}")
backup=("usr/share/${_pkg}-3.0/settings.ini")
_http="https://gitlab.${_project}.org"
_ns="GNOME"
_url="${_http}/${_ns}/${_pkg}"
_local="file://${HOME}/${_pkg}"
source=(
  "git+${_url}.git#branch=${_pkg}-3-24"
  # "git+${_local}#branch=${_pkg}-3-24"
  settings.ini
  "${_pkg}-query-immodules-3.0.hook"
  cups-2.5-enum-compat.patch
)
sha256sums=('SKIP'
            '01fc1d81dc82c4a052ac6e25bf9a04e7647267cc3017bc91f9ce3e63e5eb9202'
            'a0319b6795410f06d38de1e8695a9bf9636ff2169f40701671580e60a108e229'
            'c4de1db9592876479463b253091272de47488529265933a43efd22c538a866d3')

pkgver() {
  cd \
    "${_pkg}"
  git \
    describe \
    --long | \
    sed \
      -r \
        's/([^-]*-g)/r\1/;s/-/./g'
}

prepare() {
  cd "${_pkg}"
  # cups >= 2.5 renamed the IPP/HTTP enums but still reports major version 2,
  # falling into gtk3's legacy-name shims (upstream only knows cups 2.x-old
  # and libcups3). Rerun-safe over a dirty checkout: restore the paths first.
  git checkout -- modules/printbackends/cups
  patch -Np1 -i "$srcdir/cups-2.5-enum-compat.patch"
}

_meson_options=(
  -D broadway_backend=false
  -D cloudproviders=false
  -D colord=yes
  -D gtk_doc=false
  -D introspection=true
  -D man=false
  -D tracker3=true
  -D b_ndebug=true
)

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  CFLAGS+=" -DG_DISABLE_CAST_CHECKS"
  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1: PGO instrumented build
  # pgo_min_gcda: ≈ minimum distinct TUs the training suite touches before a
  # profile is worth trusting; below it the profile is too thin and we fall
  # back to an LTO-only build.
  local pgo_min_gcda=100
  CFLAGS+=" -fprofile-generate" CXXFLAGS+=" -fprofile-generate"
  arch-meson \
    "${_pkg}" \
    build \
      "${_meson_options[@]}" \
      -Db_lto=false
  meson compile -C build

  # Phase 2: training — bounded run (lib/pgo.sh); display-class suite like
  # gtk4-git, so prefer a virtual display when the host has none.
  pgo_train_meson --display-suite build 120

  # Phase 3: verify profile quality
  local _gcda_count
  _gcda_count="$(find build -name '*.gcda' 2>/dev/null | wc -l)"
  if ((_gcda_count < pgo_min_gcda)); then
    warning "PGO produced only %d gcda files — rebuilding with LTO only" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "${_pkg}" build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    export CFLAGS="$_final_cflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    export CXXFLAGS="$_final_cxxflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    export LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "${_pkg}" build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  fi
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir \
      -p \
      "$(dirname \
           "${d}")"
    mv \
      "${f}" \
      "$d"
    rmdir \
      -p \
      --ignore-fail-on-non-empty \
      "$(dirname \
           "${f}")"
  done
}

package_gtk3-git() {
  depends+=(
    "${_pkg}-update-icon-cache")
  optdepends=(
    'evince: Default print preview command')
  provides=(
    "gtk3=${pkgver}"
    "${_pkgbase}-print-backends"
    libgailutil-3.so
    libgdk-3.so
    "lib${_pkg}-3.so"
  )
  conflicts=(
    "gtk3"
    "${_pkgbase}-print-backends")
  replaces=(
    "${_pkgbase}-print-backends<=3.22.26-1")
  install="${pkgbase}.install"

  meson \
    install \
      -C build \
      --destdir "${pkgdir}"

  install \
    -Dm644 \
    /dev/stdin \
    "${pkgdir}/usr/share/${_pkg}-3.0/settings.ini" <<END
[Settings]
${_pkg}-icon-theme-name = Adwaita
${_pkg}-theme-name = Adwaita
gtk-font-name = Cantarell 11
END

  install \
    -Dt \
    "${pkgdir}/usr/share/libalpm/hooks" \
    -m644 \
    "${_pkg}-query-immodules-3.0.hook"

  cd \
    "${pkgdir}"

  # Built by GTK 4, shared with GTK 3
  rm -f \
    "usr/bin/${_pkg}-update-icon-cache"
  rm -f \
    "usr/share/man/man1/${_pkg}-update-icon-cache.1"

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may be
  # added to $pkgdir after the payload is verified.
  verify_no_profile_instrumentation "$pkgdir"
}

