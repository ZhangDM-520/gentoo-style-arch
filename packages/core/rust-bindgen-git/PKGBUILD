pkgname=rust-bindgen-git
_pkgname=bindgen
# WEEKLY SNAPSHOT policy (rule 64, 2026-11-01): core ABI provider (bindgen
# consumes libclang) — pin = last commit at or before Monday 00:00 UTC of
# the current week (boundary 2026-10-26T00:00Z =
# f08d4fff0e060fb4081222b0ad624e0bd7ec247d, commit date 2026-10-16T11:44Z).
# ADVANCE THE PIN on the Monday cadence together with the llvm coupled set:
# move #commit= and pkgver together (pkgver() recomputes the same value at
# the pin).
pkgver=0.73.2.r17.gf08d4fff
pkgrel=1
pkgdesc="Automatically generates Rust FFI bindings to C (and some C++) libraries"
arch=('x86_64')
url="https://github.com/rust-lang-nursery/rust-bindgen"
license=('BSD-3-Clause')
depends=('glibc' 'libgcc' 'clang')
makedepends=('cargo' 'git')
provides=("rust-bindgen=$pkgver")
conflicts=('rust-bindgen')
source=("git+${url}.git#commit=f08d4fff0e060fb4081222b0ad624e0bd7ec247d")
sha512sums=('SKIP')

pkgver() {
  cd "rust-bindgen"
  git describe --long --tags | sed 's/^v//;s/-/.r/;s/-/./g'
}

prepare() {
  cd "rust-bindgen"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  mkdir -p completions
}

build() {
  # House style: native CPU codegen for Rust (only when RUSTFLAGS lacks it)
  if ! grep -q 'target-cpu' <<<"${RUSTFLAGS:-}"; then
    export RUSTFLAGS+=" -C target-cpu=native"
  fi
  cd "rust-bindgen"
  cargo build --release --frozen
  local _completion="target/release/$_pkgname --generate-shell-completions"
  $_completion bash >"completions/$_pkgname"
  $_completion fish >"completions/$_pkgname.fish"
  $_completion zsh >"completions/_$_pkgname"
}

package() {
  cd "rust-bindgen"
  install -Dm755 "target/release/$_pkgname" "$pkgdir"/usr/bin/bindgen
  install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
  install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
  install -Dm664 "completions/$_pkgname" -t "$pkgdir/usr/share/bash-completion/completions/"
  install -Dm664 "completions/$_pkgname.fish" -t "$pkgdir/usr/share/fish/vendor_completions.d/"
  install -Dm664 "completions/_$_pkgname" -t "$pkgdir/usr/share/zsh/site-functions/"
}
