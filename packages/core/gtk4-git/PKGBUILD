pkgver() {
  cd "$_pkgsrc"
  local _pkgver=$(
    git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
      | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
  )
  local _split=(${_pkgver//./ })
  printf '%s.%s.r%s' "${_split[0]}" "$((_split[1] + 1))" "${_pkgver##*.r}"
}

prepare() {
  # Allow -fcf-protection to work
  # https://gitlab.gnome.org/GNOME/gtk/-/issues/6153
  sed -E -e 's&^(\s*can_use_objcopy_for_resources) = \S+$&\1 = false&' \
    -i "$_pkgsrc/meson.build"
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D broadway-backend=false
    -D cloudproviders=disabled
    -D colord=enabled
    -D documentation=false
    -D man-pages=false
    -D tracker=enabled
    -D b_ndebug=true
  )

  CFLAGS+=" -DG_DISABLE_CAST_CHECKS"
  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1: PGO instrumented build
  # pgo_min_gcda: ≈ minimum distinct TUs the training suite touches before a
  # profile is worth trusting; below it the profile is too thin and we fall
  # back to an LTO-only build.
  local pgo_min_gcda=100
  CFLAGS+=" -fprofile-generate" CXXFLAGS+=" -fprofile-generate"
  arch-meson "$_pkgsrc" build "${meson_options[@]}" -Db_lto=false
  meson compile -C build

  # Phase 2: training — bounded run (lib/pgo.sh): wall budget, capped test
  # parallelism, no core dumps (each abort otherwise spawns
  # systemd-coredump). Headless, the gsk-compare rows (8240 of 9665 tests)
  # abort at gtk_init and write zero profiles (measured 2026-10-03) and are
  # scheduled first — drop them so the budget stops feeding the spawn/crash
  # storm that OOM-killed the build unit; the remaining rows are then at
  # worst a bounded version of the same churn. With a display the render
  # rows are the profile input worth having: run the full suite.
  if pgo_display_available; then
    pgo_train_meson --display-suite build 120
  else
    pgo_train_meson build 120 --no-suite gsk-compare
  fi

  # Phase 3: verify profile quality
  local _gcda_count
  _gcda_count="$(find build -name '*.gcda' 2>/dev/null | wc -l)"
  if ((_gcda_count < pgo_min_gcda)); then
    warning "PGO produced only %d gcda files — rebuilding with LTO only" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "$_pkgsrc" build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    export CFLAGS="$_final_cflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    export CXXFLAGS="$_final_cxxflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    export LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "$_pkgsrc" build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  fi
}

_pick() {
  local p="$1" f d
  shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

_package_gtk4() {
  optdepends=('evince: Default print preview command')
  provides=(
    "gtk4=1:${pkgver%%.g*}"
    'libgtk-4.so'
  )
  conflicts=('gtk4')

  meson install -C build --destdir "$pkgdir"

  install -Dm644 /dev/stdin "$pkgdir/usr/share/gtk-4.0/settings.ini" << END
[Settings]
gtk-icon-theme-name = Adwaita
gtk-theme-name = Adwaita
gtk-font-name = Cantarell 11
END

  install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 gtk4-querymodules.hook
  install -D gtk4-querymodules.script "$pkgdir/usr/share/libalpm/scripts/gtk4-querymodules"

  cd "$pkgdir"

  _pick demo usr/bin/gtk4-{demo,demo-application,node-editor,print-editor,widget-factory}
  _pick demo usr/share/applications/org.gtk.{Demo4,PrintEditor4,WidgetFactory4,gtk4.NodeEditor}.desktop
  _pick demo usr/share/glib-2.0/schemas/org.gtk.Demo4.gschema.xml
  _pick demo usr/share/icons/hicolor/*/apps/org.gtk.{Demo4,PrintEditor4,WidgetFactory4,gtk4.NodeEditor}[-.]*
  _pick demo usr/share/metainfo/org.gtk.{Demo4,PrintEditor4,WidgetFactory4,gtk4.NodeEditor}.appdata.xml

  # _pick docs removed 2026-09-04: documentation=false → usr/share/doc never populated

  # Built by GTK 4, shared with GTK 3
  _pick guic usr/bin/gtk4-update-icon-cache
  # man page pick removed 2026-09-04 (man-pages=false)

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may be
  # added to $pkgdir after the payload is verified. The demo/guic splits are
  # gated by their own package functions on their own $pkgdir.
  verify_no_profile_instrumentation "$pkgdir"
}

_package_gtk4-demos() {
  pkgdesc+=" (demo applications)"
  depends=(
    cairo
    dconf
    gdk-pixbuf2
    graphene
    gtk4
    harfbuzz
    hicolor-icon-theme
    libepoxy
    librsvg
    pango
  )
  provides=("gtk4-demos=1:${pkgver%%.g*}")
  conflicts=('gtk4-demos')

  mv demo/* "$pkgdir"

  # Fatal shared gate (lib/pgo.sh) — this split ships binaries (gtk4-demo,
  # widget-factory, ...) and is gated on its own payload, after the move.
  verify_no_profile_instrumentation "$pkgdir"
}

# _package_gtk4-docs removed 2026-09-04 (documentation=false, split disabled)

_package_gtk-update-icon-cache() {
  pkgdesc="GTK icon cache updater"
  depends=(
    gdk-pixbuf2
    hicolor-icon-theme
    librsvg
  )
  provides=("gtk-update-icon-cache=1:${pkgver%%.g*}")
  conflicts=('gtk-update-icon-cache')

  mv guic/* "$pkgdir"

  ln -sr "$pkgdir"/usr/bin/gtk{4,}-update-icon-cache
  # man page symlink only when it was built (-D man-pages=true; false here → skip)
  if [ -f "$pkgdir/usr/share/man/man1/gtk4-update-icon-cache.1" ]; then
    ln -sr "$pkgdir"/usr/share/man/man1/gtk{4,}-update-icon-cache.1
  fi

  install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 gtk-update-icon-cache.hook
  install -D gtk-update-icon-cache.script \
    "$pkgdir/usr/share/libalpm/scripts/gtk-update-icon-cache"

  # Fatal shared gate (lib/pgo.sh) — this split ships the gtk4-update-icon-cache
  # binary and is gated on its own payload, after the move.
  verify_no_profile_instrumentation "$pkgdir"
}

_pkgtype="${pkgbase#$_pkgname}"
pkgname=(
  "gtk4${_pkgtype:-}"
  "gtk4-demos${_pkgtype:-}"
  #"gtk4-docs${_pkgtype:-}"
  "gtk-update-icon-cache${_pkgtype:-}"
)

for _p in "${pkgname[@]}"; do
  eval "package_$_p() {
    $(declare -f "_package_${_p%$_pkgtype}")
    _package_${_p%$_pkgtype}
  }"
done
