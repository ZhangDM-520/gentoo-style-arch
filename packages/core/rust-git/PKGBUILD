# Maintainer: Generic native Rust snapshot build; set GSA_TARGET_CPU for an
# explicit host target when the resulting packages will stay on that machine.
# NOTE: rustc's driver links libLLVM target-init symbols for every target
# present in llvm-libs at BUILD time. Rebuild this package after EVERY
# llvm-git/llvm-libs-git reinstall, or rustc dies with
# "symbol lookup error ... undefined symbol: LLVMInitialize*Target*".

pkgbase=rust-git
pkgname=(
  rust-git
  rust-src-git
)
pkgver=1.101.0.r342246.g0abfedb
pkgrel=1
epoch=1
_target_cpu="${GSA_TARGET_CPU:-}"
pkgdesc="Systems programming language focused on safety, speed and concurrency (git version)"
url=https://www.rust-lang.org/
arch=(x86_64)
license=("Apache-2.0 OR MIT")
depends=(
  bash
  compiler-rt
  curl
  gcc
  glibc
  libgcc
  libgit2
  libssh2
  libstdc++
  lld
  llvm-libs
  openssl
  zlib
)
makedepends=(
  clang
  cmake
  git
  # no `rust`: bootstrap.toml's /usr/bin pins are stripped below precisely so
  # x.py falls back to its DOWNLOADED official stage0 (2026-09-08 recovery),
  # and a stock `rust` makedepend is unresolvable alongside the house
  # llvm-git (rust-libs pins stock llvm-libs exactly; run #70 wall).
  libffi
  llvm
  ninja
  perl
  python
)
# checkdepends (gdb, procps-ng) removed 2026-09-04 — no check() exists
options=(
  !emptydirs
  # !lto: makepkg's LTOFLAGS (-flto=auto) would make the C++ llvm-wrapper
  # objects GCC-LTO GIMPLE, which lld (rustc's gnu-lld-cc default linker)
  # cannot materialize — librustc_driver.so then ships undefined LLVMRust*
  # and stage1 dies on --no-allow-shlib-undefined. Rust-side fat LTO in
  # bootstrap.toml is unaffected.
  !lto
)
source=(
  git+https://github.com/rust-lang/rust.git
  0001-bootstrap-Change-libexec-dir.patch
  0002-bootstrap-Change-bash-completion-dir.patch
  0003-bootstrap-Workaround-for-system-stage0.patch
  0004-compiler-Change-LLVM-targets.patch
  0005-compiler-Use-ld.lld-by-default.patch
  0008-compiler-Swap-primary-and-secondary-lib-dirs.patch
  bootstrap.x86_64.toml
)
b2sums=('SKIP'
        '82fc40bdff90ef33b41d8d2c4e625ba600d830c42d9f46cb397e1de863f756a2c09f3ce877917e16aed7d5edccfa626ba50cc0423b51ed6b58b6b893edd475ac'
        '575d5d895eaf1767de983cd42cbd7d32018be7c03c0df4f0ed79e88463c348034ba9357955e0d9fc153764385cb4969a499a69b3fcef2025d6d642684df0c571'
        '4f0ff61346a77386ce2c56c54fd424838200ea87a83b6d80fb8d93f8804d297d879bd67a51ece88705eb867dad954beaedbc525c6bcb5e6d099802690afa4edb'
        'd587ff9463f09b5e04b556e22f60d0fee204931676f821d5d86b5b67429f158bd2f83693f7ed4d676b14c23ff171b91e7e28b601985e973f2b98fd2419bb704c'
        '7210f6762473d1cdc6a5e2c703be9d6d9aeeb813ec1e1dff099d90497c9fdb6cb8f298f34801bb0ff958fe2ac10635bb8631fa6cebeca203a3863bf789b069f9'
        '991cb47155fb2a0d7969e3e2cbc44d030e9eb13474a38d9c9ad88365ce6ab6ecfb69692dd420d68f439585fa2a6e0139cd6f294b5487b77f6b875b773382a459'
        '64ef4657d265beaf0d1431136a29cf7bd4db840e0a28abc606ff5b83ca71bc7b5f59e20f739c5e8f1a2fa21975fa6749e97659fe8209f71ff74b983dbeb8a823')

COMPRESSZST+=(--long)

pkgver() {
  cd rust
  local _ver="$(cat src/version)"
  _ver="$(echo $_ver | tr -d '[:space:]')"
  printf "%s.r%s.g%s" "$_ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd rust

  git submodule init
  git submodule update

  local src
  for src in "${source[@]}"; do
    src="${src%%::*}"
    src="${src##*/}"
    src="${src%.zst}"
    [[ $src = *.patch ]] || continue
    echo "Applying patch $src..."
    patch -Np1 < "../$src"
  done

  local clangdir
  clangdir="$(clang -print-resource-dir)"
  local compiler_rt_builtins
  compiler_rt_builtins="$(clang -print-file-name=libclang_rt.builtins.a)"
  sed -e "s|%description%|Arch Linux $pkgbase $epoch:$pkgver-$pkgrel|g" \
      -e "s|%clangdir%|$clangdir|g" \
      -e "s|%compiler_rt_builtins%|$compiler_rt_builtins|g" \
      "$srcdir/bootstrap.x86_64.toml" > bootstrap.toml

  sed -i 's/vendor = true/vendor = false/g' bootstrap.toml
  sed -i 's/locked-deps = true/locked-deps = false/g' bootstrap.toml
  sed -i 's/channel = "stable"/channel = "nightly"/g' bootstrap.toml
  # KEEP lto = "fat" from the dist profile — do NOT sed it to "off"; fat LTO +
  # codegen-units=1 is the whole point of a self-built compiler.
  # x.py overrides env RUSTFLAGS. Inject an explicit target only when the
  # caller requests one; the default remains the host's makepkg configuration.
  if [[ -n "$_target_cpu" ]]; then
    sed -i "/^\[rust\]/a rustflags = [\"-C\", \"target-cpu=$_target_cpu\"]" bootstrap.toml
  fi
  sed -i '/rustc = "\/usr\/bin\/rustc"/d' bootstrap.toml
  sed -i '/cargo = "\/usr\/bin\/cargo"/d' bootstrap.toml
  # same rationale as rustc/cargo: the system rustfmt may be ABI-broken while
  # this package is being rebuilt (it links the same librustc_driver); let
  # bootstrap fall back to its stage0 rustfmt instead of invoking a dead binary
  sed -i '/rustfmt = "\/usr\/bin\/rustfmt"/d' bootstrap.toml
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

build() {
  cd rust

  export LIBGIT2_NO_VENDOR=1
  export LIBSSH2_SYS_USE_PKG_CONFIG=1
  export RUST_BACKTRACE=1
  
  # Preserve the caller's architecture and optimization policy. makepkg.conf
  # supplies the normal CFLAGS/CXXFLAGS; only add a harmless pipeline flag.
  export CFLAGS="${CFLAGS:+$CFLAGS }-pipe"
  export CXXFLAGS="${CXXFLAGS:+$CXXFLAGS }-pipe"

  local xpy_options=(
    -j "${GSA_BUILD_JOBS:-$(nproc)}"
  )

  # Start from a clean DESTDIR: a previously failed build() leaves dest-rust
  # mutated (manifests deleted, tool symlinks created, licenses moved), and
  # the next install.sh then dies on `cp: not writing through dangling
  # symlink` and leaks `.old` backups into the package.
  rm -rf "$srcdir/dest-rust" "$srcdir/dest-src"

  echo "Building Rust compiler..."
  DESTDIR="$srcdir/dest-rust" python ./x.py install "${xpy_options[@]}"

  # Upstream abcb9780d6d4 (2026-09-07) renamed the install step from `src`
  # to `rust-src`, and its default run additionally requires
  # [build] extended = true — which this config deliberately does not set.
  # Without this explicit step the rust-src split receives no
  # usr/lib/rustlib/src and _pick below aborts the whole build.
  DESTDIR="$srcdir/dest-rust" python ./x.py install rust-src "${xpy_options[@]}"

  cd ../dest-rust

  # Clean up metadata and install leftovers
  rm -v etc/target-spec-json-schema.json
  rm -v usr/lib/rustlib/{components,install.log,rust-installer-version,uninstall.sh}
  rm -v usr/lib/rustlib/manifest-*

  # Setup documentation licenses
  local ldir="usr/share/licenses/rust" f d
  mkdir -p "$ldir"
  for f in usr/share/doc/*/{COPYRIGHT,LICENSE}*; do
    d="$(dirname "$f")"
    case $f in
      */LICENSE-APACHE) rm -v "$f" ;;
      *) mv -v "$f" "$ldir/${f##*/}.${d##*/}" ;;
    esac
    rmdir -p --ignore-fail-on-non-empty "$d"
  done

  # Target symlinks
  ln -srvft usr/lib usr/lib/rustlib/x86_64-unknown-linux-gnu/lib/*.so

  mkdir -pv usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/gcc-ld
  ln -srvf  usr/bin/lld          usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-lld
  ln -srvf  usr/bin/llvm-objcopy usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/rust-objcopy
  ln -srvft usr/lib/rustlib/x86_64-unknown-linux-gnu/bin/gcc-ld usr/bin/{ld.lld,ld64.lld,lld-link,wasm-ld}

  _pick dest-src usr/lib/rustlib/src
}

_install_licenses() {
  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
    "$srcdir/rust"/{COPYRIGHT,LICENSE-MIT}
}

package_rust-git() {
  depends+=(
    libcurl.so
    libgcc_s.so
    libgit2.so
    libssh2.so
    libssl.so
  )
  optdepends=(
    'gdb: rust-gdb script'
    'lldb: rust-lldb script'
  )
  provides=(
    "cargo=$pkgver"
    "rust=$pkgver"
    "rustfmt=$pkgver"
  )
  conflicts=(
    cargo
    rust
    'rust-docs<1:1.56.1-3'
    rustfmt
  )
  replaces=(
    cargo
    cargo-tree
    'rust-docs<1:1.56.1-3'
    rustfmt
  )

  cp -a dest-rust/* "$pkgdir"
}

package_rust-src-git() {
  pkgdesc="Source code for the Rust standard library (GIT VERSION)"
  depends=(rust-git)
  provides=("rust-src=$pkgver")
  conflicts=(rust-src)

  cp -a dest-src/* "$pkgdir"
  _install_licenses
}
