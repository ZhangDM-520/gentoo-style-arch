pkgver() {
  cd glibc
  git describe --abbrev=12 --tags | sed 's/[^-]*-//;s/[^-]*-/&r/;s/-/+/g'
}

prepare() {
  mkdir -p glibc-build lib32-glibc-build

  # elf/Makefile derives the rtld object set by parsing the librtld link map;
  # the patch guards that parse and pins the one $(CC)-direct link past the
  # recipe's LDFLAGS pin. Both build trees share this source tree: one patch
  # covers glibc-build and lib32-glibc-build.
  patch -Np1 --fuzz=0 -d glibc \
    -i "$srcdir/0001-bfd-relocatable-links-and-librtld-parse-guard.patch"

  # patch can succeed at the wrong offset; assert the contract lines verbatim.
  grep -qF '$(objpfx)librtld.map: $(objpfx)dl-allobjs.os $(common-objpfx)libc_pic.a Makefile' \
    glibc/elf/Makefile &&
    grep -qF 'rtld: remediation: if the map format changed' glibc/elf/Makefile &&
    grep -qF '$(CC) -fuse-ld=bfd -nostdlib -nostartfiles -r -o $@ $^' glibc/csu/Makefile || {
      echo 'ERROR: 0001-bfd-relocatable-links-and-librtld-parse-guard.patch did not land on the librtld map/parse seam; refresh it against the glibc Makefiles' >&2
      return 1
    }

  # Generated link intermediates may predate the bfd pin (mold corrupts
  # versioned symtabs in -r output and drops map-assigned default versions in
  # -shared output, and make never revisits an up-to-date file): drop them so
  # the pinned rules regenerate them. The artifacts they feed go with them.
  local _dir
  for _dir in glibc-build lib32-glibc-build; do
    rm -f "$_dir"/libc_pic.os "$_dir"/libc_pic.opts "$_dir"/libc_pic.os.clean \
      "$_dir"/libc.so "$_dir"/elf/dl-allobjs.os "$_dir"/elf/librtld.map \
      "$_dir"/elf/librtld.mapT "$_dir"/elf/librtld.mapT.o "$_dir"/elf/librtld.mk \
      "$_dir"/elf/librtld.mkT "$_dir"/elf/rtld-libc.a "$_dir"/elf/librtld.os \
      "$_dir"/elf/librtld.os.map "$_dir"/elf/ld.so "$_dir"/elf/ld.so.new
  done
}

build() {
  local configure_flags=(
    --prefix=/usr
    --with-headers=/usr/include
    --with-bugurl=https://gitlab.archlinux.org/archlinux/packaging/packages/glibc/-/issues
    --enable-bind-now
    --enable-fortify-source
    --enable-kernel=4.4
    --enable-multi-arch
    --enable-stack-protector=strong
    --enable-systemtap
    --disable-nscd
    --disable-profile
    --disable-werror
  )

  CFLAGS=${CFLAGS/-Wp,-D_FORTIFY_SOURCE=3/}

  # mold cannot build this package correctly: its link map defeats the
  # librtld member parse, its -r links drop symbol versions from the output
  # symtab, and its -shared links drop map-assigned default versions (missing
  # ABI rows — e.g. open64@@GLIBC_2.1 in the 32-bit libc.so, measured against
  # the installed Arch lib32 oracle). Glibc builds with bfd; every other
  # recipe keeps the host's linker. Appended last: gcc takes the last
  # -fuse-ld= on its command line.
  LDFLAGS+=" -fuse-ld=bfd"

  (
    cd glibc-build

    printf '%s\n' \
      'slibdir=/usr/lib' \
      'rtlddir=/usr/lib' \
      'sbindir=/usr/bin' \
      'rootsbindir=/usr/bin' >>configparms

    "$srcdir/glibc/configure" \
      --libdir=/usr/lib \
      --libexecdir=/usr/lib \
      --enable-cet \
      --enable-sframe \
      "${configure_flags[@]}"

    make -O
    make info
  )

  if [[ $CARCH == x86_64 ]]; then
    (
      cd lib32-glibc-build
      export CC='gcc -m32 -mstackrealign'
      export CXX='g++ -m32 -mstackrealign'

      CFLAGS=${CFLAGS/-fno-omit-frame-pointer -mno-omit-leaf-frame-pointer/}

      printf '%s\n' \
        'slibdir=/usr/lib32' \
        'rtlddir=/usr/lib32' \
        'sbindir=/usr/bin' \
        'rootsbindir=/usr/bin' >>configparms

      "$srcdir/glibc/configure" \
        --host=i686-pc-linux-gnu \
        --libdir=/usr/lib32 \
        --libexecdir=/usr/lib32 \
        "${configure_flags[@]}"

      make -O
    )

    make -C "$srcdir/glibc/localedata" \
      objdir="$srcdir/glibc-build" \
      DESTDIR="$srcdir/locales" \
      install-locale-files
  fi
}

_skip_test() {
  local test=$1
  local file=$2
  sed -i "/\b${test} /d" "$srcdir/glibc/$file"
}

check() (
  cd glibc-build

  sed -i 's/-Werror=format-security/-Wformat-security/' config.make
  sed -i '/CFLAGS/s/-fno-plt//' config.make
  sed -i '/CFLAGS/s/-fexceptions//' config.make

  # These tests require syscall permissions blocked by the Arch build environment.
  # The systemd-nspawn fix is --system-call-filter="@clock @memlock @pkey".
  _skip_test tst-ldconfig-cache elf/Makefile
  _skip_test tst-pthread-gdb-attach nptl/Makefile
  _skip_test tst-pthread-gdb-attach-static nptl/Makefile
  _skip_test test-errno-linux sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-mlock2 sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-ntp_gettime sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-ntp_gettimex sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-pkey sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-mseal-pkey sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-process_mrelease sysdeps/unix/sysv/linux/Makefile
  _skip_test tst-shstk-legacy-1g sysdeps/x86_64/Makefile
  _skip_test tst-adjtime time/Makefile

  make -O check
)

_install_license() {
  # The git tree carries the versioned COPYING files; release tarballs add
  # the legacy COPYING name this used to install. Explicit names so upstream
  # drift fails loudly instead of silently skipping.
  install -Dm644 "$srcdir/glibc/COPYINGv2" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYINGv2"
  install -Dm644 "$srcdir/glibc/COPYINGv3" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYINGv3"
  install -Dm644 "$srcdir/glibc/COPYING.LESSERv2" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING.LESSERv2"
  install -Dm644 "$srcdir/glibc/COPYING.LIB" \
    "$pkgdir/usr/share/licenses/$pkgname/COPYING.LIB"
}

package_glibc-git() {
  pkgdesc='GNU C Library development snapshot'
  depends=('linux-api-headers>=4.10' tzdata filesystem)
  optdepends=(
    'gd: for memusagestat'
    'perl: for mtrace'
  )
  provides=("glibc=$pkgver")
  conflicts=(glibc)
  backup=(
    etc/gai.conf
    etc/locale.gen
    etc/tunables.conf
    etc/tunables.conf.d/shstk.conf
  )

  make -C glibc-build DESTDIR="$pkgdir" install
  rm -f "$pkgdir/etc/ld.so.cache"
  rm -f "$pkgdir"/usr/bin/{tzselect,zdump,zic}

  install -dm755 "$pkgdir/usr/lib/locale"
  install -Dm644 "$srcdir/glibc/posix/gai.conf" "$pkgdir/etc/gai.conf"
  install -Dm755 "$srcdir/locale-gen" "$pkgdir/usr/bin/locale-gen"
  install -Dm644 "$srcdir/locale.gen.txt" "$pkgdir/etc/locale.gen"
  sed -e '1,3d' -e 's|/| |g' -e 's|\\| |g' -e 's|^|#|g' \
    "$srcdir/glibc/localedata/SUPPORTED" >>"$pkgdir/etc/locale.gen"
  sed -e '1,3d' -e 's|/| |g' -e 's| \\||g' \
    "$srcdir/glibc/localedata/SUPPORTED" >"$pkgdir/usr/share/i18n/SUPPORTED"

  install -dm755 "$pkgdir/usr/lib/locale"
  cp -r "$srcdir/locales/usr/lib/locale/C.utf8" -t "$pkgdir/usr/lib/locale"
  sed -i '/#C\.UTF-8 /d' "$pkgdir/etc/locale.gen"

  install -Dm644 "$srcdir/sdt.h" "$pkgdir/usr/include/sys/sdt.h"
  install -Dm644 "$srcdir/sdt-config.h" "$pkgdir/usr/include/sys/sdt-config.h"

  install -Dm644 "$srcdir/10-glibc-locale-gen.hook" \
    "$pkgdir/usr/share/libalpm/hooks/10-glibc-locale-gen.hook"
  install -Dm644 "$srcdir/10-glibc-remove-locale-archive.hook" \
    "$pkgdir/usr/share/libalpm/hooks/10-glibc-remove-locale-archive.hook"
  install -Dm644 "$srcdir/11-glibc-ldconfig.hook" \
    "$pkgdir/usr/share/libalpm/hooks/11-glibc-ldconfig.hook"
  install -Dm644 "$srcdir/11-glibc-remove-ldconfig-cache.hook" \
    "$pkgdir/usr/share/libalpm/hooks/11-glibc-remove-ldconfig-cache.hook"
  install -Dm644 "$srcdir/12-glibc-iconvconfig.hook" \
    "$pkgdir/usr/share/libalpm/hooks/12-glibc-iconvconfig.hook"
  install -Dm644 "$srcdir/12-glibc-remove-iconvconfig-cache.hook" \
    "$pkgdir/usr/share/libalpm/hooks/12-glibc-remove-iconvconfig-cache.hook"
  install -Dm644 "$srcdir/tunables.conf" "$pkgdir/etc/tunables.conf"
  install -Dm644 "$srcdir/shstk.conf" "$pkgdir/etc/tunables.conf.d/shstk.conf"
  _install_license
}

package_lib32-glibc-git() {
  pkgdesc='GNU C Library (32-bit development snapshot)'
  arch=(x86_64)
  depends=("glibc-git=$pkgver")
  provides=("lib32-glibc=$pkgver")
  conflicts=(lib32-glibc)
  options+=(!emptydirs)

  cd lib32-glibc-build
  make DESTDIR="$pkgdir" install
  rm -rf -- \
    "$pkgdir/etc" \
    "$pkgdir/sbin" \
    "$pkgdir/usr/bin" \
    "$pkgdir/usr/sbin" \
    "$pkgdir/usr/share" \
    "$pkgdir/var"

  find "$pkgdir/usr/include" -type f ! -name '*-32.h' -delete
  install -d "$pkgdir/usr/lib"
  ln -s ../lib32/ld-linux.so.2 "$pkgdir/usr/lib/ld-linux.so.2"
  install -Dm644 "$srcdir/lib32-glibc.conf" \
    "$pkgdir/etc/ld.so.conf.d/lib32-glibc.conf"
  ln -s ../lib/locale "$pkgdir/usr/lib32/locale"

  install -Dm644 "$srcdir/12-lib32-glibc-iconvconfig.hook" \
    "$pkgdir/usr/share/libalpm/hooks/12-lib32-glibc-iconvconfig.hook"
  install -Dm644 "$srcdir/12-lib32-glibc-remove-iconvconfig-cache.hook" \
    "$pkgdir/usr/share/libalpm/hooks/12-lib32-glibc-remove-iconvconfig-cache.hook"
  _install_license
}

package_glibc-locales-git() {
  pkgdesc='Pregenerated locales for GNU C Library development snapshot'
  depends=("glibc-git=$pkgver")
  provides=("glibc-locales=$pkgver")
  conflicts=(glibc-locales)

  cp -r "$srcdir/locales/." "$pkgdir"
  rm -r "$pkgdir/usr/lib/locale/C.utf8"
  hardlink -c "$pkgdir/usr/lib/locale"
  _install_license
}
