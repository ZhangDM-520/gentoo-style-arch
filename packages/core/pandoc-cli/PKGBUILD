# Maintainer: Gentoo_Style_Arch contributors
#
# Owned in-house because pandoc FFI-links ICU (text-icu → citeproc →
# pandoc): every icu soname bump breaks a stock pandoc until the whole
# Haskell closure is rebuilt. Measured 2026-10-19 after the icu 78→79
# move: /usr/bin/pandoc AND five shared libs (libHSpandoc, -lua-engine,
# -server, libHSciteproc, libHStext-icu) all carried their own
# DT_NEEDED libicuuc.so.78 — Arch's --enable-shared model bakes the C
# closure into every unit, so patching one .so fixes nothing. This recipe
# instead builds the CLI with cabal's STATIC Haskell closure: the shipped
# binary links only C libs (our icu among them), and the next icu bump is
# repaired by rebuilding exactly this recipe — the topology edge to
# icu-git makes the engine order that for us.

pkgname=pandoc-cli
pkgver=3.11
pkgrel=2
pkgdesc='Conversion between documentation formats'
arch=('x86_64')
url='https://pandoc.org'
license=('GPL-2.0-or-later')
depends=(
  'gcc-libs'   # libgcc_s for the GHC RTS's unwinder
  'glibc'
  'gmp'        # GHC's integer-gmp links libgmp dynamically
  'icu'        # text-icu FFI — the reason this recipe exists (icu-git provides)
  'libffi'     # GHC RTS (Arch's ghc is built against libffi)
  'zlib'       # zlib-hs / digest FFI
)
makedepends=(
  'cabal-install'
  'ghc'
  'pkgconf'    # text-icu's Setup locates ICU via pkg-config
)
# Versioned mapped-name provide (the provides ratchet): consumers ask for
# the 'pandoc' virtual, never the concrete CLI name.
provides=("pandoc=${pkgver}")
source=("https://hackage.haskell.org/packages/archive/${pkgname}/${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('a9f3fc8c64962c8778b379cc2238c7c554541e1e94fd36a210c3f92e1729e929')

prepare() {
  cd "${pkgname}-${pkgver}"

  # Hermetic Hackage store inside $srcdir (the zig/go precedent): cabal
  # update pins the index-state; build() then pulls the solve's tarballs
  # into the store (the from-source closure) — no other network steps.
  export CABAL_DIR="$srcdir/cabal"
  cabal update

  # Way config for the WHOLE plan. The 2026-10-20 haskell wave left GHC's
  # package set dynamic-way-only, and `cabal build` has no
  # --enable-library-dynamic (a Setup-level flag) — without this stanza
  # every from-source dep compile dies "files missing in ‘base’".
  # `packages: .` keeps the pinned solve local to this source tree.
  cat > cabal.project <<'EOF'
packages: .
package *
  shared: True
  library-vanilla: False
  ghc-options: -dynamic
EOF
}

build() {
  cd "${pkgname}-${pkgver}"
  export CABAL_DIR="$srcdir/cabal"

  # Optimization layer: cabal's default -O build (parity with Arch's
  # Setup -O). No GCC-style PGO and no hand-tuned -march: the payload is
  # GHC codegen, outside lib/pgo.sh's instrumented families and outside
  # CFLAGS' reach — same rationale as ghostty-git. mold reaches the final
  # link through GHC's -optl passthrough (house command -v guard).
  local _ghc_opts=(-pie '-optl-Wl,-z,relro,-z,now')

  # Way probe (load-bearing): the 2026-10-20 haskell wave left GHC's
  # package set dynamic-way-only (base ships .dyn_hi and zero .hi), and a
  # vanilla compile dies "files missing in the ‘base’ package". Compile the
  # toolchain's way; on a vanilla-capable GHC this probe is a no-op.
  local _base_imports
  _base_imports=$(ghc-pkg field base import-dirs 2>/dev/null | sed 's/^import-dirs: *//')
  local _cabal_way=()
  if [[ ! -e "$_base_imports/Prelude.hi" ]]; then
    _ghc_opts+=(-dynamic)
    _cabal_way=(--enable-executable-dynamic)
    # The dep compiles take their way from prepare()'s cabal.project
    # stanza (see there). No mold in this branch: it rejects the distro's
    # prebuilt haskell .so set at the final link ("mold: fatal: … invalid
    # version index 0 for defined symbol"). The default linker handles
    # them.
  else
    command -v mold >/dev/null 2>&1 && _ghc_opts+=(-optl-fuse-ld=mold)
  fi

  # Feature parity with Arch's pandoc-cli: lua + server on, nightly off.
  # --index-state pins the Hackage solve so the dependency closure cannot
  # drift under a rebuild (the sha256 anchor covers the CLI tarball only).
  # citeproc's `icu` flag defaults FALSE and the solver will happily drop
  # it to dodge the text-icu constraint (stock Arch builds citeproc +icu)
  # — force it, and force text-icu FROM SOURCE: the stock haskell-text-icu
  # chains Arch's icu .78, which our icu-git (SONAME .79) orphaned. Its
  # Setup locates ICU via pkg-config, so the store build links the current
  # icu; the cascade (citeproc, pandoc lib, pandoc-server, …) rebuilds the
  # same way and package() ships the whole store closure.
  cabal build exe:pandoc \
    --index-state='2026-10-19T00:00:00Z' \
    --flags='+lua +server -nightly' \
    --constraint='citeproc +icu' \
    --constraint='any.text-icu source' \
    "${_cabal_way[@]}" \
    --jobs="${GSA_BUILD_JOBS:-$(nproc)}" \
    --ghc-options="${_ghc_opts[*]}"
}

package() {
  cd "${pkgname}-${pkgver}"

  # Docs/man/bash-completion are trimmed per house policy (the upstream
  # tarball ships man/pandoc.1; the CLI's own --help is the interface).
  install -Dm755 "$(CABAL_DIR="$srcdir/cabal" cabal list-bin exe:pandoc)" \
    "${pkgdir}/usr/bin/pandoc"
  install -Dm644 COPYING.md "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Ship the store-built closure's shared libs (hashed SONAMEs under
  # usr/lib, mirroring Arch's haskell-* layout; the hashes keep them from
  # colliding with the distro's libHS* files): the exe links them by name
  # and text-icu's NEEDED chain carries libicuuc.so.79 — the stock
  # haskell-text-icu's .78 chain is the orphaned one. Fail closed unless
  # the closure is there and text-icu rode along: a pandoc with an
  # unresolvable NEEDED would trip the engine's install gate anyway.
  local _so _n=0 _saw_icu=0
  while IFS= read -r -d '' _so; do
    install -Dm755 "$_so" "${pkgdir}/usr/lib/$(basename "$_so")"
    _n=$((_n + 1))
    [[ $(basename "$_so") == libHStext-icu* ]] && _saw_icu=1
  done < <(find "$srcdir/cabal/store" -name 'libHS*.so' -print0 2>/dev/null)
  ((_n > 0 && _saw_icu == 1)) ||
    { echo "pandoc-cli: store closure libs missing (n=$_n text-icu=$_saw_icu)" >&2; return 1; }
}
