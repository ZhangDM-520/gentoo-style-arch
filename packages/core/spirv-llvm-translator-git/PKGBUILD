# Maintainer: Lone_Wolf <lone_wolf@klaas-de-kat.nl>
_srcname=SPIRV-LLVM-Translator
pkgname=spirv-llvm-translator-git
pkgdesc="Tool and a library for bi-directional translation between SPIR-V and LLVM IR, trunk version"
epoch=1
pkgver=r2545.01625b9
pkgrel=1
arch=('x86_64')
url="https://github.com/KhronosGroup/SPIRV-LLVM-Translator"
license=('LicenseRef-custom')
makedepends=(llvm-git git cmake spirv-headers spirv-tools)
checkdepends=(python python-setuptools llvm-git clang-opencl-headers-git)
depends=(llvm-libs-git spirv-tools gcc-libs glibc)
provides=("spirv-llvm-translator=$pkgver")
conflicts=(spirv-llvm-translator spirv-llvm-translator-minimal-git)
source=("git+https://github.com/KhronosGroup/SPIRV-LLVM-Translator.git"
)
md5sums=('SKIP'
)
sha512sums=('SKIP'
)
options=(!lto !debug)

pkgver() {
    cd $_srcname
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    
    # llvm-git provides LLVM; its pkgver Major is the BASE_LLVM_VERSION
    local _BASE_LLVM_VERSION=$(echo $(pacman -Q llvm-git) | cut -d' ' -f2 |  cut -d. -f1)
    cmake \
        -B _build \
        -S "$srcdir"/$_srcname  \
        -G Ninja \
        -D BASE_LLVM_VERSION=$_BASE_LLVM_VERSION \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold" \
        -D CMAKE_SHARED_LINKER_FLAGS="-fuse-ld=mold" \
        -D CMAKE_POSITION_INDEPENDENT_CODE=ON \
        -D CMAKE_SKIP_RPATH=ON \
        -D LLVM_EXTERNAL_LIT=/usr/bin/lit \
        -D LLVM_EXTERNAL_SPIRV_HEADERS_SOURCE_DIR=/usr/include/spirv/ \
        -D LLVM_SPIRV_INCLUDE_TESTS=ON \
        -D BUILD_SHARED_LIBS=ON \
        -Wno-dev

    ninja -C _build
}

check() {
    LD_LIBRARY_PATH="$srcdir"/_build/lib/SPIRV ninja -C _build test
}

package() {

    # ninja >= 1.13 removed command-line VAR=VALUE syntax -> pass DESTDIR via env
    DESTDIR="${pkgdir}" ninja -C _build install
    install -Dm755 _build/tools/llvm-spirv/llvm-spirv -t "$pkgdir"/usr/bin
    install -Dm644 $_srcname/LICENSE.TXT -t "$pkgdir"/usr/share/licenses/$pkgname/
}

# vim:set ts=2 sw=2 et:
