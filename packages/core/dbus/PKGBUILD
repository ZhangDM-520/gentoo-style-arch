pkgbase=dbus
pkgname=(
  dbus
)
# dbus-daemon-units split dropped: this machine runs dbus-broker (its units
# conflict with dbus-broker-units-git); _pick unit still discards the reference
# units so they never land in the main package
pkgver=1.16.2
pkgrel=1.1
pkgdesc="Freedesktop.org message bus system"
url="https://www.freedesktop.org/wiki/Software/dbus/"
arch=(x86_64)
license=("AFL-2.1 OR GPL-2.0-or-later")
depends=(
  audit
  expat
  glibc
  libcap-ng
  systemd-libs
)
makedepends=(
  git
  glib2
  meson
  python
  systemd
)
source=(
  "git+https://gitlab.freedesktop.org/dbus/dbus.git?signed#tag=dbus-$pkgver"
  0001-Arch-Linux-tweaks.patch
  dbus-reload.hook
)
b2sums=('669cd4203fbac908db3a20c5b51355d9e84b68c9cc94f8de52e35544a636c6d5d1df8ee2bbdfd6dead53a6bd9865db547aa4af0e913bac697b138c698840d3ce'
        '3896c994aa7afde605aebb88b7123f33c578ad1ede2dc3e76982dbc021d6994874c5c735d31a66c7b3e9d3cba77ebbba7db05013716bbac14948618b1464e4a8'
        '9ac03e4dca00b2c31dc505db4c5da5b8498da21377b01abf186800c6da00492abc6a9a2058c3e3b0f282e3b28e0e4f3318114230db0418fe9754ad2420adb4bf')
validpgpkeys=(
  DA98F25C0871C49A59EAFF2C4DE8FF2A63C7CC90  # Simon McVittie <simon.mcvittie@collabora.co.uk>
)

prepare() {
  cd dbus
  patch -Np1 -i ../0001-Arch-Linux-tweaks.patch
}

# PGO toggle — set false for quick rebuilds
_pgo=true

build() {
  local meson_options=(
    -D apparmor=disabled
    -D dbus_user=dbus
    -D kqueue=disabled
    -D launchd=disabled
    -D relocation=disabled
    -D selinux=disabled
    -D x11_autolaunch=disabled
    # trim: no documentation
    -D doxygen_docs=disabled
    -D ducktype_docs=disabled
    -D xml_docs=disabled
    -D qt_help=disabled
  )

  local _pgo_profile_dir="${srcdir}/dbus-pgo"
  local _cflags_orig="${CFLAGS}"
  local _cxxflags_orig="${CXXFLAGS}"
  local _ldflags_orig="${LDFLAGS}"

  # phase 1: instrumented build
  if ${_pgo}; then
    export CFLAGS+=" -fprofile-generate=${_pgo_profile_dir} -fprofile-update=atomic"
    export CXXFLAGS+=" -fprofile-generate=${_pgo_profile_dir} -fprofile-update=atomic"
    export LDFLAGS+=" -fprofile-generate=${_pgo_profile_dir}"
  fi

  arch-meson dbus build "${meson_options[@]}"
  meson compile -C build

  if ${_pgo}; then
    # ---- PGO training: dbus test suite (bus dispatch / IPC hot paths) ----
    timeout 600 meson test -C build --print-errorlogs || true

    # verify profile data before shipping -fprofile-use (never use an empty profile)
    local _gcda_count
    _gcda_count=$(find "${_pgo_profile_dir}" -name '*.gcda' 2>/dev/null | wc -l)
    echo "  -> Generated ${_gcda_count} profile data files"

    local _use_profile=true
    if [ "${_gcda_count}" -eq 0 ]; then
      _use_profile=false
      echo "  -> WARNING: No profile data generated. Falling back to LTO-only build."
    fi

    # phase 2: rebuild with profile-use
    export CFLAGS="${_cflags_orig}"
    export CXXFLAGS="${_cxxflags_orig}"
    export LDFLAGS="${_ldflags_orig}"
    if ${_use_profile}; then
      export CFLAGS+=" -fprofile-use=${_pgo_profile_dir} -fprofile-reorder-functions \
-Wno-error=format-overflow -Wno-error=coverage-mismatch"
      export CXXFLAGS+=" -fprofile-use=${_pgo_profile_dir} -fprofile-reorder-functions \
-Wno-error=format-overflow -Wno-error=coverage-mismatch"
    fi
    # meson 1.12.99 --reconfigure does NOT re-read changed env CFLAGS (ninja: no
    # work to do) — wipe the build dir and configure fresh so profile-use applies
    rm -rf build
    arch-meson dbus build "${meson_options[@]}"
    meson compile -C build
    rm -rf "${_pgo_profile_dir}"
  fi
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_dbus() {
  depends+=(
    libaudit.so
    libcap-ng.so
    libexpat.so
    libsystemd.so
  )
  provides=(
    libdbus
    libdbus-1.so
  )
  conflicts=(libdbus)
  replaces=(libdbus)

  meson install -C build --destdir "$pkgdir"

  _pick unit "$pkgdir"/usr/lib/systemd/{system,user}/dbus.service

  install -Dt "$pkgdir/usr/share/libalpm/hooks" -m644 *.hook

  install -Dt "$pkgdir/usr/share/licenses/$pkgname" -m644 \
    dbus/COPYING dbus/LICENSES/AFL-2.1.txt
}

