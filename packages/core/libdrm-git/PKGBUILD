# Contributor : Eric Engestrom <eric@engestrom.ch>
# Contributor : Jan de Groot <jgc@archlinux.org>

pkgname=libdrm-git
_realname=libdrm
pkgver=2.4.134.r16.gb97cbde1
pkgrel=1
pkgdesc="Userspace interface to kernel DRM services, master git version"
arch=(i686 x86_64)
license=('custom')
depends=('libpciaccess')
makedepends=('python-docutils' 'meson' 'git' 'ninja')
checkdepends=('cairo' 'cunit')
url="http://dri.freedesktop.org/"
provides=('libdrm')
conflicts=('libdrm')

source=(git+https://gitlab.freedesktop.org/mesa/libdrm.git
        COPYING)
sha512sums=('SKIP'
            'b0ca349b882a4326b19f81f22804fabdb6fb7aef31cdc7b16b0a7ae191bfbb50c7daddb2fc4e6c33f1136af06d060a273de36f6f3412ea326f16fa4309fda660')

pkgver() {
    cd $_realname
    git describe --long --tags --abbrev=8 | sed 's/^libdrm-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
    :
}

build() {
    if command -v mold >/dev/null 2>&1; then
        export LDFLAGS+=" -fuse-ld=mold"
    fi

    local meson_options=(
        -D udev=false
        -D valgrind=disabled
        -D install-test-programs=false
        -D b_lto=true
        -D b_ndebug=true
        # AMD target: amdgpu + radeon only
        -D amdgpu=enabled
        -D radeon=enabled
        -D intel=disabled
        -D nouveau=disabled
        -D vmwgfx=disabled
        -D omap=disabled
        -D exynos=disabled
        -D tegra=disabled
        -D vc4=disabled
        -D etnaviv=disabled
    )
    arch-meson libdrm build "${meson_options[@]}"
    meson compile -C build
}

check() {
   # Symbol-check tests fail with LTO (symbols get inlined/reordered)
   # Run tests but don't fail the build
   meson test -C build -t 10 || true
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dt "$pkgdir"/usr/share/licenses/"$pkgname" -m644 COPYING
}
