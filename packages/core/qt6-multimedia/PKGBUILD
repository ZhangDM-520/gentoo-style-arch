# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgbase=qt6-multimedia
pkgname=(qt6-multimedia
         qt6-multimedia-ffmpeg
         qt6-multimedia-gstreamer)
# placeholder — overridden by pkgver() (git describe on dev branch)
pkgver=6.13.0_r9875.g99eda9976
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Classes for audio, video, radio and camera functionality'
depends=(glibc
         libgcc
         libpulse
         libstdc++
         pipewire
         qt6-base)
makedepends=(cmake
             ffmpeg
             git
             gst-plugins-bad-libs
             gst-plugins-base
             libxrandr
             ninja
             pipewire
             qt6-declarative
             qt6-quick3d
             qt6-shadertools
             vulkan-headers)
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#branch=dev)
sha256sums=('SKIP')

# PGO toggle — false for quick rebuilds
_pgo=true

_configure_and_build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
  cmake --build build
}

_train_pgo() {
  # 5 s stereo sine tone for streaming through the graph
  python -c "import math,struct,wave; f=wave.open('${srcdir}/tone.wav','wb'); f.setnchannels(2); f.setsampwidth(2); f.setframerate(48000); f.writeframes(b''.join(struct.pack('<hh', int(6000*math.sin(2*math.pi*440*i/48000)), int(6000*math.sin(2*math.pi*440*i/48000))) for i in range(48000*5)))" || true

  cat > "${srcdir}/pgo_train.cpp" <<'EOF'
#include <QGuiApplication>
#include <QAudioOutput>
#include <QMediaPlayer>
#include <QTimer>
#include <QUrl>
int main(int argc, char **argv) {
    QGuiApplication app(argc, argv);
    QMediaPlayer player;
    QAudioOutput out;
    player.setAudioOutput(&out);
    out.setVolume(0.0);
    player.setSource(QUrl::fromLocalFile(QString::fromLocal8Bit(argv[1])));
    player.setLoops(QMediaPlayer::Infinite);
    player.play();
    // self-terminate: SIGINT/SIGTERM kills do NOT flush .gcda (no clean exit)
    QTimer::singleShot(8000, &app, &QCoreApplication::quit);
    return app.exec();
}
EOF
  # compiled against installed Qt headers; runs against the BUILD-TREE libs
  # Arch ships NO Qt6 .pc files — pkg-config returns nothing. Use explicit
  # include/lib paths for the trainer (compiled against installed headers,
  # run against the BUILD-TREE libs).
  if ! g++ "${srcdir}/pgo_train.cpp" -o "${srcdir}/pgo_train" \
      -I/usr/include/qt6 -I/usr/include/qt6/QtCore -I/usr/include/qt6/QtGui \
      -I/usr/include/qt6/QtMultimedia -I/usr/include/qt6/QtNetwork \
      -lQt6Core -lQt6Gui -lQt6Multimedia -fPIC 2>"${srcdir}/pgo_train.err"; then
    echo "  -> WARNING: trainer compile failed; multimedia training skipped"
    head -5 "${srcdir}/pgo_train.err" || true
    rm -f "${srcdir}/pgo_train.cpp"
    return 0
  fi
  rm -f "${srcdir}/pgo_train.err"

  local _env=(
    QT_QPA_PLATFORM=offscreen
    QT_MEDIA_BACKEND=ffmpeg
    QT_LOGGING_RULES="*.debug=false"
    LD_LIBRARY_PATH="${srcdir}/build/lib"
    QT_PLUGIN_PATH="${srcdir}/build/plugins:/usr/lib/qt6/plugins"
  )
  # app quits itself after 8 s (clean exit flushes .gcda); KILL is a backstop
  env "${_env[@]}" timeout -s KILL 30 "${srcdir}/pgo_train" "${srcdir}/tone.wav" >/dev/null 2>&1 || true
  rm -f "${srcdir}/pgo_train" "${srcdir}/pgo_train.cpp" "${srcdir}/tone.wav"
}

build() {
  local _pgo_dir="${srcdir}/qt6multimedia-pgo"
  local _cxx_orig="${CXXFLAGS}"
  local _ldf_orig="${LDFLAGS}"

  if ${_pgo}; then
    # phase 1: instrumented, LTO stripped (instrumented LTO is fragile)
    export CXXFLAGS="$(printf '%s' "${CXXFLAGS}" | sed 's/-flto=[^ ]*//g; s/-flto//g') -fprofile-generate=${_pgo_dir} -fprofile-update=atomic"
    export LDFLAGS="${_ldf_orig} -fprofile-generate=${_pgo_dir}"
  fi

  _configure_and_build

  if ${_pgo}; then
    _train_pgo

    local _gcda_count
    _gcda_count=$(find "${_pgo_dir}" -name '*.gcda' 2>/dev/null | wc -l)
    echo "  -> Generated ${_gcda_count} profile data files"

    export CXXFLAGS="${_cxx_orig}"
    export LDFLAGS="${_ldf_orig}"
    if [ "${_gcda_count}" -gt 0 ]; then
      # phase 2: env-flag changes require a CLEAN build dir (reconfigure keeps
      # stale flags); never ship -fprofile-use with an empty profile
      export CXXFLAGS+=" -fprofile-use=${_pgo_dir} -fprofile-reorder-functions -Wno-error=format-overflow -Wno-error=coverage-mismatch"
      rm -rf build
      _configure_and_build
    else
      echo "  -> WARNING: no profile data generated. Falling back to LTO-only build."
    fi
    rm -rf "${_pgo_dir}"
  fi
}

package_qt6-multimedia() {
  depends+=(qt6-multimedia-backend)
  optdepends=('qt6-declarative: QML bindings'
              'qt6-quick3d: for QtQuick3DAudio')

  DESTDIR="$pkgdir" cmake --install build
# Split plugins
  rm -r "$pkgdir"/usr/lib/qt6/plugins/
  rm "$pkgdir"/usr/lib/cmake/Qt6Multimedia/Qt6Q{FFmpeg,Gstreamer}*
  rm -r "$pkgdir"/usr/include/qt6/Qt{FFmpeg,Gstreamer}MediaPluginImpl \
        "$pkgdir"/usr/lib/cmake/Qt6{FFmpeg,Gstreamer}MediaPluginImplPrivate \
        "$pkgdir"/usr/lib/libQt6{FFmpeg,Gstreamer}MediaPluginImpl.{a,prl} \
        "$pkgdir"/usr/lib/qt6/metatypes/qt6{ffmpeg,gstreamer}mediapluginimplprivate_metatypes.json \
        "$pkgdir"/usr/lib/qt6/mkspecs/modules/qt_lib_{ffmpeg,gstreamer}mediapluginimpl_private.pri \
        "$pkgdir"/usr/lib/qt6/modules/{FFmpeg,Gstreamer}MediaPluginImplPrivate.json

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

package_qt6-multimedia-gstreamer() {
  pkgdesc='Gstreamer backend for qt6-multimedia'
  depends=(glib2
           glibc
           gst-libav
           gst-plugins-bad-libs
           gst-plugins-base
           gst-plugins-good
           gstreamer
           libglvnd
           libpulse
           libstdc++
           qt6-base
           qt6-multimedia)
  provides=(qt6-multimedia-backend)
  groups=()
  optdepends=('gst-plugins-bad: camera support, additional plugins'
              'gst-plugins-ugly: additional plugins')
  
  DESTDIR="$pkgdir" cmake --install build/src/plugins/multimedia/gstreamer    
}

package_qt6-multimedia-ffmpeg() {
  pkgdesc='FFMpeg backend for qt6-multimedia'
  depends=(ffmpeg
           glibc
           libgcc
           libglvnd
           libstdc++
           libva
           libx11
           libxext
           libxrandr
           qt6-base
           qt6-declarative
           qt6-multimedia)
  provides=(qt6-multimedia-backend)
  groups=()

  DESTDIR="$pkgdir" cmake --install build/src/plugins/multimedia/ffmpeg
}

pkgver() {
  cd $_pkgfn
  # git describe is UNUSABLE on Qt dev branches: release tags (6.8+) live on
  # the 'release' branch, not in dev ancestry — describe finds ancient tags.
  # Read the real module version from .cmake.conf instead (pyside6 precedent).
  _ver="$(grep -m1 -oP 'QT_REPO_MODULE_VERSION\s+"?\K[0-9][0-9.]*' .cmake.conf)"
  echo "${_ver}_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}
