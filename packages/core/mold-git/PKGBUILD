# Maintainer: Peter Jung <ptr1337@cachyos.org>
# Maintainer: asyync1024 <asyync1024 at proton dot me>

# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package(). A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

# Upstream merged the Rust rewrite on 2026-09-18 (af97c800 "Merge Rust
# implementation and its history"): HEAD is a Cargo workspace (Cargo.toml,
# cli/, arch/, tests/) with no CMakeLists.txt, so the former CMake/C++ recipe
# fails at configure time ("source directory does not appear to contain
# CMakeLists.txt"). The build below is cargo-based with 3-phase Rust PGO:
# (1) instrumented build, (2) training by relinking mold with its own
# instrumented binary acting as ld.mold, (3) profile-use + fat LTO + CGU=1.

_reponame=mold
pkgname=${_reponame}-git
pkgver=2.42.1.r468.g6fc6e191
pkgrel=1
pkgdesc='A Modern Linker'
arch=('x86_64')
url="https://github.com/rui314/$_reponame"
license=('MIT')
# Runtime closure of the final Rust binary (derived from readelf -d after
# building): the C++-era deps are gone — libstdc++/tbb/mimalloc/libblake3
# shipped binaries before, while blake3, flate2/zlib, zstd and mimalloc are
# cargo crates now (mimalloc statically linked from the pinned git dep).
depends=(
  glibc
  gcc-libs
  zlib
)
# rust: compiler; git: VCS source + build.rs embeds the commit hash;
# llvm: llvm-profdata merges the PGO profiles. cmake/ninja/python died with
# the C++ build. mold itself is deliberately NOT a makedepend: it is only a
# build-time linker, probed in build(), so mold-git can bootstrap even on a
# host whose linker is broken.
makedepends=(
  rust
  git
  llvm
)
# !debug: release profile already carries no debug info.
# !lto: rust LTO is controlled via CARGO_PROFILE_RELEASE_* below; the only C
# compiled here (mold-wrapper.c/lto-message.c via build.rs) must not inherit
# makepkg's -flto — build.rs links them with a plain gcc driver invocation.
options=(!debug strip !lto)
source=("git+${url}.git")
b2sums=('SKIP')
provides=("$_reponame=$pkgver")
conflicts=("$_reponame")

pkgver() {
  cd "$_reponame"
  git describe --long --tags | sed -E 's/^v//;s/([^-]*-g)/r\1/;s/-/./g'
}

prepare() {
  cd "$_reponame"
  # Fetch into the source tree, not ~/.cargo; --locked pins the committed
  # Cargo.lock (including the pinned mimalloc_rust git dependency).
  export CARGO_HOME="${srcdir}/.cargo"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_reponame"
  export CARGO_HOME="${srcdir}/.cargo"
  # External compiler wrappers must not interfere with the per-phase RUSTFLAGS.
  unset RUSTC_WRAPPER

  # Start from the RUSTFLAGS provided by the environment (e.g. CachyOS's
  # /etc/makepkg.conf.d/rust.conf already sets "-C opt-level=3 -C target-cpu=native").
  local _rustflags="${RUSTFLAGS:-}"

  # ISA fallback for systems whose makepkg.conf does not tune the target.
  if ! grep -q 'target-cpu' <<<"${_rustflags}"; then
    _rustflags+=" -C target-cpu=native"
  fi

  # Fast linker: huge win for fat-LTO link times (build-time only, no output
  # effect). Probed, not declared — see makedepends above.
  if command -v mold >/dev/null 2>&1; then
    _rustflags+=" -C link-arg=-fuse-ld=mold"
  fi

  # Prevent warning: 'Package contains reference to $srcdir'
  _rustflags+=" --remap-path-prefix=${srcdir}=/"

  local _pgo_dir="${srcdir}/pgo-data"
  # pgo_min_profraw: ≈ minimum distinct TUs the training phase touches before
  # a profile is worth trusting (here: .profraw files, Rust's profiling
  # format). 0 = any profile data at all is enough; 0 files means the
  # self-relink training never ran and we fall back to a plain fat-LTO build.
  local pgo_min_profraw=0
  rm -rf "${_pgo_dir}"
  mkdir -p "${_pgo_dir}"

  # Phase 1: instrumented build (LTO off — faster, and profiling does not
  # need it; phase 3 turns LTO back on).
  msg "PGO Phase 1: instrumented build"
  RUSTFLAGS="${_rustflags} -Cprofile-generate=${_pgo_dir}" \
    CARGO_PROFILE_RELEASE_LTO=false \
    cargo build --frozen --release -p mold

  # Phase 2: training by self-relink. The instrumented binary is copied
  # aside and exposed as ld.mold (and mold) at the FRONT of PATH, so the
  # gcc driver resolving -fuse-ld=mold executes it while it relinks mold
  # itself. The copy-aside is mandatory: cargo relinks over
  # target/release/mold, and the *executing* linker must not be that same
  # file (ETXTBSY / relinking the running binary).
  # Two runs give the profile more than a single link's samples. The output
  # is a real file (the old C++ recipe's /dev/null mmap spin does not apply),
  # so no timeout is needed; if no profile appears, the count check below
  # falls back to a plain fat-LTO build instead of failing the package.
  msg "PGO Phase 2: training by relinking mold with the instrumented linker"
  local _bin="target/release/mold"
  local _train="${_pgo_dir}/train-bin"
  mkdir -p "${_train}"
  cp -a "${_bin}" "${_train}/mold-instrumented"
  ln -s mold-instrumented "${_train}/ld.mold"
  ln -s mold-instrumented "${_train}/mold"

  local _run
  for _run in 1 2; do
    # Removing the output plus touching exactly one crate source dirties only
    # the mold cli unit (RUSTFLAGS are identical to phase 1), forcing cargo
    # to recompile that unit and relink through the PATH route.
    rm -f "${_bin}"
    touch cli/main.rs
    LLVM_PROFILE_FILE="${_pgo_dir}/mold-%p-%m.profraw" \
      PATH="${_train}:${PATH}" \
      RUSTFLAGS="${_rustflags} -Cprofile-generate=${_pgo_dir}" \
      CARGO_PROFILE_RELEASE_LTO=false \
      cargo build --frozen --release -p mold
  done

  local profraw_count
  profraw_count=$(find "${_pgo_dir}" -name '*.profraw' 2>/dev/null | wc -l)
  if (( profraw_count <= pgo_min_profraw )); then
    warning "No profile data generated — falling back to a plain fat-LTO build"
    RUSTFLAGS="${_rustflags} -Cstrip=symbols" \
      CARGO_PROFILE_RELEASE_LTO=fat \
      CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
      cargo build --frozen --release -p mold
    rm -rf "${_pgo_dir}"
    return 0
  fi
  msg "Profile data generated: $profraw_count .profraw files"

  # Phase 3: merge the profiles, then rebuild with profile-use + fat LTO +
  # CGU=1 (max cross-crate optimization; overrides the upstream thin-LTO
  # intent without editing Cargo.toml) + symbol stripping. The RUSTFLAGS
  # differ from phase 1, so every unit recompiles — no instrumentation can
  # survive into the final binary.
  msg "PGO Phase 3: optimized build"
  llvm-profdata merge -o "${_pgo_dir}/merged.profdata" "${_pgo_dir}"/*.profraw
  RUSTFLAGS="${_rustflags} -Cprofile-use=${_pgo_dir}/merged.profdata -Cstrip=symbols" \
    CARGO_PROFILE_RELEASE_LTO=fat \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1 \
    cargo build --frozen --release -p mold
  rm -rf "${_pgo_dir}"
}

# check() removed 2026-09-04 (C++ era): upstream's suite is release
# validation, not packaging. The Rust tree's CI equivalent (cargo test plus
# the bash tests/) was likewise not adopted when the recipe was rewritten
# on 2026-09-25.

package() {
  cd "$_reponame"
  # Upstream's installer: /usr/bin/mold + ld.mold symlink, the wrapper in
  # /usr/lib/mold, /usr/libexec/mold/ld, man pages, LICENSE under doc/.
  DESTDIR="$pkgdir" PREFIX=/usr ./install-mold.sh

  install -vDm644 -t "$pkgdir/usr/share/licenses/$pkgname" LICENSE

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may be
  # added to $pkgdir after the payload is verified. `pgo-data` is the profile
  # work directory name phase 1 embeds; clang/rustc may bake the directory
  # alone, with no .profraw suffix, so it is matched as a raw literal too.
  verify_no_profile_instrumentation "$pkgdir" pgo-data
}
# vim: ts=2 sw=2 et:
