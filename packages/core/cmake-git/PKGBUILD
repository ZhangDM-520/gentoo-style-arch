# This PKGBUILD is based on the official Arch cmake package.

# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package(). A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgname=cmake-git
pkgver=4.4.4.1233.g5c710a430e
pkgrel=1
pkgdesc='A cross-platform open-source make system'
arch=('x86_64')
url="http://www.cmake.org/"
license=('custom')
conflicts=('cmake')
provides=("cmake=${pkgver}")
depends=('curl' 'libarchive' 'hicolor-icon-theme' 'jsoncpp' 'libjsoncpp.so' 'libuv' 'rhash' 'cppdap')
# python-sphinx dropped 2026-09-26 with --sphinx-man (MEMORY rule 8: purged
# tools stay purged; man pages are not part of this package set).
makedepends=('nlohmann-json' 'git')
optdepends=()
source=('git+https://gitlab.kitware.com/cmake/cmake.git'
        'cmake-cppflags.patch')
md5sums=('SKIP'
         'd7316e540d07e0a7ebce75951a7b2697')
#shortver=$(printf "${pkgver}" | sed 's/\([0-9]\+\.[0-9]\+\)\..*/\1/')

pkgver() {
    cd "$srcdir/cmake"
    git describe --always --tags --long | sed -e 's|^v||' -e 's|-|.|g'
}

prepare() {
    cd "$srcdir/cmake"
    patch -p1 -i ../cmake-cppflags.patch # Honor CPPFLAGS https://gitlab.kitware.com/cmake/cmake/issues/12928
}

build() {
  cd "$srcdir/cmake"

  # Phase 1: Generate profile data
  # pgo_min_gcda: ≈ minimum distinct TUs the training phase touches before a
  # profile is worth using. 0 here — the trainer is a single toy-project
  # configure, so any profile data at all is enough; 0 gcda files means
  # training never ran and phase 2 is skipped entirely.
  local pgo_min_gcda=0
  export CFLAGS="$CFLAGS -fprofile-generate"
  export CXXFLAGS="$CXXFLAGS -fprofile-generate ${CPPFLAGS}"
  export LDFLAGS="$LDFLAGS -fuse-ld=mold -fprofile-generate"

  ./bootstrap --prefix=/usr \
    --mandir=/share/man \
    --docdir=/share/doc/cmake \
    --datadir=/share/cmake \
    --system-libs \
    --parallel="${GSA_BUILD_JOBS:-$(/usr/bin/getconf _NPROCESSORS_ONLN)}"
  make

  # Run cmake on a test project to generate profile data
  mkdir -p /tmp/cmake-pgo-test
  cat > /tmp/cmake-pgo-test/CMakeLists.txt << 'EOF'
cmake_minimum_required(VERSION 3.10)
project(pgo_test C CXX)
add_executable(hello main.cpp)
EOF
  cat > /tmp/cmake-pgo-test/main.cpp << 'EOF'
int main() { return 0; }
EOF
  ./bin/cmake -S /tmp/cmake-pgo-test -B /tmp/cmake-pgo-test/build 2>/dev/null || true
  rm -rf /tmp/cmake-pgo-test

  # Verify profile data
  local gcda_count=$(find . -name '*.gcda' | wc -l)
  if (( gcda_count <= pgo_min_gcda )); then
    echo "Warning: No profile data generated, skipping PGO"
    return 0
  fi
  echo "Profile data generated: $gcda_count .gcda files"

  # Phase 2: Use profile data
  # The generate->use rewrite has to reach *inside CMakeCache.txt*, because that
  # cache is where phase 1's `./bootstrap` stored the flags and CMake only reads
  # CFLAGS/CXXFLAGS/LDFLAGS while it *initialises* a cache. `make clean` does not
  # remove the cache, so exporting the phase-2 flags here would be a no-op: `make`
  # would relink the phase-1 objects, the payload would stay a generate-phase
  # build, and every one of the four binaries would recreate its `.gcda` tree on
  # every run — the 2026-09-20 failure, which package() refused.
  # Deleting the cache is the other way to make CMake re-read the environment, and
  # it is the wrong one: the cache also holds every *other* decision phase 1 made
  # — the install dirs, CMAKE_USE_SYSTEM_LIBS, the -fuse-ld=mold linker flags, and
  # the feature-check answers. Measured on the purge attempt: `-- Using
  # system-installed: CURL EXPAT ...` became `-- Using bundled: ...` and the
  # payload was installed under pkg/usr/local/... instead of pkg/usr/...
  # So rewrite the flags in place and let the generated Makefile reconfigure.
  # No `./bootstrap` re-run: it recompiles the bootstrap's own objects under
  # -fprofile-use against the phase-1 profiles and dies on
  # -Werror=coverage-mismatch.
  # `-Wno-missing-profile`: objects the training run never touched warn about it,
  # and Source/Checks/cm_cxx_features.cmake reads ANY warning in a probe as
  # "feature unavailable", so a re-run probe would conclude this compiler has no
  # C++11 support and abort the configure.
  # `-Wno-error=coverage-mismatch`: `-fprofile-use` enables passes the generate
  # phase never ran, so a few kwsys sources (ProcessUNIX.c, in both the C and the
  # C++ target) come back with a different arc count and GCC errors on that by
  # default. Downgraded, those functions compile without profile data; everything
  # else keeps the real profile, and the payload is uninstrumented either way.
  sed -i 's/-fprofile-generate/-fprofile-use -Wno-missing-profile -Wno-error=coverage-mismatch/g' CMakeCache.txt
  if grep -q -- '-fprofile-generate' CMakeCache.txt; then
    error "phase-2 rewrite left -fprofile-generate in CMakeCache.txt"
    return 1
  fi
  # The generated Makefile only reconfigures when a tracked input is newer than
  # the generated files, so force that check; `make` then re-runs cmake with the
  # rewritten cache, regenerates flags.make/link.txt and only then relinks.
  touch CMakeLists.txt
  make clean
  make
}

package() {
  cd "$srcdir/cmake"
  make DESTDIR="${pkgdir}" install

  install -Dm644 LICENSE.rst -t "${pkgdir}"/usr/share/licenses/$pkgname

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may
  # be added to $pkgdir after the payload is verified.
  verify_no_profile_instrumentation "${pkgdir}"
}
