# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-quick3d
# placeholder — overridden by pkgver() (git describe on dev branch)
pkgver=6.13.0_r5540.ga1a3e7f33
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Qt module and API for defining 3D content in Qt Quick'
depends=(glibc
         libgcc
         libglvnd
         libstdc++
         openxr
         qt6-base
         qt6-declarative
         qt6-quicktimeline
         qt6-shadertools
         zlib)
makedepends=(assimp
             cmake
             git
             ninja
             vulkan-headers)
optdepends=('assimp: assimp import plugin')
groups=(qt6)
_pkgfn=${pkgname/6-/}
# 0001-bridge-*.patch is a TEMPORARY BRIDGE: it adapts us to qtbase 2beefb38db9's
# QRhiShaderResourceBinding::Data rework (stex moved out of u, count() method,
# QVarLengthArray texSamplers) until qtquick3d upstream does. DROP IT then.
source=(git+https://code.qt.io/qt/$_pkgfn#branch=dev
        0001-bridge-QRhiShaderResourceBinding-Data-stex-rework.patch)
sha256sums=('SKIP'
            '11af14441050a1f24749c174a5914c1c4c553f59b4af32f3bc82ba8428b8951f')

prepare() {
  # TEMPORARY BRIDGE — same rationale as the patch header; drop both together.
  patch -Np1 --fuzz=0 -d "$_pkgfn" \
    -i "$srcdir/0001-bridge-QRhiShaderResourceBinding-Data-stex-rework.patch"

  # patch can succeed at the wrong offset; assert the contract lines verbatim.
  grep -qF 'd->stex.texSamplers.resize(1);' "$_pkgfn"/src/runtimerender/qssgrhicontext.cpp
  grep -qF 'd->stex.texSamplers[0].sampler = sampler;' "$_pkgfn"/src/runtimerender/qssgrhicontext.cpp
  ! grep -qF 'u.stex' "$_pkgfn"/src/runtimerender/qssgrhicontext.cpp
}

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

pkgver() {
  cd $_pkgfn
  # git describe is UNUSABLE on Qt dev branches: release tags (6.8+) live on
  # the 'release' branch, not in dev ancestry — describe finds ancient tags.
  # Read the real module version from .cmake.conf instead (pyside6 precedent).
  _ver="$(grep -m1 -oP 'QT_REPO_MODULE_VERSION\s+"?\K[0-9][0-9.]*' .cmake.conf)"
  echo "${_ver}_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}
