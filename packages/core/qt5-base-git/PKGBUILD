pkgbase=qt5-base-git
pkgname=(qt5-base-git qt5-xcb-private-headers-git)
pkgver=5.15.2+kde_r45808.gfbed962c319
pkgrel=1
arch=($CARCH)
url='https://www.qt.io'
license=(GPL3 LGPL3 FDL custom)
pkgdesc='A cross-platform application and UI framework'
depends=(libjpeg-turbo xcb-util-keysyms xcb-util-renderutil libgl fontconfig xdg-utils
         shared-mime-info xcb-util-wm libxrender libxi sqlite xcb-util-image mesa
         tslib libinput libxkbcommon-x11 libproxy libcups double-conversion md4c)
makedepends=(git alsa-lib gst-plugins-base-libs
             libpulse cups vulkan-headers)
# Trimmed 2026-09-04: libfbclient/mariadb-libs/unixodbc/postgresql-libs/freetds
# (SQL server drivers — only sqlite is used here; freetds/libfbclient were never
# even enabled by the old -plugin-sql line) and gtk3 (dead GTK platform plugin
# under niri).
conflicts=(qtchooser{,-git})
optdepends=('qt5-svg: to use SVG icon themes'
            'qt5-wayland: to run Qt applications in a Wayland session'
            'qt5-translations: for some native UI translations'
            'perl: for fixqt4headers and syncqt')
groups=(qt-git qt5-git)
# 2026-10-07: explicit `kde-qtbase::` name + `#branch=kde/5.15` — the SRCDEST
# git-mirror dir is derived from the source basename, and qt6-base-git's
# code.qt.io qtbase claims the same `qtbase` name (one dir, one origin: the
# second fetch gets "is not a clone of"). The branch pin also stops the clone
# landing on invent.kde.org's default `dev` (Qt6 tip), which `pkgver()` would
# otherwise read before prepare()'s checkout.
source=("kde-qtbase::git+https://invent.kde.org/qt/qt/qtbase.git#branch=kde/5.15" qt5-base-cflags.patch qt5-base-nostrip.patch)
sha256sums=('SKIP'
            'cf707cd970650f8b60f8897692b36708ded9ba116723ec8fcd885576783fe85c'
            '4b93f6a79039e676a56f9d6990a324a64a36f143916065973ded89adc621e094')

pkgver() {
  cd kde-qtbase/dist
  _ver="$(ls | sort -V | tail -1 | sed 's/changes-//')"
  echo "$_ver+kde_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}

prepare() {
  cd kde-qtbase
  git checkout kde/5.15

  patch -p1 < ../qt5-base-cflags.patch # Use system CFLAGS in qmake
  patch -p1 < ../qt5-base-nostrip.patch # Don't strip binaries with qmake

  # Fat-LTO hardening: makepkg 7.1's tidy hook (safe_strip_lto) strips .gnu.lto_*
  # from every packaged static archive. qtbase -ltcg builds slim-LTO objects (pure
  # IR; GCC >=12 defaults to slim even without -fno-fat-lto-objects), so that hook
  # erases the entire payload and every shipped .a becomes unlinkable (observed:
  # qt5ct undefined QDBus* refs — the symbols live in the hollowed
  # libQt5ThemeSupport.a). Forcing -ffat-lto-objects gives objects real machine
  # code, so the hook only removes the IR and the archives stay linkable.
  sed -i 's/-fno-fat-lto-objects/-ffat-lto-objects/' mkspecs/common/gcc-base.conf
}

build() {
  cd kde-qtbase

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure -confirm-license -opensource -v \
    -prefix /usr \
    -docdir /usr/share/doc/qt \
    -headerdir /usr/include/qt \
    -archdatadir /usr/lib/qt \
    -datadir /usr/share/qt \
    -sysconfdir /etc/xdg \
    -examplesdir /usr/share/doc/qt/examples \
    -plugin-sql-sqlite \
    -system-sqlite \
    -openssl-linked \
    -nomake examples \
    -no-rpath \
    -dbus-linked \
    -system-harfbuzz \
    -journald \
    -no-mimetype-database \
    -no-use-gold-linker \
    -reduce-relocations \
    -no-strip \
    -ltcg
  make
}

package_qt5-base-git() {
  pkgdesc='A cross-platform application and UI framework'
  conflicts=(qt5-base)
  provides=(qt5-base=$pkgver)

  cd kde-qtbase
  make INSTALL_ROOT="${pkgdir}" install

  install -Dm644 LICENSE* -t "$pkgdir"/usr/share/licenses/${pkgbase%-git}

  # Drop QMAKE_PRL_BUILD_DIR because reference the build dir
  find "${pkgdir}/usr/lib" -type f -name '*.prl' \
    -exec sed -i -e '/^QMAKE_PRL_BUILD_DIR/d' {} \;

  # Fix wrong qmake path in pri file
  sed -i "s|${srcdir}/kde-qtbase|/usr|" \
    "${pkgdir}"/usr/lib/qt/mkspecs/modules/qt_lib_bootstrap_private.pri

  # Symlinks for backwards compatibility
  for b in "${pkgdir}"/usr/bin/*; do
    ln -s $(basename $b) "${pkgdir}"/usr/bin/$(basename $b)-qt5
  done
}

package_qt5-xcb-private-headers-git() {
  pkgdesc='Private headers for Qt5 Xcb'

  depends=("qt5-base-git=$pkgver")
  conflicts=(qt5-xcb-private-headers)
  provides=(qt5-xcb-private-headers=$pkgver)

  cd kde-qtbase
  install -d -m755 "$pkgdir"/usr/include/qtxcb-private
  cp -r src/plugins/platforms/xcb/*.h "$pkgdir"/usr/include/qtxcb-private/
}
