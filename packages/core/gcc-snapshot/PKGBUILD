pkgbase=gcc-snapshot
# Trimmed 2026-09-04: c,c++,fortran,lto only (fortran runtime needed by hdf5/scipy;
# libgccjit kept — emacs needs it). Dropped: ada/ga68/cobol/d/go/m2/objc/rust
# frontends + their runtime libs, GPU offload (nvptx/amdgcn), vtable-verify.
pkgname=({gcc,gcc-fortran,gcc-libs,libasan,libatomic,libgcc,libgccjit,libgfortran,libgomp,libitm,liblsan,libquadmath,libstdc++,libtsan,libubsan,lib32-gcc-libs,lto-dump}-snapshot)
# WEEKLY SNAPSHOT policy (2026-10-31, replacing the AUR snapshot-tarball
# mechanism and version-sync=nvchecker): the pin below is the last gcc master
# commit at or before Monday 00:00 UTC of the current week (boundary
# 2026-10-26T00:00Z = 9f6f255b68b08218234d6c59aeee8a66943c99c7, commit date
# 2026-10-25T22:00Z), fetched as a git tree checkout like the -git recipes
# (github mirror of gcc.gnu.org git; SHAs identical). ADVANCE THE PIN on the
# Monday cadence (or at any deliberate upgrade): move _commit and pkgver
# together. pkgver = BASE-VER_r<count>.<short12> at the pin
# (17.0.0_r233981.9f6f255b68b0); _realver is BASE-VER at the pin.
# epoch=2: the 2026-10-31 scheme change (snapshotYYYYMMDD →
# BASE-VER_r<count>.<short12>) sorts LOWER than every old-scheme version
# ("snapshot…" > "r…" lexically) — without the epoch the engine's
# already-current install gate would silently skip the migration install.
# With an epoch set, EVERY versioned pin in this recipe must spell it:
# pacman parses an epoch-less "=17.0.0…" dep as 0:17.0.0… and refuses to
# match the provided 2:17.0.0… ("failed to prepare transaction" — the
# 2026-11-01 install wall). Hence "${epoch}:${pkgver}" in all split
# depends/provides pins; never paste the bare ${pkgver} into a versioned
# dependency or provide.
epoch=2
pkgver=17.0.0_r233981.9f6f255b68b0
_commit=9f6f255b68b08218234d6c59aeee8a66943c99c7
_realver=${pkgver%%_r*}
_gmpver=6.3.0
_mpcver=1.4.1
_mpfrver=4.2.2
pkgrel=2
pkgdesc="The GNU Compiler Collection (snapshot)"
arch=(x86_64)
license=(GFDL-1.3-or-later GPL-2.0-or-later GPL-3.0-with-GCC-exception LGPL-3.0-only LGPL-3.0-or-later)
url='https://gcc.gnu.org'
# doxygen: package_gcc-snapshot() installs the libstdc++ man3 pages, which
# `doc-install-man` only materialises when doxygen is present — without it the
# generation fails "ignored" and the copy walls (2026-10-07 run #58).
makedepends=(binutils doxygen git lib32-glibc lib32-gcc-libs python zstd)
options=(!emptydirs !lto)
_libdir=usr/lib/gcc/${CHOST}/${_realver}
source=(gcc::git+https://github.com/gcc-mirror/gcc.git#commit=${_commit}
        git+https://github.com/Meinersbur/isl.git#branch=master
        https://gmplib.org/download/gmp/gmp-${_gmpver}.tar.xz{,.sig}
        https://ftp.gnu.org/gnu/mpc/mpc-${_mpcver}.tar.xz{,.sig}
        https://www.mpfr.org/mpfr-${_mpfrver}/mpfr-${_mpfrver}.tar.xz{,.asc}
        c89
        c99)
validpgpkeys=(F3691687D867B81B51CE07D9BBE43771487328A9  # bpiotrowski@archlinux.org
              86CFFCA918CF3AF47147588051E8B148A9999C34  # evangelos@foutrelis.com
              13975A70E63C361C73AE69EF6EEB81F8981C74C7  # richard.guenther@gmail.com
              D3A93CAD751C2AF4F8C7AD516C35B99309B5FA62  # Jakub Jelinek <jakub@redhat.com>
              343C2FF0FBEE5EC2EDBEF399F3599FF828C67298  # Niels Möller <nisse@lysator.liu.se>
              A534BE3F83E241D918280AEB5831D11A0D4DB02A  # vincent@vinc17.net
              AD17A21EF8AED8F1CC02DBD9F7D5C9BF765C61E3) # Andres Enge <andreas.enge@inria.fr>
# The gcc source anchor is the #commit= git pin above (tree content, not a
# digest) — the git-tree-checkout mechanics replace the old AUR tarball
# digest chain entirely (its stale-digest history is gone with the tarball).
# gmp/mpfr/mpc keep their upstream signatures (validpgpkeys).
sha256sums=('SKIP'
            'SKIP'
            'a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898'
            'SKIP'
            '91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931'
            'SKIP'
            'b67ba0383ef7e8a8563734e2e889ef5ec3c3b898a01d00fa0a6869ad81c6ce01'
            'SKIP'
            'de48736f6e4153f03d0a5d38ceb6c6fdb7f054e8f47ddd6af0a3dbf14f27b931'
            '2513c6d9984dd0a2058557bf00f06d8d5181734e41dcfe07be7ed86f2959622a')

prepare() {
  cd gcc
  [[ ! -e isl ]] && ln -s ../isl isl
  [[ ! -e gmp ]] && ln -s ../gmp-${_gmpver} gmp
  [[ ! -e mpc ]] && ln -s ../mpc-${_mpcver} mpc
  [[ ! -e mpfr ]] && ln -s ../mpfr-${_mpfrver} mpfr
  echo "${_realver}" >gcc/BASE-VER

  sed -i 's@\./fixinc\.sh@-c true@' gcc/Makefile.in
  sed -i '/m64=/s/lib64/lib/' gcc/config/i386/t-linux64

  # PR c++/127395 (regression r17-4199): verify_ctor_sanity false-positives
  # on valid code — gcc_assert (ctx->ctor) fires on a legitimately null ctor
  # in abseil-cpp-20260817 and vendored protobuf map.h, ICEing every consumer
  # of those headers (opencv, …) at -O0 and -O3 alike.  The asserts below it
  # dereference ctx->ctor, so removing only the failing one turns a clean ICE
  # into a compiler segfault on the same inputs.  No upstream fix as of
  # snapshot 20261004 (constexpr.cc last touched upstream 2026-09-27), so
  # make the verifier a no-op wholesale — what --enable-checking=no does to
  # it, scoped.  Drop this block once the upstream fix lands.
  #
  # Applied in prepare(), NOT as a source=() entry: house patch, kept inline
  # since the 2026-10-31 migration to the pinned git checkout (there is no
  # upstream snapshot tarball to carry it any more).  The grep guard keeps
  # prepare() idempotent over an already-patched $srcdir.
  grep -q 'PR c++/127395' gcc/cp/constexpr.cc || patch -Ntp1 <<'GSA_PR127395'
--- a/gcc/cp/constexpr.cc
+++ b/gcc/cp/constexpr.cc
@@ -7374,6 +7374,19 @@
 static void
 verify_ctor_sanity (const constexpr_ctx *ctx, tree type)
 {
+  /* PR c++/127395: since r17-4199 this verifier false-positives on valid
+     code (abseil-cpp-20260817 headers, vendored protobuf map.h): gcc_assert
+     (ctx->ctor) fires on a legitimately null ctor and ICEs every consumer of
+     those headers at -O0 and -O3 alike.  The ICE line is that assert; the
+     asserts below it dereference ctx->ctor, so disabling only the first one
+     would turn a clean ICE into a compiler segfault on the same inputs.
+     No upstream fix had landed as of snapshot 20261004 (constexpr.cc last
+     touched upstream 2026-09-27; still unfixed at the 2026-10-26 pin), so make
+     this verifier a no-op wholesale -- identical to what --enable-checking=no
+     does to it, without dropping the rest of the compiler's checks.
+     Drop this patch once the upstream fix lands.  */
+  return;
+
   /* We don't bother building a ctor for an empty base subobject.  */
   if (is_empty_class (type))
     return;
GSA_PR127395

  mkdir -p ${srcdir}/gcc-build ${srcdir}/libgccjit-build
}

build() {
  local _confflags=(
    --prefix=/usr
    --libdir=/usr/lib
    --libexecdir=/usr/lib
    --mandir=/usr/share/man
    --infodir=/usr/share/info
    --with-bugurl=https://github.com/ZhangDM-520/gentoo-style-arch/issues
    --with-build-config=bootstrap-lto
    --with-linker-hash-style=gnu
    --with-isl-include=../gcc/isl/include
    --enable-__cxa_atexit
    --enable-cet=auto
    --enable-checking=release
    --enable-clocale=gnu
    --enable-cxx-modules
    --enable-default-pie
    --enable-default-ssp
    --enable-experimental-modules
    --enable-gnu-indirect-function
    --enable-gnu-unique-object
    --enable-libstdcxx-backtrace
    --enable-link-serialization=1
    --enable-linker-build-id
    --enable-lto
    --enable-multilib
    --enable-plugin
    --enable-shared
    --enable-threads=posix
    --disable-libssp
    --disable-libstdcxx-pch
    --disable-werror
  )

  cd gcc-build

  CFLAGS=${CFLAGS/-Werror=format-security/}
  CXXFLAGS=${CXXFLAGS/-Werror=format-security/}

  ../gcc/configure \
    --enable-languages=c,c++,fortran,lto \
    --enable-bootstrap \
    "${_confflags[@]:?_confflags unset}"

  make -O "STAGE1_CFLAGS=-O2" "STAGE2_CFLAGS=-O2" "STAGE3_CFLAGS=-O2" "STAGE4_CFLAGS=-O2" \
          "BOOT_CFLAGS=${CFLAGS}" "BOOT_LDFLAGS=${LDFLAGS}" "LDFLAGS_FOR_TARGET=${LDFLAGS}" \
          bootstrap V=0

  cd ${srcdir}/libgccjit-build

  ../gcc/configure \
    --enable-languages=jit \
    --disable-bootstrap \
    --enable-host-shared \
    "${_confflags[@]:?_confflags unset}"

  make -O "STAGE1_CFLAGS=-O2" "STAGE2_CFLAGS=-O2" "STAGE3_CFLAGS=-O2" "STAGE4_CFLAGS=-O2" \
          "BOOT_CFLAGS=${CFLAGS}" "BOOT_LDFLAGS=${LDFLAGS}" "LDFLAGS_FOR_TARGET=${LDFLAGS}" \
          all-gcc V=0

  cp -a gcc/libgccjit.so* ../gcc-build/gcc/
}

package_gcc-snapshot() {
  pkgdesc="GNU Compiler Collection - C and C++ front-ends (snapshot)"
  depends=("libgcc-snapshot=${epoch}:${pkgver}-${pkgrel}" "libstdc++-snapshot=${epoch}:${pkgver}-${pkgrel}" "glibc>=2.40" zstd)
  optdepends=("lib32-gcc-libs-snapshot: for generating code for 32-bit ABI")
  provides=(${pkgname}-multilib "gcc-multilib=${epoch}:${pkgver}" "gcc=${epoch}:${pkgver}")
  replaces=(${pkgname}-multilib gcc-multilib gcc)
  conflicts=(gcc-multilib gcc)
  options=(!emptydirs staticlibs)

  cd gcc-build

  make -C gcc DESTDIR=${pkgdir} install-driver install-cpp install-gcc-ar c++.install-common install-headers install-plugin install-lto-wrapper V=0

  install -m755 -t ${pkgdir}/usr/bin/ gcc/gcov{,-tool}
  install -m755 -t ${pkgdir}/${_libdir}/ gcc/{cc1,cc1plus,collect2,lto1}

  make -C ${CHOST}/libgcc DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/32/libgcc DESTDIR=${pkgdir} install V=0
  rm -f ${pkgdir}/usr/lib{,32}/libgcc_s*so*

  make -C ${CHOST}/libstdc++-v3/src DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libstdc++-v3/include DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libstdc++-v3/libsupc++ DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libstdc++-v3/python DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/libatomic DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/32/libstdc++-v3/src DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/32/libstdc++-v3/include DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/32/libstdc++-v3/libsupc++ DESTDIR=${pkgdir} install V=0
  make -C ${CHOST}/32/libatomic DESTDIR=${pkgdir} install V=0

  make DESTDIR=${pkgdir} install-libcc1 V=0
  install -d ${pkgdir}/usr/share/gdb/auto-load/usr/lib
  mv ${pkgdir}/usr/lib/libstdc++.so.6.*-gdb.py ${pkgdir}/usr/share/gdb/auto-load/usr/lib/
  rm -f ${pkgdir}/usr/lib{,32}/libstdc++.so*

  make DESTDIR=${pkgdir} install-fixincludes V=0
  make -C gcc DESTDIR=${pkgdir} install-mkheaders V=0

  make -C lto-plugin DESTDIR=${pkgdir} install V=0
  install -dm755 ${pkgdir}/usr/lib/bfd-plugins/
  ln -s /${_libdir}/liblto_plugin.so ${pkgdir}/usr/lib/bfd-plugins/

  make -C ${CHOST}/libgomp DESTDIR=${pkgdir} install-nodist_{libsubinclude,toolexeclib}HEADERS V=0
  make -C ${CHOST}/libitm DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/libquadmath DESTDIR=${pkgdir} install-nodist_libsubincludeHEADERS V=0
  make -C ${CHOST}/libsanitizer DESTDIR=${pkgdir} install-nodist_{saninclude,toolexeclib}HEADERS V=0
  make -C ${CHOST}/libsanitizer/asan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/libsanitizer/tsan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/libsanitizer/lsan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/32/libgomp DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/32/libitm DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0
  make -C ${CHOST}/32/libsanitizer DESTDIR=${pkgdir} install-nodist_{saninclude,toolexeclib}HEADERS V=0
  make -C ${CHOST}/32/libsanitizer/asan DESTDIR=${pkgdir} install-nodist_toolexeclibHEADERS V=0

  make -C gcc DESTDIR=${pkgdir} install-man install-info V=0
  rm -f ${pkgdir}/usr/share/man/man1/{ga68,gcobol,gccgo,gfortran,lto-dump,gdc,gm2}*
  rm -f ${pkgdir}/usr/share/man/man3/{ga68,gcobol}*
  rm -f ${pkgdir}/usr/share/info/{ga68,gccgo,gfortran,gnat-style,gnat_rm,gnat_ugn,gdc,m2}*

  make -C libcpp DESTDIR=${pkgdir} install V=0
  make -C gcc DESTDIR=${pkgdir} install-po V=0

  ln -s gcc ${pkgdir}/usr/bin/cc

  for binary in {c++,g++,gcc,gcc-ar,gcc-nm,gcc-ranlib}
  do
    ln -s /usr/bin/${binary} ${pkgdir}/usr/bin/x86_64-linux-gnu-${binary}
  done

  install -Dm755 ${srcdir}/c89 ${pkgdir}/usr/bin/c89
  install -Dm755 ${srcdir}/c99 ${pkgdir}/usr/bin/c99

  make -C ${CHOST}/libstdc++-v3/doc DESTDIR=${pkgdir} doc-install-man V=0
  rm -f ${pkgdir}/usr/lib32/lib{stdc++,gcc_s}.so*
  rm -f ${pkgdir}/usr/lib{,32}/libatomic*so*

  python -m compileall ${pkgdir}/usr/share/gcc-${_realver}/
  python -O -m compileall ${pkgdir}/usr/share/gcc-${_realver}/

  install -Dm644 ${srcdir}/gcc/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
  install -Dm644 ${srcdir}/gcc/COPYING.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB
  install -Dm644 ${srcdir}/gcc/COPYING.RUNTIME ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.RUNTIME
  install -Dm644 ${srcdir}/gcc/COPYING3 ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3
  install -Dm644 ${srcdir}/gcc/COPYING3.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3.LIB
}

package_gcc-fortran-snapshot() {
  pkgdesc="GNU Compiler Collection - Fortran front-end (snapshot)"
  depends=("gcc-snapshot=${epoch}:${pkgver}-${pkgrel}" "libgfortran-snapshot=${epoch}:${pkgver}-${pkgrel}" "glibc>=2.40")
  provides=(${pkgname}-multilib "gcc-fortran-multilib=${epoch}:${pkgver}" "gcc-fortran=${epoch}:${pkgver}")
  replaces=(${pkgname}-multilib gcc-fortran-multilib gcc-fortran)
  conflicts=(gcc-fortran-multilib gcc-fortran)
  options=(!emptydirs staticlibs)

  cd gcc-build
  make -C ${CHOST}/libgfortran DESTDIR=${pkgdir} install-cafexeclibLTLIBRARIES install-{toolexeclibDATA,nodist_fincludeHEADERS,gfor_cHEADERS} V=0
  make -C ${CHOST}/32/libgfortran DESTDIR=${pkgdir} install-cafexeclibLTLIBRARIES install-{toolexeclibDATA,nodist_fincludeHEADERS,gfor_cHEADERS} V=0
  make -C ${CHOST}/libgomp DESTDIR=${pkgdir} install-nodist_fincludeHEADERS V=0
  make -C gcc DESTDIR=${pkgdir} fortran.install-{common,man,info} V=0
  install -Dm755 gcc/f951 ${pkgdir}/${_libdir}/f951
  ln -s gfortran ${pkgdir}/usr/bin/f95

  install -Dm644 ${srcdir}/gcc/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
  install -Dm644 ${srcdir}/gcc/COPYING.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB
  install -Dm644 ${srcdir}/gcc/COPYING.RUNTIME ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.RUNTIME
  install -Dm644 ${srcdir}/gcc/COPYING3 ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3
  install -Dm644 ${srcdir}/gcc/COPYING3.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3.LIB
}

