pkgbase=gcc-snapshot
# Trimmed 2026-09-04: c,c++,fortran,lto only (fortran runtime needed by hdf5/scipy;
# libgccjit kept — emacs needs it). Dropped: ada/ga68/cobol/d/go/m2/objc/rust
# frontends + their runtime libs, GPU offload (nvptx/amdgcn), vtable-verify.
pkgname=({gcc,gcc-fortran,gcc-libs,libasan,libatomic,libgcc,libgccjit,libgfortran,libgomp,libitm,liblsan,libquadmath,libstdc++,libtsan,libubsan,lib32-gcc-libs,lto-dump}-snapshot)
pkgver=17.0.0.snapshot20260927
if [[ $pkgver =~ ^([0-9]+)\.0\.0\.snapshot([0-9]{8})$ ]]; then
  _pkgver="${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"
else
  printf 'gcc-snapshot: unsupported pkgver format: %s\n' "$pkgver" >&2
  exit 1
fi
_majorver=${_pkgver//-*}
_snapshot=${_pkgver#*-}
_realver=${pkgver//.s*}
_gmpver=6.3.0
_mpcver=1.4.1
_mpfrver=4.2.2
pkgrel=1
pkgdesc="The GNU Compiler Collection (snapshot)"
arch=(x86_64)
license=(GFDL-1.3-or-later GPL-2.0-or-later GPL-3.0-with-GCC-exception LGPL-3.0-only LGPL-3.0-or-later)
url='https://gcc.gnu.org'
makedepends=(binutils git lib32-glibc lib32-gcc-libs python zstd)
options=(!emptydirs !lto)
_libdir=usr/lib/gcc/${CHOST}/${_realver}
source=(https://ftp.fu-berlin.de/unix/languages/gcc/snapshots/${_pkgver}/gcc-${_pkgver}.tar.xz
        git+https://github.com/Meinersbur/isl.git#branch=master
        https://gmplib.org/download/gmp/gmp-${_gmpver}.tar.xz{,.sig}
        https://ftp.gnu.org/gnu/mpc/mpc-${_mpcver}.tar.xz{,.sig}
        https://www.mpfr.org/mpfr-${_mpfrver}/mpfr-${_mpfrver}.tar.xz{,.asc}
        c89
        c99)
validpgpkeys=(F3691687D867B81B51CE07D9BBE43771487328A9  # bpiotrowski@archlinux.org
              86CFFCA918CF3AF47147588051E8B148A9999C34  # evangelos@foutrelis.com
              13975A70E63C361C73AE69EF6EEB81F8981C74C7  # richard.guenther@gmail.com
              D3A93CAD751C2AF4F8C7AD516C35B99309B5FA62  # Jakub Jelinek <jakub@redhat.com>
              343C2FF0FBEE5EC2EDBEF399F3599FF828C67298  # Niels Möller <nisse@lysator.liu.se>
              A534BE3F83E241D918280AEB5831D11A0D4DB02A  # vincent@vinc17.net
              AD17A21EF8AED8F1CC02DBD9F7D5C9BF765C61E3) # Andres Enge <andreas.enge@inria.fr>
sha256sums=('a53e7de5347e898d42fc0f9b7d719c437e0db6aeef303d990b02a99a5454ca68'
            'SKIP'
            'a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898'
