package_lib32-gcc-libs-snapshot() {
  pkgdesc="GNU Compiler Collection - 32-bit Runtime libraries (snapshot)"
  depends=("lib32-glibc>=2.40")
  provides=(${pkgname}-multilib lib32-gcc-libs libasan.so libatomic.so libgfortran.so libgcc_s.so libgomp.so libitm.so libquadmath.so libstdc++.so libubsan.so)
  replaces=(${pkgname}-multilib lib32-gcc-libs)
  conflicts=(lib32-gcc-libs-multilib lib32-gcc-libs)
  options=(!emptydirs)

  cd gcc-build
  make -C ${CHOST}/32/libgcc DESTDIR=${pkgdir} install-shared V=0
  rm -rf ${pkgdir}/${_libdir}/32/libgcc_eh.a

  for lib in libatomic libgfortran libgomp libitm libquadmath libsanitizer/{a,l,ub}san libstdc++-v3/src
  do
    make -C ${CHOST}/32/${lib} DESTDIR=${pkgdir} install-toolexeclibLTLIBRARIES V=0
  done

  rm -rf ${pkgdir}/usr/lib32/libgphobos.spec

  install -Dm644 ${srcdir}/gcc/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
  install -Dm644 ${srcdir}/gcc/COPYING.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB
  install -Dm644 ${srcdir}/gcc/COPYING.RUNTIME ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.RUNTIME
  install -Dm644 ${srcdir}/gcc/COPYING3 ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3
  install -Dm644 ${srcdir}/gcc/COPYING3.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3.LIB
}

package_lto-dump-snapshot() {
  pkgdesc="GNU Compiler Collection - Dump link time optimization object files tool (snapshot)"
  depends=("gcc-snapshot=${pkgver}-${pkgrel}" libgcc-snapshot)
  provides=(${pkgname}-multilib lto-dump)
  replaces=(${pkgname}-multilib lto-dump)
  conflicts=(lto-dump)
  options=(!emptydirs)

  cd gcc-build
  make -C gcc DESTDIR=${pkgdir} lto.install-{common,man,info} V=0

  install -Dm644 ${srcdir}/gcc/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
  install -Dm644 ${srcdir}/gcc/COPYING.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB
  install -Dm644 ${srcdir}/gcc/COPYING.RUNTIME ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.RUNTIME
  install -Dm644 ${srcdir}/gcc/COPYING3 ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3
  install -Dm644 ${srcdir}/gcc/COPYING3.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3.LIB
}
