  options=(!emptydirs)

  cd gcc-build
  make -C ${CHOST}/libgomp DESTDIR=${pkgdir} install-toolexeclibLTLIBRARIES V=0
  make -C ${CHOST}/libgomp DESTDIR=${pkgdir} install-info V=0

  install -Dm644 ${srcdir}/gcc/COPYING ${pkgdir}/usr/share/licenses/${pkgname}/COPYING
  install -Dm644 ${srcdir}/gcc/COPYING.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.LIB
  install -Dm644 ${srcdir}/gcc/COPYING.RUNTIME ${pkgdir}/usr/share/licenses/${pkgname}/COPYING.RUNTIME
  install -Dm644 ${srcdir}/gcc/COPYING3 ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3
  install -Dm644 ${srcdir}/gcc/COPYING3.LIB ${pkgdir}/usr/share/licenses/${pkgname}/COPYING3.LIB
}

