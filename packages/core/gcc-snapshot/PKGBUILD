  pkgdesc="GNU Compiler Collection - Runtime libraries (snapshot)"
  depends=("libasan-snapshot=${epoch}:${pkgver}-${pkgrel}" "libatomic-snapshot=${epoch}:${pkgver}-${pkgrel}" "libgfortran-snapshot=${epoch}:${pkgver}-${pkgrel}" "libgcc-snapshot=${epoch}:${pkgver}-${pkgrel}" "libgomp-snapshot=${epoch}:${pkgver}-${pkgrel}" "libitm-snapshot=${epoch}:${pkgver}-${pkgrel}" "liblsan-snapshot=${epoch}:${pkgver}-${pkgrel}" "libquadmath-snapshot=${epoch}:${pkgver}-${pkgrel}" "libstdc++-snapshot=${epoch}:${pkgver}-${pkgrel}" "libtsan-snapshot=${epoch}:${pkgver}-${pkgrel}" "libubsan-snapshot=${epoch}:${pkgver}-${pkgrel}" "glibc>=2.40")
  provides=(${pkgname}-multilib "gcc-libs-multilib=${epoch}:${pkgver}" "gcc-libs=${epoch}:${pkgver}-${pkgrel}")
  replaces=(${pkgname}-multilib gcc-libs-multilib gcc-libs)
  conflicts=(gcc-libs-multilib gcc-libs)
  options=(!emptydirs)
}

