# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: Andrea Scarpino <andrea@archlinux.org>

pkgname=qt6-declarative
# placeholder — overridden by pkgver() (git describe on dev branch)
pkgver=6.13.0_r39629.g2d2eb7860f
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='Classes for QML and JavaScript languages'
depends=(glibc
         libgcc
         libstdc++
         qt6-base)
makedepends=(cmake
             git
             ninja
             python
             qt6-languageserver
             qt6-shadertools
             qt6-svg
             vulkan-headers)
optdepends=('qt6-svg: for QtQuickVectorImage and svgtoqml')
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#branch=dev)
sha256sums=('SKIP')

# PGO toggle — false for quick rebuilds
_pgo=true

_configure_and_build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
  cmake --build build
}

_train_pgo() {
  local _xdg="${srcdir}/qml-xdg"
  rm -rf "${_xdg}"
  mkdir -m 700 -p "${_xdg}"

  # QML exerciser: animation loops, JS hot loops, model/view instantiation
  cat > "${srcdir}/pgo_train.qml" <<'EOF'
import QtQuick
Item {
    id: root
    width: 480; height: 480
    property real sink: 0
    Rectangle {
        id: rect; width: 60; height: 60; color: "steelblue"
        NumberAnimation on x { from: 0; to: 420; duration: 200; loops: Animation.Infinite; running: true }
        SequentialAnimation on y { loops: Animation.Infinite; running: true
            NumberAnimation { to: 420; duration: 200 }
            NumberAnimation { to: 0; duration: 200 } }
    }
    ListModel { id: lm
        Component.onCompleted: for (var i = 0; i < 300; i++) lm.append({ name: "item" + i, v: i })
    }
    ListView { width: 220; height: 480; model: lm
        delegate: Text { text: name + ":" + v } }
    Timer { interval: 5; running: true; repeat: true
        onTriggered: { var s = 0; for (var j = 0; j < 5000; j++) s += Math.sin(j); root.sink = s } }
    Repeater { model: 40
        Rectangle { x: index * 12; y: 300; width: 10; height: 10; color: "gray" } }
    Component.onCompleted: { var a = []; for (var k = 0; k < 20000; k++) a.push({ a: k }); }
}
EOF

  # SIGINT (not TERM!) so Qt quits cleanly and atexit flushes the .gcda files
  local _env=(
    QT_QPA_PLATFORM=offscreen
    QSG_RENDER_LOOP=basic
    QT_LOGGING_RULES="*.debug=false"
    XDG_RUNTIME_DIR="${_xdg}"
    LD_LIBRARY_PATH="${srcdir}/build/lib"
    QML2_IMPORT_PATH="${srcdir}/build/qml"
  )
  local _qml_bin="${srcdir}/build/bin/qml"
  if [ -x "${_qml_bin}" ]; then
    env "${_env[@]}" timeout -s INT -k 5 40 "${_qml_bin}" "${srcdir}/pgo_train.qml" >/dev/null 2>&1 || true
    env "${_env[@]}" timeout -s INT -k 5 40 "${_qml_bin}" "${srcdir}/pgo_train.qml" >/dev/null 2>&1 || true
  else
    echo "  -> WARNING: build/bin/qml not found; QML training skipped"
  fi
  rm -rf "${_xdg}" "${srcdir}/pgo_train.qml"
}

build() {
  local _pgo_dir="${srcdir}/qt6declarative-pgo"
  local _cxx_orig="${CXXFLAGS}"
  local _ldf_orig="${LDFLAGS}"

  if ${_pgo}; then
    # phase 1: instrumented, LTO stripped (instrumented LTO is fragile)
    export CXXFLAGS="$(printf '%s' "${CXXFLAGS}" | sed 's/-flto=[^ ]*//g; s/-flto//g') -fprofile-generate=${_pgo_dir} -fprofile-update=atomic"
    export LDFLAGS="${_ldf_orig} -fprofile-generate=${_pgo_dir}"
  fi

  _configure_and_build

  if ${_pgo}; then
    _train_pgo

    local _gcda_count
    _gcda_count=$(find "${_pgo_dir}" -name '*.gcda' 2>/dev/null | wc -l)
    echo "  -> Generated ${_gcda_count} profile data files"

    export CXXFLAGS="${_cxx_orig}"
    export LDFLAGS="${_ldf_orig}"
    if [ "${_gcda_count}" -gt 0 ]; then
      # phase 2: env-flag changes require a CLEAN build dir (reconfigure keeps
      # stale flags); never ship -fprofile-use with an empty profile
      export CXXFLAGS+=" -fprofile-use=${_pgo_dir} -fprofile-reorder-functions -Wno-error=format-overflow -Wno-error=coverage-mismatch"
      rm -rf build
      _configure_and_build
    else
      echo "  -> WARNING: no profile data generated. Falling back to LTO-only build."
    fi
    rm -rf "${_pgo_dir}"
  fi
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

pkgver() {
  cd $_pkgfn
  # git describe is UNUSABLE on Qt dev branches: release tags (6.8+) live on
  # the 'release' branch, not in dev ancestry — describe finds ancient tags.
  # Read the real module version from .cmake.conf instead (pyside6 precedent).
  _ver="$(grep -m1 -oP 'QT_REPO_MODULE_VERSION\s+"?\K[0-9][0-9.]*' .cmake.conf)"
  echo "${_ver}_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}
