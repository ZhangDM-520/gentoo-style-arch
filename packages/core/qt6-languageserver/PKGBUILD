# Maintainer: Antonio Rojas <arojas@archlinux.org>
# Maintainer: Felix Yan <felixonmars@archlinux.org>

pkgname=qt6-languageserver
# placeholder — overridden by pkgver() (git describe on dev branch)
pkgver=6.13.0_r654.g9ecf481
pkgrel=1
arch=(x86_64)
url='https://www.qt.io'
license=(GPL-3.0-only
         LGPL-3.0-only
         LicenseRef-Qt-Commercial
         Qt-GPL-exception-1.0)
pkgdesc='An implementation of the Language Server Protocol'
depends=(qt6-base)
makedepends=(cmake
             git
             ninja)
groups=(qt6)
_pkgfn=${pkgname/6-/}
source=(git+https://code.qt.io/qt/$_pkgfn#branch=dev)
# UNPINNED 2026-09-26: the 2026-09-08 pin to r647 (d845a85) existed because
# dba4b9f ("update LSP types to 3.18") renamed the spec types
# (Variant{1,2} → Partial/WholeDocument; untyped QJsonObject fields → typed
# classes) and qtdeclarative's qmlls had not yet adapted. The documented exit
# condition ("Unpin once qt/qtdeclarative dev adapts") is now met — qtdeclarative
# dev uses the regenerated types — so the source returns to the pre-pin
# #branch=dev idiom. Rebuild qt6-declarative in the same pass (MEMORY.md rule 14).
sha256sums=('SKIP')

build() {
  cmake -B build -S $_pkgfn -G Ninja \
    -DCMAKE_MESSAGE_LOG_LEVEL=STATUS \
    -DQT_BUILD_TESTS=OFF \
    -DQT_BUILD_EXAMPLES=OFF \
    -DCMAKE_CXX_FLAGS="$CXXFLAGS -ffat-lto-objects"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -d "$pkgdir"/usr/share/licenses
  ln -s /usr/share/licenses/qt6-base "$pkgdir"/usr/share/licenses/$pkgname
}

pkgver() {
  cd $_pkgfn
  # git describe is UNUSABLE on Qt dev branches: release tags (6.8+) live on
  # the 'release' branch, not in dev ancestry — describe finds ancient tags.
  # Read the real module version from .cmake.conf instead (pyside6 precedent).
  _ver="$(grep -m1 -oP 'QT_REPO_MODULE_VERSION\s+"?\K[0-9][0-9.]*' .cmake.conf)"
  echo "${_ver}_r$(git rev-list --count HEAD).g$(git rev-parse --short HEAD)"
}
