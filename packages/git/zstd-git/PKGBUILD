# Maintainer: Johan Förberg <johan@forberg.se>
pkgname=zstd-git
_pkgname=zstd
pkgver=1.5.7.r0.gf8745da6f
pkgrel=1
pkgdesc='Zstandard - Fast real-time compression algorithm (git build)'
arch=('x86_64' 'aarch64')
url='https://github.com/facebook/zstd'
license=('BSD-3-Clause' 'GPL-2.0-only')
groups=()
depends=('xz' 'zlib' 'lz4')
makedepends=('git')
conflicts=('zstd')
provides=('zstd' 'libzstd.so=1-64')
# Track the release branch — dev branch tags diverged after v1.4.7
# (release tags are on a separate branch, unreachable from dev via git describe)
source=('git+https://github.com/facebook/zstd.git#branch=release')
noextract=()
md5sums=('SKIP')

pkgver() {
    cd "$srcdir/$_pkgname"
    git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//g'
}

build() {
    cd "$srcdir/$_pkgname"

    # Save original flags
    local _cflags_orig="$CFLAGS"
    local _cxxflags_orig="$CXXFLAGS"
    local _ldflags_orig="$LDFLAGS"

    # Phase 1: instrumented build (LTO off for speed)
    export CFLAGS="${_cflags_orig} -fprofile-generate=$(pwd)/pgo-profiles"
    export CXXFLAGS="${_cxxflags_orig} -fprofile-generate=$(pwd)/pgo-profiles"
    export LDFLAGS="${_ldflags_orig} -fuse-ld=mold -fprofile-generate=$(pwd)/pgo-profiles"
    make clean 2>/dev/null || true
    make

    # Phase 2: training — use built-in benchmark
    # NOTE: the CLI lands at programs/zstd, NOT ./zstd
    msg "PGO Phase 2: training with zstd benchmark"
    ./programs/zstd -b1 2>/dev/null || true
    ./programs/zstd -b3 2>/dev/null || true
    ./programs/zstd -b7 2>/dev/null || true

    # Verify profile data
    local gcda_count=$(find . -name '*.gcda' 2>/dev/null | wc -l)
    if [ "$gcda_count" -eq 0 ]; then
        warning "No profile data generated — falling back to LTO-only build"
        export CFLAGS="${_cflags_orig} -flto"
        export CXXFLAGS="${_cxxflags_orig} -flto"
        export LDFLAGS="${_ldflags_orig} -fuse-ld=mold -flto"
        make clean 2>/dev/null || true
        make
        make -C contrib/pzstd
        return 0
    fi
    msg "Profile data generated: $gcda_count .gcda files"

    # Phase 3: rebuild with profile + LTO
    export CFLAGS="${_cflags_orig} -flto -fprofile-use=$(pwd)/pgo-profiles"
    export CXXFLAGS="${_cxxflags_orig} -flto -fprofile-use=$(pwd)/pgo-profiles"
    export LDFLAGS="${_ldflags_orig} -fuse-ld=mold -flto -fprofile-use=$(pwd)/pgo-profiles"
    make clean 2>/dev/null || true
    make
    make -C contrib/pzstd
    rm -rf pgo-profiles
}

package() {
    cd "$srcdir/$_pkgname"
    make PREFIX="/usr" DESTDIR="$pkgdir/" install
    install -D -m755 contrib/pzstd/pzstd "$pkgdir/usr/bin/pzstd"
    install -D -m644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"

    # zstd's Makefile install ships no CMake package config (only the CMake
    # build's install(EXPORT) generates one), but openexr >= 3.5 resolves zstd
    # with find_dependency(zstd CONFIG) and fails its whole config load without
    # it — which pushed krita's FindOpenEXR onto its broken manual fallback
    # (Imath_INCLUDE_DIR-NOTFOUND, 2026-09-29). Install an equivalent config by
    # hand so CONFIG-mode consumers of OpenEXR keep working.
    install -d "$pkgdir/usr/lib/cmake/zstd"
    cat > "$pkgdir/usr/lib/cmake/zstd/zstdConfig.cmake" <<'EOF'
# Hand-written stand-in for upstream's CMake-build-generated zstdConfig.cmake;
# this recipe installs via the Makefile, which ships no package config.
# Mirrors upstream's exported targets: zstd::libzstd_shared (what OpenEXR
# links) and zstd::libzstd. No zstd::libzstd_static — shared libs only here.
if(NOT TARGET zstd::libzstd_shared)
  add_library(zstd::libzstd_shared SHARED IMPORTED)
  get_filename_component(_zstd_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
  set_target_properties(zstd::libzstd_shared PROPERTIES
    IMPORTED_LOCATION "${_zstd_prefix}/lib/libzstd.so"
    INTERFACE_INCLUDE_DIRECTORIES "${_zstd_prefix}/include")
  unset(_zstd_prefix)
endif()

if(NOT TARGET zstd::libzstd)
  add_library(zstd::libzstd INTERFACE IMPORTED)
  set_target_properties(zstd::libzstd PROPERTIES
    INTERFACE_LINK_LIBRARIES zstd::libzstd_shared)
endif()
EOF
    # SameMajorVersion semantics, matching upstream's write_basic_package_version_file
    cat > "$pkgdir/usr/lib/cmake/zstd/zstdConfigVersion.cmake" <<EOF
set(PACKAGE_VERSION "${pkgver%%.r*}")
if(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
elseif(NOT PACKAGE_FIND_VERSION_MAJOR EQUAL ${pkgver%%.*})
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION VERSION_EQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
EOF
}
