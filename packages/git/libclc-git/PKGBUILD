# Maintainer: Solomon Choina <shlomochoina@gmail.com>
pkgname=libclc-git
# WEEKLY SNAPSHOT policy (2026-10-31, replacing free git tracking): pin
# tracks the SAME llvm-project commit as llvm-git (boundary 2026-10-26T00:00Z
# = caf7a716fe6eb7fbc0f0cec7b745b94ab3706ddf) — libclc is built by the
# matching LLVM and must move with it (coupled batch, abi=must). ADVANCE THE
# PIN on the Monday cadence together with llvm-git: move #commit= and pkgver
# together (pkgver() recomputes the same value at the pin).
pkgver=24.0.0_r604528.caf7a716fe6e
pkgrel=1
epoch=1
groups=('chaotic-mesa-git')
pkgdesc="Library requirements of the OpenCL C programming language (git version)"
arch=('any')
url="http://libclc.llvm.org/"
license=('MIT')
provides=("libclc=${pkgver}")
conflicts=('libclc')
makedepends=('clang' 'llvm-libs' 'llvm' 'git' 'python' 'ninja' 'cmake')
# Trimmed 2026-09-04: amdgcn target only. The spirv* targets feed clover/rusticl
# OpenCL (mesa-git builds none) and nvptx64 is NVIDIA-only; polly and
# spirv-llvm-translator were only needed by those dropped targets.
source=('llvm-project-git::git+https://github.com/llvm/llvm-project.git#commit=caf7a716fe6eb7fbc0f0cec7b745b94ab3706ddf')
md5sums=('SKIP')

pkgver() {
  cd llvm-project-git/cmake/Modules
  local _pkgver=$(awk -F 'MAJOR |MINOR |PATCH |)' \
          'BEGIN { ORS="." ; i=0 } \
           /set\(LLVM_VERSION_/ { print $2 ; i++ ; if (i==2) ORS="" } \
           END { print "\n" }' \
           LLVMVersion.cmake)_r$(git rev-list --count HEAD).$(git rev-parse --short HEAD)
  echo "${_pkgver}"

}

prepare() {
   cd llvm-project-git

  rm -rf build
}
build() {
  cd llvm-project-git

  export CXXFLAGS="${CXXFLAGS} -fno-lto"
  export CFLAGS="${CFLAGS} -fno-lto"

  # libclc's CLC compiler defaults to CMAKE_C_COMPILER, which must be clang
  export CC=clang
  export CXX=clang++

  # libclc no longer supports LIBCLC_TARGETS_TO_BUILD; each target is
  # selected via LLVM_DEFAULT_TARGET_TRIPLE and must be configured separately.
  local _targets=(
    amdgcn-amd-amdhsa-llvm
  )

  for _target in "${_targets[@]}"; do
    cmake -B build/$_target -S libclc -G Ninja \
      -DCMAKE_BUILD_TYPE=Release \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_C_COMPILER=clang \
      -DCMAKE_CXX_COMPILER=clang++ \
      -DLLVM_CMAKE_DIR=/usr/lib/cmake/llvm \
      -DLLVM_DEFAULT_TARGET_TRIPLE=$_target

    ninja -C build/$_target
  done
}

package() {
  cd "$srcdir/llvm-project-git"

  local _target
  for _target in build/*; do
    DESTDIR="$pkgdir" ninja -C "$_target" install
  done

  install -Dm644 libclc/LICENSE.TXT "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
