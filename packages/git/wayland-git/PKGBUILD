# Maintainer: Daniel Bermond <dbermond@archlinux.org>
# Contributor: Joel Teichroeb <joel@teichroeb.net>
# Contributor: Scimmia

pkgbase=wayland-git
pkgname=('wayland-git')
pkgver=1.26.0.r14.g1bd29e0
pkgrel=1
pkgdesc='A computer display server protocol (git version)'
arch=('x86_64')
url='https://wayland.freedesktop.org/'
license=('MIT')
depends=(
    'default-cursors'
    'expat'
    'glibc'
    'libffi'
    'libxml2')
makedepends=(
    'git'
    'meson')
source=('git+https://gitlab.freedesktop.org/wayland/wayland.git')
sha256sums=('SKIP')

pkgver() {
    git -C wayland describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
    if command -v mold >/dev/null 2>&1; then
        export LDFLAGS+=" -fuse-ld=mold"
    fi

    # PGO: instrumented build → training → optimized build
    if [[ -n "${_wayland_PGO:-}" ]]; then
        msg "PGO Phase 1: instrumented build"
        arch-meson wayland build \
            -Ddocumentation=false \
            -D b_lto=false \
            -D b_pgo=generate
        meson compile -C build

        msg "PGO Phase 2: training with test suite"
        timeout -k 5 120 meson test -C build --no-rebuild --print-errorlogs 2>/dev/null || true

        local gcda_count=$(find build -name '*.gcda' 2>/dev/null | wc -l)
        if (( gcda_count < 10 )); then
            warning "Profile data insufficient ($gcda_count .gcda files) — falling back to LTO-only"
            meson configure build -Db_pgo=disabled -Db_lto=true
        else
            msg "Profile data generated: $gcda_count .gcda files"
            msg "PGO Phase 3: optimized build"
            meson configure build -Db_pgo=use -Db_lto=true
        fi
        meson compile -C build
    else
        arch-meson wayland build \
            -Ddocumentation=false \
            -D b_lto=true
        meson compile -C build
    fi
}

check() {
    meson test -C build --print-errorlogs || true
}

package_wayland-git() {
    provides=(
        libwayland-{client,cursor,egl,server}.so
        "wayland=${pkgver}")
    conflicts=(
        'wayland')

    meson install -C build --destdir "$pkgdir"
    install -D -m644 wayland/COPYING "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
