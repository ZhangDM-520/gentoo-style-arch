# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package(). A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgname=xorg-xwayland-git
pkgver=24.1.14.r1232.g0780950be
pkgrel=1
arch=('x86_64')
license=(
  LicenseRef-Adobe-Display-PostScript
  BSD-3-Clause
  LicenseRef-DEC-3-Clause
  HPND
  LicenseRef-HPND-sell-MIT-disclaimer-xserver
  HPND-sell-variant
  ICU
  ISC
  MIT
  MIT-open-group
  NTP
  SGI-B-2.0
  SMLNJ
  X11
  X11-distribute-modifications-variant)
groups=('xorg')
url="https://xorg.freedesktop.org"
pkgdesc="Run X clients under Wayland (git version)"
depends=('nettle' 'libepoxy' 'systemd-libs' 'libxfont2'
         'pixman' 'xorg-server-common' 'libxcvt' 'mesa'
         'libglvnd' 'libxau' 'wayland' 'libdrm' 'libtirpc'
         'libei' 'libxshmfence' 'glibc')
makedepends=('meson' 'xorgproto' 'xtrans' 'libxkbfile' 'dbus'
             'xorg-font-util' 'wayland-protocols' 'mesa-libgl'
             'systemd' 'git'
             # PGO training (phase 2): the piglit xts-render suite drives the
             # pinned XTS against the phase-1 Xwayland under a headless weston.
             # xts's own build needs the X client libs and both font tools
             # (meson find_program, hard); xts5/bin/xts-config calls
             # xdpyinfo/xset while the tests run.
             'piglit-git' 'weston'
             'libx11' 'libxext' 'libxi' 'libxt' 'libxtst' 'libxmu' 'libxaw'
             'xorg-bdftopcf' 'xorg-mkfontdir' 'xorg-xdpyinfo' 'xorg-xset')
source=("xserver::git+https://gitlab.freedesktop.org/xorg/xserver.git"
        # Training input for the PGO phase (phase 2): the X Test Suite the
        # piglit xts-render profile runs. Pinned deliberately — it shapes
        # codegen through the profile, so it moves on purpose, never with
        # remote HEAD.
        "xts::git+https://gitlab.freedesktop.org/xorg/test/xts#commit=6cf94400a09abecd6b86e4eb6441741acecd51f6")
sha256sums=('SKIP'
            'SKIP')

provides=('xorg-xwayland' 'xorg-server-xwayland' 'xorg-server-xwayland-git')
conflicts=('xorg-xwayland' 'xorg-server-xwayland' 'xorg-server-xwayland-git')
replaces=('xorg-server-xwayland-git')

pkgver() {
  cd xserver
  local branch=origin/xwayland-24.1
  local head=$(git rev-parse --short HEAD)
  local tag=$(git describe --abbrev=0 "$branch")
  local revisions=$(git rev-list "${tag}..HEAD" --count)
  printf "%s.r%d.g%s" "$(echo "$tag" | sed 's/^xwayland.//')" "$revisions" "$head"
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D ipv6=true
    -D xvfb=false
    -D xnest=false
    -D xdmcp=false
    -D xcsecurity=true
    -D xorg=false
    -D xephyr=false
    -D xwayland=true
    -D xwin=false
    -D xquartz=false
    -D dri3=true
    -D glamor=true
    -D xkb_dir=/usr/share/X11/xkb
    -D xkb_output_dir=/var/lib/xkb
    -D b_ndebug=true
  )

  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1: PGO instrumented build.
  # pgo_min_gcda: ≈ minimum distinct TUs the training suite touches before a
  # profile is worth trusting; below it the profile is too thin and we fall
  # back to an LTO-only build.
  local pgo_min_gcda=50
  # The profile work dir lives outside the build dir (mesa precedent), and
  # -fprofile-generate=<dir> must stay SYMMETRIC with phase 3's
  # -fprofile-use=<dir>: profiles are looked up as
  # <dir>/<mangled-object-path>.gcda, so the pre-2026-10-19 spelling (bare
  # generate + use=<dir>) missed every profile and silently compiled a
  # profile-less build — -Wno-error=missing-profile downgraded the miss to
  # nothing visible (GCC probe + recipe fix: docs/NOTE.md 2026-10-19; jq's
  # C-autotools block is the template). Phase 1 also strips -flto:
  # generate-mode bookkeeping and LTO whole-program codegen interact badly
  # and meson's -Db_lto=false cannot remove what the env flags still carry.
  local _pgo_dir="$PWD/pgo-profiles"
  mkdir -p "$_pgo_dir"
  local _gen_cflags="" _gen_cxxflags="" _gen_ldflags="" _flag
  for _flag in $_final_cflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_cxxflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cxxflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_ldflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_ldflags+=" $_flag" ;;
    esac
  done
  export CFLAGS="${_gen_cflags# } -fprofile-generate=$_pgo_dir"
  export CXXFLAGS="${_gen_cxxflags# } -fprofile-generate=$_pgo_dir"
  export LDFLAGS="${_gen_ldflags# } -fprofile-generate=$_pgo_dir"
  arch-meson xserver build "${meson_options[@]}" -Db_lto=false
  meson compile -C build

  # Phase 2: training — bounded run (lib/pgo.sh).
  # The training suite is xserver:XTS: the piglit `xts-render` profile (all
  # of xts5/xlib9) run against the phase-1 Xwayland under a headless weston.
  # It SKIPS (exit 77) unless a BUILT XTS tree is provided and the piglit
  # working directory carries a piglit.conf [xts] path= entry — the
  # 2026-10-19 leaf build therefore trained on nothing (3 gcda) and the
  # floor guard below fell back to LTO-only. Build the pinned XTS into
  # $srcdir and shim the installed piglit-git: its wrapper resolves its data
  # dir via realpath, so the shim is just ./piglit + piglit.conf. Budget
  # 300s — the suite actually runs now.
  local _xts_build="$srcdir/xts-build"
  meson setup "$srcdir/xts" "$_xts_build"
  meson compile -C "$_xts_build" -j "${GSA_BUILD_JOBS:-$(nproc)}"
  local _piglit_dir="$srcdir/piglit-shim"
  mkdir -p "$_piglit_dir"
  ln -sf /usr/bin/piglit "$_piglit_dir/piglit"
  printf '[xts]\npath = %s\n' "$_xts_build" > "$_piglit_dir/piglit.conf"
  export XTEST_DIR="$_xts_build"
  export PIGLIT_DIR="$_piglit_dir"
  pgo_train_meson build 300

  # Phase 3: verify profile quality
  local _gcda_count
  _gcda_count="$(find "$_pgo_dir" -name '*.gcda' 2>/dev/null | wc -l)"
  if ((_gcda_count < pgo_min_gcda)); then
    warning "PGO produced only %d gcda files — rebuilding with LTO only" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure xserver build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    export CFLAGS="$_final_cflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile"
    export CXXFLAGS="$_final_cxxflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile"
    export LDFLAGS="$_final_ldflags"
    meson setup --reconfigure xserver build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  fi
}

package() {
  meson install -C build --destdir "${pkgdir}"
  # xorg-server-common file /usr/lib/xorg/protocol.txt
  rm "${pkgdir}"/usr/lib/xorg/protocol.txt
  rmdir "${pkgdir}"/usr/lib/xorg
  rm "${pkgdir}"/usr/share/man/man1/Xserver.1

  # license
  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" xserver/COPYING

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may be
  # added to $pkgdir after the payload is verified.
  verify_no_profile_instrumentation "$pkgdir"
}
