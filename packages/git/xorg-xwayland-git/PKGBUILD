# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package(). A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgname=xorg-xwayland-git
pkgver=24.1.13.r1187.gb125b19fc
pkgrel=1
arch=('x86_64')
license=(
  LicenseRef-Adobe-Display-PostScript
  BSD-3-Clause
  LicenseRef-DEC-3-Clause
  HPND
  LicenseRef-HPND-sell-MIT-disclaimer-xserver
  HPND-sell-variant
  ICU
  ISC
  MIT
  MIT-open-group
  NTP
  SGI-B-2.0
  SMLNJ
  X11
  X11-distribute-modifications-variant)
groups=('xorg')
url="https://xorg.freedesktop.org"
pkgdesc="Run X clients under Wayland (git version)"
depends=('nettle' 'libepoxy' 'systemd-libs' 'libxfont2'
         'pixman' 'xorg-server-common' 'libxcvt' 'mesa'
         'libglvnd' 'libxau' 'wayland' 'libdrm' 'libtirpc'
         'libei' 'libxshmfence' 'glibc')
makedepends=('meson' 'xorgproto' 'xtrans' 'libxkbfile' 'dbus'
             'xorg-font-util' 'wayland-protocols' 'mesa-libgl'
             'systemd' 'git')
source=("xserver::git+https://gitlab.freedesktop.org/xorg/xserver.git")
sha256sums=('SKIP')

provides=('xorg-xwayland' 'xorg-server-xwayland' 'xorg-server-xwayland-git')
conflicts=('xorg-xwayland' 'xorg-server-xwayland' 'xorg-server-xwayland-git')
replaces=('xorg-server-xwayland-git')

pkgver() {
  cd xserver
  local branch=origin/xwayland-24.1
  local head=$(git rev-parse --short HEAD)
  local tag=$(git describe --abbrev=0 "$branch")
  local revisions=$(git rev-list "${tag}..HEAD" --count)
  printf "%s.r%d.g%s" "$(echo "$tag" | sed 's/^xwayland.//')" "$revisions" "$head"
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D ipv6=true
    -D xvfb=false
    -D xnest=false
    -D xdmcp=false
    -D xcsecurity=true
    -D xorg=false
    -D xephyr=false
    -D xwayland=true
    -D xwin=false
    -D xquartz=false
    -D dri3=true
    -D glamor=true
    -D xkb_dir=/usr/share/X11/xkb
    -D xkb_output_dir=/var/lib/xkb
    -D b_ndebug=true
  )

  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1: PGO instrumented build
  # pgo_min_gcda: ≈ minimum distinct TUs the training suite touches before a
  # profile is worth trusting; below it the profile is too thin and we fall
  # back to an LTO-only build.
  local pgo_min_gcda=50
  CFLAGS+=" -fprofile-generate" CXXFLAGS+=" -fprofile-generate"
  arch-meson xserver build "${meson_options[@]}" -Db_lto=false
  meson compile -C build

  # Phase 2: training — run test suite
  timeout -k 5 120 meson test -C build --print-errorlogs || true

  # Phase 3: verify profile quality
  local _gcda_count
  _gcda_count="$(find build -name '*.gcda' 2>/dev/null | wc -l)"
  if ((_gcda_count < pgo_min_gcda)); then
    warning "PGO produced only %d gcda files — rebuilding with LTO only" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure xserver build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    export CFLAGS="$_final_cflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    export CXXFLAGS="$_final_cxxflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    export LDFLAGS="$_final_ldflags"
    meson setup --reconfigure xserver build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -Db_lto=true
    meson compile -C build
  fi
}

package() {
  meson install -C build --destdir "${pkgdir}"
  # xorg-server-common file /usr/lib/xorg/protocol.txt
  rm "${pkgdir}"/usr/lib/xorg/protocol.txt
  rmdir "${pkgdir}"/usr/lib/xorg
  rm "${pkgdir}"/usr/share/man/man1/Xserver.1

  # license
  install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" xserver/COPYING

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may be
  # added to $pkgdir after the payload is verified.
  verify_no_profile_instrumentation "$pkgdir"
}
