# Maintainer: auto-generated
# Contributor: Chocobo1 <chocobo1 AT archlinux DOT net> (AUR libcap-ng-git)

pkgname=libcap-ng-git
_pkgname=libcap-ng
pkgver=0.9.6.r5.g701cefc
pkgrel=1
pkgdesc="Library for Linux that makes using posix capabilities easy (git build)"
arch=('x86_64')
url="https://people.redhat.com/sgrubb/libcap-ng/"
license=('GPL-2.0-or-later' 'LGPL-2.1-or-later')
depends=('glibc')
makedepends=('bash-completion' 'git')
# stock python-capng split is dropped (bindings disabled at configure)
provides=("libcap-ng=$pkgver" 'libcap-ng.so' 'libdrop_ambient.so')
conflicts=('libcap-ng')
source=("git+https://github.com/stevegrubb/${_pkgname}.git")
b2sums=('SKIP')

prepare() {
  cd "$_pkgname"
  # make autotools happy (stock libcap-ng)
  touch NEWS
  autoreconf -fiv
}

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local _jobs="${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"

  cd "$_pkgname"
  ./configure --prefix=/usr \
              --sysconfdir=/etc \
              --enable-static=no \
              --without-python \
              --without-python3
  make -j "$_jobs"
}

package() {
  cd "$_pkgname"
  make DESTDIR="$pkgdir" install
  # belt and braces: never ship python bindings here (stock python-capng split)
  rm -rf "$pkgdir/usr/lib/python"*
  install -Dm644 COPYING COPYING.LIB -t "$pkgdir/usr/share/licenses/$pkgname"
}
