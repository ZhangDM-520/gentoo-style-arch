# Maintainer: auto-generated (Class A upstream-VCS recipe)
# Contributor: Clarence <xjh.azzbcc@gmail.com> (AUR spandsp-git reference)
# Contributor: Kyle <kyle@free2.ml>
# Contributor: Balló György <ballogyor+arch at gmail dot com> (stock spandsp)
# Contributor: Tobias Powalowski <tpowa@archlinux.org>

pkgname=spandsp-git
pkgver=3.1.1.r572.g8f1e164
pkgrel=1
pkgdesc='Low-level signal processing library for telephony (FreeSWITCH fork, git build)'
arch=('x86_64')
# stock builds the original soft-switch.org 0.0.6 tarball, which has no
# public VCS; the maintained VCS line is the FreeSWITCH fork (AUR spandsp-git
# reference) — tracked here, superset of the 0.0.6 API (recorded as anomaly:
# codebase lineage differs from stock)
url='https://github.com/freeswitch/spandsp'
# COPYING: "library is licenced under LGPL 2.1 ... test suite and some of the
# supporting code are licenced under GPL 2" (kept from the fork)
license=('LGPL-2.1-only' 'GPL-2.0-only')
depends=(
  glibc
  libtiff
)
makedepends=('git')
provides=("spandsp=$pkgver" 'libspandsp.so')
# bare libspandsp.so: soname is libspandsp.so.4 at tip (libtool
# CURRENT=4 AGE=0) — pacman 7.1 derives the versioned provide from the bare
# entry; stock's spandsp-docs split dropped (docs build removed below) and
# conflicted, not provided (classb sqlite-doc precedent)
conflicts=('spandsp' 'spandsp-docs')
source=('spandsp::git+https://github.com/freeswitch/spandsp.git')
b2sums=('SKIP')

pkgver() {
  cd spandsp
  # upstream has no usable tags; version comes from spandsp.spec (AUR ref)
  printf '%s.r%s.g%s' \
    "$(awk '/^Version:/ { print $2 }' spandsp.spec)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short HEAD)"
}

prepare() {
  cd spandsp

  # the fork's configure.ac hardcodes Debian multiarch libdirs (AUR ref);
  # normalize to /usr/lib so the sed is redundant with --libdir but harmless
  sed -i "s|libdir='\${exec_prefix}/lib/x86_64-linux-gnu'|libdir='\${exec_prefix}/lib'|g" configure.ac
  sed -i "s|libdir='\${exec_prefix}/lib64'|libdir='\${exec_prefix}/lib'|g" configure.ac

  ./autogen.sh
}

build() {
  cd spandsp

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # stock's --enable-doc + docbook-xsl/doxygen makedeps dropped with the
  # spandsp-docs output
  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --disable-static
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd spandsp
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
