# Maintainer: Kirill Fries-Raevskiy <exocarnivore@gmail.com>
_pkgbase="bpftune"
pkgname="$_pkgbase-git"
pkgver=r772.d5d9f60
pkgrel=1
pkgdesc="BPF/tracing tools for auto-tuning Linux"
arch=("x86_64")
url="https://github.com/oracle/bpftune"
license=('GPLv2 WITH Linux-syscall-note')
#groups=()
depends=("libbpf" "libnl" "libcap")
makedepends=('git' 'bpf' 'clang' 'llvm' 'llvm-libs' 'python-docutils')
provides=("$_pkgbase=${pkgver}")
conflicts=("$_pkgbase")
#replaces=()
#backup=()
options=('strip')
#install=
source=('git+https://github.com/oracle-samples/bpftune'
        '50-bpftune-tuners-pre.hook'
        '95-bpftune-tuners-post.hook'
        'bpftune-restart.script')
#noextract=()
md5sums=('SKIP'
         '0798e6254c576e9fc220f3ecd3e320e1'
         'b5a112e94e4ba2ccf2b3d30d46eee54c'
         'ec68bfa2db973bc9169f24d943f6f327')

pkgver() {
	cd "$_pkgbase"
	printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
	cd "$srcdir/$_pkgbase"
	sed -i 's/\/sbin/\/bin/g' src/Makefile
	sed -i 's/\/sbin/\/bin/g' src/bpftune.service
}

build() {
	cd "$srcdir/$_pkgbase"
	CC=clang make libdir=lib
}

package() {
	cd "$srcdir/$_pkgbase"
	CC=clang make DESTDIR="$pkgdir" libdir=lib install

	# bpftune dlopens the tuner plugins from /usr/lib/bpftune/ and keeps
	# pointers into them, so replacing those files underneath the running
	# process kills a worker thread in strstr() with SIGSEGV.  These hooks
	# stop the unit before the swap and start it after, so it never spans the
	# transaction.
	install -Dm755 "$srcdir/bpftune-restart.script" \
		"$pkgdir/usr/share/libalpm/scripts/bpftune-restart"
	install -Dm644 "$srcdir/50-bpftune-tuners-pre.hook" \
		"$pkgdir/usr/share/libalpm/hooks/50-bpftune-tuners-pre.hook"
	install -Dm644 "$srcdir/95-bpftune-tuners-post.hook" \
		"$pkgdir/usr/share/libalpm/hooks/95-bpftune-tuners-post.hook"
}
