# $Id: PKGBUILD 226039 2017-04-27 13:52:30Z felixonmars $
# Maintainer: Felix Yan <felixonmars@archlinux.org>
# Contributor: csslayer <wengxt AT gmail com>

_pkgname=fcitx5-gtk
pkgname=${_pkgname}-git
pkgver=5.1.7.r1.g0445d4f
pkgrel=1
pkgdesc="Gtk im module for fcitx5 and glib based dbus client library"
arch=('i686' 'x86_64')
url="https://github.com/fcitx/fcitx5-gtk"
license=('GPL')
depends=('glib2')
makedepends=('extra-cmake-modules' 'gobject-introspection' 'gtk3' 'gtk4' 'vulkan-headers' 'git')
provides=(${_pkgname})
conflicts=(${_pkgname})
source=("git+$url.git")
sha512sums=('SKIP')

pkgver() {
  cd fcitx5-gtk
  git describe --long | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd fcitx5-gtk
  # GCC 17 patch (2026-09-07): <string> is no longer transitively included
  # via <memory>/<utility> — gtk{3,4}/utils.h use std::string but don't
  # include it (build died in gtk4/utils.h).
  sed -i 's/^#include <memory>$/#include <memory>\n#include <string>/' \
      gtk3/utils.h gtk4/utils.h
}

build(){
  cd fcitx5-gtk

  # gtk2 im module disabled 2026-09-07: gtk2 not installed, nothing on this
  # system needs it (option name verified against fcitx5-gtk CMakeLists.txt).
  # makepkg.conf CFLAGS/LTO/mold apply via cmake.
  cmake -GNinja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_LIBDIR=/usr/lib \
        -DENABLE_GTK2_IM_MODULE=OFF .
  ninja
}

package() {
  cd fcitx5-gtk
  DESTDIR="$pkgdir" ninja install
}
