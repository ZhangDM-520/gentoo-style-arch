pkgname=libxrandr-git
pkgver=1.5.5.r3.g8a4ba19
pkgrel=1
pkgdesc="X11 RandR extension library (git build)"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('HPND-sell-variant')
depends=('libxext' 'libxrender' 'libx11' 'glibc')
makedepends=('git' 'xorg-util-macros' 'xorgproto')
provides=("libxrandr=$pkgver" 'libXrandr.so')
# bare libXrandr.so entry: pacman 7.1 auto-derives the versioned soname
# provide (libXrandr.so=2-64); soname is libXrandr.so.2
conflicts=('libxrandr')
# stock's release tarball signature (validpgpkeys: Alan Coopersmith) cannot be
# carried: master-tracking has no pinned tag to verify (makepkg would run
# `git verify-commit HEAD` for ?signed on unsigned commits) — tracked unsigned
source=('git+https://gitlab.freedesktop.org/xorg/lib/libxrandr.git')
b2sums=('SKIP')

pkgver() {
  cd libxrandr
  git describe --long --tags | sed 's/^libXrandr-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd libxrandr
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd libxrandr

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd libxrandr
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
