pkgname=kmod-git
pkgver=v34+335+g65ac890
pkgrel=1
pkgdesc="Linux kernel module management tools and library"
arch=('x86_64')
url='https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git'
license=('GPL2')
depends=('glibc' 'zlib' 'openssl' 'xz' 'zstd')
# checkdepends (linux-headers, libelf) removed 2026-09-04: check() is commented out
makedepends=('git' 'meson' 'scdoc')
#options=('strip' 'debug')
provides=('module-init-tools=3.16' 'libkmod.so' "kmod=$pkgver")
conflicts=('module-init-tools' 'kmod')
replaces=('module-init-tools')
#validpgpkeys=('EAB33C9690013C733916AC839BA2A5A630CBEA53')  # Lucas DeMarchi
source=("git+https://git.kernel.org/pub/scm/utils/kernel/kmod/kmod.git"
        'depmod-search.conf'
        'depmod.hook' 'depmod.script')
md5sums=('SKIP'
         'dd62cbf62bd8f212f51ef8c43bec9a77'
         'e179ace75721e92b04b2e145b69dab29'
         '18fb3d1f6024a5a84514c8276cb3ebff')

pkgver() {
  cd kmod
  git describe --tags | sed 's/-/+/g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D xz=enabled
    -D zlib=enabled
    -D zstd=enabled
    -D openssl=enabled
    -D mbedtls=disabled
    -D b_lto=true
    -D b_ndebug=true
  )

  arch-meson kmod build "${meson_options[@]}"
  meson compile -C build
}

