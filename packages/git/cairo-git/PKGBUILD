# Shared PGO payload gate — one implementation in lib/pgo.sh, called at the
# end of package_cairo-git. A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgbase=cairo-git
pkgname=(cairo-git)
pkgver=1.18.6.r4.g74755964e
pkgrel=1
pkgdesc="2D graphics library with support for multiple output devices"
url="https://cairographics.org/"
arch=(x86_64)
license=('LGPL-2.1-only OR MPL-1.1')
depends=(
  bash
  fontconfig
  freetype2
  glib2
  glibc
  libpng
  libx11
  libxcb
  libxext
  libxrender
  lzo
  pixman
  zlib
)
makedepends=(
  git
  meson
  valgrind
)
source=("git+https://gitlab.freedesktop.org/cairo/cairo.git")
sha256sums=('SKIP')

pkgver() {
  cd cairo
  git describe --tags | sed 's/[^-]*-g/r&/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D dwrite=disabled
    -D gtk_doc=false
    -D spectre=disabled
    -D symbol-lookup=disabled
    -D b_ndebug=true
  )

  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"

  # Phase 1: PGO instrumented build (tests enabled for training)
  # pgo_min_gcda: ≈ minimum distinct TUs the training suite touches before a
  # profile is worth trusting; below it the profile is too thin and we fall
  # back to an LTO-only build.
  local pgo_min_gcda=50
  CFLAGS+=" -fprofile-generate" CXXFLAGS+=" -fprofile-generate"
  arch-meson cairo build "${meson_options[@]}" \
    -D tests=enabled \
    -D b_lto=false
  meson compile -C build

  # Phase 2: training — bounded run (lib/pgo.sh)
  pgo_train_meson build 120

  # Phase 3: verify profile quality
  local _gcda_count
  _gcda_count="$(find build -name '*.gcda' 2>/dev/null | wc -l)"
  if ((_gcda_count < pgo_min_gcda)); then
    warning "PGO produced only %d gcda files — rebuilding with LTO only" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    meson setup --reconfigure cairo build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -D tests=disabled -Db_lto=true
    meson compile -C build
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    CFLAGS="$_final_cflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    CXXFLAGS="$_final_cxxflags -fprofile-use=$(pwd)/build -Wno-error=missing-profile"
    meson setup --reconfigure cairo build \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build -D tests=disabled -Db_lto=true
    meson compile -C build
  fi

}

package_cairo-git() {
  provides=(
    libcairo-gobject.so
    libcairo-script-interpreter.so
    libcairo.so
  )
  provides+=("${pkgname%-git}=${pkgver%%.r*}")
  conflicts=("${pkgname%-git}")
  options+=(!emptydirs)

  meson install -C build --destdir "$pkgdir"
  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may be
  # added to $pkgdir after the payload is verified.
  verify_no_profile_instrumentation "$pkgdir"
}

