# Maintainer: bartus <arch-user-repo at bartus dot org>
# Contributor: Stephen Zhang <zsrkmyn at gmail dot com>
# Contributor: Maël Kerbiriou <m431.kerbiriou at gmail dot com>

_pkgname=autofdo
pkgname=${_pkgname}-git
pkgver=0.30.1.r20.gf95d1a1
pkgrel=1
pkgdesc='Tool to generate LLVM Propeller profiles from perf.data'
arch=('x86_64')
url='https://github.com/google/autofdo'
license=('Apache')
depends=('google-glog' 'protobuf' 'libelf' 'openssl')
makedepends=('cmake' 'git' 'lld' 'ninja' 'python')
provides=("${_pkgname}=${pkgver%.r*}")
conflicts=("${_pkgname}")
source=(
  "${_pkgname}::git+${url}#branch=master"
  'llvm-project::git+https://github.com/llvm/llvm-project.git#branch=main'
  'abseil-cpp::git+https://github.com/abseil/abseil-cpp.git'
  'perf_data_converter::git+https://github.com/google/perf_data_converter.git'
  'glog::git+https://github.com/google/glog.git'
  'googletest::git+https://github.com/google/googletest.git'
  '0001-abseil-crc-constexpr-brace-init.patch'
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP'
            '9731c1cd583e5497d1557266e80092e6a37a6b6cf99850c12c164134cad88a08')
options=(!lto)

prepare() {
  local repo=$srcdir/${_pkgname}

  git -C "$repo" config submodule.third_party/abseil.url "$srcdir/abseil-cpp"
  git -C "$repo" config submodule.third_party/llvm-project.url "$srcdir/llvm-project"
  git -C "$repo" config submodule.third_party/perf_data_converter.url \
    "$srcdir/perf_data_converter"
  git -C "$repo" config submodule.third_party/glog.url "$srcdir/glog"
  git -C "$repo" config submodule.third_party/googletest.url "$srcdir/googletest"
  git -C "$repo" -c protocol.file.allow=always submodule update --init --recursive
  git -C "$repo/third_party/llvm-project" checkout --detach \
    "$(git -C "$srcdir/llvm-project" rev-parse HEAD)"

  # Work around GCC 17 snapshot ICE (gcc PR 127395): a block-scope `constexpr`
  # scalar initialized from a braced scalar CONSTRUCTOR (uint32_t{0xffffffff})
  # in this function template is constant-folded while the template body is
  # parsed and aborts in verify_ctor_sanity (cp/constexpr.cc). A plain literal
  # initializer is equivalent and takes the CONSTRUCTOR out of the fold. Drop
  # this once GCC fixes PR 127395 or upstream stops using the braced form.
  local crc_memcpy="$repo/third_party/abseil/absl/crc/internal/crc_memcpy_x86_arm_combined.cc"
  if grep -qF 'uint32_t{0xffffffff}' "$crc_memcpy"; then
    patch -d "$repo" -p1 --forward \
      < "$srcdir/0001-abseil-crc-constexpr-brace-init.patch"
  fi

  sed -i \
    's/message(FATAL_ERROR "Unverified git commit hash/message(WARNING "Unverified git commit hash/' \
    "$repo/CMakeLists.txt"

  sed -i '/#include <stddef.h>/a #include <string>' \
    "$repo/third_party/perf_data_converter/src/quipper/perf_buildid.h"
  sed -i 's/Arena::CreateMessage</Arena::Create</' \
    "$repo/third_party/perf_data_converter/src/quipper/perf_reader.cc"
  sed -i \
    -e 's/lookupTarget(triple.normalize(), err)/lookupTarget(triple, err)/' \
    -e 's/triple.getTriple()/triple/g' \
    "$repo/mini_disassembler.cc"
  sed -i \
    -e 's/disassembler->asm_info_\.get(),/*disassembler->asm_info_,/' \
    -e 's/disassembler->mri_\.get(),/*disassembler->mri_,/' \
    -e 's/disassembler->sti_\.get());/*disassembler->sti_);/' \
    "$repo/mini_disassembler.cc"
  sed -i \
    -e '/prof_sym_list->setToCompress(absl::GetFlag(FLAGS_compress_symbol_list));/d' \
    "$repo/profile_creator.cc"
  sed -i \
    '/add_executable(create_llvm_prof create_llvm_prof.cc)/,/^  )/ {
      /    absl::strings/a\
    absl::log_globals\
    absl::log_internal_message
    }' \
    "$repo/CMakeLists.txt"
  sed -i '/ABSL_DEPRECATE_AND_INLINE/d' \
    "$repo/third_party/abseil/absl/base/macros.h"
  sed -i '1i #define ABSL_DEPRECATE_AND_INLINE()' \
    "$repo/third_party/abseil/absl/base/macros.h"
  sed -i \
    -e 's/#define ABSL_LTS_RELEASE_VERSION 20240116/#define ABSL_LTS_RELEASE_VERSION 20260817/' \
    -e 's/#define ABSL_LTS_RELEASE_PATCH_LEVEL 1/#define ABSL_LTS_RELEASE_PATCH_LEVEL 0/' \
    "$repo/third_party/abseil/absl/base/config.h"
  sed -i \
    's/#define ABSL_OPTION_INLINE_NAMESPACE_NAME lts_20240116/#define ABSL_OPTION_INLINE_NAMESPACE_NAME lts_20260817/' \
    "$repo/third_party/abseil/absl/base/options.h"
}

pkgver() {
  git -C "$srcdir/${_pkgname}" describe --long --tags |
    sed -E 's/^v//; s/([^-]*)-([0-9]+)-g/\1.r\2.g/; s/-/./g'
}

build() {
  local no_lto_cflags="${CFLAGS//-flto=auto/} -fno-lto"
  local no_lto_cxxflags="${CXXFLAGS//-flto=auto/} -fno-lto"
  local lld_flags="-fuse-ld=lld ${LDFLAGS//-fuse-ld=mold/}"

  # BUILD_SHARED is autofdo's own switch. BUILD_SHARED_LIBS has to be seeded on
  # the command line, because autofdo adds third_party/glog before it adds the
  # LLVM subdirectory, and glog's `option(BUILD_SHARED_LIBS ON)` *creates* that
  # cache entry when it is undefined. Left undefined, every LLVM component
  # library, autofdo's own protobuf libraries and glog itself build shared, the
  # executable gets a RUNPATH into the build directory, and package() - which
  # installs the tool alone - ships a binary that cannot start anywhere.
  rm -rf build-with-llvm
  cmake -G Ninja -S "$srcdir/${_pkgname}" -B build-with-llvm \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED=On \
    -DBUILD_SHARED_LIBS=Off \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
    -DBUILD_TESTING=OFF \
    -DABSL_BUILD_TESTING=OFF \
    -DLLVM_INCLUDE_BENCHMARKS=OFF \
    "-DCMAKE_C_FLAGS=$no_lto_cflags" \
    "-DCMAKE_CXX_FLAGS=$no_lto_cxxflags -DABSL_ATTRIBUTE_WARN_UNUSED= -DABSL_ATTRIBUTE_NULL_AFTER_MOVE= -DABSL_ATTRIBUTE_TRIVIAL_ABI= -DABSL_NULLABILITY_COMPATIBLE= -DABSL_ATTRIBUTE_VIEW=" \
    -DCMAKE_INTERPROCEDURAL_OPTIMIZATION=OFF \
    "-DCMAKE_EXE_LINKER_FLAGS=$lld_flags" \
    "-DCMAKE_SHARED_LINKER_FLAGS=$lld_flags" \
    "-DCMAKE_MODULE_LINKER_FLAGS=$lld_flags" \
    -DCMAKE_LINKER=/usr/bin/ld.lld \
    -DCMAKE_INSTALL_PREFIX=. \
    -DENABLE_TOOL=LLVM \
    -DCMAKE_C_COMPILER=gcc \
    -DCMAKE_CXX_COMPILER=g++
  cmake --build build-with-llvm --target create_llvm_prof
}

package() {
  install -Dm755 build-with-llvm/create_llvm_prof "$pkgdir/usr/bin/create_llvm_prof"
}
