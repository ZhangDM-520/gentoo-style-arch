# Contributor: Kevin Majewski < kevin.majewski02 AT gmail.com >
# Contributor: Jeremy Kescher < jeremy AT kescher.at >

pkgname=xdg-desktop-portal-git
_pkgname="${pkgname%-git}"
pkgver=1.22.0.r194.g7b17a329
pkgrel=1
pkgdesc="Desktop integration portals for sandboxed apps"
url="https://github.com/flatpak/${_pkgname}"
arch=(x86_64)
license=(LGPL)
depends=(
  fuse3
  gdk-pixbuf2
  geoclue
  glib2
  pipewire
  rtkit
  systemd
)
makedepends=(
  flatpak
  git
  libportal
  meson
  python-pytest
  python-dbus
  python-dbusmock
  glib2-devel
  umockdev
  libdex
)  # doc toolchain (docbook-xsl, sphinx*, xmlto) dropped 2026-09-04
checkdepends=('python-pytest-xdist')
provides=("${_pkgname}=${pkgver}")
conflicts=("${_pkgname}")
source=("git+https://github.com/flatpak/${_pkgname}")
b2sums=('SKIP')

pkgver() {
  cd "${_pkgname}"

  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  arch-meson "${_pkgname}" build \
    --wrap-mode=default \
    -D documentation=disabled \
    -D man-pages=disabled \
    -D b_lto=true \
    -D b_ndebug=true
  meson compile -C build 
}

check() {
  meson test -C build --print-errorlogs || true
}

package() {
  depends+=(xdg-desktop-portal-impl)

  meson install -C build --destdir "$pkgdir"
}
