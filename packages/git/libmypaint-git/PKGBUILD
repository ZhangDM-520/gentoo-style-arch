# Maintainer: Albert Westra <odyssyewestra@gmail.com>
# Maintainer: Iru Cai <mytbk920423@gmail.com>
# Class A git recipe: tracks upstream libmypaint git directly (HEAD of master =
# the 2.0 line). AUR libmypaint-git and stock libmypaint are REFERENCES ONLY.
# The AUR reference is stale and policy-violating: it force-sets
# -Ofast/-march=native/-mtune=native (dropped — makepkg.conf owns opt level)
# and omits --enable-gegl; stock builds the GEGL renderer, kept here so the git
# build supersedes the full stock feature set.
# ABI NOTE: master is API 2.0 (sonames libmypaint-2.0.so.0 /
# libmypaint-gegl-2.0.so.0) while stock 1.6.1 ships libmypaint.so.0 /
# libmypaint-gegl.so.0 — soname drift vs stock is inherent to tracking master.

pkgname=libmypaint-git
pkgver=2.0.0.beta.1.r0.gd5a88fbe66
pkgrel=1
pkgdesc="A library for making brushstrokes which is used by MyPaint and other projects (git build)"
arch=('x86_64')
url="http://mypaint.org/"
license=('ISC')
depends=('babl' 'gegl' 'glib2' 'glibc' 'gobject-introspection' 'json-c' 'json-glib')
makedepends=('git' 'intltool' 'python')
# sonames shipped: libmypaint-2.0.so.0, libmypaint-gegl-2.0.so.0
provides=("libmypaint=$pkgver" 'libmypaint-2.0.so' 'libmypaint-gegl-2.0.so')
conflicts=('libmypaint')
source=('git+https://github.com/mypaint/libmypaint.git')
b2sums=('SKIP')

pkgver() {
  cd libmypaint
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd libmypaint
  ./autogen.sh
}

build() {
  cd libmypaint

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --enable-gegl
  make
}

check() {
  cd libmypaint
  make check
}

package() {
  cd libmypaint
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
