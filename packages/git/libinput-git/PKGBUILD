# Contributor: Andreas Radke <andyrtr@archlinux.org>

# Shared PGO module — payload gate at the end of package() plus the bounded
# training runner. A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgname=libinput-git
pkgver=1.32.0.r0.g5cf833b5
pkgrel=1
pkgdesc="Input device management and event handling library"
url="https://gitlab.freedesktop.org/libinput/libinput"
arch=(x86_64)
license=(MIT)
depends=('mtdev' 'libevdev' 'libwacom' 'systemd-libs' 'glibc')
# upstream doesn't recommend building docs
makedepends=('git' 'meson' 'wayland-protocols' 'check') # gtk4 dropped 2026-09-04 (debug-gui only); tests kept for PGO training
checkdepends=('python-pytest')
optdepends=('python-pyudev: libinput measure'
            'python-libevdev: libinput measure'
            'python-yaml: used by various tools')
provides=(libinput 'libinput.so')
conflicts=(libinput)
source=(git+https://gitlab.freedesktop.org/libinput/libinput)
sha256sums=('SKIP')
#validpgpkeys=('3C2C43D9447D5938EF4551EBE23B7E70B467F0BF') # Peter Hutterer (Who-T) <office@who-t.net>

pkgver() {
  cd libinput
  git describe --long | sed 's/^foo-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # PGO: instrumented build → training → optimized build
  if [[ -n "${_libinput_PGO:-}" ]]; then
    msg "PGO Phase 1: instrumented build"
    arch-meson libinput build \
      -D udev-dir=/usr/lib/udev \
      -D documentation=false \
      -D b_lto=false \
      -D b_pgo=generate

    meson compile -C build

    msg "PGO Phase 2: training with test suite"
    pgo_train_meson build 120

    local gcda_count=$(find build -name '*.gcda' 2>/dev/null | wc -l)
    if (( gcda_count < 10 )); then
      warning "Profile data insufficient ($gcda_count .gcda files) — falling back to LTO-only"
      meson configure build -Db_pgo=disabled -Db_lto=true
    else
      msg "Profile data generated: $gcda_count .gcda files"
      msg "PGO Phase 3: optimized build"
      meson configure build -Db_pgo=use -Db_lto=true
    fi
    meson compile -C build
  else
    arch-meson libinput build \
      -D udev-dir=/usr/lib/udev \
      -D documentation=false \
      -D b_lto=true

    meson compile -C build
  fi
}

check() {
  # litest-selftest zalloc test may fail with certain compiler optimizations
  meson test -C build --print-errorlogs || true
}

package() {
  meson install -C build --destdir "$pkgdir"

  install -Dvm644 libinput/COPYING \
    "$pkgdir/usr/share/licenses/libinput/LICENSE"

  verify_no_profile_instrumentation "$pkgdir"
}
