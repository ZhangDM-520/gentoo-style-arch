# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>
# Previous maintainer: Boohbah <boohbah at gmail.com>
# Contributor: sekret <sekret at posteo.se>
# Contributor: Felix Yan <felixonmars@archlinux.org>
# Contributor: namelessjon <jonathan.stott@gmail.com>
# Contributor: Alessio Sergi <asergi at archlinux dot us>
#
# git build adapted from AUR libsodium-git (reference only) + stock Arch
# libsodium: PARKED 2026-10-08 at the last safe generation — tracks a
# signed *-RELEASE tag instead of master. Master carries
# SODIUM_LIBRARY_VERSION 30:0:0 (soname .so.30) while the installed
# linkers (stock libzmq/libostree + /usr/lib/ostree/ostree-prepare-root,
# and in-set noctalia) want .so.26; 1.0.19-RELEASE through 1.0.22-RELEASE
# all ship so.26 (libtool current-age). Unpin and heal the consumers in
# one batch when adopting the new generation.

pkgname=libsodium-git
pkgver=1.0.22.RELEASE.r0.g77e1ce5d
pkgrel=1
pkgdesc="A modern, portable, easy to use crypto library (git build)"
arch=('x86_64')
url="https://libsodium.org/"
license=('custom:ISC')
depends=('glibc')
makedepends=('git')
provides=("libsodium=$pkgver" 'libsodium.so')
conflicts=('libsodium')
# x.y.z-RELEASE tags are signed and the tag pin above is verified at
# build time (?signed). Fingerprints: the release tags are signed by
# Frank Denis's [S] signing subkey; the primary is kept for tags signed
# directly (both from the stock Arch PKGBUILD / upstream-published key).
validpgpkeys=('54A2B8892CC3D6A597B92B6C210627AABA709FE1'  # Frank Denis (primary)
              '0C7983A8FD9A104C623172CB62F25B592B6F76DA') # Frank Denis (release-signing subkey; signs 1.0.22-RELEASE)
source=("git+https://github.com/jedisct1/libsodium.git#tag=1.0.22-RELEASE?signed")
sha256sums=('SKIP')

pkgver() {
  # clone dir is the upstream repo name (libsodium), not $pkgname
  cd libsodium
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd libsodium

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./autogen.sh -s
  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd libsodium

  make DESTDIR="$pkgdir" install
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
