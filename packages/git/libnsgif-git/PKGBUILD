# Maintainer: ROllerozxa <temporaryemail4meh [gee mail]>
# Contributor: Ivy Foster <ivy.iverson@gmail.com>
# Class A git recipe: tracks upstream netsurf libnsgif git directly (HEAD).
# AUR libnsgif-git and stock libnsgif are REFERENCES ONLY.
# ANOMALY: upstream publishes only the git:// transport
# (git.netsurf-browser.org has no https git) — kept as upstream-published.

pkgname=libnsgif-git
pkgver=1.0.0.r0.g22e99eb681
pkgrel=1
pkgdesc='Decoding library for the gif image file format (git build)'
url='http://www.netsurf-browser.org/projects/libnsgif/'
license=('MIT')
arch=('x86_64')
makedepends=('git' 'netsurf-buildsystem')
# soname shipped: libnsgif.so.1
provides=("libnsgif=$pkgver" 'libnsgif.so')
conflicts=('libnsgif')
source=('git://git.netsurf-browser.org/libnsgif.git')
b2sums=('SKIP')

pkgver() {
  cd libnsgif
  git describe --long | sed 's:release/::; s:-\([0-9]\+\)-:.r\1.:'
}

prepare() {
  # reference fix kept: glibc >= 2.20 rejects the deprecated -D_BSD_SOURCE
  sed 's:-D_BSD_SOURCE::' -i libnsgif/Makefile
}

build() {
  make -C libnsgif PREFIX=/usr INCLUDEDIR=include \
    LIBDIR=lib COMPONENT_TYPE=lib-shared
}

package() {
  cd libnsgif
  make DESTDIR="$pkgdir" PREFIX=/usr INCLUDEDIR=include \
    LIBDIR=lib COMPONENT_TYPE=lib-shared install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
