# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>
# Recipe adapted for the gentoo-style-arch fleet; tracks upstream VCS directly.
# The AUR package of the same name was used as a reference only.

pkgname=gdbm-git
pkgver=1.26.r1.gfb46d98
pkgrel=1
pkgdesc="GNU database library (git build)"
arch=('x86_64')
url="https://www.gnu.org.ua/software/gdbm/gdbm.html"
license=('GPL-3.0-or-later')
depends=('glibc' 'sh')
makedepends=('git' 'readline' 'rsync')
provides=("gdbm=$pkgver" 'libgdbm.so' 'libgdbm_compat.so')
conflicts=('gdbm')
options=('staticlibs')
source=("git+https://git.gnu.org.ua/gdbm.git")
b2sums=('SKIP')

pkgver() {
  cd gdbm

  # rc tags sort above final releases; select the newest non-rc tag
  # (AUR reference logic), then rev-count + hash (house style)
  _tag=$(git tag -l --sort -v:refname | sed '/rc/d' | head -n1)
  _rev=$(git rev-list --count "$_tag"..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^v//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  cd gdbm

  ./bootstrap
  CFLAGS="$CFLAGS -ffat-lto-objects" \
  ./configure \
    --prefix="/usr" \
    --enable-libgdbm-compat
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd gdbm

  make DESTDIR="$pkgdir" install

  install -Dm644 {AUTHORS,NEWS,NOTE-WARNING,README} -t "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
