source=(
    "git+${url}#branch=master"
    "${pkgname}.desktop"
    "${pkgname}-wayland.desktop"
    "${pkgname}-uri-handler.desktop"
    "fix-dangling-tsc-shims.patch"
    "rustup-target-guard.patch"
    # Applied to the vscode clone in build() (NOT prepare()'s *.patch loop,
    # which targets the vscodium wrapper repo) — hence the .diff name.
    "node-modules-asar-stream.diff"
)
sha256sums=('SKIP'
