# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>
# Recipe adapted for the gentoo-style-arch fleet; tracks upstream VCS directly.
# The AUR package of the same name was used as a reference only.

pkgname=expat-git
pkgver=2.9.0.r6.g4a9912a2
pkgrel=1
pkgdesc="A stream-oriented XML parser library written in C (git build)"
arch=('x86_64')
url="https://libexpat.github.io/"
license=('MIT')
depends=('glibc')
makedepends=('cmake' 'git')
provides=("expat=$pkgver" 'libexpat.so')
conflicts=('expat')
source=("git+https://github.com/libexpat/libexpat.git")
b2sums=('SKIP')

pkgver() {
  cd libexpat/expat

  # upstream tags use R_2_7_1 style names
  _tag=$(git tag -l --sort -v:refname | grep -E 'R_[0-9_]+$' | head -n1)
  _rev=$(git rev-list --count "$_tag"..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/R_//;s/_/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # CMAKE_BUILD_TYPE=None: makepkg.conf owns the opt level (no hard-coded -O3)
  cmake \
    -B "_build" \
    -S libexpat/expat \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="/usr" \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DEXPAT_BUILD_DOCS=OFF \
    -DEXPAT_BUILD_EXAMPLES=OFF
  cmake --build "_build" --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install "_build"

  install -Dm644 libexpat/expat/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
