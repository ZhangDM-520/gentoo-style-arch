#!/usr/bin/python3
# vencord-inject — assert Vencord injection into the Discord desktop client.
#
# Initiation contract of vencord-git (docs/JOURNAL.md 2026-09-23): the payload in
# /usr/lib/vencord is inert until Discord's newest app-<ver>/resources tree is
# patched — app.asar renamed to _app.asar and replaced with a shim asar whose
# index.js requires /usr/lib/vencord/patcher.js. The shim is byte-equivalent
# to the official Vencord Installer's WriteAppAsar (Vencord/Installer,
# app_asar.go), so an injection created by the official installer is adopted
# in place by simply rewriting the shim.
#
# Modes: inject (idempotent, rewrites the shim every run), uninject (restore
# the pristine app.asar), status (exit 0 only when every discovered channel
# is injected against /usr/lib/vencord).
#
# Discovery: $XDG_CONFIG_HOME (fallback ~/.config)/discord*/app-*/resources,
# newest app-* per channel — this host's discord is the self-updating
# bootstrap, so a Discord update lands a pristine asar and `inject` must be
# re-run; discord-vencord does that on every launch.
#
# Root policy mirrors the official installer: never as bare root; with
# SUDO_USER/DOAS_USER the target user's HOME is adopted and files written as
# root are chowned back to that user (pacman scriptlet path).

import json
import os
import pwd
import re
import struct
import sys
from pathlib import Path

PATCHER = "/usr/lib/vencord/patcher.js"
PACKAGE_JSON = '{\n\t"name": "discord",\n\t"main": "index.js"\n}'


def die(msg, code=1):
    print(f"vencord-inject: error: {msg}", file=sys.stderr)
    sys.exit(code)


def target_user_home():
    """HOME of the user this run acts for; refuses bare root like upstream."""
    if os.geteuid() != 0:
        return Path(os.environ.get("HOME") or Path.home()), None
    user = os.environ.get("SUDO_USER") or os.environ.get("DOAS_USER")
    if not user or user == "root":
        die("must not run as the root user — re-run as a normal user "
            "(sudo/doas sets SUDO_USER/DOAS_USER)")
    pw = pwd.getpwnam(user)
    os.environ["HOME"] = pw.pw_dir
    return Path(pw.pw_dir), (pw.pw_uid, pw.pw_gid)


def build_shim(patcher=PATCHER):
    """The exact asar the official installer writes (app_asar.go port)."""
    index_js = f"require({json.dumps(patcher)})"
    content = index_js + PACKAGE_JSON
    header = {"files": {
        "index.js": {"size": len(index_js), "offset": "0"},
        "package.json": {"size": len(PACKAGE_JSON),
                         "offset": str(len(index_js))},
    }}
    # Go's encoding/json emits compact, alphabetically keyed objects; python
    # insertion order already matches ("index.js" < "package.json").
    raw = json.dumps(header, separators=(",", ":")).encode()
    hss = len(raw)                    # headerStringSize
    aligned = (hss + 3) & ~3
    header_size = aligned + 8         # +4 dataSize field, +4 own length
    object_size = aligned + 4         # +4 dataSize field
    out = struct.pack("<4I", 4, header_size, object_size, hss)
    out += raw + b"\0" * (aligned - hss)
    return out + content.encode()


def shim_patcher(path):
    """Patcher path embedded in a shim asar, or None if unparseable."""
    try:
        data = path.read_bytes()
        if len(data) < 16:
            return None
        _, hsz, _, hss = struct.unpack_from("<4I", data)
        header = json.loads(data[16:16 + hss])
        entry = header["files"]["index.js"]
        content_off = 8 + hsz         #4 ints + padded header
        body = data[content_off + int(entry["offset"]):
                    content_off + int(entry["offset"]) + int(entry["size"])]
        text = body.decode()
    except Exception:
        return None
    if not (text.startswith('require("') and text.endswith('")')):
        return None
    return text[len('require("'):-2]


def version_key(path):
    return tuple(int(n) for n in re.findall(r"\d+", path.name))


def channels(config_home):
    """Newest app-*/resources per discord* channel that has a tree."""
    found = []
    for channel in sorted(config_home.glob("discord*")):
        if not channel.is_dir():
            continue
        apps = [d for d in channel.glob("app-*") if d.is_dir()]
        if not apps:
            continue
        resources = max(apps, key=version_key) / "resources"
        if resources.is_dir():
            found.append(resources)
    return found


def chown_if_root(path, ids):
    if ids is not None:
        os.chown(path, *ids)


def do_inject(res, ids):
    app, backup = res / "app.asar", res / "_app.asar"
    if not app.exists() and not backup.exists():
        print(f"vencord-inject: skip {res}: no app.asar to patch")
        return
    if app.exists() and not backup.exists():
        os.rename(app, backup)        # pristine tree: park the original
    # Both exist (official-install adoption or our own previous run) or only
    # the backup exists (interrupted run): either way rewrite the shim so it
    # points at the pacman-owned payload.
    tmp = res / ".app.asar.vencord-tmp"
    tmp.write_bytes(build_shim())
    chown_if_root(tmp, ids)
    os.replace(tmp, app)
    print(f"vencord-inject: injected {res} -> {PATCHER}")


def do_uninject(res):
    app, backup = res / "app.asar", res / "_app.asar"
    if not backup.exists():
        print(f"vencord-inject: not injected: {res}")
        return
    if app.exists():
        app.unlink()
    os.rename(backup, app)            # original bytes, original owner
    print(f"vencord-inject: restored pristine app.asar: {res}")


def do_status(res):
    app, backup = res / "app.asar", res / "_app.asar"
    if not backup.exists() and not app.exists():
        return "absent"
    if not backup.exists():
        return "not-injected"
    if not app.exists():
        return "incomplete"
    embedded = shim_patcher(app)
    if embedded == PATCHER:
        return "injected"
    return f"injected-foreign({embedded or 'unparseable'})"


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else ""
    if mode not in ("inject", "uninject", "status"):
        die("usage: vencord-inject {inject|uninject|status}", 2)

    home, ids = target_user_home()
    config = Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config")
    targets = channels(config)
    if not targets:
        # Fresh bootstrap: no app-* tree yet; discord-vencord patches the
        # tree on a later launch once the download has happened.
        print(f"vencord-inject: no discord channel under {config} — nothing "
              f"to do ({mode})")
        sys.exit(0 if mode != "status" else 1)

    if mode == "inject":
        for res in targets:
            do_inject(res, ids)
    elif mode == "uninject":
        for res in targets:
            do_uninject(res)
    else:
        states = {str(res): do_status(res) for res in targets}
        for res, state in states.items():
            print(f"vencord-inject: {state}: {res}")
        ok = all(s == "injected" for s in states.values())
        sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
