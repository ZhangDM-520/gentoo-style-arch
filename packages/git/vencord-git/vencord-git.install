# vencord-git scriptlets — initiation contract (docs/JOURNAL.md 2026-09-23).
#
# Scriptlet phases: pacman has NO fallback between them — an upgrade calls
# pre_upgrade/post_upgrade, never pre_install/post_install (the pkgrel=2
# upgrade executed nothing until post_upgrade was added; PKGBUILD(5) names
# each phase explicitly). post_* runs while the package's files exist;
# pre_remove (NOT post_remove) runs before they are deleted, which is the
# only scriptlet that can still call /usr/bin/vencord-inject and the libalpm
# script.

post_install() {
    # Redirect the stock launcher through the wrapper. No-op when the
    # discord package's desktop file is absent; the vencord-discord-desktop
    # libalpm hook re-wraps it whenever discord installs or upgrades.
    /usr/share/libalpm/scripts/vencord-discord-desktop wrap 2>/dev/null || true

    # Adopt any existing injection (e.g. one created by the official
    # installer) onto the pacman-owned payload right now. The CLI refuses
    # bare root; with sudo/doas it follows SUDO_USER/DOAS_USER.
    if [ -n "${SUDO_USER:-}" ] || [ -n "${DOAS_USER:-}" ]; then
        /usr/bin/vencord-inject inject >/dev/null 2>&1 || true
    fi

    cat <<'EOF'
vencord-git: Vencord payload installed to /usr/lib/vencord.

Injection is initiated by the launcher, not by this transaction:
  * the stock Discord desktop entry now runs /usr/bin/discord-vencord,
    which re-asserts the patch on every launch — this survives Discord's
    self-updates (a fresh app-*.resources tree is patched next start);
  * discord package upgrades are re-wrapped by an alpm hook;
  * `vencord-inject status` reports the state, `vencord-inject uninject`
    restores a pristine app.asar.
If no Discord channel exists yet (fresh bootstrap), the first launch runs
the downloaded tree unpatched and every launch after it is patched.
EOF
}

pre_remove() {
    # Files still exist in pre_remove; restore both sides of the contract so
    # nothing points at a payload that is about to disappear.
    if [ -n "${SUDO_USER:-}" ] || [ -n "${DOAS_USER:-}" ]; then
        /usr/bin/vencord-inject uninject >/dev/null 2>&1 || true
    fi
    /usr/share/libalpm/scripts/vencord-discord-desktop restore 2>/dev/null || true
}

# Upgrade phase entry points (no fallback exists — see the header).
post_upgrade() {
    post_install "$@"
}
