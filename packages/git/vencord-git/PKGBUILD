# Maintainer: Gentoo_Style_Arch <maintainer@localhost>
# Contributor: Toria <ninetailedtori@uwu.gal> (AUR vencord)
#
# Desktop standalone build of Vencord, tracking upstream `main`. The build
# mirrors the AUR `vencord` recipe's desktop path: the standalone bundle set
# (Discord desktop and Vesktop main/renderer/preload with sourcemaps) is the
# only thing packaged here; the web build and the browser-extension outputs
# are deliberately out of scope for this recipe.

pkgname=vencord-git
_pkgname=Vencord
pkgver=1.15.9.r0.g7f0c10cc2
pkgrel=1
pkgdesc='The cutest Discord client mod (git build)'
arch=('any')
url="https://github.com/Vendicated/${_pkgname}"
license=('GPL-3.0-or-later')
provides=('vencord')
conflicts=('vencord')
install=vencord-git.install
# Nothing is compiler-built: the payload is plain JavaScript and esbuild runs
# from its prebuilt helper, so there is no ISA/LTO/PGO phase to apply. The
# Electron/JavaScript standard (docs/MEMORY.md §4): strip would rewrite
# nothing useful, debug packages would duplicate the source, and LTO flags
# could only leak into an incidental native addon build.
options=('!strip' '!debug' '!lto')
# Loader choice stays an optdepend; python is the one real runtime depend —
# /usr/bin/vencord-inject (stdlib only) is what initiates the payload.
depends=('python')
optdepends=(
  'discord: official host client the desktop patcher modifies'
  'vesktop: desktop client with Vencord support built in'
)
makedepends=(
  'git'
  'nodejs'
  'pnpm'
  # House idiom for the JavaScript bullet: a native addon compiled by any
  # dependency reuses the cache and links through mold when present.
  'ccache'
)
source=("${_pkgname}::git+${url}.git#branch=main"
        discord-vencord
        vencord-inject
        vencord-discord-desktop
        vencord-discord-desktop.hook)
sha256sums=('SKIP'
            'd26eb9b6c1dbd204d9e1a287aa7feca57c2482e563b65ac3dbd32ce5d50adcad'
            '5cfb7c12b5d4e5af750aaa76e47604b976a63ab79f0bd8875f28261eb33062ff'
            'b9ada45f032c7722cb667b5e0273eba143d50a756cfdec104d84840411456384'
            '8c1ef45e980f264948d70230e80832b303bd502a6f07efe2a2f6901d563dcdda')

pkgver() {
  cd "${_pkgname}"

  # Tags are v-prefixed; house -git describe form:
  # v1.15.6-14-gabc123 -> 1.15.6.r14.gabc123
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/; s/-/./g; s/^v//'
}

prepare() {
  cd "${_pkgname}"

  # Install at the tree root, where pnpm-workspace.yaml declares packages/*.
  # A subdirectory install in such a tree resolves the ROOT project and builds
  # nothing without the workspace-isolating flag (the 2026-09-18 logseq
  # incident); there is no subdirectory install here, so the plain root
  # install is the correct call.
  pnpm install --frozen-lockfile
}

build() {
  cd "${_pkgname}"

  # No host ISA or optimisation flags of our own (see the options comment
  # above). The ccache + mold probe is the house idiom for any native addon
  # a dependency may compile; identical to vscodium-insiders-git.
  export CCACHE_DIR="${CCACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/ccache}"
  export CCACHE_COMPILERCHECK=content
  if [[ -d /usr/lib/ccache/bin ]]; then
    export PATH="/usr/lib/ccache/bin:${PATH}"
  fi
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # Standalone = platform-neutral defines ("Platform: Universal"); the six
  # desktop bundles land in dist/.
  pnpm buildStandalone
}

check() {
  cd "${_pkgname}"

  # Type-check only: upstream's full `pnpm test` also re-runs eslint,
  # stylelint and the plugin-manifest generator on every git bump. tsc
  # --noEmit is the part that catches real source breakage.
  pnpm testTsc
}

package() {
  cd "${_pkgname}"

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  # The desktop standalone payload: patcher/renderer/preload (Discord
  # desktop) plus the Vesktop-facing main/renderer/preload, each with its
  # external sourcemap. The four globs are the complete buildStandalone
  # output set.
  install -d "${pkgdir}/usr/lib/vencord"
  cp -r -- dist/vencord* dist/preload* dist/patcher* dist/renderer* \
    "${pkgdir}/usr/lib/vencord/"

  # Loader contract: a package.json must sit beside the payloads (same shim
  # the AUR recipe writes).
  printf '{}\n' > "${pkgdir}/usr/lib/vencord/package.json"

  # Initiation contract: the payload above is inert until injected.
  #   * discord-vencord  — launcher that re-asserts the patch every start,
  #                        which is what survives Discord self-updates;
  #   * vencord-inject   — the injector (official-compatible asar shim),
  #                        repointed at the pacman-owned payload;
  #   * libalpm hook+script — re-wrap the stock discord.desktop Exec line
  #                        after every discord package install/upgrade;
  # vencord-git.install wires the first wrap into post_install and the
  # unpatch+unwrap into pre_remove (still inside the package's lifetime).
  install -Dm755 "${srcdir}/discord-vencord" "${pkgdir}/usr/bin/discord-vencord"
  install -Dm755 "${srcdir}/vencord-inject" "${pkgdir}/usr/bin/vencord-inject"
  install -Dm755 "${srcdir}/vencord-discord-desktop" \
    "${pkgdir}/usr/share/libalpm/scripts/vencord-discord-desktop"
  install -Dm644 "${srcdir}/vencord-discord-desktop.hook" \
    "${pkgdir}/usr/share/libalpm/hooks/vencord-discord-desktop.hook"
}
