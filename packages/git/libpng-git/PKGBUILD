# Contributor: Christian Hesse <mail@eworm.de>
# Contributor: Jan de Groot <jgc@archlinux.org>
# Contributor: dorphell <dorphell@archlinux.org>
# Contributor: Travis Willard <travis@archlinux.org>
# Contributor: Douglas Soares de Andrade <douglas@archlinux.org>
#
# git build adapted from AUR libpng-git (reference only) + stock Arch libpng:
# builds the official GitHub mirror's libpng16 maintenance branch (the AUR
# reference still clones the SourceForge remote).
#
# 2026-10-07 (run #52 wall): upstream's default branch is now libpng18, the
# 1.8 development line whose SONAME moved to libpng18.so.18 — a branch-less
# git+ source resolves there and the resulting package cannot install
# (everything installed pins libpng16.so=16-64, including stock-side pinners
# outside this workspace like harfbuzz). Pinned to #branch=libpng16, the
# living 1.6 line (the master alias points there too), same one-line
# reversibility as the libdisplay-info pin (docs/MEMORY.md rule 30(c)).
# The so.18 migration is a coordinated consumer batch, parked in MEMORY §5.

pkgname=libpng-git
_pkgname=libpng
pkgver=1.6.59.r2.gd76d5106f
pkgrel=1
pkgdesc="The official PNG reference library (git build)"
arch=('x86_64')
url="http://www.libpng.org/pub/png/libpng.html"
license=('libpng-2.0')
depends=('zlib' 'sh')
makedepends=('git')
provides=("libpng=$pkgver" 'libpng16.so')
conflicts=('libpng')
# Release tags are signed by the release manager; this recipe tracks a
# maintenance branch so there is no pinned tag to verify — fingerprints kept
# for documentation only, taken from the stock Arch PKGBUILD
# (upstream-published release signers).
validpgpkeys=('F57A55036A4D45837074FD92C9E384533403C2F8'  # Cosmin Truta <ctruta@gmail.com>
              '1FED507E3236B4A6E53E922BB292C64843FF5BCF') # Cosmin Truta <ctruta@gmail.com>
source=("git+https://github.com/pnggroup/libpng.git#branch=libpng16")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/^libpng-//;s/^v//;s/-master//;s/-signed//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"
  autoreconf -fiv
}

build() {
  cd "$_pkgname"

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --disable-static
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd "$_pkgname"

  make DESTDIR="$pkgdir" install
  # The libpng18 line renamed LICENSE -> LICENSE.md; the 1.6 line keeps
  # LICENSE. Install whichever exists under the stock name for surface parity.
  local _license=LICENSE
  [[ -f LICENSE.md ]] && _license=LICENSE.md
  install -Dm644 "$_license" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # pngminus tools (stock file-surface parity)
  # 2026-10-07 (run #53 wall): these link the library just installed into
  # $pkgdir, and makepkg reuses the src tree across builds — when the tracked
  # line moved (libpng18 -> libpng16) the previous build's tools were still
  # "up to date" and package() shipped binaries whose NEEDED was the old
  # soname (the post-install NEEDED probe caught it). Clean first: package()
  # ships only artifacts produced from THIS build.
  cd contrib/pngminus
  make clean
  make PNGLIB_SHARED="-L$pkgdir/usr/lib -lpng" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" png2pnm pnm2png
  install -m0755 png2pnm pnm2png "$pkgdir/usr/bin/"
}
