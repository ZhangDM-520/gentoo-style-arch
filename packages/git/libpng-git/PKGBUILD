# git build adapted from AUR libpng-git (reference only) + stock Arch libpng:
# tracks upstream master directly via the official GitHub mirror (the AUR
# reference still clones the SourceForge remote).

pkgname=libpng-git
_pkgname=libpng
pkgver=1.6.43.r1.gf1848a3b5
pkgrel=1
pkgdesc="The official PNG reference library (git build)"
arch=('x86_64')
url="http://www.libpng.org/pub/png/libpng.html"
license=('libpng-2.0')
depends=('zlib' 'sh')
makedepends=('git')
provides=("libpng=$pkgver" 'libpng16.so')
conflicts=('libpng')
# Release tags are signed by the release manager; this recipe tracks master so
# there is no pinned tag to verify — fingerprints kept for documentation only,
# taken from the stock Arch PKGBUILD (upstream-published release signers).
validpgpkeys=('F57A55036A4D45837074FD92C9E384533403C2F8'  # Cosmin Truta <ctruta@gmail.com>
              '1FED507E3236B4A6E53E922BB292C64843FF5BCF') # Cosmin Truta <ctruta@gmail.com>
source=("git+https://github.com/pnggroup/libpng.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/^libpng-//;s/^v//;s/-master//;s/-signed//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"
  autoreconf -fiv
}

build() {
  cd "$_pkgname"

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --disable-static
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd "$_pkgname"

  make DESTDIR="$pkgdir" install
  # 2026-10-07: upstream renamed LICENSE -> LICENSE.md in the v1.6.54 ->
  # libpng18 restructure (run #51 wall); installed name kept for surface
  # parity with stock.
  install -Dm644 LICENSE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE"

  # pngminus tools (stock file-surface parity)
  cd contrib/pngminus
  make PNGLIB_SHARED="-L$pkgdir/usr/lib -lpng" CFLAGS="$CFLAGS" LDFLAGS="$LDFLAGS" png2pnm pnm2png
  install -m0755 png2pnm pnm2png "$pkgdir/usr/bin/"
}
