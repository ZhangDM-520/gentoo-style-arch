# Maintainer: Nikita Puzyryov <PuzyryovN@gmail.com>
pkgname=liburing-git
pkgver=2.15.r35.g78dce99b
pkgrel=1
pkgdesc="Linux-native io_uring I/O access library (git-version)"
arch=(x86 x86_64)
url="http://git.kernel.dk/cgit/liburing/"
license=('LGPL2.1')
provides=('liburing' 'liburing.so' 'liburing-ffi.so')
conflicts=(liburing liburing.so)
source=("$pkgname::git+https://github.com/axboe/liburing.git")
sha256sums=('SKIP')

pkgver() {
  cd "$srcdir/$pkgname"
  ( set -o pipefail
    git describe --tags 2>/dev/null | sed 's/^liburing-//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
  )
}

build() {
  cd "$srcdir/$pkgname"

  export LDFLAGS="$LDFLAGS -fuse-ld=mold"
  ./configure
  make CFLAGS="$CFLAGS -flto" LDFLAGS="$LDFLAGS -flto"
}

package() {
  cd "$srcdir/$pkgname"
  DESTDIR="$pkgdir/" make install
}
