# Maintainer: Darshit Shah <darnir [at] gnu [dot] org>
# Contributor: Levente Polyak <anthraxx[at]archlinux[dot]org>
# Contributor: Tim Rühsen <tim.ruehsen@gmx.de>
#
# git build adapted from AUR libpsl-git (reference only) + stock Arch libpsl:
# tracks upstream master directly (stock pins release tarballs).

_pkgname=libpsl
pkgname=libpsl-git
pkgver=libpsl.0.21.0.r41.g72365d3
pkgrel=2
pkgdesc='Public Suffix List library (git build)'
url='https://github.com/rockdaboot/libpsl'
arch=('x86_64')
license=('MIT')
depends=('libidn2' 'libunistring')
# gtk-doc trimmed 2026-11-01 (NOTE.md wall class): the docbook-xsl chain
# refused the generated libpsl-docs.sgml ("Get a newer version at
# docbook.sourceforge.net…/xsl/" → "no result", run 0324). Docs are not
# load-bearing; the doc-only makedepends (gtk-doc, libxslt) left with them.
makedepends=('git' 'publicsuffix-list' 'python')
provides=("libpsl=$pkgver" 'libpsl.so')
conflicts=('libpsl')
source=("git+https://github.com/rockdaboot/${_pkgname}.git")
sha512sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd "$_pkgname"
  # use the system publicsuffix-list data instead of the bundled snapshot
  rm -frv list
  autoreconf -fiv
}

build() {
  cd "$_pkgname"

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --disable-static \
    --disable-dependency-tracking \
    --enable-man \
    --disable-gtk-doc \
    --enable-{builtin,runtime}=libidn2 \
    --with-psl-file=/usr/share/publicsuffix/effective_tld_names.dat \
    --with-psl-testfile=/usr/share/publicsuffix/test_psl.txt
  LC_CTYPE=en_US.UTF-8 make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd "$_pkgname"

  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
