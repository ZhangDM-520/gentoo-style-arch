# Maintainer: Daniel Bermond <dbermond@archlinux.org>
# Class A git recipe: tracks upstream hoene/libmysofa git directly (HEAD).
# AUR libmysofa-git and stock libmysofa are REFERENCES ONLY.

pkgname=libmysofa-git
pkgver=1.3.5.r0.g648eed0347
pkgrel=1
pkgdesc='C library to read HRTFs if they are stored in the AES69-2015 SOFA format (git build)'
arch=('x86_64')
url='https://github.com/hoene/libmysofa/'
license=('BSD-3-Clause')
depends=('glibc' 'zlib')
makedepends=('cmake' 'cunit' 'git')
checkdepends=('nodejs')
# soname shipped: libmysofa.so.1
provides=("libmysofa=$pkgver" 'libmysofa.so')
conflicts=('libmysofa')
source=('git+https://github.com/hoene/libmysofa.git')
b2sums=('SKIP')

pkgver() {
    git -C libmysofa describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
    if command -v mold >/dev/null 2>&1; then
        export LDFLAGS+=" -fuse-ld=mold"
    fi

    cmake -B libmysofa/build -S libmysofa \
        -DCMAKE_BUILD_TYPE:STRING='None' \
        -DCMAKE_INSTALL_PREFIX:PATH='/usr' \
        -DCODE_COVERAGE:BOOL='OFF' \
        -Wno-dev
    cmake --build libmysofa/build
}

check() {
    ctest --test-dir libmysofa/build --output-on-failure --stop-on-failure
}

package() {
    DESTDIR="$pkgdir" cmake --install libmysofa/build
    install -D -m644 libmysofa/LICENSE -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
