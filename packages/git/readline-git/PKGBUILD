pkgname=readline-git
pkgver=8.3.r6.gf95e814
pkgrel=1
pkgdesc='GNU readline library (git build)'
arch=('x86_64')
url='https://tiswww.case.edu/php/chet/readline/rltop.html'
license=('GPL-3.0-or-later')
backup=('etc/inputrc')
depends=(
  glibc
  libncursesw.so
  ncurses
)
provides=("readline=$pkgver" 'libhistory.so' 'libreadline.so')
# bare soname entries kept from stock (sonames libreadline.so.8/libhistory.so.8
# on the 8.x line); pacman 7.1 derives versioned provides from them
conflicts=('readline')
options=('!emptydirs')
# stock's ftp.gnu.org tarball + readline83-* point patches + .sig files are
# release-train artifacts: git master carries the post-release fixes already.
# No upstream git tag signature to verify on master (makepkg would run
# `git verify-commit HEAD` for ?signed on unsigned commits) — tracked unsigned.
# inputrc kept from stock packaging (local file).
source=(
  readline::git+https://git.savannah.gnu.org/git/readline.git
  inputrc
)
b2sums=('SKIP'
        '50db43bff430f282175aba4c4259e0b2222bc7e342fbe47b9dcce0172458472e72aebb9852eeafa4d10d4e89f2e1e8bb83b6b5dfc68eeababe699d4b5eae80f7')

pkgver() {
  cd readline
  git describe --long --tags | sed 's/^readline-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd readline

  # remove RPATH from shared objects (FS#14366, kept from stock)
  sed -i 's|-Wl,-rpath,$(libdir) ||g' support/shobj-conf
}

build() {
  cd readline

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # build with -fPIC for x86_64 (FS#15634, kept from stock)
  [[ $CARCH == x86_64* ]] && CFLAGS="$CFLAGS -fPIC"

  ./configure --prefix=/usr
  make SHLIB_LIBS=-lncurses -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd readline
  make DESTDIR="$pkgdir" install

  install -Dm644 "$srcdir/inputrc" -t "$pkgdir/etc"
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
