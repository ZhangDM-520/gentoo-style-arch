# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

# git recipe tracking upstream libusb VCS (AUR libusb-git used as reference
# only)

pkgname=libusb-git
pkgver=1.0.30.r143.gabba63e
pkgrel=1
pkgdesc='A cross-platform library to access USB devices (git build)'
arch=('x86_64')
url='https://libusb.info/'
license=('LGPL-2.1-or-later')
depends=('glibc' 'libudev.so')
makedepends=('git')
provides=("libusb=$pkgver" 'libusb-1.0.so')
conflicts=('libusb')
options=('staticlibs')
source=('git+https://github.com/libusb/libusb.git')
b2sums=('SKIP')

pkgver() {
  cd libusb
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  cd libusb
  ./bootstrap.sh
  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

check() {
  cd libusb
  make -k check
}

package() {
  cd libusb
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
