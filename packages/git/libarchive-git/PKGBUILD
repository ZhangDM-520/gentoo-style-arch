prepare() {
  cd "$srcdir"

  # extract licenses (stock libarchive)
  # NOTE: some license files are missing: https://github.com/libarchive/libarchive/issues/2385
  sed -n '43,65p' "$_pkgname/COPYING" > BSD-2-Clause.txt
  sed -n '33,62p' "$_pkgname/$_pkgname/archive_read_support_filter_compress.c" > BSD-4-Clause-UC.txt

  cd "$_pkgname"
  autoreconf -fiv
}

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local _jobs="${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"

  cd "$_pkgname"
  ./configure --prefix=/usr \
              --without-nettle \
              --disable-static
  make -j "$_jobs"
}

package() {
  cd "$_pkgname"
  make DESTDIR="$pkgdir" install
  install -Dm644 "$srcdir"/BSD-2-Clause.txt "$srcdir"/BSD-4-Clause-UC.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
