# Contributor: MGislv <mgislv at ceppo dot xyz>

pkgname=zlib-ng-compat-git
pkgver=2.3.1.r596.gg8b61b4ef
pkgrel=1
pkgdesc='zlib replacement with optimizations for next generation systems'
url='https://github.com/zlib-ng/zlib-ng'
arch=('x86_64')
license=('Zlib')
depends=('glibc')
makedepends=('git' 'cmake' 'ninja')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
    cd zlib-ng
    git describe --long --tags | sed 's/-/.r/;s/-/.g/'
}

build() {
    cmake -B build -S zlib-ng \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=None \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_C_FLAGS="$CFLAGS -flto" \
        -DCMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold -flto" \
        -DCMAKE_SHARED_LINKER_FLAGS="-fuse-ld=mold -flto" \
        -DWITH_GTEST=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DZLIB_COMPAT=ON \
        -DWITH_OPTIM=ON \
        -Wno-dev

    cmake --build build
}

check() {
    ctest --output-on-failure --test-dir build
}

package() {
    pkgdesc+=" (zlib compat)"
    provides=('zlib' 'libz.so')
    conflicts=(zlib)
    # Name-level swap metadata (house rule): the stock zlib-ng-compat must be
    # replaced by this build and its dependents must resolve here (2026-10-04).
    provides+=("zlib-ng-compat=$pkgver")
    conflicts+=('zlib-ng-compat')

    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 zlib-ng/LICENSE.md -t "${pkgdir}/usr/share/licenses/${pkgname}"
    install -Dm644 zlib-ng/README.md -t "${pkgdir}/usr/share/doc/${pkgname}"
}

