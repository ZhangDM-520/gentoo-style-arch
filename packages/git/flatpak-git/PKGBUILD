# Maintainer: madelineceleste
# this is my first pkgbuild. might be issues with it but its better than the outdated one that didnt even work at least!!
# (original version uses autotools for build which were removed from flatpak a hot sec ago in favor of meson)

pkgname=flatpak-git
_pkgname=flatpak
pkgver=1.19.2+21+gddbee83f4
pkgrel=1
pkgdesc="Linux application sandboxing and distribution framework (formerly xdg-app) (git)"
arch=(x86_64 aarch64)
url="https://github.com/flatpak/flatpak"
license=(LGPL2.1)
# libmalcontent: meson auto-detects it and links the parental-controls
# support into libflatpak (NEEDED libmalcontent-0.so.0). Undeclared, the
# dep-install became an orphan whose removal broke flatpak (2026-10-14).
# Not trimmable.
depends=('ostree' 'libarchive' 'bubblewrap' 'appstream-glib' 'polkit' 'appstream' 'xdg-dbus-proxy' 'glib2-devel' 'gobject-introspection' 'socat' 'libmalcontent')
makedepends=('git' 'meson' 'ninja' 'docbook-xsl' 'docbook-xml' 'python' 'python-pyparsing' 'gi-docgen')
provides=("flatpak=${pkgver}" 'libflatpak.so')
conflicts=('flatpak')
source=("git+https://github.com/flatpak/flatpak.git")
sha256sums=('SKIP')
options=(!debug) # dont waaaaaant flatpak-git-debug package please

pkgver() {
  cd $_pkgname
  git describe --tags | sed 's/-/+/g'
}

build() {
  cd flatpak

  # House style: mold linker when available (mold-git doesn't satisfy makedepends)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # api_docs (2026-10-15): upstream dropped the gtkdoc meson option for
  # gi-docgen-driven api_docs — the old -Dgtkdoc=disabled broke the build.
  meson setup \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var \
    -Dselinux_module=disabled \
    -Ddbus_config_dir=/usr/share/dbus-1/system.d \
    -Dprivileged_group=sudo \
    -Drun_media_dir=/media \
    -Dsystem_bubblewrap=bwrap \
    -Dsystem_dbus_proxy=xdg-dbus-proxy \
    -Dsystemdsystemunitdir=/usr/lib/systemd/system \
    -Dsystemdsystemenvgendir=/usr/lib/systemd/system-environment-generators \
    -Dapi_docs=disabled \
  build
  meson compile -C build
}

package() {
  cd flatpak
  
  DESTDIR="$pkgdir" meson install -C build
}
