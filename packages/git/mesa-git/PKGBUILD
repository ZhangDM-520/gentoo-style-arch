options=(!debug)
# debug is disabled manually through meson -D flags, but it feels cleaner to also list it here.
# lto is controlled via meson -D b_lto and -D allow-broken-lto options.

# PGO (Profile-Guided Optimization) toggle
# Set to true to enable two-pass PGO build (instrumented + optimized)
# Set to false for standard single-pass build
# PGO provides 5-15% performance gain in shader compilation and driver dispatch
_pgo=true

# NVK/Rusticl crate subprojects removed 2026-09-04: both NVK and rusticl are
# disabled in the meson options, so no Rust components are built.

# NINJAFLAGS is an env var used to pass commandline options to ninja
# NOTE: It's your responbility to validate the value of $NINJAFLAGS. If unsure, don't set it.

# MESA_WHICH_LLVM is an environment variable that determines which llvm package tree is used to built mesa-git against.
# Adding a line to ~/.bashrc  that sets this value is the simplest way to ensure a specific choice.
#
# NOTE: Aur helpers don't handle this method well, check the sticky comments on mesa-git aur page .
#
# 1: llvm-minimal-git (aur) preferred value
# 2: AUR llvm-git
# 3: llvm-git from LordHeavy unofficial repo 
# 4  llvm (stable from extra) Default value
#

_rusticl=false
# default to workspace LLVM lineage (case 2 = aur llvm-git; llvm-git provides aur-llvm-git)
MESA_WHICH_LLVM=${MESA_WHICH_LLVM:-2}

case $MESA_WHICH_LLVM in
    1)
        # aur llvm-minimal-git
        _rusticl=true
        makedepends+=(
            'llvm-minimal-git'
            'libclc-minimal-git'
            'spirv-llvm-translator-minimal-git'
            'clang-minimal-git'
            'clang-opencl-headers-minimal-git'
            'rust'
            'rust-bindgen'
            'spirv-tools'
            'glslang'
        )
        depends+=(
            'llvm-libs-minimal-git'
            'spirv-llvm-translator-minimal-git'
            'libclc-minimal-git'
            'spirv-tools'
            'clang-libs-minimal-git'
            'clang-opencl-headers-minimal-git'
        )
        conflicts+=('opencl-rusticl-mesa')
        provides+=('opencl-rusticl-mesa')
        ;;
    2)
        # aur llvm-git
        # depending on aur-llvm-* to avoid mixup with LH llvm-git
        makedepends+=(
            'aur-llvm-git'
            'libclc-git'
            'spirv-llvm-translator-git'
            'clang-git'
            'clang-opencl-headers-git'
        )
        depends+=('aur-llvm-libs-git')
        optdepends+=('aur-llvm-git: opencl')
        ;;
    3)
        # mesa-git/llvm-git (lordheavy unofficial repo)
        makedepends+=(
            'llvm-git'
            'clang-git'
            'libclc-git'
            'spirv-tools'
            'spirv-llvm-translator-git'
        )
        depends+=('llvm-libs-git')
        optdepends+=('clang-git: opencl' 'compiler-rt: opencl')
        ;;
    4)
        # extra/llvm
        makedepends+=(
            'llvm'
            'clang'
            'libclc'
            'spirv-llvm-translator'
            'spirv-tools'
            'rust'
            'rust-bindgen'
        )
        depends+=(
            'llvm-libs'
            'clang'
            'libclc'
            'spirv-llvm-translator'
            'spirv-tools'
        )
        conflicts+=('opencl-rusticl-mesa')
        provides+=('opencl-rusticl-mesa')
        _rusticl=true
        ;;
    *)
esac

pkgver() {
    cd mesa
    local _ver
    _ver=$(<VERSION)

    local _patchver
    local _patchfile
    for _patchfile in "${source[@]}"; do
        _patchfile="${_patchfile%%::*}"
        _patchfile="${_patchfile##*/}"
        [[ $_patchfile = *.patch ]] || continue
        _patchver="${_patchver}$(md5sum ${srcdir}/${_patchfile} | cut -c1-32)"
    done
    _patchver="$(echo -n $_patchver | md5sum | cut -c1-7)"

    echo ${_ver/-/_}.$(git rev-list --count HEAD).$(git rev-parse --short HEAD).${_patchver}
}

prepare() {
    # although removing _build folder in build() function feels more natural,
    # that interferes with the spirit of makepkg --noextract
    if [  -d _build ]; then
        rm -rf _build
    fi

    local _patchfile
    for _patchfile in "${source[@]}"; do
        _patchfile="${_patchfile%%::*}"
        _patchfile="${_patchfile##*/}"
        [[ $_patchfile = *.patch ]] || continue
        echo "Applying patch $_patchfile..."
        patch --directory=mesa --forward --strip=1 --input="${srcdir}/${_patchfile}"
    done
}

build () {
    local meson_options=(
        -D android-libbacktrace=disabled
        -D b_ndebug=true
        -D b_lto=true
        -D allow-broken-lto=true
        -D egl=enabled
        -D gallium-drivers=radeonsi,zink
        -D gallium-extra-hud=false
        -D gallium-rusticl=false
        -D gallium-va=enabled
        -D gbm=enabled
        -D gles1=disabled
        -D gles2=enabled
        -D glvnd=enabled
        -D glx=dri
        -D libunwind=enabled
        -D llvm=enabled
        -D lmsensors=disabled
        -D microsoft-clc=disabled
        -D platforms=wayland,x11
        -D valgrind=disabled
        -D video-codecs=all
        -D vulkan-drivers=amd,swrast
        # upstream retired the anti-lag LAYER (run #79 wall: meson.options
        # now allows only device-select, intel-nullhw, overlay, screenshot,
        # vram-report-limit — VK_MESA_anti_lag became a device-level runtime
        # feature, no layer to build)
        -D vulkan-layers=device-select
        -D tools=[]
        -D zstd=enabled
        -D buildtype=plain
        --wrap-mode=nofallback
        -D prefix=/usr
        -D sysconfdir=/etc
        -D legacy-x11=dri2
    )

    # Build only minimal debug info to reduce size
    CFLAGS+=' -g1'
    CXXFLAGS+=' -g1'

    # Inject subproject packages so meson won't re-download them
    export MESON_PACKAGE_CACHE_DIR="$srcdir"

    if $_pgo; then
        echo "==> PGO: Building instrumented version (Phase 1/2)..."
        local _pgo_profile_dir="${srcdir}/mesa-pgo-profile"
        mkdir -p "${_pgo_profile_dir}"

        # Save original flags for Phase 2
        local _cflags_orig="${CFLAGS}"
        local _cxxflags_orig="${CXXFLAGS}"

        # Phase 1: Instrumented build with PGO generation
        CFLAGS+=" -fprofile-generate=${_pgo_profile_dir} -fprofile-correction"
        CXXFLAGS+=" -fprofile-generate=${_pgo_profile_dir} -fprofile-correction"

        meson setup mesa _build "${meson_options[@]}"
        meson configure --no-pager _build
        ninja $NINJAFLAGS -C _build

        echo "==> PGO: Running profiling workloads..."
        # Run profiling workloads to exercise hot paths
        # These generate .gcda files that the compiler uses for optimization
        # The profile data helps the compiler make better inlining and branch prediction decisions

        # Set up environment to use the built libraries
        export LD_LIBRARY_PATH="${srcdir}/_build/src/gallium/targets/dri:${srcdir}/_build/src/vulkan/lavapipe:${srcdir}/_build/src/egl:${srcdir}/_build/src/glx:${srcdir}/_build/src/gbm:${LD_LIBRARY_PATH:-}"
        export VK_ICD_FILENAMES="${srcdir}/_build/src/vulkan/lavapipe/lvp_icd.x86_64.json"
        export EGL_LOG_LEVEL=debug
        export LIBGL_DRIVERS_PATH="${srcdir}/_build/src/gallium/targets/dri"

        # Run vkcube (exercises Vulkan driver path - lavapipe software renderer)
        if [ -f _build/src/vulkan/lavapipe/vkcube ]; then
            echo "  -> Running vkcube (Vulkan path)..."
            cd _build
            timeout 10 ./src/vulkan/lavapipe/vkcube --present-mode=fifo || true
            cd ..
        fi

        # Run glxinfo if available (exercises GLX/EGL path)
        if command -v glxinfo &>/dev/null; then
            echo "  -> Running glxinfo (GLX path)..."
            timeout 10 glxinfo 2>/dev/null || true
        fi

        # Try to run eglinfo if available (exercises EGL path)
        if command -v eglinfo &>/dev/null; then
            echo "  -> Running eglinfo (EGL path)..."
            timeout 10 eglinfo 2>/dev/null || true
        fi

        # Run a simple OpenGL test if available
        if command -v glxgears &>/dev/null; then
            echo "  -> Running glxgears (OpenGL rendering)..."
            timeout 5 glxgears -info 2>/dev/null || true
        fi

        # Unset the custom environment
        unset LD_LIBRARY_PATH VK_ICD_FILENAMES EGL_LOG_LEVEL LIBGL_DRIVERS_PATH

        # Count generated profile data
        local _gcda_count
        _gcda_count=$(find "${_pgo_profile_dir}" -name '*.gcda' 2>/dev/null | wc -l)
        echo "  -> Generated ${_gcda_count} profile data files"
        # NEVER ship -fprofile-use with an empty/partial profile: uncovered code
        # is treated as cold -> pessimization. Fall back to LTO-only rebuild.
        local _use_profile=true
        if [ "${_gcda_count}" -eq 0 ]; then
            _use_profile=false
            echo "  -> WARNING: No profile data generated. Falling back to LTO-only build."
            echo "  -> Consider running mesa workloads manually and re-running makepkg."
        fi

        # Clean up instrumented build (we'll rebuild with profile data)
        rm -rf _build

        echo "==> PGO: Building optimized version (Phase 2/2)..."
        # Restore original flags; add PGO use flags only when profile data exists
        CFLAGS="${_cflags_orig}"
        CXXFLAGS="${_cxxflags_orig}"
        if $_use_profile; then
            CFLAGS+=" -fprofile-use=${_pgo_profile_dir} -fprofile-reorder-functions"
            CXXFLAGS+=" -fprofile-use=${_pgo_profile_dir} -fprofile-reorder-functions"
        else
            echo "  -> NOTE: building with LTO only (no -fprofile-use)."
        fi

        meson setup mesa _build "${meson_options[@]}"
        meson configure --no-pager _build
        ninja $NINJAFLAGS -C _build

        # Cleanup profile data after successful build
        echo "==> PGO: Cleaning up profile data..."
        rm -rf "${_pgo_profile_dir}"
    else
        echo "==> Building without PGO..."
        meson setup mesa _build "${meson_options[@]}"
        meson configure --no-pager _build
        ninja $NINJAFLAGS -C _build
    fi
}

package() {
    DESTDIR="${pkgdir}" ninja $NINJAFLAGS -C _build install

    # remove script file from /usr/bin (if overlay layer is built)
    # https://gitlab.freedesktop.org/mesa/mesa/issues/2230
    rm -f "${pkgdir}/usr/bin/mesa-overlay-control.py"
    [ -d "${pkgdir}/usr/bin" ] && rmdir "${pkgdir}/usr/bin" 2>/dev/null || true

    # indirect rendering
    ln -s /usr/lib/libGLX_mesa.so.0 "${pkgdir}/usr/lib/libGLX_indirect.so.0"

    install -m644 -Dt "${pkgdir}/usr/share/licenses/${pkgname}" "${srcdir}/LICENSE"
}
