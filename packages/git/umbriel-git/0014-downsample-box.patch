From f75b2161522dc87814e2b5751ae8dfe2d28e80fd Mon Sep 17 00:00:00 2001
From: ZhangDM-520 <jixianqiang1540@gmail.com>
Date: Mon, 26 Oct 2026 16:28:00 +0800
Subject: [PATCH 3/3] fix(review): apply the downsample policy to
 window-capture mirrors

applyDownsampleMode() configured only the desktop scene; each view's
capture mirror is a separate wlr_scene that kept the zero default
(bilinear), so toplevel captures point-sampled minified buffers and
aliased despite appearance.downsample. Map the setting once, apply it to
every mirror scene on reload, and set it when a view creates one.

The harness pin drives a toplevel capture in all three method phases;
without the fix the box legs read pure texels (0,0,255)/(0,255,0).

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/server/server.h                           |  3 ++
 src/server/server_outputs.cpp                 | 22 +++++++++----
 src/view/view.cpp                             |  7 ++++
 src/view/view.h                               |  3 ++
 tests/harness/checks/render/downsample_box.sh | 32 +++++++++++++++++++
 5 files changed, 60 insertions(+), 7 deletions(-)

diff --git a/src/server/server.h b/src/server/server.h
index 3de52869..571a3862 100644
--- a/src/server/server.h
+++ b/src/server/server.h
@@ -428,6 +428,9 @@ namespace umbriel {
     // scale or moves surfaces between outputs outside setWorkspace; the notifies dedup, so extra calls are cheap.
     void refreshSurfaceScales();
     void applyDownsampleMode();
+    // The configured minified-sampling policy as a scene mode, for scenes
+    // outside m_scene (window-capture mirrors) that must follow it too.
+    [[nodiscard]] enum wlr_scene_downsample_mode sceneDownsampleMode();
     // Re-evaluate each output's policy after keyboard focus or a dynamic window rule changes.
     void refreshOutputPolicies();
     [[nodiscard]] wlr_output* preferredOutput() const;
diff --git a/src/server/server_outputs.cpp b/src/server/server_outputs.cpp
index 65f17517..4883d818 100644
--- a/src/server/server_outputs.cpp
+++ b/src/server/server_outputs.cpp
@@ -107,17 +107,25 @@ namespace umbriel {
     }
   }
 
-  void Server::applyDownsampleMode() {
+  enum wlr_scene_downsample_mode Server::sceneDownsampleMode() {
     switch (config().appearance.downsample) {
     case DownsampleMode::Box:
-      wlr_scene_set_downsample_mode(m_scene, WLR_SCENE_DOWNSAMPLE_BOX);
-      break;
+      return WLR_SCENE_DOWNSAMPLE_BOX;
     case DownsampleMode::Bilinear:
-      wlr_scene_set_downsample_mode(m_scene, WLR_SCENE_DOWNSAMPLE_BILINEAR);
-      break;
+      return WLR_SCENE_DOWNSAMPLE_BILINEAR;
     case DownsampleMode::Nearest:
-      wlr_scene_set_downsample_mode(m_scene, WLR_SCENE_DOWNSAMPLE_NEAREST);
-      break;
+      return WLR_SCENE_DOWNSAMPLE_NEAREST;
+    }
+    return WLR_SCENE_DOWNSAMPLE_BILINEAR;
+  }
+
+  void Server::applyDownsampleMode() {
+    const enum wlr_scene_downsample_mode mode = sceneDownsampleMode();
+    wlr_scene_set_downsample_mode(m_scene, mode);
+    // Window-capture mirrors are separate scenes with their own policy, and
+    // they minify render_scale-supersampled buffers like the desktop scene.
+    for (const auto& view : m_registry.all()) {
+      view->applyDownsampleMode(mode);
     }
   }
 
