From 2083bd00f64064eef1321aa2bc997242fbf34f97 Mon Sep 17 00:00:00 2001
From: ZhangDM-520 <jixianqiang1540@gmail.com>
Date: Mon, 26 Oct 2026 13:07:25 +0800
Subject: [PATCH 4/4] fix(xwayland): keep the X output rectangle in
 render-scale pixels
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

With xwayland_native_resolution, X coordinates scale by region.scale —
now the render scale — but the X rectangle Xwayland receives stayed at
the physical mode size. The two mappings disagree as soon as
render_scale differs from scale: a fullscreen X11 window is configured
to the physical width (the whole-output special case), then drawn
through the render-scale factor — at scale 1.25 / render_scale 2.0 it
filled 62.5% of the screen (and overshot with render_scale below
scale). Multi-output positions spread by the largest render scale
while the boxes stayed physical, leaving gaps and overlaps.

Scale the transformed resolution by the same factor the coordinate
mapping uses (render_scale / scale). A render scale that follows the
logical one has factor 1 and keeps the physical size exactly.

Pinned in nativeScreenPublishesTheRenderScale: the whole-output width
and height, the toX/toLayout round-trips through the rectangle, and
right-neighbour adjacency under a 2x render scale (mutation-proven:
the physical rectangle fails the pin).

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/xwayland/outputs.cpp        |  6 ++++++
 tests/unit/xwayland_outputs.cpp | 16 ++++++++++++++++
 2 files changed, 22 insertions(+)

diff --git a/src/xwayland/outputs.cpp b/src/xwayland/outputs.cpp
index 5a8b715b..8c05c1b9 100644
--- a/src/xwayland/outputs.cpp
+++ b/src/xwayland/outputs.cpp
@@ -114,7 +114,13 @@ namespace umbriel {
       if (m_nativeResolution) {
         // X11 clients render at the output's render scale, like Wayland clients.
         region.scale = m_renderScale != nullptr ? m_renderScale(output) : static_cast<double>(output->scale);
+        // X coordinates measure render-scale pixels, so the X rectangle must
+        // too: scale the physical resolution by the same factor the mapping
+        // uses. A render scale that follows the logical one has factor 1 and
+        // keeps the physical size exactly.
         wlr_output_transformed_resolution(output, &region.x.width, &region.x.height);
+        region.x.width = scaled(region.x.width, region.scale / output->scale);
+        region.x.height = scaled(region.x.height, region.scale / output->scale);
       }
       positionScale = std::max(positionScale, region.scale);
       regions.push_back({.output = output, .region = region});
diff --git a/tests/unit/xwayland_outputs.cpp b/tests/unit/xwayland_outputs.cpp
index 8c36bd68..f13cbac3 100644
--- a/tests/unit/xwayland_outputs.cpp
+++ b/tests/unit/xwayland_outputs.cpp
@@ -196,6 +196,22 @@ UMBRIEL_TEST(nativeScreenPublishesTheRenderScale) {
   CHECK_EQ(main.scale, 2.5);
   CHECK_EQ(main.toXWidth(1000), 2500);
   CHECK_EQ(main.toLayoutWidth(2500), 1000);
+
+  // The whole-output mapping must agree with the coordinate mapping: a
+  // fullscreen X window is configured to the X rectangle and drawn through the
+  // same scale. The rectangle measures render-scale pixels (3072 logical x
+  // 2.5), not the physical mode.
+  CHECK_EQ(main.x.width, 7680);
+  CHECK_EQ(main.x.height, 4320);
+  CHECK_EQ(main.toXWidth(main.layout.width), main.x.width);
+  CHECK_EQ(main.toX(main.layout.x + main.layout.width), main.x.x + main.x.width);
+  CHECK_EQ(main.toLayoutWidth(main.x.width), main.layout.width);
+
+  // Multi-output positions spread by the same factor as the rectangles, so
+  // the right neighbour still starts where the scaled output ends.
+  const umbriel::XwaylandRegion right = outputs.region(fixture.outputs[2], 0, 0);
+  CHECK_EQ(right.x.x, main.x.x + main.x.width);
+  CHECK_EQ(right.x.y, main.x.y);
 }
 
 int main() { return RUN_TESTS(); }
