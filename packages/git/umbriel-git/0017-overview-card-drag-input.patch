@@ -0,0 +1,108 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# Regression check (2026-10-27 user feedback, overview card drag input): the VERTICALLY scrolling
+# strip twin of drag/overview_card_drag_edge_scroll.sh. With workspace_axis = "horizontal" the
+# layout strip runs along Y (scrolling layouts run perpendicular to the workspace axis), and an
+# overview card drag held at the bottom edge must slide it exactly like the horizontal twin slides
+# the columns at the right edge — pinning that the edge auto-scroll mechanic is axis-generic.
+# Asserts: post-detach baseline (beginDrag detaches the tile and the strip closes the gap live),
+# >50 px of further vertical strip movement while parked at the edge, then drop placement after the
+# revealed column.
+set -euo pipefail
+
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly BTN_LEFT=272
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+
+spawn_client() {
+  foot --title="card-vedge-$1" sh -c 'sleep 120' > /dev/null 2>&1 &
+}
+
+window_y() {
+  jq -r --arg title "$1" '.[] | select(.title == $title) | .y' <<< "$2"
+}
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output."HEADLESS-1"]
+workspace_axis = "horizontal"
+
+[layout.scrolling]
+default_extent_fraction = 0.5
+center_focused = "never"
+
+[overview]
+background_blur = false
+shortcuts = false
+zoom = 0.5
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+for id in $(seq 1 4); do
+  spawn_client "$id"
+  for _ in $(seq 60); do
+    [[ $("$UMBRIEL" windows --json | jq 'length') -eq $id ]] && break
+    sleep 0.25
+  done
+done
+"$UMBRIEL" msg column-focus-first > /dev/null
+"$UMBRIEL" settle
+
+windows=$("$UMBRIEL" windows --json)
+initial_last_y=$(window_y card-vedge-4 "$windows")
+echo "probe: initial card-vedge-4 y=$initial_last_y (strip must run along Y)"
+if ((initial_last_y < OUTPUT_H)); then
+  echo "the last column began inside the viewport instead of below it: $windows"
+  exit 1
+fi
+
+"$UMBRIEL_POINTER_CLIENT" "$OUTPUT_W" "$OUTPUT_H" move 640 360
+"$UMBRIEL" msg overview-open > /dev/null
+"$UMBRIEL" settle
+
+start_x=$(jq -r '.[] | select(.title == "card-vedge-1") | (.x + .w / 2 | round)' <<< "$windows")
+start_y=$(jq -r '.[] | select(.title == "card-vedge-1") | (.y + .h / 2 | round)' <<< "$windows")
+press_x=$((320 + start_x / 2))
+press_y=$((180 + start_y / 2))
+
+pointer_hold "$OUTPUT_W" "$OUTPUT_H" \
+  move "$press_x" "$press_y" press "$BTN_LEFT" move "$press_x" $((press_y + 20)) \
+  -- move 640 719 mark atedge hold release "$BTN_LEFT"
+
+windows=$("$UMBRIEL" windows --json)
+base_last_y=$(window_y card-vedge-4 "$windows")
+echo "probe: post-detach baseline card-vedge-4 y $initial_last_y -> $base_last_y"
+
+pointer_step atedge
+
+revealed=false
+last_y=$base_last_y
+for _ in $(seq 120); do
+  windows=$("$UMBRIEL" windows --json)
+  last_y=$(window_y card-vedge-4 "$windows")
+  if ((last_y < base_last_y - 50)); then
+    revealed=true
+    break
+  fi
+  sleep 0.05
+done
+if [[ $revealed != true ]]; then
+  echo "RED: overview card drag at the bottom edge did not slide the vertical strip: card-vedge-4 y $base_last_y -> $last_y"
+  pointer_release
+  exit 1
+fi
+
+pointer_release
+"$UMBRIEL" settle
+
+windows=$("$UMBRIEL" windows --json)
+moved_y=$(window_y card-vedge-1 "$windows")
+dropped_last_y=$(window_y card-vedge-4 "$windows")
+if ((moved_y <= dropped_last_y)); then
+  echo "dropping at the revealed edge did not place card-vedge-1 after card-vedge-4: $windows"
+  exit 1
+fi
+
+echo "GREEN: overview card drag at the bottom edge slid the vertical strip (card-vedge-4 y $base_last_y -> $last_y) and dropped after it"
diff --git a/tests/harness/checks/drag/overview_card_workspace_axis_pan.sh b/tests/harness/checks/drag/overview_card_workspace_axis_pan.sh
new file mode 100644
index 00000000..ea526749
--- /dev/null
+++ b/tests/harness/checks/drag/overview_card_workspace_axis_pan.sh
@@ -0,0 +1,97 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# Regression check (2026-10-27 user feedback: "the feature is missing for vertical workspace;
+# horizontal and vertical scroll could use the same mechanic"): while an overview card drag is
+# held, the touchpad finger-scroll stream must pan the WORKSPACE FILMSTRIP along the workspace axis
+# — the workspace-axis twin of the strip pan drag/overview_card_axis_pan.sh pins. Pan-only: the
+# rows follow the fingers, the active workspace never changes under the hold, and the release
+# settles without selecting anything so the drop lands on the workspace under the pointer (the
+# drop's focus is what activates its destination).
+set -euo pipefail
+
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly BTN_LEFT=272
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+
+spawn_client() {
+  foot --title="card-wsaxis-$1" sh -c 'sleep 120' > /dev/null 2>&1 &
+}
+
+active_workspace() {
+  "$UMBRIEL" workspaces --json | jq -r '.[] | select(.active) | .index'
+}
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[output."HEADLESS-1"]
+workspaces = 3
+
+[overview]
+background_blur = false
+shortcuts = false
+zoom = 0.5
+scroll_factor_horizontal = 1.0
+scroll_factor_vertical = 1.0
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+spawn_client 1
+for _ in $(seq 60); do
+  [[ $("$UMBRIEL" windows --json | jq 'length') -eq 1 ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+active_before=$(active_workspace)
+windows=$("$UMBRIEL" windows --json)
+start_x=$(jq -r '.[] | select(.title == "card-wsaxis-1") | (.x + .w / 2 | round)' <<< "$windows")
+start_y=$(jq -r '.[] | select(.title == "card-wsaxis-1") | (.y + .h / 2 | round)' <<< "$windows")
+# Overview zoom 0.5: the active workspace preview is centred at origin 320,180, half scale; rows
+# step 396 px (= 360 preview + 36 gap). The press lands at the card centre (~640,360 = row 0's band).
+press_x=$((320 + start_x / 2))
+press_y=$((180 + start_y / 2))
+
+"$UMBRIEL_POINTER_CLIENT" "$OUTPUT_W" "$OUTPUT_H" move 640 360
+"$UMBRIEL" msg overview-open > /dev/null
+"$UMBRIEL" settle
+
+# Drag threshold nudge is a pointer move (no pan); the axis stream is the touchpad finger-scroll.
+# travelScale(1.0, zoom 0.5 -> zoomScale 1.25, factor 1.0, workspace 500) = 0.0025 rows/px, so
+# 500 px vertical travel pans exactly one row: row 1's band (576..936 at rest) reaches the
+# stationary pointer at y=360 and the drop must land on workspace 2.
+pointer_hold "$OUTPUT_W" "$OUTPUT_H" \
+  move "$press_x" "$press_y" press "$BTN_LEFT" move $((press_x + 30)) "$press_y" \
+  -- axis vertical 500 pause 400 axis-stop vertical mark panned hold release "$BTN_LEFT"
+
+pointer_step panned
+
+# Pan-only contract: panning the rows under the hold must not step the filmstrip (switch the active
+# workspace) before the drop resolves.
+active_during=$(active_workspace)
+if [[ $active_during != "$active_before" ]]; then
+  echo "the finger pan switched the active workspace under the held card: $active_before -> $active_during"
+  pointer_release
+  exit 1
+fi
+
+pointer_release
+"$UMBRIEL" settle
+
+windows=$("$UMBRIEL" windows --json)
+dropped=$(jq -r '.[] | select(.title == "card-wsaxis-1") | .workspace' <<< "$windows")
+focused=$(jq -r '.[] | select(.title == "card-wsaxis-1") | .focused // false' <<< "$windows")
+echo "probe: dropped workspace $dropped (pointer at $((press_x + 30)),$press_y -> world $(((press_x + 30 - 320) * 2)),$(((press_y - 180) * 2)))"
+
+if [[ $dropped != *":2" ]]; then
+  echo "RED: finger travel during a held card drag did not pan the workspace filmstrip: drop stayed on $dropped"
+  exit 1
+fi
+
+if [[ $focused != true ]]; then
+  echo "the drop did not keep keyboard focus on the moved window: $windows"
+  exit 1
+fi
+
+echo "GREEN: finger travel during a held card drag panned the filmstrip (drop on $dropped) without stepping the workspace"
