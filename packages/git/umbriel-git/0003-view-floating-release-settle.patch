diff --git a/tests/harness/checks/drag/floating_release_settle.sh b/tests/harness/checks/drag/floating_release_settle.sh
new file mode 100755
index 0000000..4acaf6a
--- /dev/null
+++ b/tests/harness/checks/drag/floating_release_settle.sh
@@ -0,0 +1,142 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A floating window dragged mostly out of frame settles into the grabbable
+# margin at release — animated — and later focus changes never move it. The
+# margin is floatingKeepVisible: a quarter of the window, at least 10px and at
+# most 75px, stays inside the usable area per axis.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly TITLE=release-settle
+readonly CLIENT="${UMBRIEL_FRACTIONAL_CLIENT:-./build-debug/fractional-client}"
+readonly CLIENT_LOG="$UMBRIEL_RUNTIME_DIR/release-settle.log"
+readonly BTN_LEFT=272 # evdev BTN_LEFT
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+readonly POINTER="${UMBRIEL_POINTER_CLIENT:-./build-debug/tests/pointer-client}"
+
+if [[ ! -x $POINTER ]]; then
+  echo "input helpers are not available"
+  exit 1
+fi
+
+pointer() {
+  "$POINTER" "$OUTPUT_W" "$OUTPUT_H" "$@"
+}
+
+ipc_box() {
+  "$UMBRIEL" windows --json | jq -r --arg title "$TITLE" '.[] | select(.title == $title) | "\(.x) \(.y) \(.w) \(.h)"'
+}
+
+# The IPC box is the animation target; the presented sliver is what the user
+# sees, so the interpolation is sampled from pixels.
+capture_width() {
+  local image="$UMBRIEL_RUNTIME_DIR/$1.png"
+  local w h x y
+  grim "$image"
+  read -r w h x y < <(
+    magick "$image" -alpha off -colorspace gray -threshold 1% \
+      -bordercolor black -border 1 -trim -format '%w %h %X %Y\n' info:
+  )
+  echo "$w"
+}
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[animation]
+duration_ms = 2000
+curve = "linear"
+
+[animation.windows_drag]
+physics = false
+
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+
+[appearance.shadow]
+enabled = false
+
+[[window_rule]]
+match.title = "^release-settle$"
+default_floating = true
+default_floating_size_px = { width = 700, height = 700 }
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+"$CLIENT" "$TITLE" 700 700 > "$CLIENT_LOG" 2>&1 &
+for _ in $(seq 60); do
+  [[ -n $(ipc_box) ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+# Grab near the right edge and shove the window to the left border: at the
+# drop only 11px of the 700px window are still visible, and the margin (75px)
+# asks for x=-625.
+read -r wx wy ww wh < <(ipc_box)
+gx=$((wx + ww - 6))
+gy=$((wy + 20))
+pointer_hold "$OUTPUT_W" "$OUTPUT_H" \
+  mod logo move "$gx" "$gy" press "$BTN_LEFT" move 5 "$gy" \
+  -- release "$BTN_LEFT" mod none
+
+# The settle runs at release: freeze the animation clock first, so the samples
+# land at 250ms and 1250ms of the 2000ms linear timeline. The visible sliver
+# must grow from the drop's 11px to the margin's 75px through intermediate
+# widths — a flash jumps straight to 75.
+"$UMBRIEL" clock-freeze
+pointer_release
+w0=$(capture_width drop)
+"$UMBRIEL" clock-advance 250
+w1=$(capture_width mid-250)
+"$UMBRIEL" clock-advance 1000
+w2=$(capture_width mid-1250)
+"$UMBRIEL" clock-advance 2000
+w3=$(capture_width settled)
+"$UMBRIEL" clock-resume
+"$UMBRIEL" settle
+
+if ! ((w0 <= 12 && w0 < w1 && w1 < w2 && w2 < w3 && w3 >= 74 && w3 <= 76)); then
+  echo "the release settle did not animate through the margin (slivers: $w0 -> $w1 -> $w2 -> $w3)"
+  exit 1
+fi
+
+visible=$((ww / 4))
+if ((visible < 10)); then visible=10; fi
+if ((visible > 75)); then visible=75; fi
+min_x=$((visible - ww))
+final_x=$(ipc_box | cut -d' ' -f1)
+if ((final_x < min_x)); then
+  echo "the drop left the window out of frame: x=$final_x, margin allows x>=$min_x (box: $(ipc_box))"
+  exit 1
+fi
+
+# Focus changes must never move a floating window: clicking a tiled one
+# arranges the strip, and that arrange used to clamp the float in passing.
+foot sh -c 'sleep 120' > /dev/null 2>&1 &
+for _ in $(seq 60); do
+  [[ $("$UMBRIEL" windows --json | jq 'length') -eq 2 ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+before=$(ipc_box)
+read -r bx by < <(
+  "$UMBRIEL" windows --json | jq -r --arg title "$TITLE" \
+    '.[] | select(.title != $title) | "\(.x + (.w / 2 | floor)) \(.y + (.h / 2 | floor))"' | head -1
+)
+pointer move "$bx" "$by" click "$BTN_LEFT"
+"$UMBRIEL" settle
+for _ in $(seq 20); do
+  after=$(ipc_box)
+  if [[ $after != "$before" ]]; then
+    echo "the focus change moved the floating window:"
+    echo "before: $before"
+    echo "after:  $after"
+    exit 1
+  fi
+  sleep 0.1
+done
+
+echo "a floating window settles into the margin at release, animated, and focus never moves it"
diff --git a/tests/harness/checks/layout/floating_clamp_retarget.sh b/tests/harness/checks/layout/floating_clamp_retarget.sh
new file mode 100755
index 0000000..7a7b01f
--- /dev/null
+++ b/tests/harness/checks/layout/floating_clamp_retarget.sh
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+# harness: outputs=1
+# A usable-area change during a position animation retargets the tween into the new grabbable margin. The clamp used
+# to be spent on the in-flight animation: the tween kept its old target and the window settled out of frame, and the
+# change was never re-checked.
+set -euo pipefail
+
+readonly CLIENT="${UMBRIEL_FRACTIONAL_CLIENT:-./build-debug/tests/fractional-client}"
+readonly LAYER_CLIENT="${UMBRIEL_LAYER_CLIENT:-./build-debug/tests/layer-client}"
+readonly TITLE=retarget-clamp
+readonly PANEL_LOG="$UMBRIEL_RUNTIME_DIR/retarget-panel.log"
+
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[animation]
+duration_ms = 2000
+curve = "linear"
+
+[appearance]
+border_width = 0
+outer_border_width = 0
+corner_radius = 0
+
+[appearance.shadow]
+enabled = false
+
+[[window_rule]]
+match.title = "^retarget-clamp$"
+default_floating = true
+default_floating_size_px = { width = 400, height = 300 }
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+ipc_box() {
+  "$UMBRIEL" windows --json | jq -r --arg title "$TITLE" '.[] | select(.title == $title) | "\(.x) \(.y) \(.w) \(.h)"'
+}
+
+wait_for_ready() {
+  for _ in $(seq 80); do
+    grep -q '^ready$' "$1" && return 0
+    sleep 0.1
+  done
+  echo "exclusive-zone panel did not map: $(< "$1")"
+  return 1
+}
+
+"$CLIENT" "$TITLE" 400 300 > "$UMBRIEL_RUNTIME_DIR/retarget-clamp.log" 2>&1 &
+for _ in $(seq 60); do
+  [[ -n $(ipc_box) ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+# Tween toward the top-left clamp of the unshrunken usable area: the 400x300 window heads for x=-325, y=-225.
+"$UMBRIEL" clock-freeze
+"$UMBRIEL" msg window-move-by:-9999/-9999 > /dev/null
+
+# Map a 40px exclusive top panel mid-flight. The usable area's top edge moves to y=40, and the old target leaves only
+# 35px of the window's height inside — the margin asks for 75px, so the tween must be re-aimed at y=-185.
+"$LAYER_CLIENT" HEADLESS-1 40 > "$PANEL_LOG" 2>&1 &
+panel=$!
+wait_for_ready "$PANEL_LOG"
+
+"$UMBRIEL" clock-advance 3000
+"$UMBRIEL" clock-resume
+"$UMBRIEL" settle
+
+kill "$panel" 2> /dev/null || true
+wait "$panel" 2> /dev/null || true
+
+read -r wx wy ww wh < <(ipc_box)
+visible_x=$((ww / 4))
+((visible_x < 10)) && visible_x=10
+((visible_x > 75)) && visible_x=75
+visible_y=$((wh / 4))
+((visible_y < 10)) && visible_y=10
+((visible_y > 75)) && visible_y=75
+min_x=$((visible_x - ww))
+min_y=$((40 + visible_y - wh))
+if ((wx < min_x || wy < min_y)); then
+  echo "the tween settled outside the new grabbable margin: box: $(ipc_box)"
+  echo "margin for a ${ww}x${wh} window under the 40px panel: x >= $min_x, y >= $min_y"
+  exit 1
+fi
+
+echo "the usable change retargeted the tween into the new grabbable margin"
diff --git a/tests/harness/checks/layout/floating_cross_output_clamp.sh b/tests/harness/checks/layout/floating_cross_output_clamp.sh
new file mode 100755
index 0000000..8d0b559
--- /dev/null
+++ b/tests/harness/checks/layout/floating_cross_output_clamp.sh
@@ -0,0 +1,101 @@
+#!/usr/bin/env bash
+# harness: outputs=2
+# A cross-output move restores a floating window proportionally to the destination's usable area. The proportional
+# origin can resolve outside the grabbable margin on a smaller output — a scale jump can leave only a sliver on
+# screen — so the restored origin is clamped: floatingKeepVisible (a quarter of the window, 10..75px) stays inside
+# the usable area per axis, the same margin a free drop settles into.
+set -euo pipefail
+
+readonly CLIENT="${UMBRIEL_FRACTIONAL_CLIENT:-./build-debug/tests/fractional-client}"
+readonly TITLE=cross-clamp
+
+BASELINE=$(< "$UMBRIEL_CONFIG")
+{
+  printf '%s\n' "$BASELINE"
+  printf '\n[animation]\nenabled = false\n'
+  printf '\n[output.HEADLESS-1]\nposition = [0, 0]\n'
+  printf '\n[output.HEADLESS-2]\nscale = 2\n'
+  cat << 'EOF'
+
+[[window_rule]]
+match.title = "^cross-clamp$"
+default_floating = true
+default_output = "HEADLESS-1"
+default_floating_size_px = { width = 400, height = 300 }
+EOF
+} > "$UMBRIEL_CONFIG"
+"$UMBRIEL" msg config-reload > /dev/null
+
+output_scale() {
+  "$UMBRIEL" outputs | awk -v name="$1" '$1 == name { found = 1; next } found && /Scale:/ { print $2; exit }'
+}
+
+wait_for_output_scale() {
+  local actual=
+  for _ in $(seq 40); do
+    actual=$(output_scale "$1")
+    [[ $actual == "$2" ]] && return 0
+    sleep 0.1
+  done
+  echo "$1 did not settle at scale $2, got $actual"
+  "$UMBRIEL" outputs
+  return 1
+}
+
+ipc_box() {
+  "$UMBRIEL" windows --json | jq -r --arg title "$TITLE" '.[] | select(.title == $title) | "\(.x) \(.y) \(.w) \(.h)"'
+}
+
+workspace_of() {
+  "$UMBRIEL" windows --json | jq -r --arg title "$TITLE" '.[] | select(.title == $title) | .workspace'
+}
+
+# HEADLESS-2 is the 1280x720 headless mode at scale 2: a 640x360 logical output sitting at x=1280, right of the
+# scale-1 HEADLESS-1.
+wait_for_output_scale HEADLESS-2 2.000000
+
+"$CLIENT" "$TITLE" 400 300 > "$UMBRIEL_RUNTIME_DIR/cross-clamp.log" 2>&1 &
+for _ in $(seq 60); do
+  [[ -n $(ipc_box) ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+# Park the float at the right-bottom clamp of its own output: x=1205/1280 and y=645/720 of the usable area.
+"$UMBRIEL" msg window-move-by:9999/9999 > /dev/null
+"$UMBRIEL" settle
+read -r sx sy sw sh < <(ipc_box)
+if ((sx != 1205 || sy != 645)); then
+  echo "the float did not park at the source margin: $(ipc_box)"
+  exit 1
+fi
+
+# The same fractions on the scaled output land at x=603, y=323 of its 640x360 usable area, where only 37px and 37px
+# of the 400x300 window stay visible — the margin asks for 75px per axis.
+"$UMBRIEL" msg window-move-to-output-right > /dev/null
+"$UMBRIEL" settle
+
+ws=$(workspace_of)
+if [[ $ws != HEADLESS-2:* ]]; then
+  echo "the window did not move to HEADLESS-2: workspace $ws"
+  exit 1
+fi
+
+read -r wx wy ww wh < <(ipc_box)
+visible_x=$((ww / 4))
+((visible_x < 10)) && visible_x=10
+((visible_x > 75)) && visible_x=75
+visible_y=$((wh / 4))
+((visible_y < 10)) && visible_y=10
+((visible_y > 75)) && visible_y=75
+min_x=$((1280 + visible_x - ww))
+max_x=$((1280 + 640 - visible_x))
+min_y=$((visible_y - wh))
+max_y=$((360 - visible_y))
+if ((wx < min_x || wx > max_x || wy < min_y || wy > max_y)); then
+  echo "the cross-output restore left the window outside the grabbable margin: box: $(ipc_box)"
+  echo "margin for a ${ww}x${wh} window on the 640x360 output: x in [$min_x, $max_x], y in [$min_y, $max_y]"
+  exit 1
+fi
+
+echo "the cross-output restore landed inside the grabbable margin"
