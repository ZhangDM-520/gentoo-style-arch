diff --git a/tests/harness/checks/input/mod_right_double_click_maximize.sh b/tests/harness/checks/input/mod_right_double_click_maximize.sh
new file mode 100755
index 0000000..f62cc8e
--- /dev/null
+++ b/tests/harness/checks/input/mod_right_double_click_maximize.sh
@@ -0,0 +1,69 @@
+#!/usr/bin/env bash
+# A second Mod+right-click on the same window within the double-click window
+# toggles maximize with a titlebar double-click's semantics. Single clicks stay
+# resize attempts and never toggle the state on their own.
+set -euo pipefail
+
+readonly BTN_RIGHT=273 # evdev BTN_RIGHT
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+readonly POINTER="${UMBRIEL_POINTER_CLIENT:-./build-debug/tests/pointer-client}"
+
+if [[ ! -x $POINTER ]]; then
+  echo "input helpers are not available"
+  exit 1
+fi
+
+pointer() {
+  "$POINTER" "$OUTPUT_W" "$OUTPUT_H" "$@"
+}
+
+window_center() {
+  local windows
+  windows=$("$UMBRIEL" windows --json)
+  jq -r '.[0] | "\(.x + (.w / 2 | floor)) \(.y + (.h / 2 | floor))"' <<< "$windows"
+}
+
+wait_for_maximized() {
+  local want=$1
+  for _ in $(seq 40); do
+    [[ $("$UMBRIEL" windows --json | jq -r '.[0].maximized') == "$want" ]] && return 0
+    sleep 0.1
+  done
+  echo "timed out waiting for maximized=$want: $("$UMBRIEL" windows --json)"
+  return 1
+}
+
+double_click() {
+  local x y
+  read -r x y < <(window_center)
+  pointer move "$x" "$y" mod logo click "$BTN_RIGHT" click "$BTN_RIGHT" mod none
+  "$UMBRIEL" settle
+}
+
+foot sh -c 'sleep 120' > /dev/null 2>&1 &
+for _ in $(seq 60); do
+  [[ $("$UMBRIEL" windows --json | jq 'length') -eq 1 ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+double_click
+wait_for_maximized true
+
+double_click
+wait_for_maximized false
+
+# Two clicks past the double-click window are two single clicks: resize
+# attempts that must not toggle maximize.
+read -r x y < <(window_center)
+pointer move "$x" "$y" mod logo click "$BTN_RIGHT" mod none
+sleep 0.5 # real time: must exceed the double-click window so the next click pairs with nothing
+pointer mod logo click "$BTN_RIGHT" mod none
+"$UMBRIEL" settle
+if [[ $("$UMBRIEL" windows --json | jq -r '.[0].maximized') != false ]]; then
+  echo "slow Mod+right clicks toggled maximize: $("$UMBRIEL" windows --json)"
+  exit 1
+fi
+
+echo "Mod+double-right-click toggles maximize"
