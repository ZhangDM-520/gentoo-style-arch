-      beginResize(view, view->tiled() ? 0 : floatResizeEdges(view), button);
+      // A second Mod+right-click on the same window within the double-click
+      // window applies the opposite maximize state with a titlebar
+      // double-click's semantics. The direction comes from the pair's first
+      // press: the resize grab that press starts can unmaximize on begin (the
+      // thirds edge zones resolve an edge for most clicks on a tiled window),
+      // so recomputing it here would turn a restore into a re-maximize.
+      const bool wasMaximized = view->maximizedToEdges() || view->scheduledMaximized() || view->floatingMaximized();
+      if (const std::optional<bool> firstPressWasMaximized = modRightDoubleClick(timeMsec, view, wasMaximized)) {
+        // No grab owns this press, so its release would reach the client
+        // unmatched; swallow both like the tab-bar path does.
+        m_swallowedButtons.push_back(button);
+        view->setMaximizedLikeClientRequest(!*firstPressWasMaximized);
+        return;
+      }
+      // Defer the resize grab until the pointer commits to a drag: the click
