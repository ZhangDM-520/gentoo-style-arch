--- /dev/null
+++ b/tests/harness/checks/input/mod_right_double_click_disabled.sh
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# mod_right_double_click defaults to "none": two quick Mod+right-clicks are two
+# resize attempts, never a maximize toggle. The gesture is opt-in so the
+# button's default behavior is unchanged.
+set -euo pipefail
+
+readonly BTN_RIGHT=273 # evdev BTN_RIGHT
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+readonly POINTER="${UMBRIEL_POINTER_CLIENT:-./build-debug/tests/pointer-client}"
+
+if [[ ! -x $POINTER ]]; then
+  echo "input helpers are not available"
+  exit 1
+fi
+
+pointer() {
+  "$POINTER" "$OUTPUT_W" "$OUTPUT_H" "$@"
+}
+
+window_box() {
+  "$UMBRIEL" windows --json | jq -r '.[0] | "\(.x) \(.y) \(.w) \(.h)"'
+}
+
+foot sh -c 'sleep 120' > /dev/null 2>&1 &
+for _ in $(seq 60); do
+  [[ $("$UMBRIEL" windows --json | jq 'length') -eq 1 ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+# A pair at the edge-free centre and at an edge zone: both stay clicks.
+failed=0
+for pos in "0.5 0.5" "0.25 0.5"; do
+  read -r fx fy <<< "$pos"
+  windows=$("$UMBRIEL" windows --json)
+  x=$(jq -r --argjson f "$fx" '.[0].x + (.[0].w * $f | floor)' <<< "$windows")
+  y=$(jq -r --argjson f "$fy" '.[0].y + (.[0].h * $f | floor)' <<< "$windows")
+  pointer move "$x" "$y" mod logo click "$BTN_RIGHT" click "$BTN_RIGHT" mod none
+  "$UMBRIEL" settle
+  if [[ $("$UMBRIEL" windows --json | jq -r '.[0].maximized') != false ]]; then
+    echo "Mod+double-right-click at ($fx,$fy) toggled maximize with the default config"
+    failed=1
+  fi
+done
+
+# The button still does its main job: a drag past the slop resizes with its
+# press-time edge. This also proves the pair clicks landed on the window.
+windows=$("$UMBRIEL" windows --json)
+x=$(jq -r '.[0] | "\(.x + (.w * 0.2 | floor))"' <<< "$windows")
+y=$(jq -r '.[0] | "\(.y + (.h / 2 | floor))"' <<< "$windows")
+before=$(window_box)
+pointer mod logo move "$x" "$y" press "$BTN_RIGHT" move $((x + 60)) "$y" release "$BTN_RIGHT" mod none
+"$UMBRIEL" settle
+if [[ $(window_box) == "$before" ]]; then
+  echo "Mod+right-drag did not resize with mod_right_double_click = none"
+  failed=1
+fi
+
+if (( failed != 0 )); then
+  exit 1
+fi
+
+echo "mod_right_double_click = none keeps Mod+right-click a pure resize drag"
diff --git a/tests/harness/checks/input/mod_right_double_click_maximize.sh b/tests/harness/checks/input/mod_right_double_click_maximize.sh
new file mode 100755
index 0000000..27fe530
--- /dev/null
+++ b/tests/harness/checks/input/mod_right_double_click_maximize.sh
@@ -0,0 +1,119 @@
+#!/usr/bin/env bash
+# A second Mod+right-click on the same window within the double-click window
+# applies the opposite maximize state and restores the window's geometry, for
+# tiled and floating windows alike and wherever the pair lands in the window:
+# the first press defers its resize grab (the thirds edge zones resolve an edge
+# for most points), so no grab may perturb the state the toggle reads at the
+# second press. Single clicks stay resize attempts and never toggle the state
+# on their own.
+set -euo pipefail
+
+readonly BTN_RIGHT=273 # evdev BTN_RIGHT
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+readonly POINTER="${UMBRIEL_POINTER_CLIENT:-./build-debug/tests/pointer-client}"
+
+if [[ ! -x $POINTER ]]; then
+  echo "input helpers are not available"
+  exit 1
+fi
+
+pointer() {
+  "$POINTER" "$OUTPUT_W" "$OUTPUT_H" "$@"
+}
+
+window_box() {
+  "$UMBRIEL" windows --json | jq -r '.[0] | "\(.x) \(.y) \(.w) \(.h)"'
+}
+
+# The gesture is opt-in; the check exercises its "maximize" vocabulary.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[input]
+mod_right_double_click = "maximize"
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+wait_for_box() {
+  local want=$1
+  for _ in $(seq 40); do
+    [[ $(window_box) == "$want" ]] && return 0
+    sleep 0.1
+  done
+  echo "timed out waiting for box $want, got $(window_box)"
+  return 1
+}
+
+wait_for_maximized() {
+  local want=$1
+  for _ in $(seq 40); do
+    [[ $("$UMBRIEL" windows --json | jq -r '.[0].maximized') == "$want" ]] && return 0
+    sleep 0.1
+  done
+  echo "timed out waiting for maximized=$want: $("$UMBRIEL" windows --json)"
+  return 1
+}
+
+# A double-click pair at a fractional position of the window box: 0.5 is the
+# edge-free center third, 0.25/0.85 land in the resize edge zones.
+double_click_at() {
+  local fx=$1 fy=$2 windows x y
+  windows=$("$UMBRIEL" windows --json)
+  x=$(jq -r --argjson f "$fx" '.[0].x + (.[0].w * $f | floor)' <<< "$windows")
+  y=$(jq -r --argjson f "$fy" '.[0].y + (.[0].h * $f | floor)' <<< "$windows")
+  pointer move "$x" "$y" mod logo click "$BTN_RIGHT" click "$BTN_RIGHT" mod none
+  "$UMBRIEL" settle
+}
+
+check_round_trip() {
+  local kind=$1 fx=$2 fy=$3 before after
+  before=$(window_box)
+  double_click_at "$fx" "$fy"
+  wait_for_maximized true || return 1
+  if [[ $(window_box) == "$before" ]]; then
+    echo "$kind pair at ($fx,$fy) did not change geometry: $(window_box)"
+    return 1
+  fi
+  double_click_at "$fx" "$fy"
+  wait_for_maximized false || return 1
+  after=$(window_box)
+  if [[ $after != "$before" ]]; then
+    echo "$kind pair at ($fx,$fy) did not restore $before, got $after"
+    return 1
+  fi
+}
+
+foot sh -c 'sleep 120' > /dev/null 2>&1 &
+for _ in $(seq 60); do
+  [[ $("$UMBRIEL" windows --json | jq 'length') -eq 1 ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+failed=0
+check_round_trip tiled 0.5 0.5 || failed=1
+check_round_trip tiled 0.25 0.25 || failed=1
+check_round_trip tiled 0.85 0.25 || failed=1
+
+"$UMBRIEL" msg window-toggle-floating > /dev/null
+"$UMBRIEL" settle
+check_round_trip floating 0.25 0.5 || failed=1
+check_round_trip floating 0.5 0.5 || failed=1
+
+# Two clicks past the double-click window are two single clicks: resize
+# attempts that must not toggle maximize.
+read -r x y < <(jq -r '.[0] | "\(.x + (.w / 2 | floor)) \(.y + (.h / 2 | floor))"' <<< "$("$UMBRIEL" windows --json)")
+pointer move "$x" "$y" mod logo click "$BTN_RIGHT" mod none
+sleep 0.5 # real time: must exceed the double-click window so the next click pairs with nothing
+pointer mod logo click "$BTN_RIGHT" mod none
+"$UMBRIEL" settle
+if [[ $("$UMBRIEL" windows --json | jq -r '.[0].maximized') != false ]]; then
+  echo "slow Mod+right clicks toggled maximize: $("$UMBRIEL" windows --json)"
+  failed=1
+fi
+
+if (( failed != 0 )); then
+  exit 1
+fi
+
+echo "Mod+double-right-click toggles maximize and restores geometry on tiled and floating windows"
diff --git a/tests/harness/checks/input/mod_right_grab_lifetime.sh b/tests/harness/checks/input/mod_right_grab_lifetime.sh
new file mode 100755
index 0000000..9b37193
--- /dev/null
+++ b/tests/harness/checks/input/mod_right_grab_lifetime.sh
@@ -0,0 +1,94 @@
+#!/usr/bin/env bash
+# The deferred Mod+right resize is a grab state: it holds its initiating
+# button, so a second button cannot start a competing operation, every release
+# path ends it, and nothing stale promotes once all buttons are up. The
+# sequence under test: Mod+right press on an edge zone, Mod+left press, release
+# right, drag with left past the slop, release left — then motion with no
+# buttons held must not resize the window.
+set -euo pipefail
+
+readonly BTN_LEFT=272 # evdev BTN_LEFT
+readonly BTN_RIGHT=273 # evdev BTN_RIGHT
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+readonly POINTER="${UMBRIEL_POINTER_CLIENT:-./build-debug/tests/pointer-client}"
+
+if [[ ! -x $POINTER ]]; then
+  echo "input helpers are not available"
+  exit 1
+fi
+
+pointer() {
+  "$POINTER" "$OUTPUT_W" "$OUTPUT_H" "$@"
+}
+
+window_box() {
+  "$UMBRIEL" windows --json | jq -r '.[0] | "\(.x) \(.y) \(.w) \(.h)"'
+}
+
+# Geometry must be readable without settle: it waits for a drawn frame and
+# wedges while a button is held, which is exactly the state under test.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[animation]
+enabled = false
+
+[input]
+mod_right_double_click = "maximize"
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+foot sh -c 'sleep 120' > /dev/null 2>&1 &
+for _ in $(seq 60); do
+  [[ $("$UMBRIEL" windows --json | jq 'length') -eq 1 ]] && break
+  sleep 0.25
+done
+"$UMBRIEL" settle
+
+# The press lands in the left third so it proposes a resize edge. The whole
+# sequence must leave the window alone: the deferred press holds its button, so
+# the Mod+left press is swallowed and the drag commits nothing. The floating
+# round matters: a tiled window snapped back to its column after an unwanted
+# move-grab would look unchanged.
+repro_round() {
+  local kind=$1 windows x y before after
+  windows=$("$UMBRIEL" windows --json)
+  x=$(jq -r '.[0] | "\(.x + (.w * 0.2 | floor))"' <<< "$windows")
+  y=$(jq -r '.[0] | "\(.y + (.h / 2 | floor))"' <<< "$windows")
+  before=$(window_box)
+  pointer mod logo \
+    move "$x" "$y" \
+    press "$BTN_RIGHT" press "$BTN_LEFT" \
+    release "$BTN_RIGHT" \
+    move $((x + 40)) "$y" \
+    release "$BTN_LEFT" mod none
+  "$UMBRIEL" settle
+
+  # Motion with no buttons held must not resize anything either. A grab that
+  # outlives its button resizes during the motions themselves; poll so a late
+  # configure cannot hide it.
+  pointer move $((x + 120)) "$y" move $((x + 200)) "$y"
+  for _ in $(seq 20); do
+    after=$(window_box)
+    if [[ $after != "$before" ]]; then
+      echo "$kind: the deferred press outlived its button and moved or resized the window:"
+      echo "before: $before"
+      echo "after:  $after"
+      return 1
+    fi
+    sleep 0.1
+  done
+  return 0
+}
+
+failed=0
+repro_round tiled || failed=1
+"$UMBRIEL" msg window-toggle-floating > /dev/null
+"$UMBRIEL" settle
+repro_round floating || failed=1
+
+if (( failed != 0 )); then
+  exit 1
+fi
+
+echo "the deferred Mod+right press ends with its button release"
diff --git a/tests/harness/checks/input/mod_right_pending_teardown.sh b/tests/harness/checks/input/mod_right_pending_teardown.sh
new file mode 100755
index 0000000..2a26246
--- /dev/null
+++ b/tests/harness/checks/input/mod_right_pending_teardown.sh
@@ -0,0 +1,90 @@
+#!/usr/bin/env bash
+# A deferred Mod+right press must not outlive the view it references: the
+# window can unmap while the button is still held, and the next motion would
+# otherwise promote the deferred grab against freed storage.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+readonly BTN_RIGHT=273 # evdev BTN_RIGHT
+readonly OUTPUT_W=1280
+readonly OUTPUT_H=720
+
+await_count() {
+  local want=$1
+  for _ in $(seq 60); do
+    [[ $("$UMBRIEL" windows --json | jq 'length') -eq $want ]] && return 0
+    sleep 0.25
+  done
+  echo "timed out waiting for $want window(s): $("$UMBRIEL" windows --json | jq -c 'map(.title)')"
+  return 1
+}
+
+boxes() {
+  "$UMBRIEL" windows --json | jq -r '.[] | [.title, .x, .y, .w, .h] | @tsv' | sort
+}
+
+await_stable_boxes() {
+  local previous= current
+  current=$(boxes)
+  for _ in $(seq 40); do
+    previous=$current
+    sleep 0.1
+    current=$(boxes)
+    [[ $current == "$previous" ]] && return 0
+  done
+  echo "window boxes never stabilised: $current"
+  return 1
+}
+
+# Geometry must be readable without settle: it waits for a drawn frame and
+# wedges while a button is held, which is exactly the state under test.
+cat >> "$UMBRIEL_CONFIG" <<'EOF'
+
+[animation]
+enabled = false
+
+[input]
+mod_right_double_click = "maximize"
+EOF
+"$UMBRIEL" msg config-reload > /dev/null
+
+# A window we close while the press is held. The press lands in the left third
+# so it proposes a resize edge and the deferred grab exists. The window's
+# lifetime is an IPC close plus a poll, never a wall-clock timer: under load a
+# timer can expire before the press and the check would pass without testing
+# anything.
+foot sh -c 'sleep 120' > /dev/null 2>&1 &
+await_count 1
+
+read -r x y < <(jq -r '.[0] | "\(.x + (.w * 0.2 | floor)) \(.y + (.h / 2 | floor))"' <<< "$("$UMBRIEL" windows --json)")
+window_id=$(jq -r '.[0].id' <<< "$("$UMBRIEL" windows --json)")
+pointer_hold "$OUTPUT_W" "$OUTPUT_H" \
+  move "$x" "$y" mod logo press "$BTN_RIGHT" mod none \
+  -- move $((x + 40)) $((y + 40)) release "$BTN_RIGHT" mod none
+
+# Kill the referenced window through IPC with the button still down.
+"$UMBRIEL" msg "window-close:$window_id" > /dev/null
+await_count 0
+
+# Fresh views are the most likely to reuse the freed storage the pending
+# record still points at; their geometry must survive the promotion either
+# way, and the compositor must survive the motion.
+for _ in $(seq 6); do
+  foot sh -c 'sleep 120' > /dev/null 2>&1 &
+done
+await_count 6
+await_stable_boxes
+before=$(boxes)
+
+# Motion past the click slop promotes the deferred grab.
+pointer_release
+
+after=$(boxes)
+if [[ $after != "$before" ]]; then
+  echo "the deferred press reached freed storage and moved a live window:"
+  echo "before: $before"
+  echo "after:  $after"
+  exit 1
+fi
+
+echo "a deferred Mod+right press is dropped when its view goes away"
