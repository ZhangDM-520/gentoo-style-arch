   void View::toggleMaximized() { setMaximized(m_tiled ? !scheduledMaximized() : !m_floatingMaximized); }
 
+  void View::toggleMaximizedLikeClientRequest() {
+    // The state a client would request from the opposite of the one it was
+    // given: the compositor-side toggle mirrors handleRequestMaximize's target
+    // selection without the client-request bookkeeping.
+    const bool requested = !(m_maximizedToEdges || scheduledMaximized() || m_floatingMaximized);
+    if (m_tiled && m_workspace != nullptr) {
+      if (maximizeRequestTargetsEdges(
+              requested, m_maximizedToEdges, m_workspace->layoutConfig().clientMaximize == ClientMaximize::Edges
+          )) {
+        setMaximizedToEdges(requested);
+        return;
+      }
+      setMaximized(requested);
+      return;
+    }
+    // A floating window keeps the default behavior whatever client_maximize
+    // says, but an active edges maximize still leaves first.
+    if (!requested && m_maximizedToEdges) {
+      setMaximizedToEdges(false);
+      return;
+    }
+    setMaximized(requested);
+  }
