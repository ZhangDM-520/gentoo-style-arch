+      // drop the maximize bookkeeping the toggle needs (see the pending struct
+      // in cursor.h). Motion promotes this to a real grab.
+      m_pendingModRightResize = PendingModRightResize{view, button, m_cursor->x, m_cursor->y};
       return;
     }
 
