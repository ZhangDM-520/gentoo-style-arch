diff --git a/docs/user/input.md b/docs/user/input.md
index 2fa0852..8f83657 100644
--- a/docs/user/input.md
+++ b/docs/user/input.md
@@ -22,6 +22,13 @@ dragging a client-side title bar or the empty tab strip of Chromium, Firefox,
 or Electron apps. Windows then move only with Mod+drag or keybinds.
 Resizing from client-side borders is unaffected.
 
+Mod+right-click drags a window's resize edge; a second Mod+right-click on the
+same window within the double-click window toggles maximize instead, with the
+same target a client's titlebar double-click picks: `client_maximize` decides
+between the column and the edges for a tiled window, and a floating window
+fills the usable area. A `Mod+MouseRight` keybind overrides the built-in
+button entirely.
+
 `window_drag_toggle` controls what pressing the other main mouse button does
 during a window drag:
 
diff --git a/src/input/cursor.cpp b/src/input/cursor.cpp
index e963473..8bfa213 100644
--- a/src/input/cursor.cpp
+++ b/src/input/cursor.cpp
@@ -1345,6 +1345,17 @@ namespace umbriel {
     processButton(event->time_msec, event->button, event->state);
   }
 
+  bool Cursor::modRightDoubleClick(uint32_t timeMsec, View* view) {
+    constexpr uint32_t kModRightDoubleClickMsec = 300;
+    constexpr double kModRightDoubleClickSlop = 8.0;
+    const bool doubleClick = m_lastModRightClick.view == view
+        && timeMsec - m_lastModRightClick.timeMsec <= kModRightDoubleClickMsec
+        && std::abs(m_cursor->x - m_lastModRightClick.x) <= kModRightDoubleClickSlop
+        && std::abs(m_cursor->y - m_lastModRightClick.y) <= kModRightDoubleClickSlop;
+    m_lastModRightClick = doubleClick ? ModRightClick{} : ModRightClick{timeMsec, m_cursor->x, m_cursor->y, view};
+    return doubleClick;
+  }
+
   void Cursor::processButton(uint32_t timeMsec, uint32_t button, wl_pointer_button_state state) {
     noteActivity();
     if (state == WL_POINTER_BUTTON_STATE_PRESSED) {
@@ -1570,6 +1581,16 @@ namespace umbriel {
     }
     if (button == BTN_RIGHT && modHeld && view != nullptr) {
       m_server->focusView(view, FocusReason::Grab);
+      // A second Mod+right-click on the same window within the double-click
+      // window toggles maximize with a titlebar double-click's semantics. The
+      // first click resized as always and its grab is already over.
+      if (modRightDoubleClick(timeMsec, view)) {
+        // No grab owns this press, so its release would reach the client
+        // unmatched; swallow both like the tab-bar path does.
+        m_swallowedButtons.push_back(button);
+        view->toggleMaximizedLikeClientRequest();
+        return;
+      }
       beginResize(view, view->tiled() ? 0 : floatResizeEdges(view), button);
       return;
     }
