+  std::optional<bool> Cursor::modRightDoubleClick(uint32_t timeMsec, View* view, bool wasMaximized) {
+    const bool doubleClick = m_lastModRightClick.view == view
+        && timeMsec - m_lastModRightClick.timeMsec <= kModRightDoubleClickMsec
+        && std::abs(m_cursor->x - m_lastModRightClick.x) <= kModRightDoubleClickSlop
+        && std::abs(m_cursor->y - m_lastModRightClick.y) <= kModRightDoubleClickSlop;
+    if (doubleClick) {
+      const bool firstPressWasMaximized = m_lastModRightClick.wasMaximized;
+      m_lastModRightClick = ModRightClick{};
+      return firstPressWasMaximized;
+    }
+    m_lastModRightClick = ModRightClick{timeMsec, m_cursor->x, m_cursor->y, view, wasMaximized};
+    return std::nullopt;
+  }
+
+  void Cursor::promotePendingModRightResize(double nextX, double nextY) {
+    if (!m_pendingModRightResize.has_value()) {
+      return;
+    }
+    const PendingModRightResize pending = *m_pendingModRightResize;
+    if (std::abs(nextX - pending.startX) <= kModRightDoubleClickSlop
+        && std::abs(nextY - pending.startY) <= kModRightDoubleClickSlop) {
+      return;
+    }
+    m_pendingModRightResize.reset();
+    // A drag is not a double-click's first press.
+    m_lastModRightClick = ModRightClick{};
+    beginResize(pending.view, pending.view->tiled() ? 0 : floatResizeEdges(pending.view), pending.button);
+  }
+
