pkgver() {
  cd "${_pkgname}"

  # Upstream tracks the version in a VERSION file (meson reads it through
  # `version: files('VERSION')`).
  local version
  version="$(tr -d '[:space:]' < VERSION)"
  printf '%s.r%s.%s' \
    "$version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${_pkgname}"

  # [input.gesture] travel_scale_horizontal/_vertical: three-finger swipes
  # move content along each axis at a configured travel (strip pans and
  # workspace switches, desktop and overview alike; below 1.0 covers less
  # ground per swipe) without touching pointer speed. Upstream PR
  # noctalia-dev/umbriel#566; while the recipe tracks
  # upstream main, rebase the patch with `git format-patch` from its scratch
  # branch when a drift breaks the apply. (0002, PR #508's windows_drag physics
  # tuning, merged upstream e045d637 and retired; 0003, PR #548's floating
  # release settle, merged upstream 0bb8befd and retired; 0004, PR #556's
  # hover_raises, merged upstream e57420b0 and retired; 0005/0006, perf PRs
  # #559/#560, rebuffed upstream and retired 2026-10-25; 0007, the
  # deform-settle-crop fix, retired the same day — it was cut on the 0005/0006
  # stack, and the main-based variant returns rebased when that thread
  # restarts; 0010, PR #569's wide columns, merged upstream 5e241f54 and
  # retired.)
  git apply -3 ../0008-strip-travel-scale.patch

  # Hot corners fire while the overview is open: the modal gate no longer
  # swallows corners behind the shell's exclusive-keyboard overview chrome
  # (Noctalia's type-to-launch capture), while a real modal on the desktop, a
  # closing overview, and fullscreen suppression stay suppressed. Upstream PR
  # noctalia-dev/umbriel#568; same refresh procedure. (Retire on merge: 0008 →
  # PR #566, 0009 → PR #568.)
  git apply -3 ../0009-hot-corner-overview.patch

  # Drag-release re-home waits for the deform settle (and the drag tree
  # demotes only when its last drag-presented view leaves). Upstream PR
  # noctalia-dev/umbriel#570; 0011-drag-deform-settle-crop.patch (sha256
  # 1d92976c…, full range 77ec5ae6..8a3c231d — three commits: the defer fix,
  # the review round, and the settle round; regenerate with
  # `git format-patch --stdout <merge-base>..pr-570` when a drift breaks the
  # apply). (Retire on merge: 0011 → PR #570.)
  git apply -3 ../0011-drag-deform-settle-crop.patch

  # [output] render_scale: per-output HiDPI supersampling — clients render at
  # the configured render_scale (fractional-scale protocol hint), unset
  # follows the output scale bit-identically, direct scanout declines while
  # render_scale != scale, and mirror scenes are isolated from render_scale
  # hints. Upstream PR noctalia-dev/umbriel#573; same refresh procedure
  # (0012-per-output-render-scale.patch, sha256 98b2ba72…, full range
  # d9497f36..0e484016 — four commits: feat + two review rounds + the X
  # rectangle P1 fix; rebased onto main d9497f36 on 2026-10-26). (Retire on
  # merge: 0012 → PR #573.)
  git apply -3 ../0012-per-output-render-scale.patch

  # [output] color_profile / sdr_gamut: ICC/EDID output characterization and
  # opt-in SDR gamut mapping (`"srgb"` confines untagged SDR to the sRGB gamut
  # in the panel's colorimetry; the default `"native"` stages no transform),
  # plus client ICC image descriptions (`create_icc`) and `icc_file`
  # advertising. Upstream issue noctalia-dev/umbriel#574; sha256 e51cef88….
  # Cut on top of 0008+0009+0011+0012 (cherry-pick of the main-based range
  # 76477c29..c1fdc062 — six commits; 0012 collisions in docs/user/outputs.md
  # and tests/unit/config_schema.cpp hand-merged, both sides kept). The
  # upstream-able branch stays main-based for the PR; regenerate from plain
  # main once 0008/0009/0011/0012 retire. (Retire on merge.)
  git apply -3 ../0013-icc-gamut.patch

  # [output] downsample texel footprint: the capped-downsample pass averages
  # the texel footprint in raster space (review fixes: capped-downsample
  # raster-space pinning, and the downsample policy applied to window-capture
  # mirrors). Upstream PR noctalia-dev/umbriel#575; sha256 6bfc6151….
  # CUT AS A SLICE on top of 0012: PR #575 is stacked on #573's head, so the
  # range is 0e484016..f75b2161 (three commits) — never 76477c29..pr-575,
  # which would duplicate 0012. Regenerate with
  # `git format-patch --stdout 0e484016..pr-575` when a drift breaks the
  # apply. #573 rebased onto main d9497f36 (head 0e484016) on 2026-10-26 and
  # the slice was re-cut on that base (sha256 6bfc6151…); if a later #573
  # force-update breaks the slice again, refresh 0012 to
  # <merge-base>..<#573-head> and re-cut the slice on the new head.
  # (Retire on merge: 0014 → PR #575, with its 0012 base → PR #573.)
  git apply -3 ../0014-downsample-box.patch

  # [input.gesture] unaccelerated gesture deltas: swipe tracking reads the
  # unaccelerated pointer deltas (selectSwipeDelta warning-clean fix, plus a
  # clang-format round). Upstream PR noctalia-dev/umbriel#577; sha256
  # 5fc4cb98…. Cut on top of 0008..0014 (cherry-pick of the main-based range
  # 76477c29..971a1ead — three commits; the 0008 collision in
  # tests/unit/gesture_physics.cpp union-merged, both test blocks kept). The
  # upstream-able branch stays main-based for the PR; regenerate from plain
  # main once 0008 retires. (Retire on merge: 0015 → PR #577.)
  git apply -3 ../0015-unaccel-gesture-deltas.patch

  # [effects] border effects on unfocused windows: opt-in border styling for
  # unfocused views (config keys in [effects], rule evaluation in
  # src/view/effects_rules.cpp). Upstream PR noctalia-dev/umbriel#580; sha256
  # cbccab7c…, full range 76477c29..ca657214 (one commit); regenerate with
  # `git format-patch --stdout <merge-base>..pr-580`.
  # (Retire on merge: 0016 → PR #580.)
  git apply -3 ../0016-border-unfocused.patch
}

build() {
  # House style: mold linker when available (mold-git does not provide 'mold').
  command -v mold >/dev/null 2>&1 && export LDFLAGS+=" -fuse-ld=mold"

  local meson_flags=(
    -Db_ndebug=true
    -Djemalloc=enabled
  )

  # PGO (meson tier): instrument -> train -> use. The profile work dir sits
  # OUTSIDE the build dir (mesa precedent): DW_AT_comp_dir equals the build
  # dir, and the payload gate's literal predicate would otherwise risk
  # false-matching debug info.
  local _pgo_dir="$srcdir/pgo-profiles"
  mkdir -p "$_pgo_dir"
  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1 strips -flto: generate-mode bookkeeping and LTO whole-program
  # codegen interact badly (same as the C-autotools tier). And
  # -fprofile-generate=<dir> must stay SYMMETRIC with phase 2's
  # -fprofile-use=<dir>: profiles are looked up as
  # <dir>/<mangled-object-path>.gcda, so a bare generate paired with
  # use=<dir> misses every profile and silently compiles a profile-less
  # build (2026-10-19 GCC probe; the xorg-xwayland-git spelling is such a
  # miss — see docs/NOTE.md 2026-10-19).
  local _gen_cflags="" _gen_cxxflags="" _gen_ldflags="" _flag
  for _flag in $_final_cflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_cxxflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cxxflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_ldflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_ldflags+=" $_flag" ;;
    esac
  done

  CFLAGS="${_gen_cflags# } -fprofile-generate=$_pgo_dir"
  CXXFLAGS="${_gen_cxxflags# } -fprofile-generate=$_pgo_dir"
  LDFLAGS="${_gen_ldflags# } -fprofile-generate=$_pgo_dir"

  # -Dtests/-Dtest_ipc are enabled ONLY for the training phase: a release
  # build compiles nothing but the compositor and its data otherwise
  # (PACKAGING.md). Phase 2 switches them back off so no test or harness-IPC
  # target is even compiled into the final build.
  arch-meson "${_pkgname}" build-release "${meson_flags[@]}" \
    -Db_lto=false -Dtests=enabled -Dtest_ipc=enabled
  meson compile -C build-release

  # Training run: the upstream suite is the broadest coverage upstream ships
  # (the unit battery plus the umbrielfx checks). A failing trainer is
  # tolerated — the floor guard below turns a thin profile into a plain
  # build. The CLI paths always exit through main(), so they flush profile
  # data even when no test ran.
  pgo_train_meson build-release 120
  local _bin="build-release/${_pkgname}"
  "$_bin" config schema --json >/dev/null 2>&1 || true
  "$_bin" config validate -c "${_pkgname}/examples/config.toml" >/dev/null 2>&1 || true
  "$_bin" --version >/dev/null 2>&1 || true
  "$_bin" --help >/dev/null 2>&1 || true

  # Floor guard: pgo_min_gcda ≈ the minimum distinct translation units the
  # training must touch before a profile is worth trusting; at or below it
  # the profile is too thin and the recipe falls back to a plain (LTO-only)
  # build rather than shipping a half-trained one.
  local pgo_min_gcda=50
  local _gcda_count
  _gcda_count="$(find "$_pgo_dir" -name '*.gcda' 2>/dev/null | wc -l)"
  if (( _gcda_count < pgo_min_gcda )); then
    warning "PGO produced only %d gcda files — rebuilding plain (LTO only)" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "${_pkgname}" build-release \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build-release -Db_lto=true -Dtests=disabled -Dtest_ipc=disabled
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    # Phase 2: profile-used build. Tolerance flags are load-bearing
    # (docs/MEMORY.md §4): -Wno-error=missing-profile keeps a TU the training
    # never ran a warning instead of a hard error; -Wno-error=coverage-mismatch
    # downgrades GCC's arc-count mismatch the same way — those functions
    # compile without profile data, everything else keeps the real profile,
    # and the payload stays uninstrumented either way. No
    # -fprofile-correction: the house pattern (cmake-git, glib2-git) does not
    # use it.
    CFLAGS="$_final_cflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile -Wno-error=coverage-mismatch"
    CXXFLAGS="$_final_cxxflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile -Wno-error=coverage-mismatch"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "${_pkgname}" build-release \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build-release -Db_lto=true -Dtests=disabled -Dtest_ipc=disabled
  fi

  meson compile -C build-release
}

package() {
  meson install -C build-release --destdir "${pkgdir}"

  # PACKAGING.md's installed layout: the MIT license travels in the upstream
  # tree and lands beside the payload.
  install -Dm644 "${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may
  # be added to $pkgdir after the payload is verified. The extra literal is
  # this recipe's PGO work dir: a generate-flag leak would bake it into a
  # shipped binary.
  verify_no_profile_instrumentation "$pkgdir" "$srcdir/pgo-profiles"
}
