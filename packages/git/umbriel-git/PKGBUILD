pkgver() {
  cd "${_pkgname}"

  # Upstream tracks the version in a VERSION file (meson reads it through
  # `version: files('VERSION')`).
  local version
  version="$(tr -d '[:space:]' < VERSION)"
  printf '%s.r%s.%s' \
    "$version" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "${_pkgname}"

  # Drag-release re-home waits for the deform settle (and the drag tree
  # demotes only when its last drag-presented view leaves). Upstream PR
  # noctalia-dev/umbriel#570; 0011-drag-deform-settle-crop.patch (sha256
  # 797d118d…, ONE squashed patch — `git diff upstream/main..HEAD` at the merge
  # 15dc93b8 on main@ad46c7d1, 13 files +1150/-9 — because the branch style is
  # merge commits and the per-commit stream conflicts on intermediate hunks once
  # main moves (the cursor.cpp tab-group region did). The union in resetMode keeps
  # landTabGroup before closeReleaseRehomeWindow: the wait covers every reparent
  # the release issues, and the disarm ends the release's say). The 2026-11-07
  # commits end a release wait when the workspace stops presenting the view
  # (deactivation, gesture slideBegin), let a held window keep its drag
  # presentation, make a dragged window's transient children ride it, keep that
  # ride's visibility ownership through the settle and a pinned landing, run
  # attach's re-parent through setSceneParent, and land the wait before keyboard
  # activation and workspace transfers travel.
  # (0002, PR #508's
  # windows_drag physics tuning, merged upstream e045d637 and retired; 0003,
  # PR #548's floating release settle, merged
  # upstream 0bb8befd and retired; 0004, PR #556's hover_raises, merged
  # upstream e57420b0 and retired; 0005/0006, perf PRs #559/#560, rebuffed
  # upstream and retired 2026-10-25; 0007, the deform-settle-crop fix,
  # retired the same day — it was cut on the 0005/0006 stack, and the
  # main-based variant returns rebased when that thread restarts; 0008, PR
  # #566's travel_scale, rejected by the maintainer and retired 2026-10-30;
  # 0009, PR #568's hot-corner-overview, merged upstream e71c825b and
  # retired 2026-10-30; 0010, PR #569's wide columns, merged upstream
  # 5e241f54 and retired; 0015, PR #577's unaccelerated gesture deltas,
  # rejected by the maintainer and retired 2026-10-30; 0017, PR #584's
  # overview card drag input, merged upstream eae7e8fb and retired
  # 2026-11-02; 0016, PR #580's border_unfocused, merged upstream 43146f7d
  # and retired 2026-11-05.) (Retire on merge: 0011 → PR #570.)
  git apply -3 ../0011-drag-deform-settle-crop.patch

  # [output] render_scale: per-output HiDPI supersampling — clients render at
  # the configured render_scale (fractional-scale protocol hint), unset
  # follows the output scale bit-identically, direct scanout declines while
  # render_scale != scale, and mirror scenes are isolated from render_scale
  # hints. Upstream PR noctalia-dev/umbriel#573. Fullscreen windows and game
  # or video content render at `scale` instead (direct scanout stays), and a
  # `supersample` window rule decides outright either way. Native-resolution
  # X11 uses the physical output scale by default; force_x11_supersample opts
  # back into render_scale. Flattened PR head 43573f4d (render_scale + X11
  # default + dMopp's 1b4a4801 exemption fold + hardened harness leg + review
  # fixes) relative to main@ad46c7d1 on top of 0011; delta 41 files,
  # +1161/-80; sha256 36442c0a…. The whole-patch review round moved the
  # neutral 1.0 scale floor from clientRenderScale() to the hint so IPC, logs
  # and the X11 mapping report the configured value, took the hint as the max
  # across a surface's outputs, broke X11 placement ties toward the furthest
  # predecessor, and pinned the post-map content-type and render_scale-only
  # reload re-hints.
  # (Retire on merge:
  # 0012 → PR #573.)
  git apply -3 ../0012-per-output-render-scale.patch

  # [output] color_profile / sdr_gamut: ICC/EDID output characterization and
  # opt-in SDR gamut mapping (`"srgb"` confines untagged SDR to the sRGB gamut
  # in the panel's colorimetry; the default `"native"` stages no transform),
  # plus client ICC image descriptions (`create_icc`) and `icc_file`
  # advertising. Upstream PR noctalia-dev/umbriel#585; 0013-icc-gamut.patch
  # Flattened downstream stack adaptation on main@ad46c7d1 over 0011+0012,
  # preserving the ICC fields, upstream screen_cast_effect, and both capture
  # and ICC harness helpers. Re-cut 2026-11-08 for the round-3 review: the ICC
  # byte charge follows the payload's lifetime (surface states copy the store),
  # the per-client budget is pruned when its wl_client goes away, only exactly
  # representable transfer curves (sRGB, gamma 2.2) are accepted for imported
  # profiles and `set_tf_power`, profiles whose RGB TRCs differ are refused, and
  # the user docs split from the design notes. Delta 44 files, +6094/-108;
  # sha256 772767ef…. (Retire on merge.)
  git apply -3 ../0013-icc-gamut.patch

  # [output] downsample texel footprint: the capped-downsample pass averages
  # the texel footprint in raster space (review fixes: capped-downsample
  # raster-space pinning, and the downsample policy applied to window-capture
  # mirrors). Upstream PR noctalia-dev/umbriel#575;
  # 0014-downsample-box.patch: flattened downstream stack adaptation. Re-cut
  # 2026-11-08 on main@ad46c7d1 over 0011+0012+0013 to carry dMopp's ba92c1d3
  # plus the round-2 review fixes: box_tf carries the pass's target curve so a
  # linear target is not decoded as gamma 2.2, an SDR passthrough box draw is
  # sRGB (the swapchain curve, not the output's gamma 2.2), the clamp variant
  # is judged by the source extents, the box programs are freed, a sampling-only
  # reload no longer rebuilds view chrome, capture mirrors repaint on the mode
  # change, the docs claim is scoped to the 4x4 grid, and three new pins cover
  # the source-box predicate, the box curve, and a live capture reload. Delta
  # 29 files, +857/-36; sha256 99ae6cbc53708c78e4dd7fc0fb19507ac6db4e1f2a873ff185a106225d6564e5….
  # (Retire on merge: 0014 → PR #575, with its 0012 base → PR #573.)
  git apply -3 ../0014-downsample-box.patch

  # [layout] underfull_strip: a scrolling strip narrower than the viewport
  # rests at its start, in the centre, or at its end, replacing the
  # `layout.scrolling.center_underfull_strip` boolean (breaking: the removed
  # key warns `unknown key`, and the docs map true -> "center", false ->
  # "start"). Placement is a whole-strip property and the value names are
  # axis-neutral so vertical strips read correctly. Resize gestures follow:
  # an end-aligned fitting strip refuses the last column's trailing edge and
  # trades width across interior boundaries, while centre keeps its symmetric
  # growth, and a corner drag keeps its cross-axis half. Upstream PR
  # noctalia-dev/umbriel#713, five commits
  # (d1c4c53/7eec2b3/33680fa/b001a86/57c27d3) on main@aa3b6b3; sha256 da533d36….
  # (KEPT DOWNSTREAM: the maintainer declined the change on 2026-11-07 and the
  # PR is closed unmerged, so this patch has no upstream to retire against.)
  git apply -3 ../0018-underfull-strip-align.patch

  # [appearance.blur] client_requests + ext_background_effect_v1: applications
  # (GTK4 terminals such as Zashterminal) name the part of their own surface
  # that should show the blurred backdrop. The global is advertised with the
  # blur capability; the requested surface-local region becomes a node clip on
  # the blur node its owner already keeps, so the transparency mask stays
  # aligned. Toplevels, popups and layer surfaces forward the committed region;
  # an empty region means no blur, no request leaves the rule in charge, and
  # client_requests = false keeps the global advertised while ignoring
  # requests. Upstream PR noctalia-dev/umbriel#715;
  # 0019-background-effect.patch (re-cut at b2141da6: an unmapped popup keeps
  # its blur hidden, plus the harness note on frame-callback barriers; Talia
  # P2 on #715): flattened downstream
  # stack adaptation on
  # main@aa3b6b3e over 0011+0012+0013+0014+0018 (delta 34 files, +1782/-63,
  # sha256 2afaf966…; the only downstream conflict is server.h's
  # ColorDescription declarations next to BackgroundEffectManager).
  # CONTRIBUTING hunk re-cut 2026-11-07 for upstream ad46c7d1's condensed
  # "Never wait on the wall clock" bullet: same frame-callback sentence,
  # inserted into the new one-line rule instead of the old bullet list.
  # (Retire on merge: 0019 -> PR #715.)
  git apply -3 ../0019-background-effect.patch

  # [appearance.title_bar] color_source: the bar paints itself with a 1-4 row
  # strip (color_source_height, one row by default) of the window's own content
  # ("window"), or with that strip's mean colour ("average"), instead of
  # [colors.title_bar] background, follows repaints live, keeps the palette
  # as the fallback under a transparent edge, dims when unfocused, and gives
  # the title and symbols a contrast edge. "window" mirrors the window's
  # committed buffer (crop, transform, damage, syncobj, ICC) and costs a strip
  # copy per commit; "average" reads that strip back once per repaint of it,
  # after the frame is reported ready. Stack adaptation on main@ad46c7d1 over
  # 0011+0012+0013+0014+0018+0019 (13 commits, sha256 cbcd201a…; the strip
  # follows xdg window geometry, marks the mirror's client-buffer lock
  # ignorable through a new umbrielfx helper, and keeps the close snapshot's
  # fill under the text and buttons).
  # (Retire on merge: 0020 -> PR #735.)
  git apply -3 ../0020-adaptive-title-bar.patch

  # [animation.windows_minimize]: a minimizing floating window leaves and returns with an animation instead of
  # vanishing in one frame: `style` (popin scale/fade), `scale` and an `anchor` (center, left, right, top_center,
  # bottom_center), on the live view, with the semantic state (minimized/visible/focus/taskbars) immediate and the
  # node disabled only when the fade lands. Six commits cut on main@ad46c7d1 and applied unchanged on top of
  # 0011+0012+0013+0014+0018+0019+0020; sha256 4bc48f1e…. (Retire on merge: 0021 -> the minimize animation PR.)
  git apply -3 ../0021-minimize-animation.patch
}

build() {
  # House style: mold linker when available (mold-git does not provide 'mold').
  command -v mold >/dev/null 2>&1 && export LDFLAGS+=" -fuse-ld=mold"

  local meson_flags=(
    -Db_ndebug=true
    -Djemalloc=enabled
  )

  # PGO (meson tier): instrument -> train -> use. The profile work dir sits
  # OUTSIDE the build dir (mesa precedent): DW_AT_comp_dir equals the build
  # dir, and the payload gate's literal predicate would otherwise risk
  # false-matching debug info.
  # Start the profile dir empty. A reused srcdir (makepkg --noextract) would
  # otherwise carry the previous revision's gcda into this build, and
  # -fprofile-use would read arc counts for code that no longer exists — the
  # -Wcoverage-mismatch shape, but silent and stale rather than expected.
  # Same idiom as mold-git.
  local _pgo_dir="$srcdir/pgo-profiles"
  rm -rf "$_pgo_dir"
  mkdir -p "$_pgo_dir"
  local _final_cflags="$CFLAGS"
  local _final_cxxflags="$CXXFLAGS"
  local _final_ldflags="$LDFLAGS"

  # Phase 1 strips -flto: generate-mode bookkeeping and LTO whole-program
  # codegen interact badly (same as the C-autotools tier). And
  # -fprofile-generate=<dir> must stay SYMMETRIC with phase 2's
  # -fprofile-use=<dir>: profiles are looked up as
  # <dir>/<mangled-object-path>.gcda, so a bare generate paired with
  # use=<dir> misses every profile and silently compiles a profile-less
  # build (2026-10-19 GCC probe; the xorg-xwayland-git spelling is such a
  # miss — see docs/NOTE.md 2026-10-19).
  local _gen_cflags="" _gen_cxxflags="" _gen_ldflags="" _flag
  for _flag in $_final_cflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_cxxflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_cxxflags+=" $_flag" ;;
    esac
  done
  for _flag in $_final_ldflags; do
    case "$_flag" in
      -flto*) ;;
      *) _gen_ldflags+=" $_flag" ;;
    esac
  done

  CFLAGS="${_gen_cflags# } -fprofile-generate=$_pgo_dir"
  CXXFLAGS="${_gen_cxxflags# } -fprofile-generate=$_pgo_dir"
  LDFLAGS="${_gen_ldflags# } -fprofile-generate=$_pgo_dir"

  # -Dtests/-Dharness are enabled ONLY for the training phase: a release
  # build compiles nothing but the compositor and its data otherwise
  # (PACKAGING.md). Phase 2 switches them back off so no test or harness-IPC
  # target is even compiled into the final build.
  #
  # The dir is purged first: a reused srcdir (a plain `makepkg -f` retry)
  # still holds the previous run's build-release, and `meson setup` on a
  # configured dir only prints "Directory already configured." — the
  # instrument leg then reuses phase 2's profile-use options, produces no
  # gcda at all, and the floor guard silently falls back to a plain build.
  rm -rf build-release
  arch-meson "${_pkgname}" build-release "${meson_flags[@]}" \
    -Db_lto=false -Dtests=enabled -Dharness=enabled
  meson compile -C build-release

  # Training run: the upstream suite is the broadest coverage upstream ships
  # (the unit battery plus the umbrielfx checks). A failing trainer is
  # tolerated — the floor guard below turns a thin profile into a plain
  # build. The CLI paths always exit through main(), so they flush profile
  # data even when no test ran.
  pgo_train_meson build-release 120
  local _bin="build-release/${_pkgname}"
  "$_bin" config schema --json >/dev/null 2>&1 || true
  "$_bin" config validate -c "${_pkgname}/examples/config.toml" >/dev/null 2>&1 || true
  "$_bin" --version >/dev/null 2>&1 || true
  "$_bin" --help >/dev/null 2>&1 || true

  # Floor guard: pgo_min_gcda ≈ the minimum distinct translation units the
  # training must touch before a profile is worth trusting; at or below it
  # the profile is too thin and the recipe falls back to a plain (LTO-only)
  # build rather than shipping a half-trained one.
  local pgo_min_gcda=50
  local _gcda_count
  _gcda_count="$(find "$_pgo_dir" -name '*.gcda' 2>/dev/null | wc -l)"
  if (( _gcda_count < pgo_min_gcda )); then
    warning "PGO produced only %d gcda files — rebuilding plain (LTO only)" "$_gcda_count"
    CFLAGS="$_final_cflags"
    CXXFLAGS="$_final_cxxflags"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "${_pkgname}" build-release \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build-release -Db_lto=true -Dtests=disabled -Dharness=disabled
  else
    msg "PGO profile: %d gcda files — rebuilding with profile" "$_gcda_count"
    # Phase 2: profile-used build. Tolerance flags are load-bearing
    # (docs/MEMORY.md §4): -Wno-error=missing-profile keeps a TU the training
    # never ran a warning instead of a hard error; -Wno-error=coverage-mismatch
    # downgrades GCC's arc-count mismatch the same way — those functions
    # compile without profile data, everything else keeps the real profile,
    # and the payload stays uninstrumented either way. The expected mismatch
    # here is structural: -Dharness=enabled is phase-1-only, so every
    # UMBRIEL_HARNESS block inside ipc.cpp (dispatchRequest,
    # notifyOutputFrame) changes that TU's arc counts between the legs. No
    # -fprofile-correction: the house pattern (cmake-git, glib2-git) does not
    # use it.
    CFLAGS="$_final_cflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile -Wno-error=coverage-mismatch"
    CXXFLAGS="$_final_cxxflags -fprofile-use=$_pgo_dir -Wno-error=missing-profile -Wno-error=coverage-mismatch"
    LDFLAGS="$_final_ldflags"
    meson setup --reconfigure "${_pkgname}" build-release \
      -Dc_args="$CFLAGS" \
      -Dcpp_args="$CXXFLAGS" \
      -Dc_link_args="$LDFLAGS" \
      -Dcpp_link_args="$LDFLAGS"
    meson configure build-release -Db_lto=true -Dtests=disabled -Dharness=disabled
  fi

  meson compile -C build-release
}

package() {
  meson install -C build-release --destdir "${pkgdir}"

  # PACKAGING.md's installed layout: the MIT license travels in the upstream
  # tree and lands beside the payload.
  install -Dm644 "${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"

  # Fatal shared gate (lib/pgo.sh) — last statement on purpose: nothing may
  # be added to $pkgdir after the payload is verified. The extra literal is
  # this recipe's PGO work dir: a generate-flag leak would bake it into a
  # shipped binary.
  verify_no_profile_instrumentation "$pkgdir" "$srcdir/pgo-profiles"
}
