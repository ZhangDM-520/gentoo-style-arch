 meson.build                                 | 14 +++++
 src/input/gesture_physics.h                 | 19 ++++++
 src/input/gestures.cpp                      | 26 +++++---
 src/server/ipc_commands.cpp                 | 37 ++++++++++-
 tests/harness/checks/input/swipe_unaccel.sh | 70 +++++++++++++++++++++
 tests/unit/gesture_physics.cpp              | 22 +++++++
 7 files changed, 181 insertions(+), 9 deletions(-)
 create mode 100755 tests/harness/checks/input/swipe_unaccel.sh

diff --git a/docs/user/input.md b/docs/user/input.md
index 89e68433..bf62feb8 100644
--- a/docs/user/input.md
+++ b/docs/user/input.md
@@ -162,6 +162,8 @@ scroll_factor = { horizontal = 2.0, vertical = 1.5 }
 
 This factor changes continuous two-finger application scrolling. Overview navigation uses the factors documented in [Workspaces Overview](workspaces-overview.md#settings-and-behavior).
 
+Three-finger swipe travel reads the touchpad's unaccelerated gesture deltas when the wlroots in use carries them, so the distance a swipe covers no longer grows with finger speed and `accel_profile`/`sensitivity` no longer change how far a swipe travels. On a wlroots without the unaccelerated deltas (or in a nested session, whose protocol has no such source), swipes consume the accelerated deltas as before. Swipe distance therefore changes once the unaccelerated feed becomes active for setups that tuned around the old speed-dependent travel with a `flat` profile or a low `sensitivity`; retune those to taste.
+
 ### Mouse
 
 ```toml
diff --git a/meson.build b/meson.build
index 66d1c42e..e19ff889 100644
--- a/meson.build
+++ b/meson.build
@@ -78,6 +78,20 @@ if test_ipc_opt.enabled() or (test_ipc_opt.auto() and get_option('buildtype') ==
   add_project_arguments('-DUMBRIEL_TEST_IPC', language: 'cpp')
 endif
 
+# wlroots carrying unaccelerated gesture deltas (upstream patch, or a release
+# that includes it): the gesture pipeline consumes the unaccelerated pair so
+# swipe travel no longer depends on finger speed. Stock 0.20.x lacks the
+# fields and compiles the accelerated fallback.
+wlr_has_unaccel_gesture = cpp.has_member(
+  'struct wlr_pointer_swipe_update_event',
+  'unaccel_dx',
+  prefix: '#define WLR_USE_UNSTABLE\n#include <wlr/types/wlr_pointer.h>',
+  dependencies: wlroots_dep,
+)
+if wlr_has_unaccel_gesture
+  add_project_arguments('-DUMBRIEL_WLR_GESTURE_UNACCEL', language: 'cpp')
+endif
+
 if cpp.get_define('WLR_HAS_SESSION', prefix: '#include <wlr/config.h>', dependencies: wlroots_dep) != '1'
   error('Umbriel requires wlroots built with session support')
 endif
diff --git a/src/input/gesture_physics.h b/src/input/gesture_physics.h
index 4c6565cd..bd365f78 100644
--- a/src/input/gesture_physics.h
+++ b/src/input/gesture_physics.h
@@ -15,6 +15,25 @@ namespace umbriel {
     // Travel in either direction before a gesture commits to one axis.
     static constexpr double kAxisLock = 16.0;
 
+    // The delta pair a swipe consumes. libinput accelerates gesture deltas and can also report them unaccelerated;
+    // wlroots carries both pairs when it has an unaccelerated source (UMBRIEL_WLR_GESTURE_UNACCEL) and sets the
+    // unaccelerated pair equal to the accelerated one otherwise. Travel on the unaccelerated pair matches niri and
+    // keeps swipe distance independent of finger speed.
+    struct DeltaPair {
+      double dx, dy;
+    };
+
+    [[nodiscard]] static constexpr DeltaPair
+    selectSwipeDelta(double dx, double dy, double unaccelDx, double unaccelDy) {
+#ifdef UMBRIEL_WLR_GESTURE_UNACCEL
+      return {unaccelDx, unaccelDy};
+#else
+      (void)unaccelDx;
+      (void)unaccelDy;
+      return {dx, dy};
+#endif
+    }
+
     // Past either end of a step the fingers keep moving while the content lags further and further behind: the extra
     // travel approaches `limit` steps without ever reaching it, and the derivative of that curve is how much of the
     // visible speed a release still carries.
diff --git a/src/input/gestures.cpp b/src/input/gestures.cpp
index 6b2360a6..f4ee2f24 100644
--- a/src/input/gestures.cpp
+++ b/src/input/gestures.cpp
@@ -35,6 +35,17 @@ namespace umbriel {
       return libinput_device_config_scroll_get_natural_scroll_enabled(device) != 0 ? 1 : -1;
     }
 
+    // The delta pair the gesture pipeline consumes. wlroots carries the unaccelerated pair when it has an
+    // unaccelerated source (UMBRIEL_WLR_GESTURE_UNACCEL); reading the same feed niri reads keeps swipe travel
+    // independent of finger speed. The client-forwarded pair stays accelerated (State::Forward).
+    GesturePhysics::DeltaPair swipeDelta(const wlr_pointer_swipe_update_event* event) {
+#ifdef UMBRIEL_WLR_GESTURE_UNACCEL
+      return GesturePhysics::selectSwipeDelta(event->dx, event->dy, event->unaccel_dx, event->unaccel_dy);
+#else
+      return GesturePhysics::selectSwipeDelta(event->dx, event->dy, event->dx, event->dy);
+#endif
+    }
+
   } // namespace
 
   // trampolines (same pattern as Cursor)
@@ -387,6 +398,7 @@ namespace umbriel {
 
   void Gestures::handleSwipeUpdate(void* data) {
     auto* event = static_cast<wlr_pointer_swipe_update_event*>(data);
+    const GesturePhysics::DeltaPair delta = swipeDelta(event);
     m_server->notifyInputActivity();
     if (m_server->sessionLocked()) {
       silentCancel();
@@ -404,8 +416,8 @@ namespace umbriel {
       return;
 
     case State::Pending: {
-      m_accumX += event->dx;
-      m_accumY += event->dy;
+      m_accumX += delta.dx;
+      m_accumY += delta.dy;
       const double maxAccum = std::max(std::abs(m_accumX), std::abs(m_accumY));
       if (maxAccum < GesturePhysics::kAxisLock) {
         return; // Not enough travel to decide axis.
@@ -470,7 +482,7 @@ namespace umbriel {
         m_state = State::Switch;
         // The travel that decided the axis is this gesture's first reading, so the slide moves with the fingers from
         // the frame the lock happens instead of after it.
-        updateSwitch(m_workspaceAxis == WorkspaceAxis::Horizontal ? event->dx : event->dy, event->time_msec);
+        updateSwitch(m_workspaceAxis == WorkspaceAxis::Horizontal ? delta.dx : delta.dy, event->time_msec);
       }
       return;
     }
@@ -478,7 +490,7 @@ namespace umbriel {
     case State::Scroll: {
       // Natural: fingers move against the strip axis → content follows them. The strip runs
       // unclamped, past its edges included; the release resolves the overscroll.
-      updateScroll(m_scrollVertical ? event->dy : event->dx, event->time_msec);
+      updateScroll(m_scrollVertical ? delta.dy : delta.dx, event->time_msec);
       return;
     }
 
@@ -492,7 +504,7 @@ namespace umbriel {
         m_state = State::Idle;
         return;
       }
-      updateSwitch(m_workspaceAxis == WorkspaceAxis::Horizontal ? event->dx : event->dy, event->time_msec);
+      updateSwitch(m_workspaceAxis == WorkspaceAxis::Horizontal ? delta.dx : delta.dy, event->time_msec);
       return;
     }
 
@@ -507,7 +519,7 @@ namespace umbriel {
         return;
       }
       overview->updateNavigation(
-          -event->dx * m_naturalScrollDirection, -event->dy * m_naturalScrollDirection, event->time_msec
+          -delta.dx * m_naturalScrollDirection, -delta.dy * m_naturalScrollDirection, event->time_msec
       );
       return;
     }
@@ -520,7 +532,7 @@ namespace umbriel {
       }
       // Swipe up opens, swipe down closes; base is where the gesture started.
       const double base = m_overviewWasOpen ? 1.0 : 0.0;
-      m_overviewTracker.push(-event->dy, event->time_msec);
+      m_overviewTracker.push(-delta.dy, event->time_msec);
       const double p = GesturePhysics::rubberBand(
           base + m_overviewTracker.pos() / kOverviewDistancePx, 0.0, 1.0, GesturePhysics::kOverscrollLimit
       );
diff --git a/src/server/ipc_commands.cpp b/src/server/ipc_commands.cpp
index 573fd132..e8252676 100644
--- a/src/server/ipc_commands.cpp
+++ b/src/server/ipc_commands.cpp
@@ -1293,21 +1293,42 @@ namespace umbriel {
     std::string phase;
     uint32_t time = 0;
     double dx = 0, dy = 0;
+    double unaccelDx = 0, unaccelDy = 0;
     int cancelled = 0;
+    bool haveUnaccel = false;
     input >> phase >> time;
     if (phase == "update") {
       input >> dx >> dy;
+      // The unaccelerated pair is optional and defaults to the accelerated pair, so every existing caller stays
+      // bit-identical: update <ms> <dx> <dy> [unaccel_dx unaccel_dy]. A divergent pair makes the delta source the
+      // gesture pipeline consumes observable. A failed probe means "no pair given" and must not fail the parse —
+      // unless the stream was already unhealthy (then the error below reports it).
+      const bool healthyBefore = !input.fail();
+      if (input >> unaccelDx) {
+        input >> unaccelDy;
+        haveUnaccel = true;
+      } else if (healthyBefore) {
+        input.clear();
+      }
     } else if (phase == "end") {
       input >> cancelled;
     }
+    if (!haveUnaccel) {
+      unaccelDx = dx;
+      unaccelDy = dy;
+    }
     std::string extra;
     if (input.fail()
         || (input >> extra)
         || !std::isfinite(dx)
         || !std::isfinite(dy)
+        || !std::isfinite(unaccelDx)
+        || !std::isfinite(unaccelDy)
         || (phase != "begin" && phase != "update" && phase != "end")
         || (cancelled != 0 && cancelled != 1)) {
-      return nlohmann::json{{"err", "expected begin <ms>, update <ms> <dx> <dy>, or end <ms> <cancelled:0|1>"}};
+      return nlohmann::json{
+          {"err",
+           "expected begin <ms>, update <ms> <dx> <dy> [unaccel_dx unaccel_dy], or end <ms> <cancelled:0|1>"}};
     }
     wlr_cursor* cursor = server.cursor()->wlr();
     if (phase == "begin") {
@@ -1315,6 +1336,12 @@ namespace umbriel {
       wl_signal_emit_mutable(&cursor->events.swipe_begin, &event);
     } else if (phase == "update") {
       wlr_pointer_swipe_update_event event{.pointer = nullptr, .time_msec = time, .fingers = 3, .dx = dx, .dy = dy};
+#ifdef UMBRIEL_WLR_GESTURE_UNACCEL
+      // Explicitly assigned: designated initializers zero-fill omitted members, and the degrade contract is that the
+      // unaccelerated pair equals the accelerated pair when a backend has no unaccelerated source.
+      event.unaccel_dx = unaccelDx;
+      event.unaccel_dy = unaccelDy;
+#endif
       wl_signal_emit_mutable(&cursor->events.swipe_update, &event);
     } else {
       wlr_pointer_swipe_end_event event{.pointer = nullptr, .time_msec = time, .cancelled = cancelled != 0};
@@ -1322,10 +1349,16 @@ namespace umbriel {
     }
     Output* output = server.outputFromWlr(server.preferredOutput());
     WorkspaceGroup* group = output != nullptr ? output->workspaceGroup() : nullptr;
+#ifdef UMBRIEL_WLR_GESTURE_UNACCEL
+    constexpr bool unaccelSupport = true;
+#else
+    constexpr bool unaccelSupport = false;
+#endif
     return nlohmann::json{
         {"ok",
          {{"progress", group != nullptr ? group->slideProgress() : 0.0},
-          {"reveal", group != nullptr && group->revealActive()}}}
+          {"reveal", group != nullptr && group->revealActive()},
+          {"unaccel_support", unaccelSupport}}}
     };
   }
 
diff --git a/tests/harness/checks/input/swipe_unaccel.sh b/tests/harness/checks/input/swipe_unaccel.sh
new file mode 100755
index 00000000..3989cd5a
--- /dev/null
+++ b/tests/harness/checks/input/swipe_unaccel.sh
@@ -0,0 +1,70 @@
+#!/usr/bin/env bash
+# Synthetic swipes with a deliberately divergent accelerated/unaccelerated delta pair pin the source the gesture
+# pipeline consumes: travel follows the unaccelerated pair when the wlroots in use carries it (niri parity, swipe
+# distance independent of finger speed) and the accelerated pair on stock wlroots, and the release lands where that
+# travel projects.
+set -euo pipefail
+source "$UMBRIEL_HARNESS_LIB"
+
+# One workspace of switch travel: gestures.cpp kSwipeWorkspacePx, niri's WORKSPACE_GESTURE_MOVEMENT.
+step=300
+
+cat > "$UMBRIEL_CONFIG" <<'CONFIG'
+[general]
+xwayland = false
+show_cheatsheet = false
+autostart = []
+
+[animation]
+enabled = false
+
+[output."HEADLESS-1"]
+workspace_axis = "vertical"
+CONFIG
+"$UMBRIEL" msg config-reload > /dev/null
+
+for n in 1 2 3; do
+  "$UMBRIEL" msg "workspace-switch:$n" > /dev/null
+  "$UMBRIEL" settle
+  "$UMBRIEL_UNMAP_CLIENT" "swipe-unaccel-$n" 400 400 > "$UMBRIEL_RUNTIME_DIR/$n.log" 2>&1 &
+  await_lines "$UMBRIEL_RUNTIME_DIR/$n.log" mapped 1
+done
+"$UMBRIEL" msg workspace-switch:2 > /dev/null
+"$UMBRIEL" settle
+
+active_index() { "$UMBRIEL" workspaces --json | jq -r '.[] | select(.active) | .index'; }
+[[ $(active_index) == 2 ]]
+
+swipe() { "$UMBRIEL" swipe-test "$@" --json; }
+
+swipe begin 0 > /dev/null
+# Cross the 16 px axis lock vertically; this event's pairs are equal, so it only decides the axis.
+swipe update 100 0 16 > /dev/null
+# Divergent pair: the accelerated delta is 200, the unaccelerated one 80. Travel must follow the source this build
+# consumes — 16 + 80 or 16 + 200 finger pixels, in steps of $step.
+divergent=$(swipe update 250 0 200 0 80)
+support=$(jq -r '.unaccel_support' <<< "$divergent")
+progress=$(jq -r '.progress' <<< "$divergent")
+expected=0.32
+if [[ $support != true ]]; then
+  expected=0.72
+fi
+magnitude=$(jq -r 'if . < 0 then -. else . end' <<< "$progress")
+awk -v got="$magnitude" -v want="$expected" 'BEGIN { exit !(got > want - 0.002 && got < want + 0.002) }' || {
+  echo "swipe travel followed the wrong delta source: |progress|=$magnitude, expected $expected (unaccel_support=$support)"
+  exit 1
+}
+
+# The release window trims the axis-lock sample, so the projection is the raw travel and lands on the nearest
+# workspace step: 0.32 of a step stays put, 0.72 crosses to the neighbour on the side the travel points to.
+swipe end 280 0
+target=$(awk -v p="$progress" 'BEGIN { print int(p + (p >= 0 ? 0.5 : -0.5)) }')
+expected_index=$((2 + target))
+for _ in $(seq 60); do
+  [[ $(active_index) == "$expected_index" ]] && break
+  sleep 0.05
+done
+[[ $(active_index) == "$expected_index" ]] || {
+  echo "release landed on workspace $(active_index), expected $expected_index (progress $progress)"
+  exit 1
+}
diff --git a/tests/unit/gesture_physics.cpp b/tests/unit/gesture_physics.cpp
index 3b8d4a68..d5a29377 100644
--- a/tests/unit/gesture_physics.cpp
+++ b/tests/unit/gesture_physics.cpp
@@ -162,4 +162,26 @@ UMBRIEL_TEST(travelScalesApplyPerAxisAcrossRoles) {
   CHECK(scroll.viewport == 500.0);
 }
 
+UMBRIEL_TEST(swipeDeltasComeFromTheUnacceleratedSourceWhenTheBuildCarriesIt) {
+  // The pair the gesture pipeline consumes is a pure selection over four doubles: the unaccelerated pair when the
+  // wlroots in use carries it (UMBRIEL_WLR_GESTURE_UNACCEL), the accelerated pair otherwise.
+#ifdef UMBRIEL_WLR_GESTURE_UNACCEL
+  const auto pair = GesturePhysics::selectSwipeDelta(2.0, 3.0, 1.0, -1.0);
+  CHECK_EQ(pair.dx, 1.0);
+  CHECK_EQ(pair.dy, -1.0);
+#else
+  const auto pair = GesturePhysics::selectSwipeDelta(2.0, 3.0, 1.0, -1.0);
+  CHECK_EQ(pair.dx, 2.0);
+  CHECK_EQ(pair.dy, 3.0);
+#endif
+}
+
+UMBRIEL_TEST(aBackendWithoutAnUnacceleratedSourceDegradesToTheAcceleratedPair) {
+  // The degrade contract: a backend with no unaccelerated source sets the pair equal to dx/dy, so the selection is
+  // the same on every build and today's behaviour survives unchanged.
+  const auto pair = GesturePhysics::selectSwipeDelta(2.0, 3.0, 2.0, 3.0);
+  CHECK_EQ(pair.dx, 2.0);
+  CHECK_EQ(pair.dy, 3.0);
+}
+
 int main() { return RUN_TESTS(); }
