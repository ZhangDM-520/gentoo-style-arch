From fc0241073f8e29a0be4a848d8e52899c46ba9115 Mon Sep 17 00:00:00 2001
From: ZhangDM-520 <jixianqiang1540@gmail.com>
Date: Mon, 26 Oct 2026 13:13:29 +0800
Subject: [PATCH 2/3] fix(input): keep selectSwipeDelta warning-clean on
 feature builds

The UMBRIEL_WLR_GESTURE_UNACCEL branch left dx/dy unused, tripping
-Wunused-parameter at warning_level=2 in every TU including the header.
Symmetric (void) casts on both branches; behavior unchanged.

Review: one LOW finding (code-review, one-review-depth convention).

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/input/gesture_physics.h | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/input/gesture_physics.h b/src/input/gesture_physics.h
index bd365f78..29cbc503 100644
--- a/src/input/gesture_physics.h
+++ b/src/input/gesture_physics.h
@@ -26,6 +26,8 @@ namespace umbriel {
     [[nodiscard]] static constexpr DeltaPair
     selectSwipeDelta(double dx, double dy, double unaccelDx, double unaccelDy) {
 #ifdef UMBRIEL_WLR_GESTURE_UNACCEL
+      (void)dx;
+      (void)dy;
       return {unaccelDx, unaccelDy};
 #else
       (void)unaccelDx;
