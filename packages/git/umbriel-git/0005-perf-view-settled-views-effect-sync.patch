From dda3114d3095c8b4cb256c409699f96baf11b713 Mon Sep 17 00:00:00 2001
From: ZhangDM-520 <jixianqiang1540@gmail.com>
Date: Sun, 25 Oct 2026 16:39:23 +0800
Subject: [PATCH] perf(view): skip settled views in the animation tick's effect
 sync
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

View::tickAnimations ran syncAnimationEffects() unconditionally for every
registered view every tick, but effect bindings carry a copy of each
animation's progress — a frame that moved nothing re-bound nothing new. The
per-tick sync now runs only when something progresses (or a bound drag slot,
live layout motion, unmapped view, persistent effects, or a registry change
demands it), and every non-tick snap/cancel path (cancelFadeAnimation,
cancelPositionAnimation, setLayoutTarget, animateTo, beginResizeAnimation,
setFullscreen, showDecorations) re-syncs when it stops an animation, so the
gate cannot leave a binding frozen at partial progress.

EffectRegistry gains a generation counter — bumped on active() 0-1
transitions (prepare, clear, setSuspended, updateInstance, removeInstance,
removeOutput) — so a static view notices a config reload recompiling its
shaders and re-binds. The generation capture lives inside
syncAnimationEffects so a direct mutator's sync is not repeated next tick.

Measured (pinned rig, cores 0-3, governor set, reps under one load window):
rendering cell 1578/1631 ms task-clock vs 1644/1709 base (both treatment
reps below both base reps; host noise floor ~5%); interactive cell parity
(expected — everything progresses there). Meson units 142/142; harness
382/385 with the three pre-existing base failures (animation/drag_toggle,
effect/selection, output/two_output_containment). A companion candidate —
eagerly warming fontconfig's FcInit on a startup thread — was implemented,
measured, and reverted: the parse is one-shot at first text draw, and the
warm thread taxed text-free sessions by ~600 ms of CPU inside the boot
window for no measured benefit.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/scene/effect_registry.cpp | 23 ++++++++++++++-
 src/scene/effect_registry.h   |  4 +++
 src/view/view.h               |  2 ++
 src/view/view_animation.cpp   | 54 ++++++++++++++++++++++++++++++++++-
 src/view/view_chrome.cpp      |  4 +++
 src/view/view_state.cpp       |  3 ++
 6 files changed, 88 insertions(+), 2 deletions(-)

diff --git a/src/scene/effect_registry.cpp b/src/scene/effect_registry.cpp
index 44f85b67..468d834b 100644
--- a/src/scene/effect_registry.cpp
+++ b/src/scene/effect_registry.cpp
@@ -129,6 +129,7 @@ vec4 animation(vec2 uv) {
     m_inPlaceReferenced = false;
     m_cursorActive = false;
     m_renderer = nullptr;
+    ++m_generation;
   }
 
   void EffectRegistry::updateCursorActive() {
@@ -149,13 +150,20 @@ vec4 animation(vec2 uv) {
   void EffectRegistry::setSuspended(bool suspended) {
     m_ledger.setSuspended(suspended);
     updateCursorActive();
+    ++m_generation;
   }
 
   void EffectRegistry::removeOutput(const Output* output) {
+    const bool wasActive = m_ledger.active() > 0;
     m_ledger.removeOutput(output);
     if (m_pointerWlrOutput == output->wlr()) {
       m_pointerWlrOutput = nullptr;
     }
+    // Views skip effect re-syncs while their own state stands still; the first
+    // and last active instances change what a settled view's sync would apply.
+    if (wasActive != (m_ledger.active() > 0)) {
+      ++m_generation;
+    }
   }
 
   void EffectRegistry::referencedNames(std::vector<std::string>& names) const {
@@ -282,6 +290,7 @@ vec4 animation(vec2 uv) {
     for (const auto& output : m_server->outputs()) {
       wlr_output_schedule_frame(output->wlr());
     }
+    ++m_generation;
   }
 
   void EffectRegistry::applyOutputEffects() {
@@ -312,7 +321,13 @@ vec4 animation(vec2 uv) {
 
   void EffectRegistry::updateInstance(const void* owner, const EffectInstanceState& state) {
     const unsigned before = m_ledger.eligible(state.output);
+    const bool wasActive = m_ledger.active() > 0;
     m_ledger.update(owner, state);
+    // Views skip effect re-syncs while their own state stands still; the first
+    // and last active instances change what a settled view's sync would apply.
+    if (wasActive != (m_ledger.active() > 0)) {
+      ++m_generation;
+    }
     if (before == 0 && m_ledger.eligible(state.output) > 0) {
       for (const auto& output : m_server->outputs()) {
         if (output.get() == state.output) {
@@ -322,7 +337,13 @@ vec4 animation(vec2 uv) {
     }
   }
 
-  void EffectRegistry::removeInstance(const void* owner) { m_ledger.remove(owner); }
+  void EffectRegistry::removeInstance(const void* owner) {
+    const bool wasActive = m_ledger.active() > 0;
+    m_ledger.remove(owner);
+    if (wasActive != (m_ledger.active() > 0)) {
+      ++m_generation;
+    }
+  }
 
   void EffectRegistry::retainRequirements(const fx_effect_requirements& requirements) {
     m_retainedPersistent += requirements.persistent ? 1U : 0U;
diff --git a/src/scene/effect_registry.h b/src/scene/effect_registry.h
index 95578303..04ad07e6 100644
--- a/src/scene/effect_registry.h
+++ b/src/scene/effect_registry.h
@@ -65,6 +65,9 @@ namespace umbriel {
     ) const;
 
     [[nodiscard]] bool active() const { return m_ledger.active() > 0; }
+    // Bumped when the registry's shape changes (prepare, clear, suspend, or
+    // gaining/losing the last active instance) so a settled view knows to re-bind.
+    [[nodiscard]] uint64_t generation() const { return m_generation; }
     // Prepared programs and retained snapshots both keep rendering requirements alive.
     [[nodiscard]] bool persistentReferenced() const { return m_persistentReferenced || m_retainedPersistent > 0; }
     [[nodiscard]] bool inPlaceReferenced() const { return m_inPlaceReferenced || m_retainedInPlace > 0; }
@@ -118,6 +121,7 @@ namespace umbriel {
     EffectLedger m_ledger;
     EffectAudio m_audio{}; // bands and availability
     mutable uint64_t m_clockEpochMsec = 0;
+    uint64_t m_generation = 0;
     mutable bool m_clockEpochSet = false;
   };
 
diff --git a/src/view/view.h b/src/view/view.h
index 1f844b6b..bd0ef520 100644
--- a/src/view/view.h
+++ b/src/view/view.h
@@ -939,6 +939,8 @@ namespace umbriel {
     bool m_minimized = false;
     uint64_t m_minimizeSerial = 0;
     ViewEffects m_effects;
+    // The effect-registry generation this view last re-bound against (UINT64_MAX = never).
+    uint64_t m_effectSyncGeneration = UINT64_MAX;
     ViewPresentation m_presentation;
     DragPhysics m_dragPhysics;
     double m_dragPhysicsMsec = 0; // animation clock at the sheet's last tick
diff --git a/src/view/view_animation.cpp b/src/view/view_animation.cpp
index 3f600980..091c7934 100644
--- a/src/view/view_animation.cpp
+++ b/src/view/view_animation.cpp
@@ -36,8 +36,14 @@ namespace umbriel {
   void View::cancelPositionAnimation() {
     // Freeze wherever the node currently sits; callers use this to take over
     // positioning (drags, layout snaps) without a jump.
+    const bool wasAnimating = m_posX.animating() || m_posY.animating();
     m_posX.snap(layoutX());
     m_posY.snap(layoutY());
+    // A snapped tween stops reporting progress; re-sync so the tick's gate
+    // cannot leave the windows_move binding frozen at its last partial travel.
+    if (wasAnimating) {
+      syncAnimationEffects();
+    }
   }
 
   bool View::fadeComposited() const {
@@ -109,9 +115,15 @@ namespace umbriel {
   }
 
   void View::cancelFadeAnimation() {
+    const bool wasAnimating = m_fade.animating();
     m_fade.snap(1.0);
     dropOpeningInset();
     setFadeAlpha(1.0F);
+    // A snapped fade stops reporting progress; re-sync so the tick's gate
+    // cannot leave the in-flight fade binding frozen at its last partial progress.
+    if (wasAnimating) {
+      syncAnimationEffects();
+    }
   }
 
   bool View::tiledOpeningActive() const {
@@ -323,6 +335,7 @@ namespace umbriel {
     const wlr_box content = committedContentBox();
     m_presentation.snapTo(content.width, content.height);
     finishSizeAnimation();
+    syncAnimationEffects();
   }
 
   bool View::sizeGrabActive() const {
@@ -515,9 +528,13 @@ namespace umbriel {
     const auto& animation = config().animation;
     const auto& resize = animation.windowsResize;
     if (!animation.enabled || !resize.enabled) {
+      const bool wasAnimating = m_presentation.animating();
       m_presentation.setSize(width, height);
       m_presentation.snapTo(width, height);
       applyPresentedSize();
+      if (wasAnimating) {
+        syncAnimationEffects();
+      }
       return;
     }
     m_presentation.animateTo(width, height, resize.durationMs, resize.curve);
@@ -533,9 +550,13 @@ namespace umbriel {
 
   void View::setLayoutTarget(int x, int y) {
     const bool changed = layoutTargetX() != x || layoutTargetY() != y;
+    const bool wasAnimating = m_posX.animating() || m_posY.animating();
     m_posX.snap(x);
     m_posY.snap(y);
     m_positioned = true;
+    if (wasAnimating) {
+      syncAnimationEffects();
+    }
     if (m_mapped && !m_tiled && changed) {
       m_server->scheduleIpcWindowsEvent();
     }
@@ -719,8 +740,12 @@ namespace umbriel {
     const int fromX = layoutX();
     const int fromY = layoutY();
     if (fromX == x && fromY == y) {
+      const bool wasAnimating = m_posX.animating() || m_posY.animating();
       m_posX.snap(x);
       m_posY.snap(y);
+      if (wasAnimating) {
+        syncAnimationEffects();
+      }
       return;
     }
     const auto& animation = config().animation;
@@ -760,6 +785,7 @@ namespace umbriel {
       wlr_scene_node_clear_animations(&target->node);
       if (ownTrees) {
         m_dragSlotBound = false;
+        m_effectSyncGeneration = effectRegistry().generation();
       }
       if (border != nullptr) {
         wlr_scene_node_clear_animations(border);
@@ -837,10 +863,19 @@ namespace umbriel {
           .outputBox = output != nullptr ? output->layoutBox() : wlr_box{},
       });
     }
+    if (ownTrees) {
+      // tickAnimations skips re-syncs while the registry generation stands
+      // still; record what this sync actually applied so a direct mutator's
+      // sync is not repeated on the next tick.
+      m_effectSyncGeneration = effectRegistry().generation();
+    }
   }
 
   bool View::tickAnimations(double nowMsec) {
     bool active = false;
+    // Did anything move this frame? Effect bindings carry a copy of each
+    // animation's progress, so only progressing state needs a re-sync.
+    bool progressed = false;
 
     // Disable sibling size animations during a tiled resize, so they do not
     // trail the pointer while clients acknowledge successive configures.
@@ -851,6 +886,7 @@ namespace umbriel {
 
     const bool movedX = m_posX.tick(nowMsec);
     const bool movedY = m_posY.tick(nowMsec);
+    progressed = movedX || movedY;
     // A carried-speed spring settles on its own solver; stop it once no pixel can change.
     static_cast<void>(m_posX.finishSpringTail(1.0));
     static_cast<void>(m_posY.finishSpringTail(1.0));
@@ -868,6 +904,7 @@ namespace umbriel {
     }
 
     if (m_presentation.tick(nowMsec)) {
+      progressed = true;
       applyPresentedSize();
       if (Overview* overview = m_server->overview(); overview != nullptr && overview->active()) {
         overview->onViewPresentationChanged(this);
@@ -882,6 +919,7 @@ namespace umbriel {
     }
 
     if (m_fade.tick(nowMsec)) {
+      progressed = true;
       m_customFade = m_customFade
           && m_fade.animating()
           && effectRegistry().animationEffect(m_inScratchpad ? AnimationEvent::Scratchpad : AnimationEvent::WindowsIn)
@@ -928,15 +966,18 @@ namespace umbriel {
       active = active || m_fade.animating();
     }
     if (m_focusDim.tick(nowMsec)) {
+      progressed = true;
       setFadeAlpha(m_fadeAlpha);
       active = active || m_focusDim.animating();
     }
     if (m_modalShadeAlpha.tick(nowMsec)) {
+      progressed = true;
       syncModalShade();
       active = active || m_modalShadeAlpha.animating();
     }
 
     if (m_borderColorAnim.tick(nowMsec)) {
+      progressed = true;
       m_decoration.setBorderRawColor(m_borderColorAnim.current(), effectiveOpacity());
       active = active || m_borderColorAnim.animating();
     }
@@ -954,9 +995,20 @@ namespace umbriel {
         const int refreshMhz = output != nullptr ? output->wlr()->refresh : 0;
         const double cadenceS = refreshMhz > 0 ? 1000.0 / refreshMhz : 0.0;
         active = m_dragPhysics.tick(elapsed / 1000.0, cadenceS) || active;
+        progressed = true;
       }
     }
-    syncAnimationEffects();
+    // A bound drag slot, live layout motion, an unmapped view, persistent
+    // effects (whose apply carries the clock), or a registry move re-syncs
+    // every pass until settled.
+    if (progressed
+        || m_dragSlotBound
+        || m_layoutMotion
+        || !m_mapped
+        || m_effects.configured()
+        || m_effectSyncGeneration != effectRegistry().generation()) {
+      syncAnimationEffects();
+    }
     if (!active && m_mapped && m_xsurface != nullptr) {
       syncXwaylandConfigure();
     }
diff --git a/src/view/view_chrome.cpp b/src/view/view_chrome.cpp
index 6632d17e..19e4ebf6 100644
--- a/src/view/view_chrome.cpp
+++ b/src/view/view_chrome.cpp
@@ -212,6 +212,7 @@ namespace umbriel {
       m_workspace->tabs().memberChanged(this);
     }
     m_server->scheduleIpcWindowsEvent();
+    syncAnimationEffects();
   }
 
   void View::applyCornerRadius() {
@@ -324,6 +325,9 @@ namespace umbriel {
     applyCornerRadius();
     updateBlur();
     updateShadow();
+    // The border effect gate reads decorated(); refresh it even when no
+    // animation is progressing.
+    syncAnimationEffects();
   }
 
   void View::updateBorderGeometry() {
diff --git a/src/view/view_state.cpp b/src/view/view_state.cpp
index f86321a0..7ae52ffd 100644
--- a/src/view/view_state.cpp
+++ b/src/view/view_state.cpp
@@ -1094,5 +1094,8 @@ namespace umbriel {
       m_server->cursor()->invalidateHoverFocus();
     }
     refreshStateRuleEffects();
+    // The border effect gate reads scheduledFullscreen(); refresh it even when
+    // no animation is progressing (a frozen clock may never tick again).
+    syncAnimationEffects();
   }
 } // namespace umbriel
