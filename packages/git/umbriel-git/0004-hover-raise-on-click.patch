+  file.write("[input.focus]\nhover_raises = true\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().input.focus.hoverRaises);
+
+  file.write("[input.focus]\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().input.focus.hoverRaises);
+}
