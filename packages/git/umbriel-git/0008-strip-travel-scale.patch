diff --git a/src/input/swipe_tracker.h b/src/input/swipe_tracker.h
index 2cc47cbc..6adb5ff3 100644
--- a/src/input/swipe_tracker.h
+++ b/src/input/swipe_tracker.h
@@ -11,6 +11,18 @@ namespace umbriel {
   inline constexpr double kSwipeWorkspacePx = 300.0;
   inline constexpr double kSwipeViewportPx = 1200.0;
 
+  // The finger travel one viewport pan or workspace step needs, after the input.gesture.travel_scale_* value for
+  // its axis. Below 1.0 the same movement takes more finger travel, so a swipe covers less ground; 1.0 keeps the
+  // upstream distances. Travel is divided rather than the deltas multiplied so every conversion sees one
+  // convention.
+  [[nodiscard]] constexpr double swipeTravelPx(double travelPx, double travelScale) { return travelPx / travelScale; }
+
+  // Which axis's travel scale a movement along `vertical` reads. Shared by every swipe conversion (strip pan,
+  // workspace step, overview roles) so their picks cannot drift apart or swap arguments silently.
+  [[nodiscard]] constexpr double axisTravelScale(bool vertical, double horizontalScale, double verticalScale) {
+    return vertical ? verticalScale : horizontalScale;
+  }
+
   // Sliding-window swipe tracker. Accumulates deltas since the gesture start, estimates velocity over recent history
   // only, and projects where the movement would coast to a stop under exponential deceleration.
   class SwipeTracker {
diff --git a/src/overview/navigation.h b/src/overview/navigation.h
index 30d09078..00e1eed6 100644
--- a/src/overview/navigation.h
+++ b/src/overview/navigation.h
@@ -30,8 +30,24 @@ namespace umbriel {
     static constexpr Travel kScrollTravel{.workspace = 500.0, .viewport = 500.0};
     static constexpr Travel kSwipeTravel{.workspace = kSwipeWorkspacePx, .viewport = kSwipeViewportPx};
 
-    [[nodiscard]] static constexpr Travel travelFor(NavigationSource source) {
-      return source == NavigationSource::Scroll ? kScrollTravel : kSwipeTravel;
+    // Workspaces move along the workspace axis and the strip pan across it, so each role reads its own axis's
+    // travel scale — the same selection `axisTravelScale` gives the desktop conversions.
+    [[nodiscard]] static constexpr Travel travelFor(
+        NavigationSource source, bool horizontalWorkspaces = true, double horizontalScale = 1.0,
+        double verticalScale = 1.0
+    ) {
+      if (source == NavigationSource::Scroll) {
+        // The scroll stream arrives unaccelerated; only swipe travel is scaled.
+        return kScrollTravel;
+      }
+      return Travel{
+          .workspace = swipeTravelPx(
+              kSwipeTravel.workspace, axisTravelScale(!horizontalWorkspaces, horizontalScale, verticalScale)
+          ),
+          .viewport = swipeTravelPx(
+              kSwipeTravel.viewport, axisTravelScale(horizontalWorkspaces, horizontalScale, verticalScale)
+          ),
+      };
     }
 
     void reset() {
