diff --git a/tests/unit/config_load.cpp b/tests/unit/config_load.cpp
index 8a4e210c..06f9d515 100644
--- a/tests/unit/config_load.cpp
+++ b/tests/unit/config_load.cpp
@@ -1486,6 +1486,30 @@ UMBRIEL_TEST(hoverRaisesLoadsAndDefaultsEnabled) {
   CHECK(store.config().input.focus.hoverRaises);
 }
 
+UMBRIEL_TEST(stripTravelScaleLoadsAndDefaultsToUpstreamTravel) {
+  const TempConfig file;
+  ConfigStore& store = umbriel::configStore();
+  store.setRootPath(file.path(), true);
+
+  file.write("[input.gesture]\nstrip_travel_scale = 0.7\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().input.gesture.stripTravelScale == 0.7);
+  CHECK(!containsDiagnostic(store, "unknown key input.gesture.strip_travel_scale"));
+
+  file.write("[input.gesture]\nstrip_travel_scale = 2.0\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().input.gesture.stripTravelScale == 2.0);
+
+  file.write("[input.gesture]\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().input.gesture.stripTravelScale == 1.0);
+
+  file.write("[input.gesture]\nstrip_travel_scale = 0.0\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().input.gesture.stripTravelScale == 0.1);
+  CHECK(containsDiagnostic(store, "input.gesture.strip_travel_scale"));
+}
+
