diff --git a/tests/unit/gesture_physics.cpp b/tests/unit/gesture_physics.cpp
index 353fc93a..6ca65b4a 100644
--- a/tests/unit/gesture_physics.cpp
+++ b/tests/unit/gesture_physics.cpp
@@ -2,9 +2,13 @@
 
 #include "check.h"
 #include "input/swipe_tracker.h"
+#include "overview/navigation.h"
 
 using umbriel::GesturePhysics;
+using umbriel::NavigationSource;
+using umbriel::OverviewNavigation;
 using umbriel::SwipeTracker;
+using umbriel::swipeTravelPx;
 
 namespace {
 
@@ -130,4 +134,29 @@ UMBRIEL_TEST(theOverviewSettlesOnTheSideTheProjectionPointsTo) {
   CHECK_EQ(pastEnd.target, 1);
 }
 
+UMBRIEL_TEST(stripTravelScaleScalesSwipeTravelOnly) {
+  // 1.0 keeps the upstream distances: one viewport pan per kSwipeViewportPx, one step per kSwipeWorkspacePx.
+  CHECK(swipeTravelPx(1200.0, 1.0) == 1200.0);
+  const auto upstream = OverviewNavigation::travelFor(NavigationSource::Swipe, 1.0);
+  CHECK(upstream.viewport == 1200.0);
+  CHECK(upstream.workspace == 300.0);
+
+  // Below 1.0 a swipe covers less ground: the same pan needs proportionally more finger travel.
+  CHECK(swipeTravelPx(1200.0, 0.7) == 1200.0 / 0.7);
+  const auto scaled = OverviewNavigation::travelFor(NavigationSource::Swipe, 0.7);
+  CHECK(scaled.viewport == 1200.0 / 0.7);
+  const auto widened = OverviewNavigation::travelFor(NavigationSource::Swipe, 2.0);
+  CHECK(widened.viewport == 600.0);
+
+  // Workspace travel is NOT scaled: overview row swipes cover the same distance as the desktop workspace switch
+  // at any scale, so the hand reads one workspace step on either side of the overview.
+  CHECK(scaled.workspace == 300.0);
+  CHECK(widened.workspace == 300.0);
+
+  // The scroll stream arrives unaccelerated and keeps its own distances at any scale.
+  const auto scroll = OverviewNavigation::travelFor(NavigationSource::Scroll, 0.7);
+  CHECK(scroll.viewport == 500.0);
+  CHECK(scroll.workspace == 500.0);
+}
+
 int main() { return RUN_TESTS(); }
