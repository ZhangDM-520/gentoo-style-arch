diff --git a/src/input/swipe_tracker.h b/src/input/swipe_tracker.h
index 2cc47cbc..996d81bd 100644
--- a/src/input/swipe_tracker.h
+++ b/src/input/swipe_tracker.h
@@ -11,6 +11,11 @@ namespace umbriel {
   inline constexpr double kSwipeWorkspacePx = 300.0;
   inline constexpr double kSwipeViewportPx = 1200.0;
 
+  // The finger travel one viewport pan needs, after input.gesture.strip_travel_scale. Below 1.0 the same pan takes
+  // more finger travel, so a swipe covers less ground; 1.0 keeps the upstream distances. Travel is divided rather
+  // than the deltas multiplied so every conversion sees one convention.
+  [[nodiscard]] constexpr double swipeTravelPx(double travelPx, double travelScale) { return travelPx / travelScale; }
+
   // Sliding-window swipe tracker. Accumulates deltas since the gesture start, estimates velocity over recent history
   // only, and projects where the movement would coast to a stop under exponential deceleration.
   class SwipeTracker {
diff --git a/src/overview/navigation.h b/src/overview/navigation.h
index 30d09078..993f9f9a 100644
--- a/src/overview/navigation.h
+++ b/src/overview/navigation.h
@@ -30,8 +30,17 @@ namespace umbriel {
     static constexpr Travel kScrollTravel{.workspace = 500.0, .viewport = 500.0};
     static constexpr Travel kSwipeTravel{.workspace = kSwipeWorkspacePx, .viewport = kSwipeViewportPx};
 
-    [[nodiscard]] static constexpr Travel travelFor(NavigationSource source) {
-      return source == NavigationSource::Scroll ? kScrollTravel : kSwipeTravel;
+    [[nodiscard]] static constexpr Travel travelFor(NavigationSource source, double travelScale = 1.0) {
+      if (source == NavigationSource::Scroll) {
+        // The scroll stream arrives unaccelerated; only swipe travel is scaled.
+        return kScrollTravel;
+      }
+      // Only the viewport pan scales. Workspace travel is the same distance here and in the desktop workspace
+      // switch, so the hand reads one workspace step on either side of the overview at any scale.
+      return Travel{
+          .workspace = kSwipeTravel.workspace,
+          .viewport = swipeTravelPx(kSwipeTravel.viewport, travelScale),
+      };
     }
 
     void reset() {
