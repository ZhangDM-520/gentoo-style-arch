From f51e99b1afd5898d9c89aaa4d8376bcd0832af9d Mon Sep 17 00:00:00 2001
From: ZhangDM-520 <jixianqiang1540@gmail.com>
Date: Sat, 7 Nov 2026 20:50:26 +0800
Subject: [PATCH 7/8] fix(title_bar): never remember the mirrored client buffer

The ignore-lock mark was undone through a stored `wlr_client_buffer*`. Once the
client releases its buffer the scene drops its own lock, the client buffer can
be freed, and the next release would write to freed memory. Ask the scene buffer
which buffer it holds instead, as wlroots' own scene surface does, and do
nothing once the scene has let go.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 src/scene/ssd_frame.cpp | 16 +++++++++++++---
 src/scene/ssd_frame.h   |  3 ++-
 2 files changed, 15 insertions(+), 4 deletions(-)

diff --git a/src/scene/ssd_frame.cpp b/src/scene/ssd_frame.cpp
index 6a7e32a6..0a476bf3 100644
--- a/src/scene/ssd_frame.cpp
+++ b/src/scene/ssd_frame.cpp
@@ -170,11 +170,21 @@ namespace umbriel {
     updateAdaptive(true);
   }
 
-  void SsdFrame::ignoreLock(wlr_buffer* buffer) { m_ignoredBuffer = umbrielfx_scene_buffer_ignore_client_lock(buffer); }
+  void SsdFrame::ignoreLock(wlr_buffer* buffer) {
+    m_ignoredLock = umbrielfx_scene_buffer_ignore_client_lock(buffer) != nullptr;
+  }
 
   void SsdFrame::releaseIgnoredLock() {
-    umbrielfx_scene_buffer_drop_ignored_client_lock(m_ignoredBuffer);
-    m_ignoredBuffer = nullptr;
+    if (!m_ignoredLock) {
+      return;
+    }
+    m_ignoredLock = false;
+    // Ask the scene buffer which buffer it holds instead of remembering the client buffer: once the client releases
+    // it, the scene drops its lock and the client buffer can be freed, which would leave a remembered pointer
+    // dangling. Nothing to undo when the scene has already let go.
+    if (m_adaptive != nullptr && m_adaptive->buffer != nullptr) {
+      umbrielfx_scene_buffer_drop_ignored_client_lock(wlr_client_buffer_get(m_adaptive->buffer));
+    }
   }
 
   void SsdFrame::updateBlur() {
diff --git a/src/scene/ssd_frame.h b/src/scene/ssd_frame.h
index 148b86e4..45241beb 100644
--- a/src/scene/ssd_frame.h
