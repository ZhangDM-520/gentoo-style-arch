+  echo "the held window vanished with the workspace it was dragged from (green=$grabbed)"
+  exit 1
+fi
+if [[ $dropped != TWO ]]; then
+  echo "the drop did not land the window on the visible workspace: '$dropped', want TWO"
+  exit 1
+fi
