+
+  file.write("[[window_rule]]\nmatch.app_id = \"^wide$\"\ndefault_scrolling_extent = 1.5\n");
+  CHECK(store.reload().success);
+  CHECK(store.config().windowRules[0].defaultScrollingExtent.value_or(0.0) == 1.5);
+}
+
 int main() { return RUN_TESTS(); }
