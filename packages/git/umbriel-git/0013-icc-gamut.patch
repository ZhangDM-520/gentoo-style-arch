+    bool invert3x3(const double in[9], double out[9]) {
+      const double determinant = in[0] * (in[4] * in[8] - in[5] * in[7])
+          - in[1] * (in[3] * in[8] - in[5] * in[6])
+          + in[2] * (in[3] * in[7] - in[4] * in[6]);
