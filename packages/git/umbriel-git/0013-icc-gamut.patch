+      m_server->updateColorPreferences();
+      return;
+    }
+    m_sdrGamutTransform = ColorTransformPtr(transform);
+    kLog.info("output '{}': SDR gamut mapping active ({} into panel colorimetry)", m_output->name, source);
+    m_server->updateColorPreferences();
