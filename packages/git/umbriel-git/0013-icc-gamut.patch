+  CHECK(closeTo(umbriel::panelEncodeSample(gamma22, 0.5F), std::pow(0.5, 1.0 / 2.2), 1e-4));
+
+  CHECK_EQ(umbriel::panelEncodeSample(srgb, 0.0F), 0.0F);
+  CHECK_EQ(umbriel::panelEncodeSample(srgb, 1.0F), 1.0F);
