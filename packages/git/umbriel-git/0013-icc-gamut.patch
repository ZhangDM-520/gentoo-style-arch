diff --git a/src/output/colorimetry.cpp b/src/output/colorimetry.cpp
new file mode 100644
index 00000000..4d37932b
--- /dev/null
+++ b/src/output/colorimetry.cpp
@@ -0,0 +1,255 @@
+#include "output/colorimetry.h"
+
+#include "output/hdr_metadata.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <memory>
+
+extern "C" {
+#include <libdisplay-info/edid.h>
+#include <libdisplay-info/info.h>
+}
+
+namespace umbriel {
+
+  namespace {
+
+    // Encode-curve resolution for PanelTransfer::Kind::Curve and LUT baking.
+    constexpr size_t kCurveSamples = 256;
+    constexpr size_t kEncodeLutDim = 1024;
+
+    float srgbEncode(float linear) {
+      // Exact endpoints keep baked LUT ramps anchored at 0 and 65535.
+      if (linear >= 1.0F) {
+        return 1.0F;
+      }
+      return linear <= 0.0031308F ? 12.92F * linear : 1.055F * std::pow(linear, 1.0F / 2.4F) - 0.055F;
+    }
+
+    float clampedUnit(float value) { return std::clamp(value, 0.0F, 1.0F); }
+
+    wlr_color_cie1931_xy lerpXy(const wlr_color_cie1931_xy& from, const wlr_color_cie1931_xy& to, float amount) {
+      return {
+          .x = from.x + (to.x - from.x) * amount,
+          .y = from.y + (to.y - from.y) * amount,
+      };
+    }
+
+    std::vector<float> samplesFromEncode(float (*encode)(float, float), float shape) {
+      std::vector<float> samples(kCurveSamples);
+      for (size_t index = 0; index < kCurveSamples; ++index) {
+        const float linear = static_cast<float>(index) / static_cast<float>(kCurveSamples - 1);
+        samples[index] = encode(linear, shape);
+      }
+      return samples;
+    }
+
+    void identityMatrix(float matrix[9]) {
+      constexpr float identity[9] = {1, 0, 0, 0, 1, 0, 0, 0, 1};
+      std::copy(identity + 0, identity + 9, matrix);
+    }
+
+  } // namespace
+
+  void ColorTransformDeleter::operator()(wlr_color_transform* transform) const { wlr_color_transform_unref(transform); }
+
+  float panelEncodeSample(const PanelTransfer& transfer, float linear) {
+    const float x = clampedUnit(linear);
+    switch (transfer.kind) {
+    case PanelTransfer::Kind::Srgb:
+      return srgbEncode(x);
+    case PanelTransfer::Kind::Gamma22:
+      return std::pow(x, 1.0F / 2.2F);
+    case PanelTransfer::Kind::Curve:
+      break;
+    }
+    if (transfer.encode.empty()) {
+      return x;
+    }
+    const float position = x * static_cast<float>(transfer.encode.size() - 1);
+    const size_t lower = static_cast<size_t>(position);
+    const size_t upper = std::min(lower + 1, transfer.encode.size() - 1);
+    const float fraction = position - static_cast<float>(lower);
+    return transfer.encode[lower] + (transfer.encode[upper] - transfer.encode[lower]) * fraction;
+  }
+
+  std::vector<uint16_t> bakeEncodeLut(const PanelTransfer& transfer, size_t dim) {
+    std::vector<uint16_t> lut(std::max<size_t>(dim, 2));
+    for (size_t index = 0; index < lut.size(); ++index) {
+      const float linear = static_cast<float>(index) / static_cast<float>(lut.size() - 1);
+      const float encoded = std::clamp(panelEncodeSample(transfer, linear), 0.0F, 1.0F);
+      lut[index] = static_cast<uint16_t>(std::lround(encoded * 65535.0F));
+    }
+    return lut;
+  }
+
+  TransferFit fitTransfer(const PanelTransfer& transfer) {
+    switch (transfer.kind) {
+    case PanelTransfer::Kind::Srgb:
+      return {.kind = TransferFit::Kind::Srgb};
+    case PanelTransfer::Kind::Gamma22:
+      return {.kind = TransferFit::Kind::Gamma22};
+    case PanelTransfer::Kind::Curve:
+      break;
+    }
+    if (transfer.encode.size() < 2) {
+      // An empty sampled table is the identity encode, i.e. a linear EOTF.
+      return {.kind = TransferFit::Kind::Power, .exponent = 1.0F};
+    }
+    // Named fast paths first: an exact match is reported as the named curve,
+    // never as an approximating power fit. The power fit is log-log
+    // least squares through the origin for encode(x) = x^(1/e), i.e.
+    // log(encode) = (1/e) * log(x); endpoints are skipped because log(0).
+    constexpr float kMatchTolerance = 1e-3F;
+    bool matchesSrgb = true;
+    bool matchesGamma22 = true;
+    double sumXX = 0.0;
+    double sumXY = 0.0;
+    for (size_t index = 1; index < transfer.encode.size(); ++index) {
+      const float linear = static_cast<float>(index) / static_cast<float>(transfer.encode.size() - 1);
+      const float encoded = transfer.encode[index];
+      if (std::abs(encoded - srgbEncode(linear)) > kMatchTolerance) {
+        matchesSrgb = false;
+      }
+      if (std::abs(encoded - std::pow(linear, 1.0F / 2.2F)) > kMatchTolerance) {
+        matchesGamma22 = false;
+      }
+      if (encoded > 0.0F) {
+        const double logLinear = std::log(static_cast<double>(linear));
+        const double logEncoded = std::log(static_cast<double>(encoded));
+        sumXX += logLinear * logLinear;
+        sumXY += logLinear * logEncoded;
+      }
+    }
+    if (matchesSrgb) {
+      return {.kind = TransferFit::Kind::Srgb};
+    }
+    if (matchesGamma22) {
+      return {.kind = TransferFit::Kind::Gamma22};
+    }
+    // A degenerate table has no exponent to fit; linear is the least wrong
+    // declared shape and keeps the reported tf_power value meaningful.
+    const float slope = sumXX > 0.0 ? static_cast<float>(sumXY / sumXX) : 0.0F;
+    const float exponent = slope > 0.0F && std::isfinite(slope) ? 1.0F / slope : 1.0F;
+    return {.kind = TransferFit::Kind::Power, .exponent = exponent};
+  }
+
+  void sdrGamutMatrix(const wlr_color_primaries& panel, float wideness, float matrix[9]) {
+    wlr_color_primaries srgb{};
+    wlr_color_primaries_from_named(&srgb, WLR_COLOR_NAMED_PRIMARIES_SRGB);
+    const float amount = std::clamp(wideness, 0.0F, 1.0F);
+    if (amount <= 0.0F) {
+      // Strict sRGB interpretation: the plain sRGB -> panel mapping.
+      wlr_color_primaries_transform_absolute_colorimetric(&srgb, &panel, matrix);
+      return;
+    }
+    if (amount >= 1.0F) {
+      // Native: content is already in the panel's gamut, so the mapping is the
+      // identity and only the panel TRC would remain (the runtime stages
+      // nothing at all instead, see sdrGamutStaged).
+      identityMatrix(matrix);
+      return;
+    }
+    // Linear interpolation between the two gamuts (KWin's wideness semantics).
+    const wlr_color_primaries interp{
+        .red = lerpXy(srgb.red, panel.red, amount),
+        .green = lerpXy(srgb.green, panel.green, amount),
+        .blue = lerpXy(srgb.blue, panel.blue, amount),
+        .white = lerpXy(srgb.white, panel.white, amount),
+    };
+    wlr_color_primaries_transform_absolute_colorimetric(&interp, &panel, matrix);
+  }
+
+  wlr_color_transform* buildSdrGamutTransform(const PanelColorimetry& panel) {
+    float matrix[9];
+    sdrGamutMatrix(panel.primaries, 0.0F, matrix);
+    wlr_color_transform* matrixStage = wlr_color_transform_init_matrix(matrix);
+    if (matrixStage == nullptr) {
+      return nullptr;
+    }
+
+    wlr_color_transform* encodeStage = nullptr;
+    switch (panel.transfer.kind) {
+    case PanelTransfer::Kind::Srgb:
+      encodeStage = wlr_color_transform_init_linear_to_inverse_eotf(WLR_COLOR_TRANSFER_FUNCTION_SRGB);
+      break;
+    case PanelTransfer::Kind::Gamma22:
+      encodeStage = wlr_color_transform_init_linear_to_inverse_eotf(WLR_COLOR_TRANSFER_FUNCTION_GAMMA22);
+      break;
+    case PanelTransfer::Kind::Curve: {
+      const std::vector<uint16_t> lut = bakeEncodeLut(panel.transfer, kEncodeLutDim);
+      encodeStage = wlr_color_transform_init_lut_3x1d(lut.size(), lut.data(), lut.data(), lut.data());
+      break;
+    }
+    }
+    if (encodeStage == nullptr) {
+      wlr_color_transform_unref(matrixStage);
+      return nullptr;
+    }
+
+    wlr_color_transform* stages[2] = {matrixStage, encodeStage};
+    wlr_color_transform* pipeline = wlr_color_transform_init_pipeline(stages, 2);
+    wlr_color_transform_unref(matrixStage);
+    wlr_color_transform_unref(encodeStage);
+    return pipeline;
+  }
+
+  IccProfileStore iccStoreForFileProfile(std::span<const uint8_t> fileBytes) {
+    if (fileBytes.empty()) {
+      return {};
+    }
+    // The store is the file exactly as read: get_information advertises the
+    // profile the user configured, quirks and all.
+    return std::make_shared<const std::vector<uint8_t>>(fileBytes.begin(), fileBytes.end());
+  }
+
+  std::optional<PanelColorimetry>
+  panelColorimetryFromEdid(std::span<const uint8_t> edid, const wlr_color_primaries* defaultPrimaries) {
+    if (edid.empty() || defaultPrimaries == nullptr || !validDisplayPrimaries(*defaultPrimaries)) {
+      return std::nullopt;
+    }
+    std::unique_ptr<di_info, decltype(&di_info_destroy)> info(
+        di_info_parse_edid(edid.data(), edid.size()), di_info_destroy
+    );
+    if (!info) {
+      return std::nullopt;
+    }
+    const di_edid* parsed = di_info_get_edid(info.get());
+    if (parsed == nullptr) {
+      return std::nullopt;
+    }
+
+    PanelColorimetry panel{
+        .primaries = *defaultPrimaries,
+        .white = {defaultPrimaries->white.x, defaultPrimaries->white.y},
+        .transfer = {},
+    };
+    if (const di_edid_chromaticity_coords* coords = di_edid_get_chromaticity_coords(parsed); coords != nullptr
+        && std::isfinite(coords->white_x)
+        && std::isfinite(coords->white_y)
+        && coords->white_x > 0.0F
+        && coords->white_y > 0.0F
+        && coords->white_x + coords->white_y <= 1.0F) {
+      panel.white[0] = coords->white_x;
+      panel.white[1] = coords->white_y;
+    }
+    panel.primaries.white = {.x = panel.white[0], .y = panel.white[1]};
+
+    // EDID gamma is the decode exponent; its inverse is the panel encode.
+    // Unknown/implausible values fall back to the common 2.2 convention.
+    const float gamma = di_edid_get_basic_gamma(parsed);
+    if (std::isfinite(gamma) && std::abs(gamma - 2.2F) <= 0.01F) {
+      panel.transfer.kind = PanelTransfer::Kind::Gamma22;
+    } else if (std::isfinite(gamma) && gamma >= 1.0F && gamma <= 4.0F) {
+      panel.transfer.kind = PanelTransfer::Kind::Curve;
+      panel.transfer.encode =
+          samplesFromEncode([](float linear, float shape) { return std::pow(linear, 1.0F / shape); }, gamma);
+    } else {
+      panel.transfer.kind = PanelTransfer::Kind::Gamma22;
+    }
+    return panel;
+  }
+
+} // namespace umbriel
diff --git a/src/output/colorimetry.h b/src/output/colorimetry.h
new file mode 100644
index 00000000..4ac296c6
--- /dev/null
+++ b/src/output/colorimetry.h
@@ -0,0 +1,146 @@
+#pragma once
+
+// Panel colorimetry characterization and SDR gamut mapping (umbriel#574).
+// A PanelColorimetry describes what untagged SDR signal values mean to the
+// panel: its primaries, white point, and transfer curve. With that, "gamut
+// limiting" is a plain output transform that interprets untagged SDR as sRGB
+// and converts it into the panel's colorimetry.
+
+#include "config/config.h"
+#include "wlr_color.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <optional>
+#include <span>
+#include <string>
+#include <vector>
+
+namespace umbriel {
+
+  // How the panel encodes linear light into signal values (the inverse of its
+  // EOTF). Srgb and Gamma22 map to named inverse-EOTF stages in the renderer;
+  // Curve is a sampled encode curve baked into a 3x1D LUT.
+  struct PanelTransfer {
+    enum class Kind {
+      Srgb,
+      Gamma22,
+      Curve,
+    };
+    Kind kind = Kind::Srgb;
+    // Kind::Curve only: encode(i / (size - 1)) for linear inputs in [0, 1].
+    std::vector<float> encode;
+  };
+
+  struct PanelColorimetry {
+    wlr_color_primaries primaries;
+    // Panel white point (x, y); primaries.white mirrors it.
+    float white[2];
+    PanelTransfer transfer;
+  };
+
+  // Encode sample: linear light -> panel-encoded signal. For Curve the sampled
+  // encode table is linearly interpolated.
+  [[nodiscard]] float panelEncodeSample(const PanelTransfer& transfer, float linear);
+
+  // Fitted transfer characteristic of a parsed profile (umbriel#574 wave 4,
+  // wp_image_description_creator_icc_v1). Srgb and Gamma22 are exact named
+  // fast paths; Power is a parametric power fit in the protocol's
+  // set_tf_power/tf_power vocabulary: the EOTF exponent e with
+  // optical = electrical^e (the request's valid range is 1.0..10.0; a fit
+  // outside it is kept as fitted and only clamped by the buffer mapping).
+  struct TransferFit {
+    enum class Kind {
+      Srgb,
+      Gamma22,
+      Power,
+    };
+    Kind kind = Kind::Srgb;
+    // Kind::Power only: the fitted EOTF exponent.
+    float exponent = 0.0F;
+  };
+
+  // Fit a transfer curve to what the renderer can express. Non-representable
+  // TRCs are approximated by a power fit — full fidelity needs per-buffer
+  // 3D LUTs (a new render transform type), out of scope for umbriel#574.
+  [[nodiscard]] TransferFit fitTransfer(const PanelTransfer& transfer);
+
+  // The encode curve baked to uint16 LUT entries for
+  // wlr_color_transform_init_lut_3x1d (channel-agnostic; all channels share it).
+  [[nodiscard]] std::vector<uint16_t> bakeEncodeLut(const PanelTransfer& transfer, size_t dim);
+
+  // Output-side SDR gamut mapping matrix, generic over `wideness` in [0, 1]
+  // (KWin semantics: 0 = interpret untagged SDR strictly as sRGB, 1 = as the
+  // panel's native gamut, linear primary interpolation with the white fixed).
+  // Wave 1 maps SdrGamut to the endpoints only; intermediate values are the
+  // future slider's math and are never selected at runtime yet.
+  void sdrGamutMatrix(const wlr_color_primaries& panel, float wideness, float matrix[9]);
+
+  // The supplied scene transform for SDR gamut mapping: one matrix stage
+  // (sRGB -> panel, wideness 0) followed by the panel's encode stage (named
+  // inverse-EOTF or a baked 3x1D LUT). Returns NULL on allocation failure.
+  [[nodiscard]] wlr_color_transform* buildSdrGamutTransform(const PanelColorimetry& panel);
+
+  // The staging decision, factored out of Output: stage the SDR gamut
+  // transform only when a characterization is active, the policy is "srgb",
+  // and no HDR image description owns the output transform. "native" stages
+  // nothing at all so pixels stay bit-identical to an uncharacterized output.
+  [[nodiscard]] constexpr bool sdrGamutStaged(bool characterized, SdrGamut gamut, bool hdrActive) {
+    return characterized && gamut == SdrGamut::Srgb && !hdrActive;
+  }
+
+  struct IccParse {
+    // Empty when the profile is rejected or the build lacks ICC support.
+    std::optional<PanelColorimetry> colorimetry;
+    // Rejection reason, empty on success.
+    std::string error;
+    // Non-fatal notes (e.g. a vcgt tag that was ignored).
+    std::vector<std::string> warnings;
+  };
+
+  // Owning handle for a wlroots color transform.
+  struct ColorTransformDeleter {
+    void operator()(wlr_color_transform* transform) const;
+  };
+  using ColorTransformPtr = std::unique_ptr<wlr_color_transform, ColorTransformDeleter>;
+
+  // Which device classes the parser admits. Output characterization wants the
+  // display profile a factory shipped; wp_image_description_creator_icc_v1
+  // additionally allows the ICC ColorSpace class (color-management-v1.xml,
+  // set_icc_file: "the class must be Display or ColorSpace").
+  enum class IccClassScope {
+    DisplayOnly,
+    DisplayOrColorSpace,
+  };
+
+  // Parses an ICC v2/v4 matrix-shaper profile (rXYZ/gXYZ/bXYZ + wtpt +
+  // chad + rTRC/gTRC/bTRC). LUT profiles (A2B0/B2A0) and out-of-scope classes
+  // are rejected; a vcgt tag is ignored with a warning. Built without lcms2
+  // this always fails with an "unsupported" error.
+  [[nodiscard]] IccParse
+  parseIccProfile(std::span<const uint8_t> data, IccClassScope scope = IccClassScope::DisplayOnly);
+
+  // EDID-based characterization: colorants from the backend's default
+  // primaries, gamma and white point from the EDID. Empty EDID or missing
+  // primaries (nested/headless outputs) stays inert with nullopt.
+  [[nodiscard]] std::optional<PanelColorimetry>
+  panelColorimetryFromEdid(std::span<const uint8_t> edid, const wlr_color_primaries* defaultPrimaries);
+
+  // Raw ICC bytes advertised by get_information's icc_file for a characterized
+  // output (umbriel#574 wave 5). Shared because image descriptions snapshot
+  // the store: every information request on the same description must return
+  // the exact same data.
+  using IccProfileStore = std::shared_ptr<const std::vector<uint8_t>>;
+
+  // File characterization: the store keeps the exact bytes the parser accepted
+  // (the profile as written on disk, never a reserialization). Empty input
+  // stores nothing.
+  [[nodiscard]] IccProfileStore iccStoreForFileProfile(std::span<const uint8_t> fileBytes);
+
+  // Panel-only (EDID) characterization: the store synthesizes a matrix-shaper
+  // ICC (colorants + white + TRC) matching the panel colorimetry. A null panel
+  // (inert) stores nothing, and so does a build without lcms2 (no synthesis).
+  [[nodiscard]] IccProfileStore iccStoreForPanel(const PanelColorimetry* panel);
+
+} // namespace umbriel
