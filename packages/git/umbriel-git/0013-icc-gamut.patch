+        } else if (type == 0x70617261) { // 'para'
+          const uint16_t functionType = readU16At(data, tagOffset + 8);
+          constexpr uint32_t parameterCounts[5] = {1, 3, 4, 5, 7};
+          if (functionType > 4) {
