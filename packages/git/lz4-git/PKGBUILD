# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

pkgname=lz4-git
pkgver=1.10.0.r321.g0774d055
pkgrel=1
pkgdesc="Extremely Fast Compression algorithm"
arch=('i686' 'x86_64')
url="https://lz4.github.io/lz4/"
license=('BSD-2-Clause' 'GPL-2.0-or-later')
depends=('glibc')
makedepends=('git')
provides=("lz4=1:$pkgver" 'liblz4.so')
conflicts=('lz4')
options=('staticlibs')
source=("git+https://github.com/lz4/lz4.git")
sha256sums=('SKIP')


pkgver() {
  cd "lz4"

  _tag=$(git tag -l --sort -v:refname | sed '/rc[0-9]*/d' | head -n1)
  _rev=$(git rev-list --count $_tag..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^v//'
}

build() {
  cd "lz4"

  # Save original flags
  local _cflags_orig="$CFLAGS"
  local _cxxflags_orig="$CXXFLAGS"
  local _ldflags_orig="$LDFLAGS"

  # Phase 1: instrumented build (LTO off for speed)
  export CFLAGS="${_cflags_orig} -fprofile-generate=$(pwd)/pgo-profiles"
  export CXXFLAGS="${CXXFLAGS} -fprofile-generate=$(pwd)/pgo-profiles"
  export LDFLAGS="${_ldflags_orig} -fuse-ld=mold -fprofile-generate=$(pwd)/pgo-profiles"
  make clean 2>/dev/null || true
  make

  # Phase 2: training — compress/decompress with lz4 CLI
  msg "PGO Phase 2: training with lz4"
  local _testfile=$(mktemp)
  dd if=/dev/urandom of="$_testfile" bs=1M count=10 2>/dev/null || true
  ./lz4 -f "$_testfile" "$_testfile.lz4" 2>/dev/null || true
  ./lz4 -d -f "$_testfile.lz4" "$_testfile.dec" 2>/dev/null || true
  ./lz4 -f -9 "$_testfile" "$_testfile.lz4" 2>/dev/null || true
  ./lz4 -f --best "$_testfile" "$_testfile.lz4" 2>/dev/null || true
  rm -f "$_testfile" "$_testfile.lz4" "$_testfile.dec"

  # Verify profile data
  local gcda_count=$(find . -name '*.gcda' 2>/dev/null | wc -l)
  if [ "$gcda_count" -eq 0 ]; then
    warning "No profile data generated — falling back to LTO-only build"
    export CFLAGS="${_cflags_orig} -ffat-lto-objects"
    export CXXFLAGS="${_cxxflags_orig} -ffat-lto-objects"
    export LDFLAGS="${_ldflags_orig} -fuse-ld=mold"
    make clean 2>/dev/null || true
    make
    return 0
  fi
  msg "Profile data generated: $gcda_count .gcda files"

  # Phase 3: rebuild with profile + LTO
  export CFLAGS="${_cflags_orig} -ffat-lto-objects -fprofile-use=$(pwd)/pgo-profiles"
  export CXXFLAGS="${_cxxflags_orig} -ffat-lto-objects -fprofile-use=$(pwd)/pgo-profiles"
  export LDFLAGS="${_ldflags_orig} -fuse-ld=mold -fprofile-use=$(pwd)/pgo-profiles"
  make clean 2>/dev/null || true
  make
  rm -rf pgo-profiles
}

check() {
  cd "lz4"

  make test || true
}

package() {
  cd "lz4"

  make DESTDIR="$pkgdir" PREFIX="/usr" install
  install -Dm644 "lib/LICENSE" -t "$pkgdir/usr/share/licenses/lz4"
}
