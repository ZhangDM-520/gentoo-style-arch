# Maintainer: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan de Groot <jgc@archlinux.org>
# Recipe adapted for the gentoo-style-arch fleet; tracks upstream VCS directly.
# The AUR package of the same name was used as a reference only.

pkgname=freetype2-git
pkgver=2.14.3.r16.ga6d486002
pkgrel=1
pkgdesc="Font rasterization library (git build)"
url="https://www.freetype.org/"
arch=('x86_64')
license=('FTL OR GPL-2.0-or-later')
depends=('brotli' 'bzip2' 'glibc' 'libpng' 'zlib')
makedepends=('git' 'meson')
provides=("freetype2=$pkgver" 'libfreetype.so')
conflicts=('freetype2')
source=("git+https://gitlab.freedesktop.org/freetype/freetype.git")
b2sums=('SKIP')
# Upstream signs only its VER-* release tags, never branch commits, so a
# floating VCS source cannot carry `?signed` (makepkg verifies the unsigned
# tip -> SIGNATURE NOT FOUND, run #14 wall 2026-10-06). Owner trust ruling
# 2026-10-06: dropping `?signed` on a floating -git source is permitted —
# the sibling floating recipes (ninja-git, meson-git, wayland-git, …) never
# had it. If tag-pinned verification is wanted later, use
# `#tag=VER-<x>?signed` with Werner Lemberg's DSA key
# 58E0C111E39F5408C5D3EC76C1A60EACE707FDA5 — the actual signer of
# VER-2-13-3..VER-2-14-3 (git verify-tag; confirmed against
# freetype.org/download.html and Gentoo's openpgp-keys-wernerlemberg), NOT
# the AUR-referenced E30674707856409FF1948010BE6C3AAC63AD8E3F, which never
# signed these tags.

pkgver() {
  cd freetype

  git describe --long --tags --match 'VER-[0-9]*' | sed 's/^VER-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    # standalone library build: the freetype-demos superproject and the
    # AUR reference's Arch-specific patches are not carried (library recipe)
    -D brotli=enabled
    -D bzip2=enabled
    -D png=enabled
    -D zlib=enabled
    # harfbuzz is dlopen'ed at runtime (Arch convention) — also breaks the
    # freetype <-> harfbuzz build cycle for this git batch
    -D harfbuzz=dynamic
    # arch-meson's --auto-features enabled turns every feature option on;
    # freetype's hvf feature then errors on non-Apple (meson.build:429) and
    # tests (a feature, not a boolean) rejects a literal false — both were
    # latent until run #15 (2026-10-06)
    -D hvf=disabled
    -D tests=disabled
  )

  arch-meson freetype build "${meson_options[@]}"
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  meson install -C build --destdir "$pkgdir"

  install -Dm644 freetype/docs/FTL.TXT -t "$pkgdir/usr/share/licenses/$pkgname"
}
