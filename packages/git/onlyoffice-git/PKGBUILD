_set_flags() {
    # Upstream omits -std= in places, so g++ falls back to its own default and
    # the ancient V8 sources reject it.
    if [[ ! "$CXXFLAGS" =~ '-std=' ]]; then
        CXXFLAGS="$CXXFLAGS -std=gnu++11"
    fi
    # Some bundled dependencies still declare a pre-3.5 cmake_minimum_required.
    export CMAKE_POLICY_VERSION_MINIMUM=3.5
}

# makepkg does not abort on a failed command *inside* prepare() either: the
# function's status is its last command's, so a rejected hunk would go unnoticed
# and surface later as an unexplainable compile error — or, worse, as a build of
# the wrong sources. `-N` keeps patch non-interactive, so an already-applied
# patch is a clean failure rather than a prompt that waits forever.
_patch() {
    patch "$@" || { error "patch failed to apply: $*"; exit 1; }
}

# DesktopEditors' own tags are vX.Y.Z only; the build number lives in the
# modules, and `core` carries it. Do not use `git describe` here: upstream tags
# one commit with several build numbers (the pinned core commit carries
# v9.4.0.126, .127, .129 *and* .130), so describe returns an arbitrary one of
# them and would report 9.4.0.126 for a .130 tree. Ask which build tags point
# *at* HEAD and take the highest.
pkgver() {
    cd "$srcdir/core" || exit 1
    local _v
    _v="$(git tag --points-at HEAD 2>/dev/null |
        grep -E "^v${_oo_release//./\\.}\.[0-9]+$" | sort -V | tail -n1)"
    [[ -n "$_v" ]] || { error "no v${_oo_release}.<build> tag points at the pinned core commit"; exit 1; }
    printf '%s' "${_v#v}"
}

prepare() {
    _set_flags

    # makepkg's `error` prints but does not abort, so every assertion below ends
    # in `exit 1`; without it a stale pin sails on into a multi-hour build.
    _assert_tag() {
        git -C "$1" tag --points-at HEAD 2>/dev/null | grep -Fxq "$2" ||
            { error "$(basename "$1") is not tagged $2"; exit 1; }
    }

    # Every module is its own source because makepkg 7.1 has no submodule
    # support, and build_tools addresses them as bare sibling directories
    # (`../core`, `../desktop-apps`, ...). Fail loudly if a source was renamed,
    # rather than letting upstream error out mid-build.
    local _module
    for _module in core desktop-apps desktop-sdk sdkjs sdkjs-forms web-apps \
                   dictionaries build_tools core-fonts document-templates \
                   DesktopEditors depot_tools v8 icu; do
        [[ -d "$srcdir/$_module" ]] ||
            { error "source $_module is missing from \$srcdir"; exit 1; }
    done

    # The pins and the two version namespaces must agree with each other. This is
    # the assertion that makes the version trustworthy: `v9.4.0` exists in
    # DesktopEditors only, so a module pin that used the release name instead of
    # the build name would silently try to check out a ref that does not exist.
    # Test tag *membership* of HEAD, never `git describe`: upstream tags one
    # commit with several build numbers (the pinned core commit carries
    # v9.4.0.126, .127, .129 and .130), so describe reports whichever it likes
    # and its answer says nothing about which build this tree actually is.
    [[ "${_oo_build}" != "${_oo_release}" ]] ||
        { error 'build and release namespaces collapsed into one'; exit 1; }
    _assert_tag "$srcdir/core" "v${_oo_build}"
    _assert_tag "$srcdir/DesktopEditors" "v${_oo_release}"
    ( cd "$srcdir/v8" && git rev-parse HEAD ) | grep -Fxq "${_v8_commit}" ||
        { error "v8 is not at the pinned commit for ${_v8_tag}"; exit 1; }
    for _module in desktop-apps desktop-sdk sdkjs sdkjs-forms web-apps \
                   dictionaries build_tools core-fonts document-templates; do
        _assert_tag "$srcdir/$_module" "v${_oo_build}"
    done

    cp -r "$srcdir/icu/icu4c" "$srcdir/core/Common/3dParty/icu/icu"

    cd "$srcdir/build_tools/tools/linux"
    # Pretend upstream's dependency checker already ran, so it does not try to
    # install toolchains into the build.
    touch packages_complete

    # Use the distribution Qt instead of the Qt upstream bundles. Contract from
    # build_tools/tools/linux/use_system_qt.py: these three symlinks are the
    # whole interface.
    mkdir -p system_qt/gcc_64
    ln -s /usr/bin            ./system_qt/gcc_64/bin
    ln -s /usr/lib            ./system_qt/gcc_64/lib
    ln -s /usr/lib/qt/plugins ./system_qt/gcc_64/plugins

    cd "$srcdir/build_tools"
    _patch -Np1 -i ../0001-Fix-boost-module-import.patch
    _patch -Np1 -i ../0001-Add-update-only-to-avoid-download-and-build-at-once.patch
    _patch -Np1 -i ../0002-Add-no-third-party-update-and-update-third-party-onl.patch
    # Do not let the build update the sources we pinned ourselves
    _patch -Np1 -i ../no-git-update.diff
    # Read the Qt version from the environment instead of guessing it from a path
    _patch -Np1 -i ../0003-use-QT_VERSION-env-instead-of-guessing.patch
    # Build only the tar target; the deb/rpm routes are dead weight here
    _patch -Np1 -i ../0004-Only-build-tar.patch
    # Link the bundled ICU against the system libstdc++ instead of a static one
    _patch -Np1 -i ../0001-Dynamically-link-libstdc-in-icu.patch
    _patch -Np0 -i ../do-not-build-commercial.diff
    # libstdc++ dropped support for what the bundled V8 expects, so make it build
    # against a sysroot (upstream sets use_sysroot=false on linux)
    _patch -Np1 -i ../Ancient-V8-Use-Sysroot.diff

    # --update 0: the sources are already here, do not fetch them
    ./configure.py --module desktop --update 0 --qt-dir "$(realpath tools/linux/system_qt)"
    ./make.py --update-only

    # Fetch V8 before the third-party update so we get a chance to patch it. The
    # scripts delete and re-clone V8 unless v8.data holds the version they expect,
    # and the .gclient solution pins the local copy instead of the network.
    cd "$srcdir"
    mv depot_tools core/Common/3dParty/v8_89/
    cd core/Common/3dParty/v8_89/
    echo -n "v8_version_1" > v8.data
    cat >.gclient <<EOF
solutions = [
  {
    "name": "v8",
    "url": "file://${srcdir}/v8@makepkg",
    "deps_file": "DEPS",
    "managed": False,
    "custom_deps": {},
    "custom_vars": {},
  },
]
EOF
    export PATH="$(pwd)/depot_tools:$PATH" DEPOT_TOOLS_UPDATE=0
    # depot_tools bootstraps itself on first use
    ensure_bootstrap
    gclient sync --force
    # V8 must use the system libstdc++, not the one it builds for itself
    ln -sf /usr/lib/libstdc++.so.6 \
        v8/third_party/llvm-build/Release+Asserts/lib/libstdc++.so.6
    _patch -Np1 -d v8 < "$srcdir/v8-89-fix-cstdint.diff"

    # Convert the official CEF distribution into the layout ONLYOFFICE expects
    # (Release/ and Resources/ side by side), then repack it as cef_binary.7z.
    cd "$srcdir"
    mkdir -p cef_binary
    tar -C cef_binary -xf "cef_${_cef_build}.tar.bz2" --strip-components=1 \
        --wildcards '*/Release' '*/Resources'
    mkdir -p "$srcdir/core/Common/3dParty/cef/linux_64"
    7z a "$srcdir/core/Common/3dParty/cef/linux_64/cef_binary.7z" cef_binary/ >/dev/null

    # These only apply once the third-party update has unpacked the trees they
    # touch, which is why they are here and not above.
    cd "$srcdir"
    _patch -Np0 -i system-heif.diff
    _patch -Np0 -i fix-limits-include-1.diff
    _patch -Np0 -i fix-QDesktopWidget-include.diff
    _patch -Np0 -i system-heif-0.diff
    _patch -Np1 -d core < 0001-Disable-static-linking-of-libstdc.patch
    _patch -Np1 -d core < use-fpermissive.diff
    dos2unix core/Common/OfficeFileFormatChecker2.cpp
    _patch -Np0 -d core < fix-limits-include.diff
    _patch -Np1 -d desktop-apps < fix-glib-qt-macro-collision.diff
    # `#pragma region`/`endregion` breaks an if-else-if chain here
    sed -Ei '/pragma (end)?region/d' \
        core/MsBinaryFile/XlsFile/Format/Logic/Biff_structures/StringPtgParser.cpp
    # The bundled zlib predates the headers it needs
    sed -i '1s/^/#include<unistd.h>\n/' core/OfficeUtils/src/zlib-1.2.11/gzwrite.c
    sed -i '1s/^/#include<unistd.h>\n/' core/OfficeUtils/src/zlib-1.2.11/gzread.c
    sed -i '1s/^/#include<unistd.h>\n/' core/OfficeUtils/src/zlib-1.2.11/gzlib.c
    sed -i '1s/^/#include<cmath>\n/' \
        desktop-sdk/ChromiumBasedEditors/videoplayerlib/src/qtimelabel.cpp
    sed -i '1s/^/#include<cmath>\n/' \
        desktop-sdk/ChromiumBasedEditors/videoplayerlib/src/qvideoslider.cpp
    sed -i '1s/^/#include<cmath>\n/' \
        desktop-sdk/ChromiumBasedEditors/videoplayerlib/src/qvideoplaylist.cpp
    sed -i '1s/^/#include<QPainterPath>\n/' \
        desktop-apps/win-linux/src/windows/platform_linux/cwindowplatform.cpp

    cd "$srcdir/build_tools"
    ./make.py --update-third-party-only
}

build() {
    _set_flags
    cd build_tools

    # 0003- makes this variable authoritative. Read it from whatever provides
    # qt5-base, so this stays correct if the provider changes.
    local qt_ver
    qt_ver="$(pacman -Q qt5-base | awk '{print $2}')"
    export QT_VERSION="${qt_ver//+*}"

    # Removals, not additions: CONTRIBUTING.md forbids appending optimisation or
    # ISA flags, and none are appended here, so this host's -march=native -O3
    # reaches the qmake build through SYSTEM_CFLAGS. _GLIBCXX_ASSERTIONS leaves
    # symbols undefined at link time. The -O2 removal is inert on this host,
    # which carries -O3; it is retained for a -O2 host, where upstream's
    # -O2-under-LTO link failure is the reason it exists at all.
    export CFLAGS="${CFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
    export CXXFLAGS="${CXXFLAGS/_FORTIFY_SOURCE=3/_FORTIFY_SOURCE=2}"
    export CFLAGS="${CFLAGS/-O2/}"
    export CXXFLAGS="${CXXFLAGS/-O2/}"
    export CXXFLAGS="${CXXFLAGS/-Wp,-D_GLIBCXX_ASSERTIONS/}"

    # cups 2.5/libcups-git installs headers under /usr/include/libcups2 (the
    # pkg-config Cflags), but src/cprintdata.cpp includes <cups/cups.h> and the
    # qmake build only ever sees our CFLAGS/CXXFLAGS (run #135 wall class —
    # hplip 496b1a9 idiom, same seam as libreoffice-fresh's CPPFLAGS).
    export CFLAGS+=" $(pkg-config --cflags cups)"
    export CXXFLAGS+=" $(pkg-config --cflags cups)"

    ./make.py --no-third-party-update
}

package() {
    cd build_tools
    ./make_package.py -P linux_x86_64 -T desktop -V "$pkgver" -B "$pkgrel"
    cd ../desktop-apps/package/tar
    tar xf "onlyoffice-desktopeditors-$pkgver-$pkgrel-$CARCH.tar.xz"
    rm -f ./*.tar.xz

    install -d "$pkgdir/opt/onlyoffice"
    cp -r usr "$pkgdir"
    cp -r opt "$pkgdir"
    chmod +x "$pkgdir"/usr/bin/*
    # Historic name, kept because it is what documentation and users type
    ln -s onlyoffice-desktopeditors "$pkgdir/usr/bin/desktopeditors"

    # CEF 109 resolves malloc_usable_size through RTLD_NEXT, so libc must follow
    # libcef.so in the loader's link map: libcef.so has to come first in
    # DT_NEEDED. patchelf appends, so remove any existing entry first.
    local _desktopeditors="$pkgdir/opt/onlyoffice/desktopeditors/DesktopEditors"
    if patchelf --print-needed "$_desktopeditors" | grep -Fxq libcef.so; then
        patchelf --remove-needed libcef.so "$_desktopeditors"
    fi
    patchelf --add-needed libcef.so "$_desktopeditors"
    [[ "$(patchelf --print-needed "$_desktopeditors" | head -n1)" == libcef.so ]] ||
        { error 'failed to place libcef.so first in the DesktopEditors DT_NEEDED entries'; exit 1; }

    # We deliberately link the system Qt5 and ICU; shipping the bundled copies as
    # well would put a second Qt in the tree and diverge from the workspace stack.
    rm -f "$pkgdir"/opt/onlyoffice/desktopeditors/libQt5*
    rm -f "$pkgdir"/opt/onlyoffice/desktopeditors/libicu*

    install -Dm644 "$srcdir/DesktopEditors/LICENSE" \
        "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
