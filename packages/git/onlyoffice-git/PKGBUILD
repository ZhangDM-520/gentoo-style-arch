# Maintainer: Gentoo_Style_Arch <maintainer@localhost>
# Contributor: Levi Zim (kxxt) <rsworktech@outlook.com> (archlinuxcn/AUR `onlyoffice`)
# Contributor: Daniel Bermond <dbermond@archlinux.org> (AUR `onlyoffice`)
# Contributor: Mikalai Ramanovich (AUR `onlyoffice`)
#
# Office suite built from upstream VCS sources, tracking the DesktopEditors
# release tags. The build mirrors `build_tools/scripts/`, which is the
# authoritative recipe; patched in a download/build split (`--update-only` then
# `--no-third-party-update`) so that no source is fetched unseen during build().
#
# Every ONLYOFFICE source is pinned by commit. Upstream's own automation would
# clone ten repositories fresh, and for V8 it would follow a moving
# `branch-heads/8.9`; pinning is what makes the result reproducible, and because
# makepkg derives a real checksum for a `#commit=`/`#tag=` fragment (it hashes
# `git archive` of that fragment) every source here is verified too. See
# BUILDING for how the pins are refreshed.

pkgname=onlyoffice-git
_oo_release=9.4.0        # DesktopEditors release tag, i.e. v9.4.0
_oo_build=9.4.0.130      # build tag: pins every module. A DIFFERENT namespace.
# The static fallback for pkgver(): pkgver() recomputes it from the checked-out
# tree at build time. Keep this line free of trailing comments -- build-all.fish
# reads it with `grep -m1 '^pkgver=' | cut -d= -f2`, which does not strip them,
# and a commented value silently matches no archive so the install step does
# nothing and still reports success.
pkgver=9.4.0.130
pkgrel=1
pkgdesc='Office suite that combines text, spreadsheet and presentation editors, built from upstream git sources'
arch=('x86_64')
url='https://www.onlyoffice.com/desktop.aspx'
license=('AGPL-3.0-only')
options=('!emptydirs' '!lto')   # the OnlyOffice/CEF link fails under -flto; see build()
depends=(
    'curl' 'gtk3' 'alsa-lib' 'libpulse' 'gstreamer' 'gst-plugins-base-libs'
    'gst-plugins-ugly' 'libxss' 'nss' 'nspr' 'ttf-dejavu' 'ttf-liberation'
    'ttf-carlito' 'desktop-file-utils' 'hicolor-icon-theme'
    'qt5-base' 'qt5-multimedia' 'qt5-x11extras' 'qt5-svg' 'libnotify'
    # System libraries linked in through our patches, rather than bundled
    'libheif'
    # win-linux/defaults.pri links -lcups against the libcups-git layout
    'libcups'
)
optdepends=('gst-libav: playing embedded video files'
            'gst-plugins-good: playing embedded video files'
            'libreoffice: OpenSymbol fonts'
            'otf-takao: japanese Takao fonts'
            'ttf-ms-fonts: Microsoft fonts')
makedepends=(
    git python
    dos2unix
    nasm
    # build_tools/tools/linux/deps.py. The plain `nodejs`, not `nodejs-lts-iron`:
    # the LTS conflicts with `nodejs`, which this host already has as a
    # dependency of npm/node-gyp, so asking for it would downgrade Node 26 -> 20
    # machine-wide to satisfy one build. `yarn` and `grunt-cli` both depend on
    # plain `nodejs` anyway, and the rest of this workspace does the same.
    nodejs
    npm
    yarn
    grunt-cli
    cmake
    '7zip'
    patchelf
    # v8
    ninja
    # Google Closure Compiler, driven by grunt. Requested through the versioned
    # virtual: only a JDK 11 satisfies `=11`, and jdk11-openjdk conflicts with
    # neither the installed jdk-openjdk nor jdk17-openjdk.
    'java-environment=11'
    libxml2-legacy   # V8 toolchain
)
provides=('onlyoffice' 'onlyoffice-desktopeditors')
conflicts=('onlyoffice' 'onlyoffice-bin' 'onlyoffice-desktopeditors')

_url=https://github.com/ONLYOFFICE
# The CEF build number is chosen by build_tools/scripts/core_common/modules/cef.py,
# whose default branch is 5414 -> chromium 109.0.5414.120. We take Spotify's
# official CEF build (ONLYOFFICE's own CDN hosts the same thing pre-unpacked) and
# repack it below into the layout their unpacker expects.
_cef_build=5414
# Percent-encoding is required: the upstream filename contains '+' characters,
# and a literal '+' in a URL path decodes to a space.
_cef_url='https://cef-builds.spotifycdn.com/cef_binary_109.1.18%2Bgf1c41e4%2Bchromium-109.0.5414.120_linux64_minimal.tar.bz2'
# Kept in sync with build_tools/scripts/core_common/modules/icu.py
_icu_major=74
_icu_minor=2
# depot_tools is only a V8 fetcher and is pinned so it cannot change underneath us
_depot_commit=8dde9800ee2b8326ab11a87abd67d3bd9f8c8773
# V8 is pinned by commit because upstream does NOT pin it: v8_89.py syncs the
# moving `remotes/branch-heads/8.9` (9.9 on mac). This commit is the tip of
# `branch-heads/9.0`, which is what the tag 9.0.257.43 resolves to. Recorded in
# BUILDING so the deviation is visible and re-derivable.
_v8_commit=3928d1150988f0350daf7ce84d1c27aefe737681
_v8_tag=9.0.257.43
_v8_branch_head=branch-heads/9.0

source=(
    # The tree that defines everything else. Named without a prefix so that
    # build_tools finds its sibling directories where it expects them.
    "DesktopEditors::git+${_url}/DesktopEditors#commit=7b9cd379f428ce23c7ef9c93cbb93f1e3c75f613"

    # The six submodules declared by .gitmodules at v9.4.0. Note web-apps: the
    # *directory* must be `web-apps` (that is the path build_tools uses), but the
    # repository upstream declares is web-apps-pro. Both resolve v9.4.0.130 to
    # the same commit, so this is a rename, not a divergence.
    "core::git+${_url}/core#commit=a016fc2868b9f99f59dd30aa2088e68bbe5104af"
    "desktop-apps::git+${_url}/desktop-apps#commit=3ad4e294ae5e25902ccc56088a760ad21a9d123a"
    "desktop-sdk::git+${_url}/desktop-sdk#commit=c84d59c08cf5303908ff8aa43296b0b9de936817"
    "sdkjs::git+${_url}/sdkjs#commit=0cd3e72a8c88c512666157bb452a4ba7b4213617"
    "web-apps::git+${_url}/web-apps-pro#commit=1993a6d89731af0fcb5129ebf0ee380076fea5a9"
    "dictionaries::git+${_url}/dictionaries#commit=d3223bbb777883db66ac3cd249f71c6ebdc992c7"

    # The four modules upstream's automation fetches for itself. Pre-seeding
    # them is what makes no-git-update.diff meaningful: nothing is left to clone.
    "build_tools::git+${_url}/build_tools#commit=cf4cac0846d03e2e00a6fec5d1ecd4e9463086d5"
    "core-fonts::git+${_url}/core-fonts#commit=7030c6681fb5bbed560675cb42422f91df15d5c9"
    "document-templates::git+${_url}/document-templates#commit=71430c9f183489e8912f54f9dc859e369cf0dfb4"
    "sdkjs-forms::git+${_url}/sdkjs-forms#commit=1a883281c41fa9aa5e98c64cce13b14782f92f56"

    # Upstream leaves this one on a branch; pinning it costs one commit hash and
    # removes the last unpinned input from the build.
    "onlyoffice.github.io::git+${_url}/onlyoffice.github.io#commit=4d02c4fde76dd98b94129881a0d68366ae0e56e5"

    # Fetched by the pinned commit below, then handed to gclient from a local path.
    "depot_tools::git+https://chromium.googlesource.com/chromium/tools/depot_tools.git#commit=${_depot_commit}"
    "v8::git+https://github.com/v8/v8#commit=${_v8_commit}"

    "icu::git+https://github.com/unicode-org/icu.git#tag=release-${_icu_major}-${_icu_minor}"

    "cef_${_cef_build}.tar.bz2::${_cef_url}"

    # Patches against build_tools, applied in exactly this order.
    '0001-Fix-boost-module-import.patch'
    '0001-Add-update-only-to-avoid-download-and-build-at-once.patch'
    '0002-Add-no-third-party-update-and-update-third-party-onl.patch'
    'no-git-update.diff'
    '0003-use-QT_VERSION-env-instead-of-guessing.patch'
    '0004-Only-build-tar.patch'
    '0001-Dynamically-link-libstdc-in-icu.patch'
    'do-not-build-commercial.diff'
    'Ancient-V8-Use-Sysroot.diff'
    # Applied after the third-party update, because they touch what it unpacks.
    '0001-Disable-static-linking-of-libstdc.patch'
    'use-fpermissive.diff'
    'fix-limits-include.diff'
    'fix-limits-include-1.diff'
    'fix-QDesktopWidget-include.diff'
    'fix-glib-qt-macro-collision.diff'
    'system-heif.diff'
    'system-heif-0.diff'
    'v8-89-fix-cstdint.diff'
)
# The CEF tarball is unpacked by hand below, selecting only Release/ and
# Resources/. Letting makepkg unpack all 300 MB first only to discard it is waste.
noextract=("cef_${_cef_build}.tar.bz2")

