# UPSTREAM IS MERCURIAL (per batch policy) — stock already sources the hg
# repo (#tag=NSS_$pkgver_RTM); this recipe tracks hg tip instead (AUR nss-hg
# reference, adapted: its pacman -Qi-based versioned nspr/p11-kit pins dropped
# for plain names). NSS_3_130_RTM is tagged on a side line, not an ancestor of
# tip, so {latesttag} lands on a BETA tag and $pkgver may sort below stock nss
# 3.130 — versioned nss deps in consumers may need review (classa-7 notes).
source=(
  'nss::hg+https://hg.mozilla.org/projects/nss'
  '0001-Fix-generating-nss.pc-with-system-nspr.patch'
  'bundle.sh'
  'certdata2pem.py'
)
b2sums=('SKIP'
