pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # CMAKE_BUILD_TYPE=None: makepkg.conf owns the opt level (no hard-coded -O3;
  # the AUR reference's "Release" would inject one)
  # CMAKE_POLICY_VERSION_MINIMUM=3.5: upstream's cmake_minimum_required predates
  # 3.5 and CMake 4 removed that compatibility (run #69 wall).
  cmake -B _build -S "$_pkgname" \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_POLICY_VERSION_MINIMUM=3.5
  cmake --build _build
}

package() {
  DESTDIR="$pkgdir" cmake --install _build
  install -Dm644 "$_pkgname/COPYING" -t "$pkgdir/usr/share/licenses/$pkgname"
}
