# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>
# Contributor: Jan Alexander Steffens (heftig) <heftig@archlinux.org>
# Contributor: Jan de Groot <jgc@archlinux.org>
#
# git build adapted from AUR libproxy-git (reference only) + stock Arch
# libproxy: tracks upstream main directly. The stock libproxy-docs split is
# NOT superseded — docs are trimmed here (-D docs=false, gi-docgen dropped).

pkgname=libproxy-git
_pkgname=libproxy
pkgver=0.5.0.r92.g736a3e1
pkgrel=1
pkgdesc="A library that provides automatic proxy configuration management (git build)"
arch=('x86_64')
url="https://libproxy.github.io/libproxy/"
license=('LGPL-2.1-or-later')
depends=('curl' 'duktape' 'glib2' 'glibc' 'libgcc')
makedepends=('git' 'gobject-introspection' 'gsettings-desktop-schemas' 'meson' 'vala')
provides=("libproxy=$pkgver" 'libproxy.so')
conflicts=('libproxy' 'libproxy-webkit<0.5.0-1')
source=("git+https://github.com/libproxy/libproxy.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  local _tag _rev _hash
  _tag=$(git tag -l --sort -v:refname | grep -E 'libproxy-[0-9\.]+$' | head -n1)
  _rev=$(git rev-list --count "$_tag"..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^libproxy-//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D release=true
    # stock ships the API reference in the libproxy-docs split; house trims
    # docs (option exists upstream, defaults true)
    -D docs=false
    -D tests=false
  )

  arch-meson "$_pkgname" build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"

  install -Dm644 "$_pkgname/COPYING" "$pkgdir/usr/share/licenses/$pkgname/COPYING"
}
