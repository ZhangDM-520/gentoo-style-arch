# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

# git recipe tracking the upstream xorg libXext VCS (AUR libxext-git used as
# reference only)

pkgname=libxext-git
pkgver=1.3.7.r4.g508f8ad
pkgrel=1
pkgdesc='X11 common extensions library (git build)'
arch=('x86_64')
url='https://www.x.org/wiki/'
license=('LicenseRef-libxext')
depends=('glibc' 'libx11' 'xorgproto')
makedepends=('git' 'xorg-util-macros')
provides=("libxext=$pkgver" 'libXext.so')
conflicts=('libxext')
options=('staticlibs')
source=('git+https://gitlab.freedesktop.org/xorg/lib/libxext.git')
b2sums=('SKIP')

pkgver() {
  cd libxext
  git describe --long --tags | sed 's/^libXext-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  cd libxext
  NOCONFIGURE=1 ./autogen.sh
  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

check() {
  cd libxext
  make check
}

package() {
  cd libxext
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
