# Shared PGO module — payload gate at the end of package() plus the bounded
# training runner. A missing module fails at parse time on purpose.
source "$startdir/../../../lib/pgo.sh"

pkgname=pixman-git
pkgver=0.46.4.r63.gf227dcb
pkgrel=1
pkgdesc="Library for pixel manipulation"
arch=('i686' 'x86_64')
url="https://www.pixman.org/"
license=('MIT')
depends=('glibc')
makedepends=('git' 'libpng' 'meson')
provides=("pixman=$pkgver" 'libpixman-1.so')
conflicts=('pixman')
options=('staticlibs')
source=("git+https://gitlab.freedesktop.org/pixman/pixman")
sha256sums=('SKIP')


pkgver() {
  cd "pixman"

  _tag=$(git tag -l --sort -v:refname | grep -E '^pixman-[0-9\.]+$' | head -n1)
  _rev=$(git rev-list --count $_tag..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^pixman-//'
}

build() {
  cd "pixman"

  export LDFLAGS="$LDFLAGS -fuse-ld=mold"

  # Phase 1: instrumented build
  meson setup \
    --buildtype=plain \
    --prefix="/usr" \
    -Ddefault_library="both" \
    -Dgtk=disabled \
    -Db_pgo=generate \
    -Dtests=enabled \
    "_build"
  meson compile -C "_build"

  # Phase 2: generate profile — bounded run (lib/pgo.sh)
  pgo_train_meson _build 300 --no-suite slow

  # Phase 3: profile-guided optimized build
  meson setup --reconfigure \
    --buildtype=plain \
    --prefix="/usr" \
    -Ddefault_library="both" \
    -Dgtk=disabled \
    -Db_pgo=use \
    -Db_lto=true \
    -Dtests=disabled \
    "_build"
  meson compile -C "_build"
}

check() {
  cd "pixman"

  meson test -C "_build" --no-suite slow --print-errorlogs || true
}

package() {
  cd "pixman"

  meson install -C "_build" --destdir "$pkgdir"
  install -Dm644 "COPYING" -t "$pkgdir/usr/share/licenses/pixman"

  verify_no_profile_instrumentation "$pkgdir"
}
