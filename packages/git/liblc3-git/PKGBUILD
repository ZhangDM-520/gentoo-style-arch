# Maintainer: Huang-Huang Bao <eh5@sokka.cn>
# Class A git recipe: tracks upstream google/liblc3 git directly (HEAD).
# AUR liblc3-git and stock liblc3 are REFERENCES ONLY. AUR naming drift: older
# AUR package "lc3"; id here is liblc3-git per batch decision.

pkgname=liblc3-git
_pkgname=liblc3
pkgver=1.1.3.r0.g8e1e722cda
pkgrel=1
pkgdesc="Low Complexity Communication Codec (LC3) library and tools (git build)"
url="https://github.com/google/liblc3"
license=('Apache-2.0')
arch=('x86_64')
depends=('glibc')
makedepends=('git' 'meson' 'python')
optdepends=('python: Python bindings')
# soname shipped: liblc3.so.1
provides=("liblc3=$pkgver" 'liblc3.so')
conflicts=('liblc3')
source=("git+https://github.com/google/${_pkgname}.git")
b2sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # stock feature set: library + cli tools + python bindings
  local meson_options=(
    -D python=true
    -D tools=true
  )
  arch-meson "$_pkgname" build "${meson_options[@]}"
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 "$_pkgname/LICENSE" -t "${pkgdir}/usr/share/licenses/${pkgname}"
}
