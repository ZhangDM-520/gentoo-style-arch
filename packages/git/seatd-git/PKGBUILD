# Maintainer: Kenny Levinsen <aur [at] kl [dot] wtf>

pkgname=seatd-git
pkgver=r365.427b5d956a
pkgrel=1
pkgdesc="Seat management daemon and library"
arch=(x86_64)
url="https://git.sr.ht/~kennylevinsen/seatd"
license=(MIT)
source=("git+$url")
sha256sums=('SKIP')
conflicts=(seatd libseat)
# libseat.so: bare entry so pacman 7.1 auto-derives the soname provide
# (libseat.so=1-64) needed by wlroots0.20 — added 2026-09-07 after trim audit
provides=("seatd=${pkgver}" "libseat=${pkgver}" libseat.so)
depends=(systemd)
makedepends=(meson ninja scdoc git)

pkgver() {
  cd seatd
  printf 'r%d.%s' \
    $(git rev-list --count HEAD) \
    $(git rev-parse HEAD | head -c10)
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local meson_options=(
    -D libseat-logind=systemd
    # server=disabled 2026-09-04: seatd daemon inactive (logind backend in use)
    -D server=disabled
    -D b_lto=true
    -D b_ndebug=true
  )

  arch-meson seatd build "${meson_options[@]}"
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
