pkgname=easyeffects-git
pkgver=8.3.0.r0.g2bd138377
pkgrel=1
pkgdesc='Audio Effects for PipeWire applications'
arch=(x86_64 i686 arm armv6h armv7h aarch64)
url='https://github.com/wwmm/easyeffects'
license=('GPL-3.0-only')
depends=(
  'breeze-icons'
  'gsl'
  'kconfigwidgets'
  'kiconthemes'
  'kirigami'
  'kirigami-addons'
  'libbs2b'
  'libebur128'
  'libmysofa'
  'libsndfile'
  'lilv'
  'nlohmann-json'
  'pipewire-pulse'
  'qqc2-desktop-style'
  'qt6-base'
  'qt6-graphs'
  'rnnoise'
  'soundtouch'
  'speexdsp'
  'tbb'
  'webrtc-audio-processing'
  'zita-convolver'
)
makedepends=('appstream' 'cmake' 'extra-cmake-modules' 'git' 'intltool' 'ladspa' 'ninja')
optdepends=(
  'breeze: KDE breeze style'
  'calf: exciter, bass enhancer and others'
  'lsp-plugins-lv2: limiter, equalizer, compressor, loudness and others'
  'zam-plugins-lv2: maximizer'
  'mda.lv2: bass loudness'
  'x42-plugins-lv2: autotune'
  'libdeep_filter_ladspa: deep noise remover'
)
conflicts=("${pkgname%%-git}")
provides=("${pkgname%%-git}")
source=("${pkgname%%-git}::git+${url}")
sha512sums=('SKIP')

pkgver() {
  cd "${pkgname%%-git}"
  printf "%s" "$(git describe --long | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g')"
}

build() {
  # ── Phase 1: instrumented build (LTO stripped — keeps flags predictable) ──
  local gen_cflags gen_cxxflags gen_ldflags
  gen_cflags=$(sed 's/-flto[^ ]*//g' <<< "$CFLAGS")
  gen_cxxflags=$(sed 's/-flto[^ ]*//g' <<< "$CXXFLAGS")
  gen_ldflags=$(sed 's/-flto[^ ]*//g' <<< "$LDFLAGS")

  cmake -B build -S "${pkgname%%-git}" -G Ninja -W no-dev \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_C_FLAGS="$gen_cflags -fprofile-generate -fprofile-update=atomic" \
    -D CMAKE_CXX_FLAGS="$gen_cxxflags -fprofile-generate -fprofile-update=atomic" \
    -D CMAKE_EXE_LINKER_FLAGS="$gen_ldflags -fuse-ld=mold -fprofile-generate" \
    -D CMAKE_SHARED_LINKER_FLAGS="$gen_ldflags -fuse-ld=mold -fprofile-generate"
  cmake --build build

  local ee_bin
  ee_bin=$(find build -maxdepth 3 -type f -name easyeffects -executable | head -1)
  if [[ -z "$ee_bin" ]]; then
    echo "Warning: easyeffects binary not found, skipping PGO"
    return 0
  fi

  # ── Trainer: easyeffects ABORTS without a PipeWire daemon, so spin up a
  #    private pipewire + wireplumber inside a dbus-run-session with sandboxed
  #    XDG dirs. CLI paths are exercised, then the primary instance is shut
  #    down cleanly via its local server ("easyeffects --quit") so atexit
  #    handlers flush the .gcda files (SIGKILL/SIGTERM/SIGINT all skip the
  #    flush → never rely on signals). Cleanup is PID-scoped ONLY — never
  #    pkill by process name (would kill the user's real session daemons). ──
  local tdir=/tmp/ee-pgo-trainer
  rm -rf "$tdir" /tmp/ee-trainer.sh /tmp/ee-trainer.log
  mkdir -p "$tdir"/{config,cache,data,runtime}
  chmod 700 "$tdir/runtime"

  cat > /tmp/ee-trainer.sh <<'TRAINER'
#!/usr/bin/env bash
set -u
export QT_QPA_PLATFORM=offscreen
EE="$1"
mkdir -p "$XDG_CONFIG_HOME/easyeffects/output" "$XDG_CONFIG_HOME/easyeffects/input"
cat > "$XDG_CONFIG_HOME/easyeffects/output/test.json" <<'EOF'
{
  "output": {"blocklist": [], "pipeline": []},
  "input": {"blocklist": [], "pipeline": []}
}
EOF
pipewire & PW=$!
wireplumber & WP=$!
sleep 4
"$EE" & PID=$!
sleep 12
"$EE" --presets || true
sleep 1
"$EE" --load-preset test || true
sleep 1
"$EE" --last-loaded-presets || true
sleep 1
"$EE" --bypass 1 || true
"$EE" --bypass 2 || true
sleep 1
"$EE" --quit || true
# backstop: SIGKILL only if the clean quit never lands (0 gcda → fallback)
timeout -s KILL 10 tail --pid="$PID" -f /dev/null || true
kill "$PW" "$WP" 2>/dev/null || true
wait 2>/dev/null || true
echo "--- trainer done"
TRAINER

  XDG_CONFIG_HOME="$tdir/config" XDG_CACHE_HOME="$tdir/cache" \
  XDG_DATA_HOME="$tdir/data" XDG_RUNTIME_DIR="$tdir/runtime" \
    timeout -s TERM 60 dbus-run-session -- bash /tmp/ee-trainer.sh "$ee_bin" \
    > /tmp/ee-trainer.log 2>&1 || true
  tail -3 /tmp/ee-trainer.log || true
  rm -rf "$tdir" /tmp/ee-trainer.sh /tmp/ee-trainer.log

  local gcda_count
  gcda_count=$(find build -name '*.gcda' | wc -l)
  if [[ $gcda_count -eq 0 ]]; then
    echo "Warning: No profile data generated, skipping PGO"
    return 0
  fi
  echo "Profile data generated: $gcda_count .gcda files"

  # ── Phase 2: profile-use + LTO (fresh configure; -Wno-error guards GCC
  #    profile-vs-codegen drift diagnostics) ──
  rm -rf build
  cmake -B build -S "${pkgname%%-git}" -G Ninja -W no-dev \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_C_FLAGS="$CFLAGS -fprofile-use -Wno-error=coverage-mismatch" \
    -D CMAKE_CXX_FLAGS="$CXXFLAGS -fprofile-use -Wno-error=coverage-mismatch -Wno-error=format-overflow" \
    -D CMAKE_EXE_LINKER_FLAGS="$LDFLAGS -fuse-ld=mold" \
    -D CMAKE_SHARED_LINKER_FLAGS="$LDFLAGS -fuse-ld=mold"
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
