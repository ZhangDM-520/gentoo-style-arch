# Maintainer: zefr0x < Matrix: "@zer0-x:kde.org" >
# Contributor: Kevin Majewski

pkgname=xdg-desktop-portal-gtk-git
_pkgname=xdg-desktop-portal-gtk
pkgver=1.15.3+9+g5409af7
pkgrel=2
pkgdesc="A GTK backend for xdg-desktop-portal"
url="https://github.com/flatpak/xdg-desktop-portal-gtk"
arch=(x86_64)
license=(LGPL)
depends=('gtk3' 'xdg-desktop-portal' 'gsettings-desktop-schemas' 'fontconfig')
makedepends=('git' 'meson' 'cmake' 'glib2-devel')
optdepends=("evince: Print preview")
# versioned provide: stock xdg-desktop-portal-gnome requires
# xdg-desktop-portal-gtk>=1.10.0-2 — an unversioned provide cannot satisfy a
# versioned constraint and pacman refuses the swap (run #113 install wall)
provides=("$_pkgname=$pkgver" 'xdg-desktop-portal-impl')
conflicts=($_pkgname)
source=("git+https://github.com/flatpak/xdg-desktop-portal-gtk")
sha256sums=('SKIP')

pkgver() {
  cd $_pkgname
  git describe --tags | sed 's/^v//;s/-/+/g'
}

build() {
  cd $_pkgname

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  arch-meson build \
    -Dwallpaper=disabled \
    -Dsettings=enabled \
    -Dappchooser=enabled \
    -Dlockdown=enabled \
    -D b_lto=true \
    -D b_ndebug=true

  meson compile -C build
}

check() {
  cd $_pkgname

  meson test -C build || true
}

package() {
  cd $_pkgname
  meson install -C build --destdir "${pkgdir}"
}
