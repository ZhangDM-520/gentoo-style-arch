# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>
# Class A git recipe: tracks upstream ngtcp2/ngtcp2 git directly (HEAD).
# AUR libngtcp2-git and stock libngtcp2 are REFERENCES ONLY. Stock's submodule
# redirect list copied verbatim. crypto/gnutls is forced on (--with-gnutls,
# ships libngtcp2_crypto_gnutls.so); crypto/ossl is auto-detected against
# OpenSSL >= 3.5 (SSL_set_quic_tls_cbs) exactly like stock ships it.

pkgname=libngtcp2-git
pkgver=1.25.0.r0.ga4925d7064
pkgrel=1
pkgdesc="Implementation of IETF QUIC protocol (git build)"
arch=('x86_64')
url="https://nghttp2.org/ngtcp2/"
license=('MIT')
depends=('glibc' 'gnutls' 'libssl.so' 'openssl')
makedepends=('brotli' 'git')
# sonames shipped: libngtcp2.so.16, libngtcp2_crypto_gnutls.so.8,
# libngtcp2_crypto_ossl.so.0 (ossl needs host OpenSSL >= 3.5)
provides=("libngtcp2=$pkgver" 'libngtcp2.so' 'libngtcp2_crypto_gnutls.so' 'libngtcp2_crypto_ossl.so')
conflicts=('libngtcp2')
source=("git+https://github.com/ngtcp2/ngtcp2.git"
        'git+https://github.com/ngtcp2/munit.git'
        'git+https://github.com/ngtcp2/urlparse.git')
b2sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  cd ngtcp2

  git config --file=.gitmodules submodule.tests/munit.url ../munit/
  git config --file=.gitmodules submodule.third-party/urlparse.url ../urlparse/

  git submodule init
  git -c protocol.file.allow=always submodule update

  autoreconf -i
}

# reference-derived: upstream tags include -rc artifacts a plain git describe
# would pick up — only plain (v)X.Y.Z release tags count
pkgver() {
  cd ngtcp2
  local _tag
  _tag=$(git tag -l --sort=-v:refname | grep -E '^v?[0-9.]+$' | head -n1)
  printf '%s.r%s.g%s' "${_tag#v}" "$(git rev-list --count "$_tag"..HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd ngtcp2

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --with-libbrotlidec \
    --with-libbrotlienc \
    --with-gnutls \
    --enable-lib-only
  make
}

package() {
  cd ngtcp2
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
