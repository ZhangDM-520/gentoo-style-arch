+# --- Orphan-recovery notices as the interrupted-turn handoff (per-call, not blanket) ---
+
+
+def _orphan_notice(content):
+    """The synthesized ``[Orphan recovery: ...]`` device, or None for a real result.
+
+    Presence/absence is the executed-vs-not distinction; the notice's own wording
+    classifies the effect (``UNKNOWN`` vs ``did not complete``)."""
+    for line in str(content).splitlines():
+        if line.strip().startswith("[Orphan recovery:"):
+            return line.strip()
+    return None
+
+
+def test_orphan_notice_is_per_call_and_double_canonicalization_is_byte_stable():
+    """Invariant A: a dangling side-effecting batch is answered by synthesized tool
+    results carrying the ``[Orphan recovery: ...]`` device, paired by the correct
+    ``tool_call_id`` and classified per call; applying canonicalization twice is
+    byte-identical (the send path re-runs it per request — cache/idempotence safety)."""
+    now = 10_000.0
+    history = [
+        _user("restart the container"),
+        {
+            "role": "assistant",
+            "content": "",
+            "tool_calls": [
+                {"id": "c1", "type": "function", "function": {"name": "terminal", "arguments": "{}"}},
+                {"id": "c2", "type": "function", "function": {"name": "read_file", "arguments": "{}"}},
+            ],
+        },
+    ]
+    once = canonicalize_replay_history(history, now=now)
+
+    assert [m["role"] for m in once] == ["user", "assistant", "tool", "tool"]
+    first, second = once[2], once[3]
+    # The device rides the tool-result row (a role the model never authors), keyed per call.
+    assert (first["tool_call_id"], second["tool_call_id"]) == ("c1", "c2")
+    assert "UNKNOWN" in _orphan_notice(first["content"])
+    assert first["effect_disposition"] == "unknown"
+    assert "did not complete" in _orphan_notice(second["content"])
+    assert second["effect_disposition"] == "none"
+
+    once_bytes = json.dumps(once, sort_keys=True)
+    twice = canonicalize_replay_history(once, now=now)
+    assert json.dumps(twice, sort_keys=True) == once_bytes, (
+        "re-applying canonicalization must be a byte-stable no-op — the same history "
+        "serializes identically on every send-path request"
+    )
+
+
+def test_orphan_notice_distinguishes_executed_from_unknown_per_call():
+    """Invariant B: a persisted (executed) result carries NO recovery notice, so
+    notice presence is the executed-vs-not distinction; inside a kept interrupted
+    block each result is classified per its own call — side-effecting → ``unknown``,
+    read-only → ``none`` — never a per-turn banner."""
+    now = 10_000.0
+    history = [
+        _user("run it"),
+        {
+            "role": "assistant",
+            "content": "",
+            "tool_calls": [
+                {"id": "c1", "type": "function", "function": {"name": "terminal", "arguments": "{}"}},
+                {"id": "c2", "type": "function", "function": {"name": "read_file", "arguments": "{}"}},
+                {"id": "c3", "type": "function", "function": {"name": "read_file", "arguments": "{}"}},
+            ],
+        },
+        {"role": "tool", "tool_call_id": "c1",
+         "content": '{"exit_code": 130, "output": "[Command interrupted]"}'},
+        {"role": "tool", "tool_call_id": "c2",
+         "content": '{"exit_code": -1, "output": "[execution interrupted]"}'},
+        {"role": "tool", "tool_call_id": "c3", "content": "ready"},
+    ]
+    out = canonicalize_replay_history(history, now=now)
+
+    # Alternation preserved: rewritten results stay adjacent to their call.
+    assert [m["role"] for m in out] == ["user", "assistant", "tool", "tool", "tool"]
+    side_effect, read_only, executed = out[2], out[3], out[4]
+
+    assert "UNKNOWN" in _orphan_notice(side_effect["content"])
+    assert side_effect["effect_disposition"] == "unknown"
+    assert "did not complete" in _orphan_notice(read_only["content"])
+    assert read_only["effect_disposition"] == "none"
+
+    # Executed result: no notice, content untouched — absence IS the executed signal.
+    assert _orphan_notice(executed["content"]) is None
+    assert executed["content"] == "ready"
+    assert "effect_disposition" not in executed
