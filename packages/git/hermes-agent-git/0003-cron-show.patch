+"""Tests for ``hermes cron show <job_ref> [--json]`` — one job's full definition.
+
+Contracts (not snapshots):
+1. ``show --json`` emits pure JSON whose job payload equals the stored record
+   field-for-field — the view is a faithful rendering of storage, and no prose
+   warning may pollute the JSON stream.
+2. Credentials embedded in outbound transport fields (``deliver``,
+   ``failure_deliver``, ``monitor_url``) are redacted in BOTH render modes
+   while hosts and the prompt survive verbatim — one serializer, one
+   redaction truth.
+"""
+
+import argparse
+import json
+
+import pytest
+
+from cron.jobs import create_job
+from hermes_cli.cron import cron_command
+from hermes_cli.subcommands.cron import build_cron_parser
+
+
+@pytest.fixture()
+def tmp_cron_dir(tmp_path, monkeypatch):
+    monkeypatch.setattr("cron.jobs.CRON_DIR", tmp_path / "cron")
+    monkeypatch.setattr("cron.jobs.JOBS_FILE", tmp_path / "cron" / "jobs.json")
+    monkeypatch.setattr("cron.jobs.OUTPUT_DIR", tmp_path / "cron" / "output")
+    return tmp_path
+
+
+def _show(job_ref, *, as_json):
+    parser = argparse.ArgumentParser(prog="hermes")
+    subparsers = parser.add_subparsers(dest="command")
+    build_cron_parser(subparsers, cmd_cron=cron_command)
+    args = parser.parse_args(
+        ["cron", "show", job_ref, "--json"] if as_json else ["cron", "show", job_ref])
+    return cron_command(args)
+
+
+def _stored_record(tmp_path, job_id):
+    """Raw record straight from jobs.json (the piece of data ``show`` must render)."""
+    stored = json.loads((tmp_path / "cron" / "jobs.json").read_text())
+    jobs = stored["jobs"] if isinstance(stored, dict) else stored
+    return next(job for job in jobs if job["id"] == job_id)
+
+
+class TestCronShowJsonMatchesStoredRecord:
+    def test_show_json_fields_equal_stored_record(self, tmp_path, tmp_cron_dir,
+                                                  capsys, monkeypatch):
+        monkeypatch.setattr("hermes_cli.cron._builtin_gateway_liveness", lambda: False)
+        prompt = "Summarize the daily build log and flag regressions."
+        job = create_job(
+            prompt=prompt,
+            schedule="every 2h",
+            name="daily-report",
+            deliver="telegram:12345",
+            skill="maps",
+            workdir=str(tmp_path),
+            model="test-model",
+            provider="nous",
+        )
+
+        rc = _show(job["id"], as_json=True)
+        out = capsys.readouterr().out
+
+        # The ENTIRE stdout must parse: JSON mode never emits prose warnings.
+        payload = json.loads(out)
+        assert rc == 0
+        shown = payload["job"]
+        stored = _stored_record(tmp_path, job["id"])
+        # Relationship: every stored field survives into the view unchanged.
+        assert {key: shown.get(key) for key in stored} == stored
+        assert shown["prompt"] == prompt
+        # Scheduler readiness is encoded as data, not prose: the field carries
+        # the liveness probe's own tri-state value (patched False above), so a
+        # missing field or a hardcoded constant would fail this.
+        assert payload["scheduler_ready"] is False
+
+
+class TestCronShowRedactsTransportCredentials:
+    def test_secrets_redacted_prompt_verbatim_in_both_views(self, tmp_path, tmp_cron_dir,
+                                                            capsys, monkeypatch):
+        monkeypatch.setattr("hermes_cli.cron._builtin_gateway_liveness", lambda: None)
+        prompt = ("PROMPT-VERBATIM: report build status for "
+                  "https://logs.example/daily?view=plain")
+        deliver = "https://usr:PWSEKRIT1@hooks.example/relay?token=TOKSEKRIT1&room=ops"
+        monitor_url = "https://monitor.example/health?api_key=KEYSEKRIT2&region=eu"
+        failure_deliver = "https://alerts.example/hook?access_token=ACCSEKRIT3"
+        job = create_job(
+            prompt=prompt,
+            schedule="every 1h",
+            deliver=deliver,
+            monitor_url=monitor_url,
+            failure_deliver=failure_deliver,
+        )
+
+        rc_json = _show(job["id"], as_json=True)
+        payload = json.loads(capsys.readouterr().out)
+        rc_human = _show(job["id"], as_json=False)
+        human = capsys.readouterr().out
+
+        assert rc_json == 0 and rc_human == 0
+        shown = payload["job"]
+        for view in (json.dumps(shown), human):
+            # Hosts survive ...
+            for host in ("hooks.example", "monitor.example", "alerts.example", "logs.example"):
+                assert host in view
+            # ... secrets do not, in either mode.
+            for secret in ("PWSEKRIT1", "TOKSEKRIT1", "KEYSEKRIT2", "ACCSEKRIT3", "usr:PWSEKRIT1"):
+                assert secret not in view
+            # The prompt is definition, not transport: verbatim in both modes.
+            assert prompt in view
+        # Non-secret query params keep their values (redaction is key-scoped).
+        assert "room=ops" in shown["deliver"]
+        assert "region=eu" in shown["monitor_url"]
+        # Secret values are replaced by the sentinel in BOTH render modes.
+        assert "«redacted»" in shown["deliver"]
+        assert "«redacted»" in shown["monitor_url"]
+        assert "«redacted»" in shown["failure_deliver"]
+        assert "«redacted»" in human
+        # Redaction is applied where the record is read from, too.
+        assert shown["deliver"] != deliver
