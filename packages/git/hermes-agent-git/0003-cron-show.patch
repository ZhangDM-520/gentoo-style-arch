+_REDACTED_MARK = "«redacted»"
+
+# The only fields a job record may carry embedded credentials in (webhook
+# tokens, URL userinfo): outbound TRANSPORT, not definition. Prompt, script,
+# skills, workdir, schedule and model overrides are printed in full — the
+# operator can already read jobs.json; `show` exists to read the definition.
+_TRANSPORT_FIELDS = ("deliver", "failure_deliver", "monitor_url")
+
+
+def _redact_transport_target(value: str) -> str:
+    """Strip URL userinfo and secret-bearing query values from one delivery target.
+
+    Key classification and URL splitting are reused from the central redactor
+    (``agent/redact.py``) so this view can never disagree with provider-egress
+    redaction about what counts as a secret. Rendering differs from
+    ``_redact_strict_url_credentials`` on purpose: the whole userinfo goes and
+    the value becomes the non-reusable ``«redacted»`` sentinel.
+    """
+    from agent.redact import (
+        _SENSITIVE_QUERY_PARAMS, _STRICT_URL_PARAM_RE, _STRICT_URL_USERINFO_RE,
+        _canonical_url_param_name)
+    text = _STRICT_URL_PARAM_RE.sub(
+        lambda m: f"{m.group(1)}{m.group(2)}={_REDACTED_MARK}"
+        if _canonical_url_param_name(m.group(2)) in _SENSITIVE_QUERY_PARAMS else m.group(0),
+        value)
+    return _STRICT_URL_USERINFO_RE.sub(lambda m: f"{m.group(1)}{_REDACTED_MARK}@", text)
+
+
+def _redact_transport_field(value: Any) -> Any:
+    if isinstance(value, list):
+        return [_redact_transport_target(str(item)) if item is not None else item for item in value]
+    if isinstance(value, str):
+        return _redact_transport_target(value)
+    return value
+
+
+def job_to_dict(job: Dict[str, Any]) -> Dict[str, Any]:
+    """One serializer for a job's full definition — the single source BOTH the
+    human view and ``--json`` render from, so the two views cannot drift.
+
+    Redaction lives here (one truth): only the outbound transport fields
+    (``deliver``, ``failure_deliver``, ``monitor_url``) are scrubbed, in every
+    render mode alike.
+    """
+    data = dict(job)
+    for field in _TRANSPORT_FIELDS:
+        if field in data:
+            data[field] = _redact_transport_field(data[field])
+    return data
+
+
+def _target_display(value: Any) -> str:
+    return value if isinstance(value, str) else ", ".join(map(str, value or []))
+
+
+def _model_display(data: Dict[str, Any]) -> str:
+    extras = []
+    if data.get("model_provider"):
+        extras.append(f"provider: {data['model_provider']}")
+    if data.get("base_url"):
+        extras.append(f"base_url: {data['base_url']}")
+    if data.get("reasoning_effort"):
+        extras.append(f"reasoning: {data['reasoning_effort']}")
+    if data.get("pinned"):
+        extras.append("pinned")
+    return f"{data.get('model') or '(follows main agent model)'}" + (
+        f"  ({', '.join(extras)})" if extras else "")
+
+
+def _definition_extra_rows(data: Dict[str, Any]) -> List[tuple[str, str]]:
+    """Definition rows ``cron list`` does not show (delivery fallbacks, model pins)."""
+    rows: List[tuple[str, str]] = []
+    if data.get("failure_deliver"):
+        rows.append(("Failure", _target_display(data.get("failure_deliver"))))
+    if any(data.get(key) for key in ("model", "model_provider", "reasoning_effort")) or data.get("pinned"):
+        rows.append(("Model", _model_display(data)))
+    if data.get("context_from"):
+        rows.append(("Context from", _target_display(data.get("context_from"))))
+    if data.get("attach_to_session") is not None:
+        rows.append(("Attach", "yes" if data["attach_to_session"] else "no"))
+    if data.get("paused_reason"):
+        rows.append(("Paused", data["paused_reason"]))
+    return rows
+
+
+# ``_job_rows`` labels covered by ``_print_job_details`` (printed below) and the
+# run-state rows that follow the definition block in ``cron show``.
+_SHOW_DETAIL_ROW_LABELS = frozenset({"Script", "Monitor", "Mode", "Workdir"})
+_SHOW_STATUS_ROW_LABELS = frozenset({"Changed", "Last run", "Dispatch", "Execution"})
+
+
+def _show_error(message: str, matches: Optional[List[Dict[str, Any]]], as_json: bool) -> int:
+    """``cron show`` error path: prose + match listing for the terminal; for
+    ``--json`` a JSON object on stdout so the stream stays parseable."""
+    if as_json:
+        payload: Dict[str, Any] = {"error": message}
+        if matches is not None:
+            payload["matches"] = matches
+        print(json.dumps(payload, indent=2, ensure_ascii=False))
+        return 1
+    print(color(message, Colors.RED))
+    for match in matches or []:
+        print(f"  {match['id']}  (name: {match.get('name')!r})")
+    return 1
+
+
+def cron_show(args) -> int:
+    """Print one job's full definition (human table or machine JSON with ``--json``).
+
+    Resolution and ambiguity handling mirror ``cron edit``: exact ID wins, then
+    case-insensitive name; an ambiguous name lists the matches and exits 1.
+    """
+    from cron.jobs import AmbiguousJobReference, effective_job_state, resolve_job_ref
+    as_json = bool(getattr(args, "json", False))
+    try:
+        job = resolve_job_ref(args.job_id)
+    except AmbiguousJobReference as exc:
+        return _show_error(str(exc),
+                           [{"id": m["id"], "name": m.get("name")} for m in exc.matches],
+                           as_json)
+    if not job:
+        return _show_error(f"Job not found: {args.job_id}", None, as_json)
+
+    data = job_to_dict(job)
+    if as_json:
+        # Machine mode is pure JSON on stdout: the scheduler-readiness notice
+        # human mode prints as prose becomes a data field here.
+        print(json.dumps({"job": data, "scheduler_ready": _builtin_gateway_liveness()},
+                         indent=2, ensure_ascii=False))
+        return 0
+
+    badge = _STATE_BADGES.get(effective_job_state(job)) or (
+        ("[active]", Colors.GREEN) if data.get("enabled", True) else ("[disabled]", Colors.RED))
+    print(f"  {color(data.get('id', '?'), Colors.YELLOW)} {color(*badge)}")
+    rows = list(_job_rows(data))
+    head = [row for row in rows if row[0] not in _SHOW_DETAIL_ROW_LABELS | _SHOW_STATUS_ROW_LABELS]
+    tail = [row for row in rows if row[0] in _SHOW_STATUS_ROW_LABELS]
+    for label, value in head + _definition_extra_rows(data):
+        print(f"  {label}: {value}")
+    _print_job_details(data)
+    for label, value in tail:
+        print(f"  {label}: {value}")
+    print()
+    print("  Prompt:")
+    print(data.get("prompt") or color("(no prompt — script/skills-only job)", Colors.DIM))
+    for line in _job_warnings(data):
+        print(f"    {line}")
+    _warn_if_gateway_not_running()
+    return 0
+
