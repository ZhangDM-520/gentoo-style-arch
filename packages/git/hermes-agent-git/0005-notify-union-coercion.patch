+        """A property typed ``anyOf: [boolean, array<string>]`` (terminal's
+        ``notify``) must coerce a stringified value against the branches in
+        schema order: the boolean branch claims "true" before the array branch
+        could wrap it as a pattern, a JSON array string parses natively, and a
+        bare pattern string still wraps into a one-element list."""
+        schema = self._mock_schema({
+            "notify": {
+                "anyOf": [
+                    {"type": "boolean"},
+                    {"type": "array", "items": {"type": "string"}},
+                ],
+            },
+        })
+        with patch("tools.arg_coercion.registry.get_schema", return_value=schema):
+            out = coerce_tool_args("test_tool", {"notify": "true"})
+            assert out["notify"] is True, f'"true" must coerce to True, got {out["notify"]!r}'
+
+            out = coerce_tool_args("test_tool", {"notify": '["a"]'})
+            assert out["notify"] == ["a"]
+            assert isinstance(out["notify"], list)
+
+            out = coerce_tool_args("test_tool", {"notify": "Application startup complete"})
+            assert out["notify"] == ["Application startup complete"]
+            assert isinstance(out["notify"], list)
