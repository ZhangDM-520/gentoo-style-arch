+def _union_branch_kinds(schema: Any) -> list:
+    """JSON type names declared by *schema* (``type`` plus anyOf/oneOf/allOf branches), in branch order, deduplicated."""
+    kinds = []
+
+    def walk(node: Any) -> None:
+        if not isinstance(node, dict):
+            return
+        t = node.get("type")
+        if isinstance(t, str):
+            kinds.append(t)
+        elif isinstance(t, list):
+            kinds.extend(x for x in t if isinstance(x, str))
+        for union_key in ("anyOf", "oneOf", "allOf"):
+            branches = node.get(union_key)
+            if isinstance(branches, list):
+                for branch in branches:
+                    walk(branch)
+
+    walk(schema)
+    seen = set()
+    return [k for k in kinds if not (k in seen or seen.add(k))]
+
+
+def _coerce_union_value(value: str, schema: Any) -> Any:
+    """Coerce *value* when the schema declares no single top-level ``type``
+    (anyOf/oneOf or list-form ``type``) — coerce against every branch in
+    schema branch order. A boolean branch claims ``"true"`` before an array
+    branch could wrap it as a bare pattern string; an array branch still
+    JSON-parses ``'["a"]'`` and falls back to the bare-string → one-element
+    list wrap when no string branch already keeps the string. The original
+    string is returned when no branch claims the value."""
+    if _schema_allows_null(schema) and value.strip().lower() == "null":
+        return None
+
+    for kind in _union_branch_kinds(schema):
+        if kind in ("string", "null"):
+            continue  # a native string already satisfies "string"; "null" handled above
+        if not _schema_accepts_kind(schema, kind):
+            continue
+        if kind == "array":
+            parsed = _coerce_json(value, list)
+            if parsed is not value:
+                return parsed
+            if _schema_accepts_kind(schema, "string"):
+                continue  # the bare string already satisfies a "string" branch — keep it
+            logger.info("coerce_tool_args: wrapped bare string in union array branch")
+            return [value]
+        coercer = _SCALAR_COERCERS.get(kind)
+        if coercer is not None:
+            coerced = coercer(value)
+            if coerced is not value:
+                return coerced
+    return value
+
+
