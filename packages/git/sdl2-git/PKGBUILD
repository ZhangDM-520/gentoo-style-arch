# Contributor: Christer Solskogen <christer.solskogen@gmail.com> (AUR sdl2-git reference)
# Contributor: Jan Alexander Steffens (heftig) <heftig@archlinux.org> (stock sdl2-compat)

pkgname=sdl2-git
pkgver=2.32.0.r259.g4c2d9014a
pkgrel=1
pkgdesc="A library for portable low-level access to a video framebuffer, audio output, mouse, and keyboard (Version 2) (git build)"
arch=('x86_64')
url="https://www.libsdl.org"
license=('Zlib')
depends=('glibc' 'libxext' 'libxrender' 'libx11' 'libgl' 'libxcursor' 'hidapi' 'libusb')
makedepends=('alsa-lib' 'dbus' 'mesa' 'libpulse' 'libxrandr' 'libxinerama' 'wayland' 'libxkbcommon'
             'wayland-protocols' 'ibus' 'libxss' 'cmake' 'jack' 'ninja' 'pipewire'
             'libdecor' 'vulkan-driver' 'vulkan-headers' 'libsamplerate' 'git')
provides=("sdl2=$pkgver" 'libSDL2-2.0.so' 'libSDL2.so')
# bare soname entries: libSDL2-2.0.so (soname libSDL2-2.0.so.0) + the
# unversioned libSDL2.so link; pacman 7.1 derives versioned provides from them.
# SUPERSEDES BOTH sdl2 AND sdl2-compat (user decision): host stock sdl2-compat
# PROVIDES sdl2 and CONFLICTS sdl2 — real SDL2 must conflict both names or the
# SDL3-backed shim lingers beside the real library double-providing the sdl2
# ABI. Only sdl2 is version-provided; a bare 'sdl2-compat' provide is
# deliberately NOT added (dependents should bind to real SDL2's ABI, not
# silently accept a shim with a different one).
conflicts=('sdl2' 'sdl2-compat')
# real SDL2 lives on the SDL2 branch (upstream default branch is SDL3);
# SDL_RPI/SDL_STATIC/SDL_ASSERTIONS kept from the AUR reference
source=('SDL::git+https://github.com/libsdl-org/SDL.git#branch=SDL2')
b2sums=('SKIP')

pkgver() {
  cd SDL
  git describe --long --tags | sed 's/^release-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # fat LTO objects kept from stock sdl2-compat (link-time opt, not an
  # -O3/-march/-mtune flag); CMAKE_BUILD_TYPE=None: stock convention, uses
  # makepkg CFLAGS and adds no -O3
  CFLAGS+=" -ffat-lto-objects"

  cmake -S SDL -B build -G Ninja \
    -D CMAKE_BUILD_TYPE=None \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D SDL_RPI=OFF \
    -D SDL_STATIC=OFF \
    -D SDL_RPATH=OFF \
    -D SDL_ASSERTIONS=disabled
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 SDL/LICENSE.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
