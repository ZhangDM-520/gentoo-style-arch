# Maintainer: Ivan Shapovalov <intelfx@intelfx.name>
# Contributor: Tom Gundersen <teg@jklm.no>
# Contributor: Ionut Biru <ionut@archlinux.ro>
# Contributor: Gabriel Martinez < reitaka at gmail dot com >
# Contributor: Adam Eberlin < ae at adameberlin dot com >
# Class A git recipe: tracks upstream libimobiledevice/libplist git directly
# (HEAD). AUR libplist-git and stock libplist are REFERENCES ONLY. The AUR
# reference's epoch=1 is stale AUR history — dropped (stock has no epoch).

pkgname=libplist-git
pkgver=2.7.0.r0.gfe3dc34dc3
pkgrel=1
pkgdesc="A library to handle Apple Property List files (git build)"
url="https://libimobiledevice.org/"
arch=('x86_64')
license=('LGPL-2.1-or-later')
depends=('gcc-libs' 'glibc')
makedepends=('cython' 'git' 'python' 'python-setuptools')
optdepends=('python: Python bindings')
# sonames shipped: libplist-2.0.so.4, libplist++-2.0.so.4
provides=("libplist=$pkgver" 'libplist-2.0.so' 'libplist++-2.0.so')
conflicts=('libplist')
source=("git+https://github.com/libimobiledevice/libplist.git")
b2sums=('SKIP')

pkgver() {
  cd libplist
  git describe --long --tags | sed 's/[^-]*-g/r&/;s/-/./g'
}

prepare() {
  cd libplist
  NOCONFIGURE=1 ./autogen.sh
}

build() {
  cd libplist

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --localstatedir=/var
  sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
  make
}

check() {
  cd libplist
  make check
}

package() {
  cd libplist
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
