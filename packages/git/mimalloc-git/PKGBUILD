# Contributor: Ranieri Althoff <ranisalt+aur at gmail dot com>

# shellcheck shell=bash
# shellcheck disable=2034,2154,2312

_pkgbase=mimalloc
pkgname=mimalloc-git
pkgver=3.5.4.r0.gf8401bef
pkgrel=1
pkgdesc='General-purpose allocator with excellent performance characteristics'
arch=('x86_64')
url='https://github.com/microsoft/mimalloc'
license=('MIT')
conflicts=("${_pkgbase}")
provides=("${_pkgbase}" 'libmimalloc.so')
depends=('glibc')
makedepends=('git' 'cmake')
source=("${pkgname}::git+${url}#branch=dev3")
sha256sums=('SKIP')
options=('staticlibs')
sha256sums=('SKIP')

pkgver() {
  cd "${pkgname}" || exit 1
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  # Profile dir lives OUTSIDE build/ — phase 3 does `rm -rf build` and
  # must not delete the profile data it is about to consume.
  rm -rf pgo-profiles && mkdir -p pgo-profiles

  # Phase 1: instrumented build (LTO off for speed)
  # -fprofile-update=atomic: training runs multi-threaded stress tests;
  # default 'single' counter updates race and corrupt the .gcda
  # (profile-use then fails with "corrupted profile info" / negative counts).
  msg "PGO Phase 1: instrumented build"
  cmake \
    -B build \
    -S "${pkgname}" \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBEXECDIR=lib \
    -D MI_BUILD_OBJECT=OFF \
    -D MI_INSTALL_TOPLEVEL=ON \
    -D CMAKE_C_FLAGS="-fprofile-generate=$(pwd)/pgo-profiles -fprofile-update=atomic" \
    -D CMAKE_CXX_FLAGS="-fprofile-generate=$(pwd)/pgo-profiles -fprofile-update=atomic" \
    -D CMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold -fprofile-generate=$(pwd)/pgo-profiles" \
    -D CMAKE_SHARED_LINKER_FLAGS="-fuse-ld=mold -fprofile-generate=$(pwd)/pgo-profiles"

  cmake --build build

  # Phase 2: training — run test suite
  msg "PGO Phase 2: training with test suite"
  (cd build && ctest --output-on-failure 2>/dev/null || true)

  # Verify profile data
  # NOTE: -fprofile-generate=<dir> routes ALL .gcda files into that dir
  local gcda_count=$(find pgo-profiles -name '*.gcda' 2>/dev/null | wc -l)
  if [ "$gcda_count" -eq 0 ]; then
    warning "No profile data generated — falling back to LTO-only build"
    rm -rf build
    cmake \
      -B build \
      -S "${pkgname}" \
      -D CMAKE_BUILD_TYPE=Release \
      -D CMAKE_INSTALL_PREFIX=/usr \
      -D CMAKE_INSTALL_LIBEXECDIR=lib \
      -D MI_BUILD_OBJECT=OFF \
      -D MI_INSTALL_TOPLEVEL=ON \
      -D CMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold" \
      -D CMAKE_SHARED_LINKER_FLAGS="-fuse-ld=mold"
    cmake --build build
    rm -rf pgo-profiles
    return 0
  fi
  msg "Profile data generated: $gcda_count .gcda files"

  # Phase 3: rebuild with profile + LTO
  msg "PGO Phase 3: optimized build"
  rm -rf build
  cmake \
    -B build \
    -S "${pkgname}" \
    -D CMAKE_BUILD_TYPE=Release \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_INSTALL_LIBEXECDIR=lib \
    -D MI_BUILD_OBJECT=OFF \
    -D MI_INSTALL_TOPLEVEL=ON \
    -D CMAKE_INTERPROCEDURAL_OPTIMIZATION=ON \
    -D CMAKE_C_FLAGS="-fprofile-use=$(pwd)/pgo-profiles" \
    -D CMAKE_CXX_FLAGS="-fprofile-use=$(pwd)/pgo-profiles" \
    -D CMAKE_EXE_LINKER_FLAGS="-fuse-ld=mold -fprofile-use=$(pwd)/pgo-profiles" \
    -D CMAKE_SHARED_LINKER_FLAGS="-fuse-ld=mold -fprofile-use=$(pwd)/pgo-profiles"

  cmake --build build
  rm -rf pgo-profiles
}

check() {
  cd build || exit 1
  ctest --output-on-failure
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
  install -vDm644 -t "${pkgdir}/usr/share/licenses/${pkgname}" "${pkgname}/LICENSE"

  # Create a symlink for mimalloc 2.x compatibility (needed by e.g. mold)
  ln -sv libmimalloc.so "${pkgdir}/usr/lib/libmimalloc.so.2"
}
