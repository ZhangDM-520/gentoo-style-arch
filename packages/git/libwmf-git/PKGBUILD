# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

# git recipe tracking upstream libwmf VCS (AUR libwmf-git used as reference
# only)

pkgname=libwmf-git
pkgver=0.2.16.r3.g63f93ca
pkgrel=1
pkgdesc="A library for reading vector images in Microsoft's native Windows Metafile Format (git build)"
arch=('x86_64')
url='https://github.com/caolanm/libwmf'
license=('LGPL-2.1-or-later')
# gd/gdk-pixbuf2/glib2 are configure-auto-detected and hard-linked into the
# shipped payloads (libgd.so.3 x3, libgdk_pixbuf-2.0.so.0, libglib-2.0.so.0),
# so they are runtime links, not optional extras — not trimmable (rule 54,
# 2026-10-15 declared-deps sweep)
depends=('expat' 'freetype2' 'gd' 'gdk-pixbuf2' 'glib2' 'glibc' 'libjpeg-turbo' 'libpng' 'libx11' 'zlib')
# gtk2 dropped from makedepends 2026-10-10: upstream's configure.ac has no
# GTK usage and the shipped outputs link no gtk2 — it was dead weight that
# leaked a gtk2 install onto the system and later conflicted with the
# gtk2-compat pinentry build
makedepends=('git' 'libxt')
# bare soname provides for the shipped libs: libwmf-0.2.so.7, libwmflite-0.2.so.7
provides=("libwmf=$pkgver" 'libwmf-0.2.so' 'libwmflite-0.2.so')
conflicts=('libwmf')
options=('staticlibs')
source=('git+https://github.com/caolanm/libwmf.git')
b2sums=('SKIP')

pkgver() {
  cd libwmf
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  cd libwmf
  autoreconf -fi
  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  cd libwmf
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
