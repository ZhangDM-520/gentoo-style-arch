# git build adapted from AUR libraw-git (reference only) + stock Arch libraw:
# tracks upstream master directly (stock pins release tags).

pkgname=libraw-git
_pkgname=LibRaw
pkgver=0.22.1.r60.g823f25da
pkgrel=1
pkgdesc="A library for reading RAW files obtained from digital photo cameras (git build)"
arch=('x86_64')
url="https://www.libraw.org/"
license=('CDDL-1.0' 'LGPL-2.1-only')
depends=('glibc' 'lcms2' 'libgcc' 'libgomp' 'libjpeg-turbo' 'libstdc++' 'zlib')
makedepends=('git')
provides=("libraw=$pkgver" 'libraw.so' 'libraw_r.so')
conflicts=('libraw')
source=("git+https://github.com/LibRaw/${_pkgname}.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"

  local _tag _rev _hash
  _tag=$(git tag -l --sort -v:refname | head -n1)
  _rev=$(git rev-list --count "$_tag"..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/-/_/g'
}

prepare() {
  cd "$_pkgname"
  autoreconf -fiv
}

build() {
  cd "$_pkgname"

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd "$_pkgname"

  make DESTDIR="$pkgdir" install
  install -Dm644 COPYRIGHT LICENSE.CDDL LICENSE.LGPL -t "$pkgdir/usr/share/licenses/$pkgname/"
}
