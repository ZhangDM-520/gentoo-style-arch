pkgbase=openal-git
pkgname=(
  openal-git
  openal-examples-git
)
pkgver=1.25.2.r219.g49f28b69
pkgrel=1
pkgdesc="Cross-platform 3D audio library, software implementation (git build)"
arch=('x86_64')
url="https://github.com/kcat/openal-soft"
license=('LGPL-2.0-or-later')
makedepends=(
  alsa-lib
  cmake
  ffmpeg
  fluidsynth
  git
  jack
  libmysofa
  libpulse
  libsndfile
  ninja
  pipewire
  portaudio
  qt6-base
  sdl3
)
source=('openal-soft::git+https://github.com/kcat/openal-soft.git')
b2sums=('SKIP')

pkgver() {
  cd openal-soft
  # upstream also carries a moving "latest" tag and the util "makemhr" tag —
  # both must be excluded or describe() picks them up
  git describe --long --tags --exclude=makemhr --exclude=latest \
    --match '[0-9]*' --match 'openal-soft-*' \
    | sed 's/^openal-soft-//;s/-/.r/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # CMAKE_BUILD_TYPE=None: stock convention — uses makepkg CFLAGS, adds no -O3
  # Modules off (ALSOFT_ENABLE_MODULES=OFF + CMAKE_CXX_SCAN_FOR_MODULES=OFF +
  # CMAKE_CXX_MODULE_STD=OFF): CMake 4 auto-enables per-TU module scanning on
  # compilers claiming module support, and that path does not survive the
  # GCC-snapshot toolchain (run #120, 2026-10-10): CMake synthesized the std
  # module from the toolchain's own bits/std.cc under upstream's -Werror=undef
  # promotion, and scanned TUs lost al::Device::OutputMode1's enumerators
  # mid-compile (module entity merge). The upstream option alone does NOT
  # stop the scanning (it only gates the .cppm targets) — all three flags are
  # needed. Content-neutral: install() ships only the public_headers FILE set.
  cmake -S openal-soft -B build -G Ninja \
    -D CMAKE_INSTALL_PREFIX=/usr \
    -D CMAKE_BUILD_TYPE=None \
    -D ALSOFT_ENABLE_MODULES=OFF \
    -D CMAKE_CXX_SCAN_FOR_MODULES=OFF \
    -D CMAKE_CXX_MODULE_STD=OFF \
    -D CMAKE_INSTALL_LIBDIR=lib
  cmake --build build --parallel "${GSA_BUILD_JOBS:-$(nproc)}"
}

_pick() {
  local p="$1" f d; shift
  for f; do
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

package_openal-git() {
  depends=(
    glibc
    libgcc
    libstdc++
  )
  optdepends=(
    'qt6-base: alsoft-config GUI Configurator'
    'fluidsynth: MIDI rendering'
    'libmysofa: makemhr tool'
  )
  provides=("openal=$pkgver" 'libopenal.so')
  # bare libopenal.so: pacman 7.1 derives libopenal.so=1-64 (soname
  # libopenal.so.1); stock's openal-examples split kept below
  conflicts=('openal')

  DESTDIR="$pkgdir" cmake --install build
  install -Dt "$pkgdir/usr/share/doc/openal" -m644 openal-soft/docs/*

  cd "$pkgdir"
  _pick _examples usr/bin/al{direct,ffplay,hrtf,latency,loopback,multireverb}
  _pick _examples usr/bin/al{debug,lafplay,play,record,reverb,stream,tonegen}

  install -Dm644 "$srcdir"/openal-soft/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_openal-examples-git() {
  pkgdesc="OpenAL Soft example programs (git build)"
  depends=(
    "openal-git=$pkgver-$pkgrel"
    ffmpeg
    libsndfile
    sdl3
  )
  provides=("openal-examples=$pkgver")
  conflicts=('openal-examples')

  mv _examples/* "$pkgdir"
  install -Dm644 openal-soft/COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
