# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

pkgname=jemalloc-git
pkgver=5.4.0.r38.g250120f2
pkgrel=1
pkgdesc="General purpose malloc implementation"
arch=('i686' 'x86_64')
url="https://jemalloc.net/"
license=('BSD')
depends=('glibc' 'sh')
makedepends=('git')  # docbook-xsl dropped 2026-09-04: man pages ship pregenerated
optdepends=('perl: for running jeprof')
provides=("jemalloc=$pkgver" 'libjemalloc.so')
conflicts=('jemalloc')
source=("git+https://github.com/jemalloc/jemalloc.git")
sha256sums=('SKIP')


pkgver() {
  cd "jemalloc"

  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd "jemalloc"

  export LDFLAGS="$LDFLAGS -fuse-ld=mold"
  ./autogen.sh \
    --prefix="/usr" \
    CFLAGS="$CFLAGS -flto" \
    CXXFLAGS="$CXXFLAGS -flto"
  make
}

check() {
  cd "jemalloc"

  make check
}

package() {
  cd "jemalloc"

  make dist
  make DESTDIR="$pkgdir" install
  install -Dm644 "COPYING" -t "$pkgdir/usr/share/licenses/jemalloc"

  find "$pkgdir" -name \*.a -type f -exec chmod 644 '{}' \;
}
