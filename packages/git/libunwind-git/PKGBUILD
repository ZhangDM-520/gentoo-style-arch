pkgname=libunwind-git
pkgver=1.8.3.r0.g44aa1a5
pkgrel=1
pkgdesc="Portable and efficient C programming interface (API) to determine the call-chain of a program"
arch=('i686' 'x86_64')
url="https://www.nongnu.org/libunwind/"
license=('MIT')
depends=('glibc' 'xz' 'zlib')
makedepends=('git')  # texlive-core dropped 2026-09-05: latex is only used for optional PDF docs
provides=("libunwind=$pkgver"
          'libunwind.so'
          'libunwind-x86_64.so'
          'libunwind-coredump.so'
          'libunwind-ptrace.so'
          'libunwind-setjmp.so')
conflicts=('libunwind')
options=('staticlibs')
# soname provides must be DECLARED explicitly (mirrors repo libunwind):
# bare stems only — makepkg auto-versions each from the packaged ELF soname
# at package time (house rule: never hand-pin the version). Without these,
# gimp's 'libunwind.so=8-64' dep breaks on install.
# PARKED 2026-10-08 at the last safe generation: master carries SOVERSION
# 11:0:0 (soname .so.11) while every installed linker wants .so.8 — unpin and
# heal gperftools/libplacebo/libcamera-git/gstreamer/xorg-server* in one batch.
source=("git+https://github.com/libunwind/libunwind.git#tag=v1.8.3")
sha256sums=('SKIP')


pkgver() {
  cd "libunwind"

  _tag=$(git tag -l --sort -v:refname | grep -E '^v?[0-9\.]+$' | head -n1)
  _rev=$(git rev-list --count $_tag..HEAD)
  _hash=$(git rev-parse --short HEAD)
  printf "%s.r%s.g%s" "$_tag" "$_rev" "$_hash" | sed 's/^v//'
}

build() {
  cd "libunwind"

  autoreconf -fi
  ./configure \
    --prefix="/usr"
  make
}

check() {
  cd "libunwind"

  make check
}

package() {
  cd "libunwind"

  make DESTDIR="$pkgdir" install
  install -Dm644 "COPYING" -t "$pkgdir/usr/share/licenses/libunwind"
}
