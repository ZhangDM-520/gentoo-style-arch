# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

# git recipe tracking the upstream xorg libX11 VCS (AUR libx11-git used as
# reference only)

pkgname=libx11-git
pkgver=1.8.13.r12.g6d4432b
pkgrel=2
pkgdesc='Core X11 protocol client library (git build)'
arch=('x86_64')
url='https://www.x.org/wiki/'
license=('MIT AND X11')
depends=('glibc' 'libxcb' 'xorgproto')
makedepends=('git' 'xorg-util-macros' 'xtrans')
provides=("libx11=$pkgver" 'libX11.so' 'libX11-xcb.so')
conflicts=('libx11')
options=('staticlibs')
source=('git+https://gitlab.freedesktop.org/xorg/lib/libx11.git')
b2sums=('SKIP')

pkgver() {
  cd libx11
  git describe --long --tags | sed 's/^libX11-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  # Documented exception (glibc-git/python/jq/sqlite/nodejs/guile class,
  # NOTE.md 2026-11-01): aggressive optimization makes GCC-snapshot's
  # bounds analysis ICE-clean but WRONG under the inlining —
  # -Werror=array-bounds fires on imDefIc.c/_XimProtoDestroyIC "array
  # subscript 4 outside char[8]" (a subscript inside the declared array;
  # run 0324). Policy lane executed 2026-11-01: level dropped to -O3 first
  # (the substitution below is a no-op guard now the host is at -O3); the
  # wall PERSISTED at -O3 under LTO (run 1517) — scoped follow-up applied:
  # guard lowering -Wno-error=array-bounds (backstop) plus the
  # --disable-selective-werror configure knob (drops the project's own
  # -Werror promotions; warnings stay disclosed in the log). NOTE.md.
  CFLAGS=${CFLAGS/-Ofast/-O3}
  CXXFLAGS=${CXXFLAGS/-Ofast/-O3}
  CFLAGS+=" -Wno-error=array-bounds"
  CXXFLAGS+=" -Wno-error=array-bounds"

  cd libx11
  NOCONFIGURE=1 ./autogen.sh
  ./configure \
    --prefix=/usr \
    --disable-xf86bigfont \
    --disable-selective-werror
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

package() {
  cd libx11
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
