# Maintainer: a821 at mail de
# Contributor: Matt Coffin <mcoffin13@gmail.com>
# Recipe adapted for the gentoo-style-arch fleet; tracks upstream VCS directly.
# The AUR package of the same name was used as a reference only.

pkgname=bzip2-git
pkgver=r181.66c46b8
pkgrel=3
pkgdesc="A high-quality data compression program (git build)"
arch=('x86_64')
url="https://gitlab.com/bzip2/bzip2"
license=('custom')
depends=('bash' 'glibc')
makedepends=('git' 'meson')
provides=("bzip2=$pkgver" 'libbz2.so')
conflicts=('bzip2')
source=("git+https://gitlab.com/bzip2/bzip2.git")
b2sums=('SKIP')

# upstream master dropped the classic Makefile (verified upstream: only
# meson.build/CMakeLists.txt remain), so meson is the build system here —
# the AUR reference already used it. No upstream tags on this line, so
# rev-count versioning (seatd-git house style).
pkgver() {
  cd bzip2

  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  arch-meson bzip2 build \
    -D docs=disabled
  meson compile -C build -j "${GSA_BUILD_JOBS:-$(nproc)}"
}

prepare() {
  # trim: upstream includes subdir('tests') unconditionally and
  # tests/meson.build hard-errors at CONFIGURE time when python-pytest is
  # absent (there is no meson 'tests' option to turn it off), while the
  # house build env runs no checks and installs no checkdepends. The suite
  # trains nothing (no PGO phase here), so the test subdir is dropped at
  # its inclusion point together with check()/checkdepends — the libei-git
  # "test-only deps dropped with the tests" shape.
  sed -i "/subdir('tests')/d" bzip2/meson.build

  # soname pin: upstream's meson port versioned the library by libtool rules
  # (current-age=1) and moved the soname to libbz2.so.1, but the whole
  # installed ecosystem — including pacman itself (ldd /usr/bin/pacman →
  # libarchive → libbz2.so.1.0) — links libbz2.so.1.0 and depends on
  # libbz2.so=1.0-64. Shipping the new soname makes this a soname swap that
  # nothing can survive: the file libbz2.so.1.0 vanishes, every consumer and
  # pacman fail to load, and the run cannot even rebuild them (each install
  # is a pacman call). Keep the ecosystem soname: the file version
  # (1.0.9) and the public BZ2_* API are unchanged (verified symbol-for-symbol
  # against 1.0.8; only 11 internal accident-exports disappear behind
  # gnu_symbol_visibility: 'hidden'). Revisit when the Arch ecosystem itself
  # moves to bzip2 1.1 / libbz2.so.1.
  sed -i "s/^bz2_soversion   = bz2_lt_current - bz2_lt_age$/bz2_soversion   = '1.0'/" bzip2/meson.build
  sed -i "s/format(bz2_soversion, bz2_lt_age, bz2_lt_revision)/format('1', bz2_lt_age, bz2_lt_revision)/" bzip2/meson.build
  # fail closed: if upstream refactors the versioning block, the seds silently
  # no-op and the soname swap returns — refuse to build instead.
  grep -q "^bz2_soversion   = '1.0'" bzip2/meson.build || {
    echo "bzip2-git: soname pin failed to apply (upstream meson.build changed)" >&2
    return 1
  }
}

package() {
  meson install -C build --destdir "$pkgdir"

  # stock-name pkg-config: upstream's meson pkg.generate names the pc file
  # after the library target (bz2.pc, Name: bz2), but the ecosystem
  # contract — stock Arch shipped it, and freetype2.pc carries
  # `Requires.private: ... bzip2 ...` — is the name `bzip2`. Without it
  # every pkg-config consumer of freetype2 fails (run #37 fontconfig-git
  # wall: meson fell through to a wrap subproject and hard-errored).
  # Derive bzip2.pc from the generated file so Version/Libs/Cflags stay in
  # sync with the build; keep bz2.pc as well (additive, upstream's name).
  local _bz2pc="$pkgdir/usr/lib/pkgconfig/bz2.pc"
  if [[ ! -f $_bz2pc ]] || ! grep -q '^Name: bz2$' "$_bz2pc"; then
    echo "bzip2-git: generated bz2.pc missing or reshaped (upstream meson changed)" >&2
    return 1
  fi
  sed 's/^Name: bz2$/Name: bzip2/' "$_bz2pc" > "$pkgdir/usr/lib/pkgconfig/bzip2.pc"

  install -Dm644 bzip2/COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
