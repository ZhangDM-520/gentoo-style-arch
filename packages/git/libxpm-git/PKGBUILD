# Maintainer: auto-generated (Class A upstream-VCS recipe)
# Contributor: Chocobo1 <chocobo1 AT archlinux DOT net> (AUR libxpm-git reference)
# Contributor: Andreas Radke <andyrtr@archlinux.org> (stock libxpm)
# Contributor: Jan de Groot <jgc@archlinux.org>

pkgname=libxpm-git
pkgver=3.5.19.r3.g58eb875
pkgrel=1
pkgdesc="X11 pixmap library (git build)"
arch=('x86_64')
url="https://xorg.freedesktop.org/"
license=('MIT' 'X11-distribute-modifications-variant')
depends=('libxt' 'libxext' 'libx11' 'glibc')
makedepends=('git' 'xorg-util-macros')
provides=("libxpm=$pkgver" 'libXpm.so')
# bare libXpm.so entry: pacman 7.1 auto-derives the versioned soname provide
# (libXpm.so=4-64) from it; soname at 3.5.x is libXpm.so.4
conflicts=('libxpm')
# stock verifies signed release tags (?signed#tag=, validpgpkeys: Olivier
# Fourdan); master-tracking cannot pin a tag and makepkg's verify_git_signature
# would run `git verify-commit HEAD` on unsigned commits — tracked unsigned,
# no --skippgpcheck anywhere
source=('git+https://gitlab.freedesktop.org/xorg/lib/libxpm.git')
b2sums=('SKIP')

pkgver() {
  cd libxpm
  git describe --long --tags | sed 's/^libXpm-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

prepare() {
  cd libxpm
  autoreconf -fiv
}

build() {
  cd libxpm

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --disable-static \
    --disable-open-zfile
  make -j"${GSA_BUILD_JOBS:-$(nproc)}"
}

package() {
  cd libxpm
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
