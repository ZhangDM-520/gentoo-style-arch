license=('MIT-open-group')
depends=(
  glibc
  libgcc
  libstdc++
)
makedepends=(
  git
)
optdepends=('bash: for ncursesw6-config')
provides=(
  "ncurses=$pkgver"
  libncurses++w.so
  libformw.so
  libmenuw.so
  libpanelw.so
  libncursesw.so
)
# bare soname entries kept from stock (ABI 6: *.so.6); pacman 7.1 derives the
# versioned soname provides from them
conflicts=('ncurses')
replaces=(
  alacritty-terminfo
  rio-terminfo
  wezterm-terminfo
)
# upstream signs release snapshot tags (stock: ?signed#tag=v$pkgver,
# validpgpkeys 19882D92... Thomas Dickey); master-tracking cannot pin a tag and
# makepkg's ?signed on a branch source runs `git verify-commit HEAD`, which the
# snapshots do not carry — tracked unsigned, no --skippgpcheck
source=(
  ncurses::git+https://github.com/ThomasDickey/ncurses-snapshots.git
  ncurses-6.6-libs.patch
  ncurses-6.6-pkgconfig.patch
)
b2sums=('SKIP'
