# Maintainer: Chocobo1 <chocobo1 AT archlinux DOT net>

# git recipe tracking the upstream xorg libXi VCS (AUR libxi-git used as
# reference only)

pkgname=libxi-git
pkgver=1.8.3.r1.g3a0adab
pkgrel=1
pkgdesc='X11 Input extension library (git build)'
arch=('x86_64')
url='https://www.x.org/wiki/'
license=('MIT-open-group' 'SMLNJ' 'MIT')
depends=('glibc' 'libx11' 'libxext' 'libxfixes' 'xorgproto')
makedepends=('git' 'xorg-util-macros')
provides=("libxi=$pkgver" 'libXi.so')
conflicts=('libxi')
options=('staticlibs')
source=('git+https://gitlab.freedesktop.org/xorg/lib/libxi.git')
b2sums=('SKIP')

pkgver() {
  cd libxi
  git describe --long --tags | sed 's/^libXi-//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  cd libxi
  NOCONFIGURE=1 ./autogen.sh
  ./configure --prefix=/usr
  make -j"${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"
}

check() {
  cd libxi
  make check
}

package() {
  cd libxi
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname/"
}
