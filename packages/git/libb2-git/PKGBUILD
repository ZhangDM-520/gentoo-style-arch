pkgname=libb2-git
_pkgname=libb2
pkgver=0.98.1.r22.g643decf
pkgrel=1
pkgdesc="C library providing BLAKE2b, BLAKE2s, BLAKE2bp, BLAKE2sp hash functions (git build)"
arch=('x86_64')
url="https://blake2.net/"
license=('CC0-1.0')
depends=('glibc' 'libgcc' 'libgomp')
makedepends=('git')
provides=("libb2=$pkgver" 'libb2.so')
conflicts=('libb2')
source=("git+https://github.com/BLAKE2/${_pkgname}.git")
b2sums=('SKIP')

prepare() {
  cd "$_pkgname"
  autoreconf -vi
}

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  local _jobs="${GSA_BUILD_JOBS:-$(getconf _NPROCESSORS_ONLN)}"

  # libb2's build system discards $CFLAGS; put them in $CC instead (stock libb2)
  export CC="${CC-cc} $CFLAGS"

  cd "$_pkgname"

  # Pulls in SSE2, x86_64 only (stock libb2)
  local _fat_option
  if [ "$CARCH" = "x86_64" ]; then
    _fat_option=--enable-fat
  else
    _fat_option=--disable-fat
  fi

  ./configure --prefix=/usr \
              --disable-static \
              --enable-shared \
              --disable-native \
              "$_fat_option"
  make -j "$_jobs"
}

package() {
  cd "$_pkgname"
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
