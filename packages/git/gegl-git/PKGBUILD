_pkgname=gegl
pkgname="${_pkgname}-git"
pkgver=0.4.73.r11485.75214d1e6
pkgrel=1
pkgdesc="Graph based image processing framework"
arch=('i686' 'x86_64')
url="https://www.gegl.org"
license=('GPL3' 'LGPL3')
depends=('babl>=0.1.116'
         'libspiro>=0.5.0'
         'json-glib>=1.0.0'
         # virtual sdl2: stock sdl2-compat and the house sdl2-git swap both
         # provide it — a concrete provider name blocks the swap's removal
         # (run #121 wall, 2026-10-10)
         'sdl2>=2.0.5')
makedepends=('git' 'meson' 'intltool' 'python' 'ruby'
             'luajit>=2.0.4'
             'libraw>=0.15.4'
             'openexr>=1.6.1'
             'ffmpeg'
             'librsvg>=2.40.6'
             'jasper>=1.900.1'
             'libtiff>=4.0.0'
             'libnsgif>=1.0.0'
             'exiv2>=0.14.0'
             'libgexiv2>=0.14.0'
             'lensfun>=0.2.5'
             'vala'
             'python-gobject>=3.2.0'
             'suitesparse'
             'gobject-introspection')
optdepends=('openexr: for using the openexr plugin'
            'ffmpeg: for using the ffmpeg plugin'
            'librsvg: for using the svg plugin'
            'libtiff: tiff plugin'
            'jasper: for using the jasper plugin'
            'libraw: raw plugin'
            'suitesparse: matting-levin plugin'
            'luajit: lua plugin'
            'libgexiv2: for image metadata'
            'lensfun: for lens distortion'
            'libnsgif: gif plugin')
provides=("gegl=${pkgver%%.r*}"
          # Bare sonames: makepkg versions them at packaging time from the
          # built libs' SONAMEs (makepkg 7.1 doesn't derive provides without
          # a declaration, and versioned entries like libgegl-npd-0.4.so=...
          # fail PKGBUILD lint). Without these, repo gimp's soname deps break
          # on the gegl→gegl-git swap and gimp-git's dep derivation can't
          # resolve the libs.
          'libgegl-0.4.so'
          'libgegl-npd-0.4.so'
          'libgegl-sc-0.4.so')
conflicts=('gegl')
options=(!libtool)
source=('git+https://gitlab.gnome.org/GNOME/gegl.git')
sha512sums=('SKIP')

pkgver() {
  cd ${srcdir}/${_pkgname}
  printf "%s.r%s.%s" \
    $(grep -ozP "(?s)^project\('gegl'.*?version: *'\K[0-9.]*" meson.build|tr '\0' '\n') \
    $(git rev-list --count HEAD) \
    $(git rev-parse --short HEAD)
}

build() {
  # gcc-snapshot compatibility
  export CFLAGS+=" -Wno-error=implicit-function-declaration"

  # House style: mold linker when available (arch-meson consumes LDFLAGS env)
  local _mold=""
  command -v mold >/dev/null 2>&1 && _mold="-fuse-ld=mold"
  export LDFLAGS+=" ${_mold}"

  # mrg + maxflow aren't packaged in Arch repos; meson-git's arch-meson
  # passes --auto-features enabled which turns these 'auto' features into
  # hard configure errors. Stock gegl ships neither mrg-gegl nor
  # matting-global, so disable explicitly for feature parity.
  arch-meson "${_pkgname}" build -Dworkshop=true -Dmrg=disabled -Dmaxflow=disabled
  meson compile -C build
}

package() {
  DESTDIR="${pkgdir}" meson install -C build
}

