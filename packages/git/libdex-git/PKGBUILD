# Maintainer: auto-generated
pkgname=libdex-git
_pkgname=libdex
pkgver=1.2.0.r13.gdd075ea
pkgrel=1
pkgdesc="A library supporting Deferred Execution (git build)"
arch=('x86_64')
url="https://gitlab.gnome.org/GNOME/libdex"
license=('LGPL-2.1-or-later')
depends=('glib2' 'glibc' 'libatomic' 'liburing')
makedepends=('git' 'meson' 'sysprof')  # gi/vala/python-gobject dropped 2026-09-04: x-d-p uses the C API only
provides=("libdex" "libdex-1.so")
conflicts=('libdex')
source=("git+https://gitlab.gnome.org/GNOME/${_pkgname}")
b2sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  git describe --long --tags | sed 's/\([^-]*-g\)/r\1/;s/-/./g;s/^v//'
}

build() {
  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  arch-meson "$_pkgname" build \
    -D b_lto=true \
    -D b_ndebug=true \
    -D docs=false \
    -D examples=false \
    -D tests=false \
    -D introspection=disabled \
    -D vapi=false \
    -D liburing=enabled
  meson compile -C build
}

package() {
  meson install -C build --destdir "$pkgdir"
}
