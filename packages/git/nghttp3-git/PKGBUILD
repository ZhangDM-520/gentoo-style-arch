# Maintainer: Atle Solbakken <atle@goliathdns.no>
# Class A git recipe: tracks upstream ngtcp2/nghttp3 git directly (HEAD).
# AUR nghttp3-git is the naming reference; STOCK NAME SUPERSEDED: libnghttp3
# (id stays nghttp3-git per batch decision — AUR naming drift nghttp3 vs
# libnghttp3). Stock's submodule redirect list copied verbatim.

pkgname=nghttp3-git
pkgver=1.18.0.r0.g2304973e5a
pkgrel=1
pkgdesc="HTTP/3 library written in C (git build)"
arch=('x86_64')
url="https://github.com/ngtcp2/nghttp3"
license=('MIT')
depends=('glibc')
makedepends=('git')
# soname shipped: libnghttp3.so.9
# stock output superseded: libnghttp3; 'nghttp3' kept for AUR-era consumers
provides=("libnghttp3=$pkgver" 'libnghttp3.so' 'nghttp3')
conflicts=('libnghttp3' 'nghttp3')
source=('git+https://github.com/ngtcp2/nghttp3.git'
        'git+https://github.com/ngtcp2/munit.git'
        'git+https://github.com/ngtcp2/sfparse.git')
b2sums=('SKIP' 'SKIP' 'SKIP')

prepare() {
  cd nghttp3

  git config --file=.gitmodules submodule.tests/munit.url ../munit/
  git config --file=.gitmodules submodule.lib/sfparse.url ../sfparse/

  git submodule init
  git -c protocol.file.allow=always submodule update

  autoreconf -i
}

pkgver() {
  cd nghttp3
  git describe --long --tags | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g'
}

build() {
  cd nghttp3

  if command -v mold >/dev/null 2>&1; then
    export LDFLAGS+=" -fuse-ld=mold"
  fi

  ./configure \
      --prefix=/usr
  make
}

check() {
  cd nghttp3
  make check
}

package() {
  cd nghttp3
  make DESTDIR="$pkgdir" install
  install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$pkgname"
}
