pkgver() {
  cd "${_pkgname}"

  # Upstream moved the version out of meson.build into a VERSION file (meson reads
  # `version: files('VERSION')` now), and the sed below stopped matching, producing an
  # empty prefix like `.r5671.g…`. Read whichever of the two layouts is present.
  local version
  version="$(sed -n "s/^  version: '\([^']*\)',/\1/p" meson.build)"
  if [ -z "${version}" ] && [ -f VERSION ]; then
    version="$(<VERSION)"
  fi
  printf '%s.r%s.g%s' "${version}" "$(git rev-list --count HEAD)" "$(git rev-parse --short=9 HEAD)"
}

prepare() {
  cd "${_pkgname}"

  # Locking must not undo the idle chain. Re-arming notifications ran the resume action of every
  # already-idled behaviour, and screen_off's resume action is PowerOnMonitors - so the panel lit
  # back up the moment the session locked, then had to wait out the blanking timeout again.
  # Candidate upstream fix, PR #4002 (fixes #4190), snapshotted from its head 9d530d40 as a
  # code-only diff — the PR's docs/user/services/idle.mdx hunks are excluded. Refresh the
  # snapshot whenever #4002 gains commits (pre-flight `git apply -3` against current main first:
  # this source floats on #branch=main); drop the patch, its source/sha256sums entry and this
  # prepare() once #4002 merges. The -dirty version suffix is the reminder that the patch is in.
  # Verified on niri 26.04: /sys/class/drm/<connector>/dpms goes On at the lock without it.
  git apply -3 ../0001-idle-lock-resume-and-inhibit-tracking.patch
}

# Run the PGO training workload: exercise the real shell under a headless sway
# session plus every headless CLI subcommand, so GCC's atexit handler can write
# the .gcda profile data. XDG config/cache/data state is sandboxed under $work;
# XDG_RUNTIME_DIR is a short private /tmp dir (created here, removed on the
# single fall-through exit path below).
_pgo_train() {
  local work="$1"
  local bin="build-release/noctalia"

  # 2026-09-23 incident: sway's IPC socket (sway-ipc.<pid>.<rand>.sock) lives
  # inside XDG_RUNTIME_DIR, and the whole path must fit the 108-byte Unix
  # sun_path — the ~93-char $srcdir sandbox path plus the socket name overflowed
  # it ("Socket path won't fit into ipc_sockaddr->sun_path"), the training sway
  # SEGVed, GUI training never ran, and only 1 .gcda was collected. Train under
  # a short private /tmp dir instead (house precedent: mold-git, easyeffects-git).
  local rt_dir
  if ! rt_dir="$(mktemp -d /tmp/nct-pgo-rt.XXXXXX)"; then
    # mktemp created nothing on failure, so there is no dir to tear down here;
    # build()'s gcda-count check falls back to -Db_pgo=off for this run.
    error "could not create the short XDG_RUNTIME_DIR for PGO training"
    return 1
  fi
  chmod 700 "$rt_dir"   # mktemp already creates it mode 700; pin it anyway

  export XDG_CONFIG_HOME="$work/config"
  export XDG_CACHE_HOME="$work/cache"
  export XDG_DATA_HOME="$work/data"
  export XDG_RUNTIME_DIR="$rt_dir"
  export NOCTALIA_ASSETS_DIR="$PWD/${_pkgname}/assets"
  export NOCTALIA_CONFIG_HOME="$work/noctalia-config"
  mkdir -p -m 700 "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" \
    "$XDG_DATA_HOME" "$NOCTALIA_CONFIG_HOME"

  local sway_pid=""
  local socket=""

  # Headless sway with the software renderer: no GPU, seat or logind needed.
  cat > "$work/sway-config" <<'EOF'
output HEADLESS-1 mode 1920x1080
seat * hide_cursor 10000
EOF
  # setsid gives the whole training tree (dbus-run-session -> sway -> children)
  # its own session/process group, so teardown below can signal the group:
  # TERMs sent to $! alone only reached dbus-run-session and let sway stray
  # (2026-09-23 incident). makepkg is non-interactive (no job control), so
  # setsid execs in place and $! remains the group/session leader — the pgid
  # bookkeeping for the wait below stays valid.
  setsid env WLR_BACKENDS=headless WLR_LIBINPUT_NO_DEVICES=1 WLR_RENDERER=pixman \
    dbus-run-session -- sway -c "$work/sway-config" >"$work/sway.log" 2>&1 &
  sway_pid=$!
  local pgid="$sway_pid"

  # Wait for the Wayland socket to appear (up to ~10 s).
  for _ in $(seq 1 100); do
    socket="$(find "$XDG_RUNTIME_DIR" -maxdepth 1 -type s -name 'wayland-*' -print -quit 2>/dev/null)"
    if [[ -n "$socket" ]]; then
      break
    fi
    sleep 0.1
  done

  if [[ -n "$socket" ]]; then
    export WAYLAND_DISPLAY="${socket##*/}"
    # Exercise the real shell: startup, bar/widgets, render loop, IPC. SIGINT is
    # sent so noctalia can shut down cleanly and flush the profile; -k 5 guards
    # against a hung exit. Do NOT check timeout's exit code: rc=124 simply means
    # the 30 s training window elapsed — the profile dump is verified below by
    # the presence of .gcda files.
    timeout -s INT -k 5 30 "$bin" >/dev/null 2>&1 || true
    sleep 1
  else
    warning "sway headless socket never appeared; PGO limited to CLI workload (see $work/sway.log)"
  fi

  # CLI subcommands always exit through main(), so they always flush profiles.
  # Run them with WAYLAND_DISPLAY unset: with the variable still exported they
  # probe the (dead or foreign) socket instead of taking the CLI path that is
  # guaranteed to exit through main().
  env -u WAYLAND_DISPLAY "$bin" --help          >/dev/null 2>&1 || true
  env -u WAYLAND_DISPLAY "$bin" --version       >/dev/null 2>&1 || true
  for sub in msg config theme ipc; do
    env -u WAYLAND_DISPLAY "$bin" "$sub" --help >/dev/null 2>&1 || true
  done
  for sh in bash zsh fish; do
    env -u WAYLAND_DISPLAY "$bin" completions "$sh" >/dev/null 2>&1 || true
  done

  # Bounded group teardown: TERM the entire setsid group, wait a bounded grace
  # (50 x 0.1 s) for its live (non-zombie) members to exit, escalate with one
  # KILL sweep for anything that ignored TERM, then reap the direct child.
  # Group signalling is what guarantees no stray sway/dbus-run-session survives
  # the build (2026-09-23 incident). Zombies are ignored in the liveness probe:
  # the unwaited leader stays a zombie until the wait below, and treating it as
  # alive would always burn the full grace window.
  if [[ -n "$sway_pid" ]]; then
    local i
    kill -TERM -- "-$pgid" 2>/dev/null || true
    for i in $(seq 1 50); do
      ps -eo pgid=,stat= | awk -v g="$pgid" \
        '$1 == g && $2 !~ /^Z/ { alive = 1 } END { exit !alive }' || break
      sleep 0.1
    done
    if ps -eo pgid=,stat= | awk -v g="$pgid" \
        '$1 == g && $2 !~ /^Z/ { alive = 1 } END { exit !alive }'; then
      kill -KILL -- "-$pgid" 2>/dev/null || true
    fi
    wait "$sway_pid" 2>/dev/null || true
  fi

  # Whatever runs later in build()/package() (completions generation) must not
  # see the dead training socket either — take the clean CLI path there too.
  unset WAYLAND_DISPLAY

  # Single fall-through exit path: remove the short runtime dir created above.
  rm -rf "$rt_dir"
}

build() {
  CXXFLAGS+=" -Wno-unused-result"

  # Upstream meson.build gates -ffunction-sections/-fdata-sections and
  # -Wl,--gc-sections on buildtype == 'release', but arch-meson configures with
  # buildtype=plain, so apply them explicitly here.
  CFLAGS+=" -ffunction-sections -fdata-sections"
  CXXFLAGS+=" -ffunction-sections -fdata-sections"
  LDFLAGS+=" -Wl,--gc-sections"   # -Wl,--as-needed already in makepkg.conf

  # mold is noticeably faster at linking the large LTO binary. Runtime check so
  # the PKGBUILD still works without it (mold-git does not provide 'mold').
  if command -v mold >/dev/null 2>&1; then
    LDFLAGS+=" -fuse-ld=mold"
  fi

  local -a meson_flags=(
    -Db_ndebug=true
    -Dtests=disabled
    -Dnative_optimizations=true   # -march=native -mtune=native (local build)
    -Djemalloc=enabled
  )

  # PGO: instrument first WITHOUT LTO, train, then rebuild with -fprofile-use.
  # LTO is only enabled on the final rebuild.
  local pgo=false
  if command -v sway >/dev/null 2>&1 && command -v dbus-run-session >/dev/null 2>&1; then
    pgo=true
    meson_flags+=(-Db_pgo=generate -Db_lto=false)
  else
    warning "sway/dbus-run-session not available; building with LTO but without PGO"
    meson_flags+=(-Db_lto=true)
  fi

  arch-meson "${_pkgname}" build-release "${meson_flags[@]}"
  meson compile -C build-release

  if $pgo; then
    _pgo_train "$srcdir/pgo-work"

    # Only use the profile if the GUI run actually flushed data: a missing or
    # trivial profile makes -fprofile-use treat uncovered code as cold and would
    # pessimize the render loop — fall back to plain LTO in that case.
    local gcda_count
    gcda_count="$(find build-release -name '*.gcda' | wc -l)"
    if (( gcda_count > 100 )); then
      msg2 "PGO profile collected (${gcda_count} .gcda files); rebuilding with -fprofile-use + LTO"
      meson configure build-release -Db_pgo=use -Db_lto=true
    else
      warning "PGO profile incomplete (${gcda_count} .gcda files); building without PGO"
      # b_pgo's enum is off/generate/use — there is no "none" (a `-none` run
      # died with: Value "none" ... not one of the choices, 2026-09-23).
      meson configure build-release -Db_pgo=off -Db_lto=true
    fi
    meson compile -C build-release
  fi
}

package() {
  meson install -C build-release --destdir "${pkgdir}"

  install -Dm644 "${_pkgname}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${_pkgname}/README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"

  # Shell completions generated by the binary we just built.
  local shell completion_dir
  for shell in bash zsh fish; do
    case "$shell" in
      bash) completion_dir='usr/share/bash-completion/completions' ;;
      zsh)  completion_dir='usr/share/zsh/site-functions' ;;
      fish) completion_dir='usr/share/fish/vendor_completions.d' ;;
    esac
    ./build-release/noctalia completions "$shell" \
      | install -Dm644 /dev/stdin "${pkgdir}/${completion_dir}/noctalia"
  done
}
