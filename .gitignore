# Rust workspace build output (the native `gsa` engine)
/target

# Builder runtime state
.state/
.build-logs/
.pkg-cache/
.lane*.result
.pacman-install.lock

# makepkg outputs and downloaded sources
**/src/
# …but the Rust workspace's source trees are repo content, not makepkg state
!crates/*/src/
!crates/*/src/**
**/pkg/
**/build/
**/_build/
**/.git/
**/keys/
packages/*/*/*/
!packages/*/*/LICENSES/
!packages/*/*/LICENSES/**
*.pkg.tar.*
*.src.tar.*
*.tar
*.tar.*
# Upstream archive types "*.tar.*" does not reach. makepkg's SRCDEST is the
# recipe directory, so a download lands beside the PKGBUILD and must never be
# committed. A file a recipe needs *locally* is still protected:
# tests/recipe-sources.sh fails when a non-URL source=() entry exists on disk
# but is not committed, so a missing negation here is caught, not silent.
# This set is the same set `-ccc`/`--nuclear` deletes: `_DOWNLOAD_ARCHIVE_EXTS`
# in build-all.fish. Keep the two in step — when they drifted, a cleanup left ten
# downloads behind for a commit sweep to pick up (2026-09-20).
*.tgz
*.zip
*.jar
*.ttf
*.whl
*.part
*.sig
*.asc
*.log
*.log.*

# Host-specific profiles, generated configurations, and credentials
afdo.prof
propeller_cc_profile.txt
propeller_ld_profile.txt
config-[0-9]*
*.profraw
*.gcda
*.gcno
*.enc

# Temporary metadata and local reports
*.tmp.*
.srcinfo.err
